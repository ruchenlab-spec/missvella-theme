{%- doc -%}
  Renders the product "series" heading (e.g. IVELLA / HESSA) with an optional
  inline SKU on the right, used above product titles on cards and product pages.

  @param {object} product - Product resource
  @param {object} settings - Block settings containing the series/SKU options
{%- enddoc -%}

{% liquid
  # series_text is a plain text setting that supports dynamic sources, so merchants
  # pick the product metafield from the editor's dynamic source picker instead of
  # typing a namespace.key.
  assign series_value = settings.series_text | strip

  if series_value == blank and settings.series_fallback_vendor
    assign series_value = product.vendor | strip
  endif

  assign sku = product.selected_or_first_available_variant.sku
  if sku == blank
    assign sku = product.variants.first.sku
  endif
  assign sku = sku | strip

  assign show_series = false
  if settings.show_series and series_value != blank
    assign show_series = true
  endif

  assign show_sku = false
  if settings.show_sku and sku != blank
    assign show_sku = true
  endif
-%}

{% if show_series or show_sku %}
  <div
    class="product-series{% unless show_series %} product-series--sku-only{% endunless %}"
    style="
      --series-size: {{ settings.series_font_size | default: 12 }}px;
      --series-case: {{ settings.series_case | default: 'none' }};
      {% if settings.series_color != blank %}--series-color: {{ settings.series_color }};{% endif %}
    "
  >
    {% if show_series %}
      <span class="product-series__label">
        <span class="product-series__text">{{ series_value }}</span>
      </span>
    {% endif %}
    {% if show_sku %}
      <span class="product-series__sku">{{ settings.sku_prefix | default: 'SKU:' }} {{ sku }}</span>
    {% endif %}
  </div>
{% endif %}

{% stylesheet %}
  .product-series {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    width: 100%;
    margin-block-end: 4px;
  }

  .product-series__label {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-body--family);
    font-size: var(--series-size, 12px);
    font-weight: 500;
    letter-spacing: 0.08em;
    line-height: 1.3;
    text-transform: var(--series-case, none);
    color: var(--series-color, var(--color-foreground));
    max-width: 60%;
  }

  .product-series__text {
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .product-series__sku {
    font-family: var(--font-body--family);
    font-size: var(--series-size, 12px);
    line-height: 1.3;
    color: var(--series-color, var(--color-foreground));
    opacity: 0.7;
    white-space: nowrap;
    margin-inline-start: auto;
  }

  /* Without the series label the SKU takes its place on the left. */
  .product-series--sku-only {
    justify-content: flex-start;
  }

  .product-series--sku-only .product-series__sku {
    margin-inline-start: 0;
  }
{% endstylesheet %}
