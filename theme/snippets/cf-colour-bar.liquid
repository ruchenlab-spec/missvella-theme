{%- doc -%}
  Colour family bar: family pills + expandable swatch panels, followed by
  the results toolbar (item count, sort, grid density) and the removable
  active-filter chips bar.

  @param {object} colour_filter - The colour filter object
  @param {object} group_lines - Colour group map split into lines, one group per
    line as "Group name:#hex:member, member, member"
  @param {object} builtin_pairs - Built-in colour-name fallback pairs
  @param {string} [colour_bar_bg] - Optional background colour for the bar
  @param {string} results_url - URL the facet form submits to
  @param {string} collection_id_attribute
  @param {string} collection_handle_attribute
  @param {string} page_type_attribute
  @param {string} results_count_attribute
  @param {number} products_count - Number of products in the results
  @param {boolean} enable_sorting - Whether to render the sort control
  @param {boolean} enable_grid_density - Whether to render the density control
  @param {object} results - The search results object
  @param {string} sort_by - Currently selected sort option
  @param {string} section_id - Section id used by the sort control
{%- enddoc -%}
<div class="cf-colour-bar" data-cf-bar{% if colour_bar_bg != blank %} style="background-color: {{ colour_bar_bg }};"{% endif %}>

  {%- comment -%}
    Group assignment (moved above the header because the pills row now renders
    inside it): every filter value is assigned to exactly ONE group (first
    match wins). The previous fuzzy matching could put "Peacock Blue" into
    both Blues and Greens, which rendered the same value twice, duplicated
    input IDs and inflated the "Other" count once per non-matching group.
  {%- endcomment -%}
  {%- assign cf_assigned = '|' -%}
  {%- assign cf_map = '|' -%}
  {%- assign cf_group_scan = 0 -%}
  {%- for line in group_lines -%}
    {%- assign gl = line | strip -%}
    {%- if gl == blank -%}{%- continue -%}{%- endif -%}
    {%- assign parts = gl | split: ':' -%}
    {%- assign members = parts[2] | split: ',' -%}
    {%- for value in colour_filter.values -%}
      {%- assign value_key = value.label | downcase | strip -%}
      {%- assign value_needle = '|' | append: value_key | append: '|' -%}
      {%- if cf_assigned contains value_needle -%}{%- continue -%}{%- endif -%}
      {%- for m in members -%}
        {%- assign m_key = m | downcase | strip -%}
        {%- if m_key contains value_key or value_key contains m_key -%}
          {%- assign cf_assigned = cf_assigned | append: value_key | append: '|' -%}
          {%- assign cf_entry = '|' | append: cf_group_scan | append: ':' | append: value_key | append: '|' -%}
          {%- assign cf_map = cf_map | append: cf_entry -%}
          {%- break -%}
        {%- endif -%}
      {%- endfor -%}
    {%- endfor -%}
    {%- assign cf_group_scan = cf_group_scan | plus: 1 -%}
  {%- endfor -%}
  {%- comment -%} Other: values that no group claimed {%- endcomment -%}
  {%- assign loose_kids = 0 -%}
  {%- assign loose_active = 0 -%}
  {%- for value in colour_filter.values -%}
    {%- assign value_key = value.label | downcase | strip -%}
    {%- assign value_needle = '|' | append: value_key | append: '|' -%}
    {%- unless cf_assigned contains value_needle -%}
      {%- assign loose_kids = loose_kids | plus: 1 -%}
      {%- if value.active -%}{%- assign loose_active = loose_active | plus: 1 -%}{%- endif -%}
    {%- endunless -%}
  {%- endfor -%}

  {%- comment -%} Merged toolbar row: filter toggle + colour pills + sort/density {%- endcomment -%}
  <header class="cf-bar-head">
      <button
        type="button"
        class="cf-filter-toggle"
        data-cf-sidebar-toggle
        aria-expanded="{% if request.page_type == 'collection' %}false{% else %}true{% endif %}"
      >
        <span class="cf-filter-toggle__icon" aria-hidden="true">
          {{ 'icon-filter-sliders.svg' | inline_asset_content }}
        </span>
        <span class="cf-filter-toggle__label">
          <span class="cf-filter-toggle__label-open">Hide filters</span>
          <span class="cf-filter-toggle__label-closed">Filters</span>
        </span>
        <span class="cf-filter-toggle__arrow" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="15 18 9 12 15 6" />
          </svg>
        </span>
      </button>

      <div class="cf-bar-pills">
        {%- comment -%} All color: no colour constraint, clears colour params via the
           theme's existing filter mechanism (sort/q/other facets survive). {%- endcomment -%}
        {%- assign colour_active_total = colour_filter.active_values | size -%}
        <button
          type="button"
          class="cf-pill cf-pill--all"
          data-cf-clear-color
          aria-pressed="{% if colour_active_total == 0 %}true{% else %}false{% endif %}"
        >
          <span
            class="cf-pill__glyph cf-pill__glyph--rainbow"
            style="background-image: url('{{ 'swatch-iridescent.png' | asset_url }}'); background-size: cover; background-position: center; background-repeat: no-repeat;"
            aria-hidden="true"
          ></span>
          <span class="cf-pill__name">All color</span>
        </button>
        {%- assign group_index = 0 -%}
        {%- for line in group_lines -%}
          {%- assign gl = line | strip -%}
          {%- if gl == blank -%}{%- continue -%}{%- endif -%}
          {%- assign parts = gl | split: ':' -%}
          {%- assign group_name = parts[0] | strip -%}
          {%- assign group_color = parts[1] | strip -%}
          {%- assign group_kids = 0 -%}
          {%- assign group_active = 0 -%}
          {%- for value in colour_filter.values -%}
            {%- assign value_key = value.label | downcase | strip -%}
            {%- assign cf_needle = '|' | append: group_index | append: ':' | append: value_key | append: '|' -%}
            {%- if cf_map contains cf_needle -%}
              {%- assign group_kids = group_kids | plus: 1 -%}
              {%- if value.active -%}{%- assign group_active = group_active | plus: 1 -%}{%- endif -%}
            {%- endif -%}
          {%- endfor -%}
          {%- if group_kids > 0 -%}
            <button
              type="button"
              class="cf-pill{% if group_active > 0 %} is-active{% endif %}"
              data-cf-pill="{{ group_index }}"
              aria-expanded="false"
              aria-controls="cf-panel-{{ group_index }}"
              aria-pressed="{% if group_active > 0 %}true{% else %}false{% endif %}"
            >
              <span class="cf-pill__glyph" style="background: {{ group_color | default: '#9E9E9E' }};" aria-hidden="true"></span>
              <span class="cf-pill__name">{{ group_name }}</span>
              <span class="cf-pill__num">{% if group_kids < 10 %}0{% endif %}{{ group_kids }}</span>
              {%- if group_active > 0 -%}<span class="cf-pill__count">{{ group_active }}</span>{%- endif -%}
            </button>
          {%- endif -%}
          {%- assign group_index = group_index | plus: 1 -%}
        {%- endfor -%}
        {%- if loose_kids > 0 -%}
          <button
            type="button"
            class="cf-pill{% if loose_active > 0 %} is-active{% endif %}"
            data-cf-pill="other"
            aria-pressed="{% if loose_active > 0 %}true{% else %}false{% endif %}"
          >
            <span class="cf-pill__glyph" style="background: #9E9E9E;" aria-hidden="true"></span>
            <span class="cf-pill__name">Other</span>
            <span class="cf-pill__num">{% if loose_kids < 10 %}0{% endif %}{{ loose_kids }}</span>
            {%- if loose_active > 0 -%}<span class="cf-pill__count">{{ loose_active }}</span>{%- endif -%}
          </button>
        {%- endif -%}
      </div>

    <div class="cf-head-controls">
      {% if enable_sorting %}
        {% render 'sorting',
          results: results,
          sort_by: sort_by,
          filter_style: 'vertical',
          suffix: 'desktop',
          sort_position: 'desktop',
          should_use_select_on_mobile: false,
          section_id: section_id
        %}
      {% endif %}
      {% if enable_grid_density %}
        {% render 'grid-density-controls', viewport: 'desktop' %}
      {% endif %}
    </div>
  </header>
  <facet-inputs-component
    class="cf-bar-component"
    on:change="/updateFilters"
    id="facet-inputs-component-colour-bar"
    {{ collection_id_attribute }}
    {{ collection_handle_attribute }}
    {{ page_type_attribute }}
    {{ results_count_attribute }}
  >
    <form action="{{ results_url }}" class="cf-bar-form">
      {%- assign panel_index = 0 -%}
      {%- for line in group_lines -%}
        {%- assign gl = line | strip -%}
        {%- if gl == blank -%}{%- continue -%}{%- endif -%}
        {%- assign parts = gl | split: ':' -%}
        {%- assign group_name = parts[0] | strip -%}
        {%- assign group_kids = 0 -%}
        {%- assign group_active = 0 -%}
        {%- capture panel_swatches -%}
          {%- for value in colour_filter.values -%}
            {%- assign value_key = value.label | downcase | strip -%}
            {%- assign cf_needle = '|' | append: panel_index | append: ':' | append: value_key | append: '|' -%}
            {%- if cf_map contains cf_needle -%}
              {%- assign group_kids = group_kids | plus: 1 -%}
              {%- if value.active -%}{%- assign group_active = group_active | plus: 1 -%}{%- endif -%}
              {%- liquid
                assign input_id = 'Filter-cf-bar-' | append: value.label | handleize
                assign is_disabled = false
              -%}
              {% render 'cf2-item', value: value, input_id: input_id, facet_target: 'facet-inputs-component-colour-bar', is_disabled: is_disabled, builtin_pairs: builtin_pairs, navigate: true %}
            {%- endif -%}
          {%- endfor -%}
        {%- endcapture -%}
        {%- if group_kids > 0 -%}
          <div class="cf-bar-panel" id="cf-panel-{{ panel_index }}" data-cf-panel="{{ panel_index }}">
            <div class="cf-panel-head">
              <span class="cf-panel-title">{{ group_name }}</span>
              <span class="cf-panel-meta">{{ group_active }} selected of {{ group_kids }}</span>
            </div>
            <div class="cf2-swatches cf2-panel-swatches">{{ panel_swatches }}</div>
          </div>
        {%- endif -%}
        {%- assign panel_index = panel_index | plus: 1 -%}
      {%- endfor -%}
      {%- if loose_kids > 0 -%}
        <div class="cf-bar-panel" data-cf-panel="other">
          <div class="cf-panel-head">
            <span class="cf-panel-title">Other</span>
            <span class="cf-panel-meta">{{ loose_active }} selected of {{ loose_kids }}</span>
          </div>
          <div class="cf2-swatches cf2-panel-swatches">
            {%- for value in colour_filter.values -%}
              {%- assign value_key = value.label | downcase | strip -%}
              {%- assign value_needle = '|' | append: value_key | append: '|' -%}
              {%- unless cf_assigned contains value_needle -%}
                {%- liquid
                  assign input_id = 'Filter-cf-bar-' | append: value.label | handleize
                  assign is_disabled = false
                -%}
                {% render 'cf2-item', value: value, input_id: input_id, facet_target: 'facet-inputs-component-colour-bar', is_disabled: is_disabled, builtin_pairs: builtin_pairs, navigate: true %}
              {%- endunless -%}
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}
    </form>
  </facet-inputs-component>

  {%- comment -%} Results toolbar: item count (sort + density live in the header row) {%- endcomment -%}
  <div class="cf-bar-right">
    <div class="products-count-wrapper" data-testid="products-count">
      <span role="status">
        {% if products_count > 25000 %}
          {{- 'content.item_count_cutoff' | t: count: 25000 -}}
        {% else %}
          {{- 'content.item_count' | t: count: products_count -}}
        {% endif %}
      </span>
    </div>
  </div>

  {%- comment -%} Removable chips for every applied filter value {%- endcomment -%}
  {% render 'cf-active-bar', results: results %}

</div>
<script>
  {%- comment -%} All color: strip colour query params, keep sort / search / other facets. {%- endcomment -%}
  if (!window.__mvCfClearColorBound) {
    window.__mvCfClearColorBound = true;
    document.addEventListener('click', function (event) {
      var trigger = event.target.closest('[data-cf-clear-color]');
      if (!trigger) return;
      var url = new URL(window.location.href);
      Array.from(url.searchParams.keys()).forEach(function (key) {
        if (/^filter\.v\./.test(key) && !/^filter\.v\.price/.test(key) && /color|colour|颜色|color-pattern/i.test(key)) {
          url.searchParams.delete(key);
        }
      });
      url.searchParams.delete('page');
      event.preventDefault();
      window.location.assign(url.toString());
    });
  }
  /* Colour swatches: multi-select toggle. Checking a swatch ADDs its value
     while KEEPING the other selected colour values; unchecking removes only
     that value. The section re-renders via the facet component (no full page
     reload), so the checked swatch keeps its highlight and the others stay
     untouched. */
  document.addEventListener('change', (e) => {
    const inp = e.target;
    if (!inp.matches || !inp.matches('[data-url-add]')) return;
    const url = new URL(window.location.href);
    const key = inp.name;
    const values = url.searchParams.getAll(key);
    const idx = values.indexOf(inp.value);
    if (inp.checked && idx === -1) values.push(inp.value);
    if (!inp.checked && idx !== -1) values.splice(idx, 1);
    url.searchParams.delete(key);
    values.forEach((v) => url.searchParams.append(key, v));
    url.searchParams.delete('page');
    const comp = document.getElementById('facet-inputs-component-colour-bar');
    if (comp && typeof comp.updateFiltersByURL === 'function') {
      comp.updateFiltersByURL(url.toString());
    } else {
      window.location.assign(url.toString());
    }
  });
  /* The "All color" pill carries the underline only while no family is open
     and no family holds real selections; it moves to the opened/selected
     family otherwise. */
  function syncAllState() {
    document.querySelectorAll('.cf-colour-bar').forEach(function (bar) {
      var all = bar.querySelector('.cf-pill--all');
      if (!all) return;
      var anyEngaged = bar.querySelector('.cf-pill.is-active:not(.cf-pill--all), .cf-pill.is-open:not(.cf-pill--all)');
      all.classList.toggle('is-active', !anyEngaged);
    });
  }
  document.addEventListener('click', (e) => {
    const pill = e.target.closest('[data-cf-pill]');
    if (pill) {
      const bar = pill.closest('.cf-colour-bar');
      const idx = pill.dataset.cfPill;
      const panel = bar.querySelector('[data-cf-panel="' + idx + '"]');
      const isOpen = panel && panel.classList.contains('open');
      bar.querySelectorAll('.cf-bar-panel').forEach((p) => p.classList.remove('open'));
      bar.querySelectorAll('.cf-pill').forEach((p) => p.classList.remove('is-open'));
      if (!isOpen && panel) { panel.classList.add('open'); pill.classList.add('is-open'); }

      // The opened family presents the "selected" treatment (like the demo)
      // while aria-pressed keeps reporting the real filter state.
      bar.querySelectorAll('.cf-pill').forEach(function (p) {
        p.setAttribute('aria-expanded', p.classList.contains('is-open') ? 'true' : 'false');
      });

      syncAllState();
    } else if (!e.target.closest('.cf-bar-panel') && !e.target.closest('.cf-colour-bar')) {
      document.querySelectorAll('.cf-bar-panel.open').forEach((p) => p.classList.remove('open'));
      document.querySelectorAll('.cf-colour-bar .cf-pill').forEach((p) => p.classList.remove('is-open'));
      syncAllState();
    }
  });
  syncAllState();
</script>
