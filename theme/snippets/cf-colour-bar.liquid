{%- doc -%}
  Colour family bar: family pills + expandable swatch panels, with the
  item count, sort and grid-density controls on the right.

  @param {object} colour_filter - The colour filter object
  @param {object} group_lines - Colour group map split into lines, one group per
    line as "Group name:#hex:member, member, member"
  @param {object} builtin_pairs - Built-in colour-name fallback pairs
  @param {string} swatch_texture - Texture class modifier (linen/satin/mesh/velvet)
  @param {string} results_url - URL the facet form submits to
  @param {string} collection_id_attribute
  @param {string} collection_handle_attribute
  @param {string} page_type_attribute
  @param {string} results_count_attribute
  @param {number} products_count - Number of products in the results
  @param {boolean} enable_sorting - Whether to render the sort control
  @param {boolean} enable_grid_density - Whether to render the density control
  @param {object} results - The search results object
  @param {string} sort_by - Currently selected sort option
  @param {string} section_id - Section id used by the sort control
{%- enddoc -%}
<div class="cf-colour-bar cf-texture--{{ swatch_texture | default: 'linen' }}" data-cf-bar>

  <header class="cf-bar-head">
    <span class="cf-kicker">Curated by Colour</span>
    <h3 class="cf-bar-title">Choose your palette <span class="cf-asterisk">&#10035;</span></h3>
    <span class="cf-bar-tag">A little colour goes a long way</span>
  </header>
  <facet-inputs-component
    class="cf-bar-component"
    on:change="/updateFilters"
    id="facet-inputs-component-colour-bar"
    {{ collection_id_attribute }}
    {{ collection_handle_attribute }}
    {{ page_type_attribute }}
    {{ results_count_attribute }}
  >
    <form action="{{ results_url }}" class="cf-bar-form">
      <div class="cf-bar-pills">
        {%- assign group_index = 0 -%}
        {%- for line in group_lines -%}
          {%- assign gl = line | strip -%}
          {%- if gl == blank -%}{%- continue -%}{%- endif -%}
          {%- assign parts = gl | split: ':' -%}
          {%- assign group_name = parts[0] | strip -%}
          {%- assign group_color = parts[1] | strip -%}
          {%- assign members = parts[2] | split: ',' -%}
          {%- assign group_kids = 0 -%}
          {%- assign group_active = 0 -%}
          {%- for value in colour_filter.values -%}
            {%- assign value_key = value.label | downcase | strip -%}
            {%- for m in members -%}
              {%- assign m_key = m | downcase | strip -%}
              {%- if m_key contains value_key or value_key contains m_key -%}
                {%- assign group_kids = group_kids | plus: 1 -%}
                {%- if value.active -%}{%- assign group_active = group_active | plus: 1 -%}{%- endif -%}
                {%- break -%}
              {%- endif -%}
            {%- endfor -%}
          {%- endfor -%}
          {%- if group_kids > 0 -%}
            <button type="button" class="cf-pill{% if group_active > 0 %} is-active{% endif %}" data-cf-pill="{{ group_index }}">
              <span class="cf-pill__glyph"><i style="background: {{ group_color | default: '#9E9E9E' }};"></i></span>
              <span class="cf-pill__name">{{ group_name }}</span>
              <span class="cf-pill__num">{% if group_kids < 10 %}0{% endif %}{{ group_kids }}</span>
              {%- if group_active > 0 -%}<span class="cf-pill__count">{{ group_active }}</span>{%- endif -%}
            </button>
          {%- endif -%}
          {%- assign group_index = group_index | plus: 1 -%}
        {%- endfor -%}
        {%- comment -%} Other: values not in any group {%- endcomment -%}
        {%- assign loose_kids = 0 -%}
        {%- assign loose_active = 0 -%}
        {%- for value in colour_filter.values -%}
          {%- assign value_key = value.label | downcase | strip -%}
          {%- assign matched = false -%}
          {%- for line in group_lines -%}
            {%- assign gl2 = line | strip -%}
            {%- if gl2 == blank -%}{%- continue -%}{%- endif -%}
            {%- assign gm = gl2 | split: ':' -%}
            {%- assign gm_members = gm[2] | split: ',' -%}
            {%- for m in gm_members -%}
              {%- assign m_key = m | downcase | strip -%}
              {%- if m_key contains value_key or value_key contains m_key -%}
                {%- assign matched = true -%}
                {%- break -%}
              {%- endif -%}
            {%- endfor -%}
            {%- unless matched -%}
              {%- assign loose_kids = loose_kids | plus: 1 -%}
              {%- if value.active -%}{%- assign loose_active = loose_active | plus: 1 -%}{%- endif -%}
            {%- endunless -%}
          {%- endfor -%}
        {%- endfor -%}
        {%- if loose_kids > 0 -%}
          <button type="button" class="cf-pill{% if loose_active > 0 %} is-active{% endif %}" data-cf-pill="other">
            <span class="cf-pill__glyph"><i style="background: #9E9E9E;"></i></span>
            <span class="cf-pill__name">Other</span>
            <span class="cf-pill__num">{% if loose_kids < 10 %}0{% endif %}{{ loose_kids }}</span>
            {%- if loose_active > 0 -%}<span class="cf-pill__count">{{ loose_active }}</span>{%- endif -%}
          </button>
        {%- endif -%}
      </div>

      {%- assign panel_index = 0 -%}
      {%- for line in group_lines -%}
        {%- assign gl = line | strip -%}
        {%- if gl == blank -%}{%- continue -%}{%- endif -%}
        {%- assign parts = gl | split: ':' -%}
        {%- assign members = parts[2] | split: ',' -%}
        {%- assign group_name = parts[0] | strip -%}
        {%- assign group_kids = 0 -%}
        {%- assign group_active = 0 -%}
        {%- for value in colour_filter.values -%}
          {%- assign value_key = value.label | downcase | strip -%}
          {%- for m in members -%}
            {%- assign m_key = m | downcase | strip -%}
            {%- if m_key contains value_key or value_key contains m_key -%}
              {%- assign group_kids = group_kids | plus: 1 -%}
              {%- if value.active -%}{%- assign group_active = group_active | plus: 1 -%}{%- endif -%}
              {%- break -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endfor -%}
        {%- if group_kids > 0 -%}
          <div class="cf-bar-panel" data-cf-panel="{{ panel_index }}">
            <div class="cf-panel-head">
              <span class="cf-panel-title">{{ group_name }}</span>
              <span class="cf-panel-meta">{{ group_active }} selected of {{ group_kids }}</span>
            </div>
            <div class="cf2-swatches cf2-panel-swatches">
              {%- for value in colour_filter.values -%}
                {%- assign value_key = value.label | downcase | strip -%}
                {%- for m in members -%}
                  {%- assign m_key = m | downcase | strip -%}
                  {%- if m_key contains value_key or value_key contains m_key -%}
                    {%- liquid
                      assign input_id = 'Filter-cf-bar-' | append: value.label | handleize
                      assign is_disabled = false
                      if value.count == 0 and value.active == false
                        assign is_disabled = true
                      endif
                    -%}
                    {% render 'cf2-item', value: value, input_id: input_id, facet_target: 'facet-inputs-component-colour-bar', is_disabled: is_disabled, builtin_pairs: builtin_pairs, navigate: true %}
                    {%- break -%}
                  {%- endif -%}
                {%- endfor -%}
              {%- endfor -%}
            </div>
          </div>
        {%- endif -%}
        {%- assign panel_index = panel_index | plus: 1 -%}
      {%- endfor -%}
      {%- if loose_kids > 0 -%}
        <div class="cf-bar-panel" data-cf-panel="other">
          <div class="cf-panel-head">
            <span class="cf-panel-title">Other</span>
            <span class="cf-panel-meta">{{ loose_active }} selected of {{ loose_kids }}</span>
          </div>
          <div class="cf2-swatches cf2-panel-swatches">
            {%- for value in colour_filter.values -%}
              {%- assign value_key = value.label | downcase | strip -%}
              {%- assign matched = false -%}
              {%- for line in group_lines -%}
                {%- assign gl2 = line | strip -%}
                {%- if gl2 == blank -%}{%- continue -%}{%- endif -%}
                {%- assign gm = gl2 | split: ':' -%}
                {%- assign gm_members = gm[2] | split: ',' -%}
                {%- for m in gm_members -%}
                  {%- assign m_key = m | downcase | strip -%}
                  {%- if m_key contains value_key or value_key contains m_key -%}
                    {%- assign matched = true -%}
                    {%- break -%}
                  {%- endif -%}
                {%- endfor -%}
              {%- endfor -%}
              {%- unless matched -%}
                {%- liquid
                  assign input_id = 'Filter-cf-bar-' | append: value.label | handleize
                  assign is_disabled = false
                  if value.count == 0 and value.active == false
                    assign is_disabled = true
                  endif
                -%}
                {% render 'cf2-item', value: value, input_id: input_id, facet_target: 'facet-inputs-component-colour-bar', is_disabled: is_disabled, builtin_pairs: builtin_pairs, navigate: true %}
              {%- endunless -%}
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}
    </form>
  </facet-inputs-component>

  {%- comment -%} Right side of the bar: item count + sort + grid density,
     bottom-aligned with the colour pills {%- endcomment -%}
  <div class="cf-bar-right">
    <div class="products-count-wrapper" data-testid="products-count">
      <span role="status">
        {% if products_count > 25000 %}
          {{- 'content.item_count_cutoff' | t: count: 25000 -}}
        {% else %}
          {{- 'content.item_count' | t: count: products_count -}}
        {% endif %}
      </span>
    </div>
    {% if enable_sorting %}
      {% render 'sorting',
        results: results,
        sort_by: sort_by,
        filter_style: 'vertical',
        suffix: 'desktop',
        sort_position: 'desktop',
        should_use_select_on_mobile: false,
        section_id: section_id
      %}
    {% endif %}
    {% if enable_grid_density %}
      {% render 'grid-density-controls', viewport: 'desktop' %}
    {% endif %}

  </div>
  <aside class="cf-edit-note">
    <span class="cf-kicker">The Missvella Edit</span>
    <p class="cf-edit-title">Made for the entrance. <em>Remembered for the feeling.</em></p>
    <p class="cf-edit-count"><strong>{{ products_count }}</strong> styles / curated for your occasion</p>
  </aside>
</div>
<script>
  document.addEventListener('change', (e) => {
    const inp = e.target;
    if (inp.matches && inp.matches('[data-url-add]')) {
      window.location.href = inp.checked ? inp.dataset.urlAdd : inp.dataset.urlRemove;
    }
  });
  function syncPush() {
    const bar = document.querySelector('.cf-colour-bar');
    if (!bar) return;
    const open = bar.querySelector('.cf-bar-panel.open');
    bar.style.marginBlockEnd = open ? (open.offsetHeight + 8) + 'px' : '';
    if (window.ResizeObserver) {
      if (bar._cfRO) bar._cfRO.disconnect();
      if (open) {
        bar._cfRO = new ResizeObserver(syncPush);
        bar._cfRO.observe(open);
      }
    }
  }
  document.addEventListener('click', (e) => {
    const pill = e.target.closest('[data-cf-pill]');
    if (pill) {
      const bar = pill.closest('.cf-colour-bar');
      const idx = pill.dataset.cfPill;
      const panel = bar.querySelector('[data-cf-panel="' + idx + '"]');
      const isOpen = panel && panel.classList.contains('open');
      bar.querySelectorAll('.cf-bar-panel').forEach((p) => p.classList.remove('open'));
      bar.querySelectorAll('.cf-pill').forEach((p) => p.classList.remove('is-open'));
      if (!isOpen && panel) { panel.classList.add('open'); pill.classList.add('is-open'); }

      syncPush();
    } else if (!e.target.closest('.cf-bar-panel') && !e.target.closest('.cf-colour-bar')) {
      document.querySelectorAll('.cf-bar-panel.open').forEach((p) => p.classList.remove('open'));
      syncPush();
    }
  });
</script>
