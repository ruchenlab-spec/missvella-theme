{%- liquid
  assign override = nil
  assign lookup_name = name | downcase
  for candidate in section.blocks
    assign candidate_name = candidate.settings.name | strip | downcase
    if candidate_name == lookup_name
      assign override = candidate
      break
    endif
  endfor
  assign garment = images[image_file]
  assign catalog_detail = garment
  if override.settings.suppress_catalog_image
    assign garment = nil
    assign catalog_detail = nil
  endif
  if override.settings.garment != blank
    assign catalog_detail = nil
  endif
  assign garment = override.settings.garment | default: garment
  assign closeup = override.settings.closeup
  assign finish = override.settings.finish | default: finish
  assign drape = override.settings.drape | default: drape
  assign feel = override.settings.feel | default: feel
  assign link = override.settings.link
  assign link_label = override.settings.link_label
  if link == blank and product_handle != blank
    assign link = routes.root_url | append: '/products/' | append: product_handle | replace: '//', '/'
    assign link_label = 'View the pictured dress'
  endif
  if override.settings.garment != blank
    assign image_caption = override.settings.garment_caption
  else
    assign image_caption = override.settings.garment_caption | default: image_caption
  endif
-%}
{% unless override.settings.hide_in_catalog %}
  <article id="Fabric-{{ section.id }}-{{ entry_id }}" class="fabric-guide__item{% if garment == blank and closeup == blank %} fabric-guide__item--text-only{% endif %}" {{ override.shopify_attributes }}>
    {% if garment != blank or closeup != blank %}
      <div class="fabric-guide__media">
        {% if closeup != blank %}
          <figure>
            {% assign closeup_alt = closeup.alt | default: name %}
            {{ closeup | image_url: width: 264 | image_tag: widths: '88, 176, 264', sizes: '(min-width: 750px) 88px, 44px', loading: 'lazy', alt: closeup_alt }}
          </figure>
        {% elsif catalog_detail != blank %}
          <figure>
            <div class="fabric-guide__crop" style="--guide-detail-origin: {{ detail_position | escape }};">
              {% assign detail_alt = 'Garment detail. ' | append: image_caption %}
              {{ catalog_detail | image_url: width: 600 | image_tag: widths: '200, 400, 600', sizes: '(min-width: 750px) 194px, 97px', loading: 'lazy', alt: detail_alt }}
            </div>
          </figure>
        {% endif %}
        {% if garment != blank %}
          <figure>
            {% assign garment_alt = image_caption | default: name %}
            {{ garment | image_url: width: 264 | image_tag: widths: '88, 176, 264', sizes: '(min-width: 750px) 88px, 44px', loading: 'lazy', alt: garment_alt }}
          </figure>
        {% endif %}
      </div>
    {% endif %}
    <div class="material-guide__copy">
      <h3 class="material-guide__item-heading">{{ name | escape }}</h3>
      {% if override.settings.description != blank %}<div class="rte">{{ override.settings.description }}</div>{% else %}<p>{{ description | escape }}</p>{% endif %}
      {% if garment != blank or closeup != blank %}
        <div class="fabric-guide__image-notes">
          {% if closeup != blank %}
            {% if override.settings.closeup_caption != blank %}<span>{{ override.settings.closeup_caption | escape }}</span>{% endif %}
          {% elsif catalog_detail != blank %}<span>Detail crop from the pictured dress.</span>{% endif %}
          {% if garment != blank and image_caption != blank %}<span>{{ image_caption | escape }}</span>{% endif %}
        </div>
      {% endif %}
      <dl class="fabric-guide__facts">
        <div><dt>{{ section.settings.finish_label | escape }}</dt><dd>{{ finish | escape }}</dd></div>
        <div><dt>{{ section.settings.drape_label | escape }}</dt><dd>{{ drape | escape }}</dd></div>
        <div><dt>{{ section.settings.feel_label | escape }}</dt><dd>{{ feel | escape }}</dd></div>
      </dl>
      {% if override.settings.notes != blank %}<div class="material-guide__note rte">{{ override.settings.notes }}</div>{% else %}<p class="material-guide__note">{{ notes | escape }}</p>{% endif %}
      {% if link != blank and link_label != blank %}<a class="material-guide__link" href="{{ link | escape }}">{{ link_label | escape }}</a>{% endif %}
    </div>
  </article>
{% endunless %}
