{%- doc -%}
  Renders a single Soft Minimal colour swatch item for the filters block
  (native checkbox plumbing preserved for facet-inputs-component).

  @param {object} value - Filter value object
  @param {string} input_id - id for the checkbox input
  @param {string} facet_target - facet-inputs-component id for keydown handling
  @param {boolean} [is_disabled] - Whether the value is disabled
  @param {boolean} [navigate] - When true, toggling navigates via
    url_to_add/url_to_remove (used outside facet forms, e.g. the colour bar)
  @param builtin_pairs - Built-in colour-name fallback pairs
{%- enddoc -%}

{%- liquid
  if value.swatch.image != blank
    assign swatch_img = value.swatch.image | image_url: width: 80
  endif
-%}
{%- capture swatch_hex -%}{%- render 'color-facet-swatch', value: value, builtin_pairs: builtin_pairs -%}{%- endcapture -%}
<div
  class="cf2-item{% if is_disabled %} cf2-item--disabled{% endif %}"
  on:keydown="#{{ facet_target }}/handleKeyDown"
>
  <input
    type="checkbox"
    name="{{ value.param_name }}"
    value="{{ value.value }}"
    aria-label="{{ value.label }}"
    id="{{ input_id }}"
    {% if value.active %}
      checked
    {% endif %}
    {% if is_disabled %}
      disabled
    {% endif %}
    {% if navigate %}
      data-url-add="{{ value.url_to_add | escape }}"
      data-url-remove="{{ value.url_to_remove | escape }}"
    {% endif %}
    ref="facetInputs[]"
    tabindex="-1"
  >
  <label class="cf2-item__label" for="{{ input_id }}" tabindex="-1">
    <span
      class="cf2-item__dot"
      style="{% if swatch_img %}background: center / cover no-repeat url({{ swatch_img }});{% elsif swatch_hex != blank %}background: {{ swatch_hex }};{% else %}background: #D9D9D9;{% endif %}"
    >
    </span>
    <span class="cf2-item__name">{{ value.label }}</span>
  </label>
</div>
