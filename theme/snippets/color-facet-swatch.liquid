{%- doc -%}
  Resolves the CSS swatch background for a single filter value.

  Priority: merchant custom map > Shopify swatch > built-in colour-name map.

  @param {object} value - Filter value object
  @param custom_pairs - Merchant "name:#hex" pairs (optional)
  @param builtin_pairs - Built-in "name:#hex" pairs
{%- enddoc -%}

{% liquid
  assign background = ''
  assign value_key = value.label | downcase | strip

  if custom_pairs != blank
    for pair in custom_pairs
      assign trimmed = pair | strip
      if trimmed == blank
        continue
      endif
      assign key_part = trimmed | split: ':'
      assign key_name = key_part[0] | downcase | strip
      if key_name == value_key and key_part[1] != blank
        assign background = key_part[1] | strip
        break
      endif
    endfor
  endif

  if background == blank and value.swatch.image != blank
    assign url = value.swatch.image | image_url: width: 80
    assign background = 'center / cover no-repeat url(' | append: url | append: ')'
  endif
  if background == blank and value.swatch.color != blank
    assign background = value.swatch.color
  endif

  if background == blank
    assign marker = value_key | prepend: ',' | append: ':'
    assign colors = builtin_pairs | join: ',' | prepend: ','
    if colors contains marker
      assign background = colors | split: marker | last | split: ',' | first
    endif
  endif
  if background == blank and value_key == 'rainbow'
    assign rainbow = metaobjects['shopify--color-pattern']['rainbow'].image.value
    if rainbow != blank
      assign url = rainbow | image_url: width: 80
      assign background = 'center / cover no-repeat url(' | append: url | append: ')'
    endif
  endif
-%}
{{- background -}}
