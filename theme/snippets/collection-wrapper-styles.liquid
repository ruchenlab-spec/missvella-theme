{%- doc -%}
  Shared collection wrapper layout styles for collection and search results pages.

  @example
  {% render 'collection-wrapper-styles' %}
{%- enddoc -%}

{% stylesheet %}
  /* ------------------------------------------------------------------------------ */

  /* Collection Wrapper - Shared layout CSS for collection and search pages */

  /* ------------------------------------------------------------------------------ */

  .collection-wrapper {
    @media screen and (min-width: 750px) {
      --facets-vertical-col-width: 6;

      grid-template-columns:
        1fr repeat(
          var(--centered-column-number),
          minmax(0, calc((var(--page-width) - var(--page-margin) * 2) / var(--centered-column-number)))
        )
        1fr;
    }

    @media screen and (min-width: 990px) {
      --facets-vertical-col-width: 5;
    }
  }

  /*
   * Full-width product grid: side gutters from the section's left/right padding
   * settings (default 40px, halved on mobile) so content does not touch the edges.
   */
  .collection-wrapper--grid-full-width {
    padding-inline: var(--grid-padding-inline-start, 40px) var(--grid-padding-inline-end, 40px);
  }

  @media screen and (max-width: 749px) {
    .collection-wrapper--grid-full-width {
      padding-inline: calc(var(--grid-padding-inline-start, 40px) * 0.5)
        calc(var(--grid-padding-inline-end, 40px) * 0.5);
    }
  }

  .collection-wrapper:has(.facets-block-wrapper--full-width),
  .collection-wrapper:has(.collection-wrapper--full-width) {
    @media screen and (min-width: 750px) {
      grid-column: 1 / -1;
      grid-template-columns:
        minmax(var(--page-margin), 1fr) repeat(
          var(--centered-column-number),
          minmax(0, calc((var(--page-width) - var(--page-margin) * 2) / var(--centered-column-number)))
        )
        minmax(var(--page-margin), 1fr);
    }
  }

  .collection-wrapper:has(.facets--vertical) .facets-block-wrapper--vertical:not(.hidden) ~ .main-collection-grid {
    @media screen and (min-width: 750px) {
      grid-column: var(--facets-vertical-col-width) / var(--full-width-column-number);
    }
  }

  .collection-wrapper:has(.facets-block-wrapper--vertical:not(#filters-drawer)):has(.collection-wrapper--full-width) {
    @media screen and (min-width: 750px) {
      grid-column: 1 / -1;
      grid-template-columns: 0fr repeat(var(--centered-column-number), minmax(0, 1fr)) 0fr;
    }
  }

  :is(.collection-wrapper--full-width, .collection-wrapper--full-width-on-mobile)
    [product-grid-view='default']
    .product-grid__card {
    @media screen and (max-width: 749px) {
      padding-inline-start: max(var(--padding-xs), var(--padding-inline-start));
      padding-inline-end: max(var(--padding-xs), var(--padding-inline-end));
    }
  }

  :is(.collection-wrapper--full-width, .collection-wrapper--full-width-on-mobile)
    [product-grid-view='mobile-single']
    .product-grid__card {
    @media screen and (max-width: 749px) {
      padding-inline-start: max(var(--padding-xs), var(--padding-inline-start));
      padding-inline-end: max(var(--padding-xs), var(--padding-inline-end));
    }
  }

  /* Make product media go edge-to-edge by using negative margins */
  :is(.collection-wrapper--full-width) .card-gallery,
  :is(.collection-wrapper--full-width-on-mobile) .card-gallery {
    @media screen and (max-width: 749px) {
      margin-inline-start: calc(-1 * max(var(--padding-xs), var(--padding-inline-start)));
      margin-inline-end: calc(-1 * max(var(--padding-xs), var(--padding-inline-end)));
    }
  }

  .collection-wrapper--full-width .main-collection-grid__title {
    margin-inline-start: var(--page-margin);
  }

  .collection-wrapper--full-width-on-mobile .main-collection-grid__title {
    @media screen and (max-width: 749px) {
      margin-inline-start: var(--page-margin);
    }
  }

  .collection-wrapper--grid-full-width .facets--vertical:not(.facets--drawer) {
    @media screen and (min-width: 750px) {
      padding-inline-start: max(var(--padding-sm), var(--padding-inline-start));
    }
  }

  .collection-wrapper:has(.product-grid-mobile--large) .facets-mobile-wrapper.facets-controls-wrapper {
    @media screen and (max-width: 749px) {
      display: none;
    }
  }

  .collection-wrapper:has(> .facets--horizontal) .facets__panel[open] {
    @media screen and (min-width: 750px) {
      z-index: var(--facets-open-z-index);
    }
  }

  /* ===== Unified filter layout (colour bar on top, sidebar for the rest) ===== */
  .collection-wrapper:has(.cf-colour-bar) {
    grid-template-columns: minmax(210px, 250px) minmax(0, 1fr) !important;
  }

  /* The filters block holds both the colour bar and the sidebar - let its
     children participate in the collection grid directly */
  .collection-wrapper:has(.cf-colour-bar) .facets-block-wrapper {
    display: contents;
  }

  /* Sidebar starts at the very top, level with the colour bar */
  .collection-wrapper:has(.cf-colour-bar) .facets-block-wrapper .facets {
    grid-column: 1;
    grid-row: 1 / span 14;
    align-self: start;
    position: sticky;
    top: calc(var(--header-height, 80px) + 16px);
    max-height: calc(100vh - var(--header-height, 80px) - 32px);
    overflow-y: auto;
    scrollbar-width: none;
  }

  .collection-wrapper:has(.cf-colour-bar) .facets-block-wrapper .facets::-webkit-scrollbar {
    display: none;
  }

  /* Colour bar row: pills bottom-left, sort/count/density bottom-right,
     bottom aligned. The expanded panel overlays the products (absolute). */
  .collection-wrapper:has(.cf-colour-bar) .cf-colour-bar {
    grid-column: 2;
    grid-row: 1;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    padding-block: 4px 0;
    margin-block-end: 26px;
    position: relative;
    z-index: 11;
  }

  .collection-wrapper:has(.cf-colour-bar) .cf-bar-component {
    flex: 1 1 auto;
    min-width: 0;
  }

  .cf-bar-right {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    gap: 18px;
    padding-bottom: 2px;
  }

  .cf-bar-right .products-count-wrapper {
    font-size: 13px;
    color: var(--color-foreground-subdued);
    white-space: nowrap;
  }

  .collection-wrapper:has(.cf-colour-bar) .main-collection-grid {
    grid-column: 2 !important;
    grid-row: 2 / span 14;
  }

  @media screen and (max-width: 749px) {
    .collection-wrapper:has(.cf-colour-bar) {
      grid-template-columns: 1fr !important;
    }

    .collection-wrapper:has(.cf-colour-bar) .cf-colour-bar {
      grid-column: 1;
      grid-row: 1;
      display: block;
    }

    .cf-colour-bar .cf-bar-pills {
      flex-wrap: nowrap;
      overflow-x: auto;
      scrollbar-width: none;
    }

    .cf-colour-bar .cf-bar-pills::-webkit-scrollbar {
      display: none;
    }

    .cf-bar-right {
      display: none;
    }

    .collection-wrapper:has(.cf-colour-bar) .facets-block-wrapper .facets {
      display: none;
    }

    .collection-wrapper:has(.cf-colour-bar) .main-collection-grid {
      grid-column: 1 !important;
      grid-row: 2;
    }
  }

  /* ===== Colour family bar components ===== */
  .cf-bar-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  /*
   * Family pills: solid swatch-coloured tiles with white centred labels,
   * fabric texture overlay (see .cf-texture-- rules) and a soft inner bevel.
   * Selected = white + dark double ring.
   */
  .cf-pill {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    min-width: 92px;
    min-height: 42px;
    padding: 10px 20px;
    border: 0;
    border-radius: 10px;
    color: #ffffff;
    cursor: pointer;
    font: inherit;
    font-size: 13px;
    background-image: linear-gradient(155deg, rgb(255 255 255 / 22%), rgb(0 0 0 / 14%));
    background-blend-mode: soft-light;
    box-shadow:
      inset 0 1px 2px rgb(255 255 255 / 35%),
      inset 0 -2px 5px rgb(0 0 0 / 22%),
      inset 0 0 0 1px rgb(0 0 0 / 12%),
      0 1px 3px rgb(0 0 0 / 12%);
    text-shadow: 0 1px 2px rgb(0 0 0 / 30%);
    transition: box-shadow 0.22s ease, transform 0.22s ease;
  }

  .cf-pill:hover {
    transform: translateY(-2px);
    box-shadow:
      inset 0 1px 2px rgb(255 255 255 / 40%),
      inset 0 -2px 5px rgb(0 0 0 / 22%),
      inset 0 0 0 1px rgb(0 0 0 / 14%),
      0 8px 18px rgb(0 0 0 / 22%);
  }

  .cf-pill.is-active {
    box-shadow:
      0 0 0 2px var(--color-background),
      0 0 0 3.5px var(--color-foreground),
      0 6px 16px rgb(0 0 0 / 18%);
  }

  .cf-pill__name {
    font-weight: 500;
    letter-spacing: 0.02em;
  }

  .cf-pill__count {
    font-size: 10px;
    opacity: 0.8;
  }

  /*
   * Expanded panel: light neutral card; the swatch row runs HORIZONTALLY
   * (dots above labels) and scrolls when a family has many colours.
   */
  /*
   * Expanded panel: light neutral card that OVERLAYS the products below the
   * pills row (absolute within the colour bar, full row width). Inline flow
   * would push the sort controls around and stretch to the pills sub-column.
   */
  .cf-bar-panel {
    display: none;
    position: absolute;
    top: calc(100% + 8px);
    left: 0;
    right: 0;
    z-index: 12;
    padding: 20px 24px;
    background: #f2efe6;
    border: 1px solid rgb(0 0 0 / 6%);
    border-radius: 12px;
    box-shadow: 0 16px 38px rgb(0 0 0 / 14%);
  }

  .cf-bar-panel.open {
    display: block;
  }

  @media screen and (max-width: 749px) {
    .cf-bar-panel {
      position: static;
      box-shadow: none;
      padding: 14px 16px;
    }
  }

  .cf2-panel-swatches {
    display: flex;
    flex-wrap: nowrap;
    overflow-x: auto;
    justify-content: flex-start;
    gap: 10px 30px;
    scrollbar-width: none;
    padding-bottom: 2px;
  }

  .cf2-panel-swatches::-webkit-scrollbar {
    display: none;
  }

  /* ===== Fabric texture overlays (cf-texture-- set on the bar) ===== */
  .cf-texture--linen .cf-pill::after,
  .cf-texture--linen .cf2-item__dot::after,
  .cf-texture--satin .cf-pill::after,
  .cf-texture--satin .cf2-item__dot::after,
  .cf-texture--mesh .cf-pill::after,
  .cf-texture--mesh .cf2-item__dot::after,
  .cf-texture--velvet .cf-pill::after,
  .cf-texture--velvet .cf2-item__dot::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
  }

  .cf-texture--linen .cf-pill::after,
  .cf-texture--linen .cf2-item__dot::after {
    background:
      repeating-linear-gradient(45deg, rgb(255 255 255 / 16%) 0 1px, transparent 1px 3px),
      repeating-linear-gradient(-45deg, rgb(0 0 0 / 12%) 0 1px, transparent 1px 3px);
  }

  .cf-texture--satin .cf-pill::after,
  .cf-texture--satin .cf2-item__dot::after {
    background: linear-gradient(
      135deg,
      rgb(255 255 255 / 42%) 0%,
      rgb(255 255 255 / 8%) 32%,
      rgb(0 0 0 / 14%) 62%,
      rgb(255 255 255 / 24%) 100%
    );
  }

  .cf-texture--mesh .cf-pill::after,
  .cf-texture--mesh .cf2-item__dot::after {
    background-image:
      radial-gradient(circle at 25% 25%, rgb(255 255 255 / 34%) 0 1.2px, transparent 2px),
      radial-gradient(circle at 75% 75%, rgb(0 0 0 / 16%) 0 1.2px, transparent 2px);
    background-size: 6px 6px;
  }

  .cf-texture--velvet .cf-pill::after,
  .cf-texture--velvet .cf2-item__dot::after {
    background:
      radial-gradient(ellipse at 35% 28%, rgb(255 255 255 / 38%), transparent 58%),
      radial-gradient(ellipse at 72% 78%, rgb(0 0 0 / 26%), transparent 62%);
  }

  /* Textured dots/pills need overflow hidden so the overlay follows the shape */
  .cf-texture--linen .cf2-item__dot,
  .cf-texture--satin .cf2-item__dot,
  .cf-texture--mesh .cf2-item__dot,
  .cf-texture--velvet .cf2-item__dot,
  .cf-texture--linen .cf-pill,
  .cf-texture--satin .cf-pill,
  .cf-texture--mesh .cf-pill,
  .cf-texture--velvet .cf-pill {
    overflow: hidden;
  }

  /*
   * Swatch refinement: larger dots, spherical bevel, layered hover / selection
   * rings instead of a flat colour chip.
   */
  .cf2-item__dot {
    width: 48px;
    height: 48px;
    box-shadow:
      inset 0 2px 4px rgb(255 255 255 / 38%),
      inset 0 -3px 6px rgb(0 0 0 / 20%),
      inset 0 0 0 1px rgb(0 0 0 / 10%),
      0 2px 5px rgb(0 0 0 / 16%);
    transition:
      transform 0.22s cubic-bezier(0.22, 0.61, 0.36, 1),
      box-shadow 0.22s ease;
  }

  .cf2-item:hover .cf2-item__dot {
    transform: scale(1.1);
    box-shadow:
      inset 0 2px 4px rgb(255 255 255 / 42%),
      inset 0 -3px 6px rgb(0 0 0 / 22%),
      inset 0 0 0 1px rgb(0 0 0 / 14%),
      0 6px 14px rgb(0 0 0 / 22%);
  }

  .cf2-item input:checked + .cf2-item__label .cf2-item__dot {
    box-shadow:
      0 0 0 2.5px var(--color-background),
      0 0 0 4px var(--color-foreground),
      0 4px 10px rgb(0 0 0 / 18%);
  }

  .cf2-item:hover input:checked + .cf2-item__label .cf2-item__dot {
    transform: scale(1.06);
  }
{% endstylesheet %}
