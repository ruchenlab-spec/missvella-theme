{%- doc -%}
  Shared collection wrapper layout styles for collection and search results pages.

  @example
  {% render 'collection-wrapper-styles' %}
{%- enddoc -%}

{% stylesheet %}
  /* ------------------------------------------------------------------------------ */

  /* Collection Wrapper - Shared layout CSS for collection and search pages */

  /* ------------------------------------------------------------------------------ */

  .collection-wrapper {
    @media screen and (min-width: 750px) {
      --facets-vertical-col-width: 6;

      grid-template-columns:
        1fr repeat(
          var(--centered-column-number),
          minmax(0, calc((var(--page-width) - var(--page-margin) * 2) / var(--centered-column-number)))
        )
        1fr;
    }

    @media screen and (min-width: 990px) {
      --facets-vertical-col-width: 5;
    }
  }

  /*
   * Full-width product grid: side gutters from the section's left/right padding
   * settings (default 40px, halved on mobile) so content does not touch the edges.
   */
  .collection-wrapper--grid-full-width {
    padding-inline: var(--grid-padding-inline-start, 40px) var(--grid-padding-inline-end, 40px);
  }

  @media screen and (max-width: 749px) {
    .collection-wrapper--grid-full-width {
      padding-inline: calc(var(--grid-padding-inline-start, 40px) * 0.5)
        calc(var(--grid-padding-inline-end, 40px) * 0.5);
    }
  }

  .collection-wrapper:has(.facets-block-wrapper--full-width),
  .collection-wrapper:has(.collection-wrapper--full-width) {
    @media screen and (min-width: 750px) {
      grid-column: 1 / -1;
      grid-template-columns:
        minmax(var(--page-margin), 1fr) repeat(
          var(--centered-column-number),
          minmax(0, calc((var(--page-width) - var(--page-margin) * 2) / var(--centered-column-number)))
        )
        minmax(var(--page-margin), 1fr);
    }
  }

  .collection-wrapper:has(.facets--vertical) .facets-block-wrapper--vertical:not(.hidden) ~ .main-collection-grid {
    @media screen and (min-width: 750px) {
      grid-column: var(--facets-vertical-col-width) / var(--full-width-column-number);
    }
  }

  .collection-wrapper:has(.facets-block-wrapper--vertical:not(#filters-drawer)):has(.collection-wrapper--full-width) {
    @media screen and (min-width: 750px) {
      grid-column: 1 / -1;
      grid-template-columns: 0fr repeat(var(--centered-column-number), minmax(0, 1fr)) 0fr;
    }
  }

  :is(.collection-wrapper--full-width, .collection-wrapper--full-width-on-mobile)
    [product-grid-view='default']
    .product-grid__card {
    @media screen and (max-width: 749px) {
      padding-inline-start: max(var(--padding-xs), var(--padding-inline-start));
      padding-inline-end: max(var(--padding-xs), var(--padding-inline-end));
    }
  }

  :is(.collection-wrapper--full-width, .collection-wrapper--full-width-on-mobile)
    [product-grid-view='mobile-single']
    .product-grid__card {
    @media screen and (max-width: 749px) {
      padding-inline-start: max(var(--padding-xs), var(--padding-inline-start));
      padding-inline-end: max(var(--padding-xs), var(--padding-inline-end));
    }
  }

  /* Make product media go edge-to-edge by using negative margins */
  :is(.collection-wrapper--full-width) .card-gallery,
  :is(.collection-wrapper--full-width-on-mobile) .card-gallery {
    @media screen and (max-width: 749px) {
      margin-inline-start: calc(-1 * max(var(--padding-xs), var(--padding-inline-start)));
      margin-inline-end: calc(-1 * max(var(--padding-xs), var(--padding-inline-end)));
    }
  }

  .collection-wrapper--full-width .main-collection-grid__title {
    margin-inline-start: var(--page-margin);
  }

  .collection-wrapper--full-width-on-mobile .main-collection-grid__title {
    @media screen and (max-width: 749px) {
      margin-inline-start: var(--page-margin);
    }
  }

  .collection-wrapper--grid-full-width .facets--vertical:not(.facets--drawer) {
    @media screen and (min-width: 750px) {
      padding-inline-start: max(var(--padding-sm), var(--padding-inline-start));
    }
  }

  .collection-wrapper:has(.product-grid-mobile--large) .facets-mobile-wrapper.facets-controls-wrapper {
    @media screen and (max-width: 749px) {
      display: none;
    }
  }

  .collection-wrapper:has(> .facets--horizontal) .facets__panel[open] {
    @media screen and (min-width: 750px) {
      z-index: var(--facets-open-z-index);
    }
  }

  /* ===== Unified filter layout (colour bar on top, sidebar for the rest) ===== */
  .collection-wrapper:has(.facets-block-wrapper[data-has-filters]) {
    grid-template-columns: minmax(210px, 250px) minmax(0, 1fr) !important;
  }



  /* The filters block holds both the colour bar and the sidebar - let its
     children participate in the collection grid directly */
  .collection-wrapper:has(.facets-block-wrapper[data-has-filters]) .facets-block-wrapper {
    display: contents;
  }

  /* Sidebar starts at the very top, level with the colour bar.
     :not(#filters-drawer) keeps these rules away from the MOBILE DRAWER's
     inner filters (same class names, must not be hidden/repositioned). */
  .collection-wrapper:has(.facets-block-wrapper[data-has-filters]) .facets-block-wrapper:not(#filters-drawer) .facets {
    grid-column: 1;
    grid-row: 1 / span 14;
    align-self: start;
    position: sticky;
    top: calc(var(--header-height, 80px) + 16px);
    max-height: none !important;
    overflow: visible !important;
    margin: var(--facets-margin, 0);
  }

  .collection-wrapper:has(.facets-block-wrapper[data-has-filters]) .facets-block-wrapper .facets::-webkit-scrollbar {
    display: none;
  }

  /* Colour bar zone: head → pills → results toolbar → active chips, all on
     the same horizontal alignment lines. The expanded panel overlays the
     products (absolute). */
  .collection-wrapper:has(.facets-block-wrapper[data-has-filters]) .cf-colour-bar {
    grid-column: 2;
    grid-row: 1;
    display: block;
    /* Mobile gutter only. On desktop the content column sits flush against
       the sidebar gap and inherits the page's own outer margin, so the
       section's left/right padding setting no longer leaks into the
       sidebar-to-content gap. */
    padding-inline: var(--page-margin, 20px);
    padding-block: 0;
    margin-block-end: 0;
    position: relative;
    z-index: 11;
  }

  /* Hairline drawn INSIDE the content box, so it spans exactly the pills'
     and the cards' width in every width mode (border-bottom would span the
     padded element box and run wider than the grid). Shown only while a
     colour panel is expanded — collapsed stays a single clean bar. */
  .cf-colour-bar::after {
    content: '';
    display: none;
    height: 1px;
    margin-block-start: 10px;
    background: rgb(var(--color-foreground-rgb) / 12%);
  }

  .cf-colour-bar:has(.cf-bar-panel.open)::after {
    display: block;
  }

  .collection-wrapper:has(.facets-block-wrapper[data-has-filters]) .cf-bar-component {
    min-width: 0;
  }

  /* Results toolbar row: item count left, sort + grid density right. */
  .cf-bar-right {
    display: flex;
    align-items: center;
    gap: 18px;
    padding-block: 10px 0;
  }

  .cf-bar-right .products-count-wrapper {
    margin-inline-end: auto;
    font-size: 12px;
    letter-spacing: 0.04em;
    color: var(--color-foreground-subdued);
    white-space: nowrap;
  }

  .collection-wrapper:has(.facets-block-wrapper[data-has-filters]) .main-collection-grid {
    grid-column: 2 !important;
    grid-row: 2 / span 14;
    /* Breathing room between the header hairline and the first card row. */
    padding-block-start: 10px;
  }

  /* ===== Active filter chips (removable, one per applied value) ===== */
  .cf-active-bar {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px 10px;
    /* Symmetric with the grid's own padding-block-start below, so the row
       sits with equal, compact space above and below. */
    padding-block: 10px;
  }

  .cf-active-bar__label {
    font-size: 9.5px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-foreground-subdued);
    margin-inline-end: 2px;
  }

  .cf-active-bar__chips {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
  }

  .cf-chip {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    min-height: 28px;
    padding: 4px 11px;
    border: 1px solid rgb(var(--color-foreground-rgb) / 14%);
    border-radius: 0;
    color: var(--color-foreground);
    text-decoration: none;
    font-size: 11px;
    letter-spacing: 0.04em;
    transition: border-color 0.18s ease, background-color 0.18s ease;
  }

  .cf-chip:hover {
    border-color: rgb(var(--color-foreground-rgb) / 45%);
    background: rgb(var(--color-foreground-rgb) / 0.03);
  }

  .cf-chip:focus-visible {
    outline: 1.5px solid var(--color-foreground);
    outline-offset: 2px;
  }

  .cf-chip__x {
    width: 9px;
    height: 9px;
    flex: 0 0 auto;
    color: var(--color-foreground-subdued);
    transition: color 0.18s ease;
  }

  .cf-chip:hover .cf-chip__x { color: var(--color-foreground); }

  .cf-active-bar__clear {
    appearance: none;
    background: none;
    border: 0;
    padding: 4px 2px;
    margin-inline-start: auto;
    font: inherit;
    font-size: 10.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-foreground-subdued);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: rgb(var(--color-foreground-rgb) / 35%);
    cursor: pointer;
    transition: color 0.18s ease;
  }

  .cf-active-bar__clear:hover {
    color: var(--color-foreground);
    text-decoration-color: currentColor;
  }

  .cf-active-bar__clear:focus-visible {
    outline: 1.5px solid var(--color-foreground);
    outline-offset: 3px;
  }

  @media screen and (max-width: 749px) {
    .collection-wrapper:has(.facets-block-wrapper[data-has-filters]) {
      grid-template-columns: 1fr !important;
    }

    .collection-wrapper:has(.facets-block-wrapper[data-has-filters]) .cf-colour-bar {
      grid-column: 1;
      grid-row: 1;
      display: block;
    }

    /* Mobile: the colour pills are a single swipeable line. Higher-specificity
       selectors here because the base merged-row rules appear later in the
       file with equal weight. align-items MUST be stretch: the base rule's
       center would shrink the row to its content width, the overflow scroll
       container would never establish, and swiping would move the page. */
    .cf-colour-bar .cf-bar-head {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      border-block: 0;
    }

    .cf-colour-bar .cf-bar-head .cf-bar-pills {
      display: flex;
      overflow-x: auto;
      overflow-y: hidden;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
      overscroll-behavior-x: contain;
      touch-action: pan-x;
      border-inline: 0;
      border-top: 1px solid rgb(var(--color-foreground-rgb) / 10%);
      border-bottom: 1px solid rgb(var(--color-foreground-rgb) / 10%);
    }

    .cf-colour-bar .cf-bar-head .cf-bar-pills::-webkit-scrollbar {
      display: none;
    }

    .cf-colour-bar .cf-pill {
      flex: 0 0 auto;
      min-height: 48px;
      padding: 0 12px;
      border-right: 1px solid rgb(var(--color-foreground-rgb) / 10%);
      border-bottom: 0;
    }

    .cf-colour-bar .cf-pill:last-child {
      border-right: 0;
    }

    /* SORT + density are integrated into the "Filter" row on mobile — the
       header's own controls row is removed to avoid duplicates. */
    .cf-colour-bar .cf-bar-head .cf-head-controls {
      display: none;
    }

    .cf-pill.is-active::after { left: 10px; right: 10px; }
    .cf-pill__name { font-size: 9px; letter-spacing: 0.09em; }

    .cf-bar-right {
      display: none;
    }

    .collection-wrapper:has(.facets-block-wrapper[data-has-filters]) .facets-block-wrapper:not(#filters-drawer) .facets {
      display: none;
    }

    .collection-wrapper:has(.facets-block-wrapper[data-has-filters]) .main-collection-grid {
      grid-column: 1 !important;
      grid-row: 2;
    }

    /* Mobile filters open as a BOTTOM SHEET instead of a right-side drawer:
       full width, anchored to the bottom edge, slides up/down, capped at 85%
       of the viewport so the page stays visible behind it. The padding
       variable is normalized so header, content and action bar share the
       same left/right inset. */
    #filters-drawer .theme-drawer__dialog {
      --theme-drawer-padding: var(--padding-lg);
      inset-inline: 0;
      inset-inline-end: 0;
      top: auto;
      bottom: 0;
      width: 100%;
      max-width: 100%;
      height: auto;
      max-height: 85dvh;
      padding-block: 0 var(--safe-area-inset-bottom);
      padding-inline: 0;
      border-inline-start: none;
      border-top: 1px solid rgb(var(--color-foreground-rgb) / 10%);
    }

    #filters-drawer .theme-drawer__dialog--opening {
      animation: mv-drawer-slide-up var(--animation-speed) var(--animation-timing-fade-in);
    }

    #filters-drawer .theme-drawer__dialog--closing {
      animation: mv-drawer-slide-down var(--animation-speed) var(--animation-timing-fade-out) forwards;
    }
  }

  @keyframes mv-drawer-slide-up {
    from { transform: translateY(100%); }
  }

  @keyframes mv-drawer-slide-down {
    to { transform: translateY(100%); }
  }

  /* ===== Colour family bar — square-corner editorial bar (demo port) ===== */
  .cf-colour-bar {
    background-color: #fff;
  }

  .cf-bar-pills {
    display: flex;
    width: 100%;
    position: relative;
    padding-block: 0;
  }

  .cf-pill {
    position: relative;
    flex: 1 1 0;
    display: flex;
    align-items: center;
    gap: 11px;
    min-width: 0;
    min-height: 44px;
    padding: 0 14px;
    border: 0;
    border-right: 1px solid rgb(var(--color-foreground-rgb) / 10%);
    border-radius: 0;
    background: transparent;
    color: inherit;
    cursor: pointer;
    font: inherit;
    text-align: left;
    transition: background-color 0.18s ease;
  }

  .cf-pill:last-child { border-right: 0; }

  .cf-pill:hover { background: rgb(var(--color-foreground-rgb) / 0.03); }

  .cf-pill.is-open,
  .cf-pill.is-active { background: #F5F0EA; }

  /* 2px ink underline overlapping the bar's bottom hairline — shown for the
     opened family (demo behaviour) and for a family with real selections.
     Spans the full option width and lands on the container's bottom border
     (1px overlap). */
  .cf-pill.is-active::after,
  .cf-pill.is-open::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 2px;
    background: var(--color-foreground);
  }

  /* Only one underline at a time: while a family panel is open it owns the
     underline, even if another family carries real selections. */
  .cf-bar-pills:has(.cf-pill.is-open) .cf-pill.is-active:not(.is-open)::after {
    display: none;
  }

  .cf-bar-pills:has(.cf-pill.is-open) .cf-pill.is-active:not(.is-open) .cf-pill__glyph {
    outline: none;
  }

  /* Rectangular family swatch — light colours stay visible on white */
  .cf-pill__glyph {
    width: 32px;
    height: 24px;
    flex: 0 0 32px;
    border-radius: 0;
    border: 1px solid rgb(0 0 0 / 12%);
    position: relative;
  }

  .cf-pill--all .cf-pill__glyph {
    background: linear-gradient(105deg, #d94747 0%, #e98a39 17%, #e5d75d 33%, #5c9b69 50%, #5599c7 67%, #6559a9 83%, #b36b9c 100%);
  }

  .cf-pill.is-active .cf-pill__glyph,
  .cf-pill.is-open .cf-pill__glyph {
    outline: 1px solid var(--color-foreground);
    outline-offset: 2px;
  }

  .cf-pill__name {
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-foreground);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .cf-pill__num {
    margin-left: auto;
    padding-left: 4px;
    font-size: 10px;
    letter-spacing: 0.08em;
    color: var(--color-foreground-subdued);
    font-variant-numeric: tabular-nums;
  }

  .cf-pill__count { display: none; }
  /* Panel renders IN FLOW when open (no overlay): it grows between the pills
     and the grid, so the hairline above the grid always separates the swatches
     from the cards. Spacing is symmetric when expanded: 10px above (here) and
     10px below (cf-bar-right's padding-block-start). */
  .cf-bar-panel {
    display: none;
    padding: 10px 0 0;
  }
  .cf-bar-panel.open { display: block; animation: cf-panel-fade 0.3s ease; }
  @keyframes cf-panel-fade { from { opacity: 0; transform: translateY(-4px); } to { opacity: 1; transform: none; } }
  .cf-panel-head { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 8px; }
  .cf-panel-title { font-family: var(--font-heading--family, inherit); font-size: 17px; }
  .cf-panel-meta { font-size: 10.5px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--color-foreground-subdued); }
  .cf2-panel-swatches {
    display: flex; flex-wrap: nowrap; overflow-x: auto; justify-content: flex-start;
    gap: 10px 20px; scrollbar-width: none;
    /* Inner padding gives the selected outline (1px + 3px offset) room, so it
       is not clipped by the scroll container on the left/top edges. */
    padding: 4px 4px 6px;
  }
  .cf2-panel-swatches::-webkit-scrollbar { display: none; }
  .cf2-panel-swatches .cf2-item__dot {
    width: 34px; height: 34px; border-radius: 0;
    box-shadow: inset 0 0 0 1px rgb(0 0 0 / 14%);
    transition: transform 0.18s ease, box-shadow 0.18s ease;
  }
  .cf2-panel-swatches .cf2-item:hover .cf2-item__dot {
    transform: translateY(-1px); box-shadow: inset 0 0 0 1px rgb(0 0 0 / 24%);
  }
  .cf2-panel-swatches .cf2-item input:checked + .cf2-item__label .cf2-item__dot {
    outline: 1px solid var(--color-foreground);
    outline-offset: 3px;
  }
  .cf2-panel-swatches .cf2-item__name {
    font-size: 10px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-foreground-subdued);
  }
  .cf2-panel-swatches .cf2-item input:checked + .cf2-item__label .cf2-item__name { color: var(--color-foreground); }

  /* ===== Editorial design layer ===== */
  .cf-kicker {
    font-size: 9.5px;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--color-foreground-subdued);
  }

  /* Merged toolbar row: toggle + colour pills + sort/density on one line.
     The top/bottom hairlines belong to the whole row, so the filter toggle
     and the sort/density controls are enclosed in the same bar; vertical
     hairlines separate the three groups (same tone as the pill dividers). */
  .cf-bar-head {
    display: flex;
    align-items: center;
    gap: 16px;
    padding-block: 0;
    border-block: 1px solid rgb(var(--color-foreground-rgb) / 10%);
  }

  .cf-bar-head .cf-bar-pills {
    flex: 1 1 auto;
    width: auto;
    min-width: 0;
    border-inline: 1px solid rgb(var(--color-foreground-rgb) / 10%);
  }

  /* Sort + density cluster in the header row (hidden on mobile: the native
     mobile controls take over). */
  .cf-bar-head .cf-head-controls {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .cf-bar-title {
    margin: 0;
    font-family: var(--font-heading--family, Georgia, serif);
    font-size: 24px;
    font-weight: 500;
    line-height: 1.2;
  }

  .cf-bar-tag {
    font-size: 9.5px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-foreground-subdued);
    white-space: nowrap;
  }

  .facets-edit-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    /* Same height as the colour bar row so the sidebar title, its reset icon
       and the bar contents share one horizontal centre line. */
    height: 44px;
    padding-block: 0;
    border: 0;
    margin: 0;
  }
  .facets-edit-row { display: flex; align-items: baseline; justify-content: space-between; gap: 10px; margin-top: 4px; }
  .facets-edit-title {
    margin: 0;
    font-family: var(--font-heading--family, Georgia, serif);
    font-size: 24px;
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: 0.01em;
  }
  .facets-edit-reset {
    display: inline-grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    color: var(--color-foreground-subdued);
    text-decoration: none;
    transition: color 0.2s ease, background-color 0.2s ease, transform 0.4s ease;
  }
  .facets-edit-reset svg { width: 17px; height: 17px; }
  .facets-edit-reset:hover {
    color: var(--color-foreground);
    background: rgb(var(--color-foreground-rgb) / 6%);
  }
  /* Spin one full turn on click only (class added by script) — never on hover */
  .facets-edit-reset.is-spinning svg { animation: facets-reset-spin 0.6s ease; }
  @keyframes facets-reset-spin { to { transform: rotate(360deg); } }

  /* Collapsible sidebar (demo port): the toggle lives in the colour-bar
     header. Expanded = plain serif "Hide filters" text; collapsed = bordered
     pill "Filters". */
  .cf-filter-toggle {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    height: 32px;
    padding: 0 11px;
    border: 1px solid transparent;
    border-radius: 0;
    background: transparent;
    color: var(--color-foreground);
    font: inherit;
    cursor: pointer;
    white-space: nowrap;
    flex: 0 0 auto;
    transition: border-color 0.2s ease, background-color 0.2s ease, box-shadow 0.2s ease, padding 0.2s ease;
  }
  .cf-filter-toggle:hover {
    border-color: rgb(var(--color-foreground-rgb) / 15%);
    background: rgb(var(--color-foreground-rgb) / 3%);
  }
  .cf-filter-toggle:focus-visible {
    outline: 1.5px solid var(--color-foreground);
    outline-offset: 3px;
  }
  .cf-filter-toggle__icon {
    display: inline-flex;
    align-items: center;
    line-height: 0;
    color: var(--color-foreground-subdued);
  }
  .cf-filter-toggle__icon svg,
  .cf-filter-toggle__icon .svg-wrapper {
    display: block;
    width: 15px;
    height: 15px;
  }
  /* Unified toolbar typography: every text control in the merged row uses
     the same treatment as the ALL COLOR pill name (body family, 10px, wide
     tracking, uppercase) for one minimal-luxury voice. */
  .cf-filter-toggle__label {
    font-family: var(--font-body--family);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    line-height: 1;
  }
  .cf-filter-toggle__label-closed { display: none; }
  .cf-filter-toggle__arrow {
    display: inline-flex;
    align-items: center;
    line-height: 0;
    color: var(--color-foreground-subdued);
    transition: transform 0.25s ease;
  }
  .cf-filter-toggle__arrow svg {
    display: block;
    width: 10px;
    height: 10px;
  }

  /* Collapsed: pill treatment, swapped label, flipped arrow. The label keeps
     the expanded typography (serif, same size) in both states. */
  .collection-wrapper.is-filters-collapsed .cf-filter-toggle {
    border-color: rgb(var(--color-foreground-rgb) / 15%);
    background: var(--color-background);
    padding: 0 13px;
    box-shadow: 0 2px 8px rgb(0 0 0 / 3%);
  }
  .collection-wrapper.is-filters-collapsed .cf-filter-toggle .cf-filter-toggle__label-open { display: none; }
  .collection-wrapper.is-filters-collapsed .cf-filter-toggle .cf-filter-toggle__label-closed { display: inline; }
  .collection-wrapper.is-filters-collapsed .cf-filter-toggle .cf-filter-toggle__arrow { transform: rotate(180deg); }

  @media screen and (max-width: 749px) {
    /* Mobile has its own drawer toggle button */
    .cf-filter-toggle { display: none; }

    /* Shared sliders icon: same 15px size as the desktop toggle. */
    .facets-toggle__button .svg-wrapper svg {
      width: 15px;
      height: 15px;
    }
  }

  /* Grid density icons: muted by default, ink on hover/active, sized to sit
     quietly next to the 10px uppercase labels. */
  .cf-bar-head .column-picker {
    color: var(--color-foreground-subdued);
    padding: 6px;
  }
  .cf-bar-head .column-picker svg {
    width: 15px;
    height: 15px;
  }
  .cf-bar-head .column-options__option:hover .column-picker,
  .cf-bar-head .column-options__option-input:checked ~ .column-picker {
    color: var(--color-foreground);
  }
  .facets-edit-sub { margin: 6px 0 0; font-size: 12.5px; color: var(--color-foreground-subdued); }
  .facet-num {
    font-family: var(--font-body--family);
    font-size: 12px;
    font-weight: 400;
    letter-spacing: 0.05em;
    color: var(--color-foreground-subdued);
    margin-inline-end: 10px;
    font-variant-numeric: tabular-nums;
  }

  /* Clear hierarchy: smaller, bold, uppercase group titles, muted footnote */
  .facets-block-wrapper .facets__summary .facets__label {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .facets-block-wrapper .price-facet__highest-price {
    font-size: 11px;
    line-height: 1.5;
    color: var(--color-foreground-subdued);
  }

  .facets-block-wrapper .facets__summary {
    display: flex;
    align-items: center;
    gap: 0;
    /* Symmetric padding keeps the collapsed row vertically centred between
       the top and bottom hairlines. */
    padding-block: 11px;
    margin-bottom: 0;
    border: 0 !important;
    box-shadow: none !important;
    background: none !important;
  }

  /* Open group: the space between the title row and the options (summary
     bottom padding) matches the space below the options (details bottom
     padding, 10px) — symmetric above and below. */
  .facets-block-wrapper details[open] > .facets__summary {
    padding-block-end: 10px;
  }

  .facets-block-wrapper .facets__summary .facet-num { flex: 0 0 30px; margin: 0; }
  .facets-block-wrapper .facets__summary .facets__label { flex: 1 1 auto; min-width: 0; }
  .facets-block-wrapper .facets__summary .facets__status-wrapper,
  .facets-block-wrapper .facets__summary .facets__status { margin-inline-start: auto; }
  .facets-block-wrapper .facets__summary .icon-caret { flex: 0 0 auto; }

  /* Count bubble: a perfect 20px circle (the base rule's swatch-height
       division made it an ellipse). Swatch strips keep the base sizing. */
  .facets-block-wrapper .facets__bubble:not(.facets__swatch-wrapper) {
    width: 20px;
    height: 20px;
    min-width: 20px;
    flex: 0 0 auto;
    padding: 0;
    border-radius: 50%;
  }

  /* Price: native min/max inputs; the applied range shows in the chips bar */
  .facets-block-wrapper .facets__summary[data-testid='price-filter'] .facets__status { display: none; }

  /* Group hairlines: the details element itself carries class facets__panel,
     so this single rule draws ONE uniform 10% line above every group — in the
     desktop sidebar and in the mobile bottom-sheet drawer alike. The bottom
     padding applies ONLY when the group is open: on closed rows (mobile
     drawer) it would add dead space below the summary and break the
     vertical rhythm. */
  .facets-block-wrapper .facets__panel,
  .facets-block-wrapper .facets__filters-wrapper > details {
    border: 0 !important;
    border-top: 1px solid rgb(var(--color-foreground-rgb) / 10%) !important;
    box-shadow: none !important;
    background: none !important;
    padding-block: 0;
  }

  .facets-block-wrapper details[open].facets__panel,
  .facets-block-wrapper .facets__filters-wrapper > details[open] {
    padding-block: 0 10px;
  }

  /* Divider between sidebar and content */
  .collection-wrapper:has(.facets-block-wrapper[data-has-filters]) .facets-block-wrapper:not(#filters-drawer) .facets {
    border-inline-end: 1px solid rgb(var(--color-foreground-rgb) / 10%);
    padding-inline-end: 24px;
  }

  /* The gutter between sidebar and products lives INSIDE the sidebar column:
     no grid gap, so themes that define extra grid columns cannot eat the
     right column's width. */
  @media screen and (min-width: 750px) {
    .collection-wrapper:has(.facets-block-wrapper[data-has-filters]) {
      column-gap: 0 !important;
      grid-template-columns: minmax(210px, 250px) minmax(0, 1fr) !important;
      transition: grid-template-columns 0.28s ease;
    }

    .collection-wrapper:has(.facets-block-wrapper[data-has-filters]) .facets-block-wrapper:not(#filters-drawer) .facets {
      margin-inline-end: var(--cf-sidebar-gap, 40px);
      transition: opacity 0.18s ease;
    }

    /* Collapsed sidebar (demo behaviour): the sidebar column collapses to zero
       width with an animated grid transition, the sidebar itself fades out and
       the products expand into the full row. minmax() on both ends keeps the
       grid-template-columns transition interpolable. */
    .collection-wrapper.is-filters-collapsed:has(.facets-block-wrapper[data-has-filters]) {
      grid-template-columns: minmax(0px, 0px) minmax(0, 1fr) !important;
      transition: grid-template-columns 0.28s ease;
    }

    .collection-wrapper.is-filters-collapsed .facets-block-wrapper:not(#filters-drawer) .facets {
      opacity: 0;
      pointer-events: none;
      overflow: hidden !important;
      margin-inline-end: 0 !important;
      padding-inline-end: 0 !important;
      border-inline-end-color: transparent;
    }
  }

    /* Content column (colour bar + grid) sits flush in the filters layout:
       its only inline inset is the page's own outer margin, so the sidebar
       gap above is the single source of truth for sidebar-to-content space. */
    .collection-wrapper:has(.facets-block-wrapper[data-has-filters]) .cf-colour-bar,
    .collection-wrapper:has(.facets-block-wrapper[data-has-filters]) .main-collection-grid {
      padding-inline: 0;
    }
  }
{% endstylesheet %}
