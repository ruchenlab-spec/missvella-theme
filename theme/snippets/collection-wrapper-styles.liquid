{%- doc -%}
  Shared collection wrapper layout styles for collection and search results pages.

  @example
  {% render 'collection-wrapper-styles' %}
{%- enddoc -%}

{% stylesheet %}
  /* ------------------------------------------------------------------------------ */

  /* Collection Wrapper - Shared layout CSS for collection and search pages */

  /* ------------------------------------------------------------------------------ */

  .collection-wrapper {
    @media screen and (min-width: 750px) {
      --facets-vertical-col-width: 6;

      grid-template-columns:
        1fr repeat(
          var(--centered-column-number),
          minmax(0, calc((var(--page-width) - var(--page-margin) * 2) / var(--centered-column-number)))
        )
        1fr;
    }

    @media screen and (min-width: 990px) {
      --facets-vertical-col-width: 5;
    }
  }

  /*
   * Full-width product grid: side gutters from the section's left/right padding
   * settings (default 40px, halved on mobile) so content does not touch the edges.
   */
  .collection-wrapper--grid-full-width {
    padding-inline: var(--grid-padding-inline-start, 40px) var(--grid-padding-inline-end, 40px);
  }

  @media screen and (max-width: 749px) {
    .collection-wrapper--grid-full-width {
      padding-inline: calc(var(--grid-padding-inline-start, 40px) * 0.5)
        calc(var(--grid-padding-inline-end, 40px) * 0.5);
    }
  }

  .collection-wrapper:has(.facets-block-wrapper--full-width),
  .collection-wrapper:has(.collection-wrapper--full-width) {
    @media screen and (min-width: 750px) {
      grid-column: 1 / -1;
      grid-template-columns:
        minmax(var(--page-margin), 1fr) repeat(
          var(--centered-column-number),
          minmax(0, calc((var(--page-width) - var(--page-margin) * 2) / var(--centered-column-number)))
        )
        minmax(var(--page-margin), 1fr);
    }
  }

  .collection-wrapper:has(.facets--vertical) .facets-block-wrapper--vertical:not(.hidden) ~ .main-collection-grid {
    @media screen and (min-width: 750px) {
      grid-column: var(--facets-vertical-col-width) / var(--full-width-column-number);
    }
  }

  .collection-wrapper:has(.facets-block-wrapper--vertical:not(#filters-drawer)):has(.collection-wrapper--full-width) {
    @media screen and (min-width: 750px) {
      grid-column: 1 / -1;
      grid-template-columns: 0fr repeat(var(--centered-column-number), minmax(0, 1fr)) 0fr;
    }
  }

  :is(.collection-wrapper--full-width, .collection-wrapper--full-width-on-mobile)
    [product-grid-view='default']
    .product-grid__card {
    @media screen and (max-width: 749px) {
      padding-inline-start: max(var(--padding-xs), var(--padding-inline-start));
      padding-inline-end: max(var(--padding-xs), var(--padding-inline-end));
    }
  }

  :is(.collection-wrapper--full-width, .collection-wrapper--full-width-on-mobile)
    [product-grid-view='mobile-single']
    .product-grid__card {
    @media screen and (max-width: 749px) {
      padding-inline-start: max(var(--padding-xs), var(--padding-inline-start));
      padding-inline-end: max(var(--padding-xs), var(--padding-inline-end));
    }
  }

  /* Make product media go edge-to-edge by using negative margins */
  :is(.collection-wrapper--full-width) .card-gallery,
  :is(.collection-wrapper--full-width-on-mobile) .card-gallery {
    @media screen and (max-width: 749px) {
      margin-inline-start: calc(-1 * max(var(--padding-xs), var(--padding-inline-start)));
      margin-inline-end: calc(-1 * max(var(--padding-xs), var(--padding-inline-end)));
    }
  }

  .collection-wrapper--full-width .main-collection-grid__title {
    margin-inline-start: var(--page-margin);
  }

  .collection-wrapper--full-width-on-mobile .main-collection-grid__title {
    @media screen and (max-width: 749px) {
      margin-inline-start: var(--page-margin);
    }
  }

  .collection-wrapper--grid-full-width .facets--vertical:not(.facets--drawer) {
    @media screen and (min-width: 750px) {
      padding-inline-start: max(var(--padding-sm), var(--padding-inline-start));
    }
  }

  .collection-wrapper:has(.product-grid-mobile--large) .facets-mobile-wrapper.facets-controls-wrapper {
    @media screen and (max-width: 749px) {
      display: none;
    }
  }

  .collection-wrapper:has(> .facets--horizontal) .facets__panel[open] {
    @media screen and (min-width: 750px) {
      z-index: var(--facets-open-z-index);
    }
  }

  /* ===== Unified filter layout (colour bar on top, sidebar for the rest) ===== */
  .collection-wrapper:has(.cf-colour-bar) {
    grid-template-columns: minmax(210px, 250px) minmax(0, 1fr) !important;
  }

  /* The filters block holds both the colour bar and the sidebar - let its
     children participate in the collection grid directly */
  .collection-wrapper:has(.cf-colour-bar) .facets-block-wrapper {
    display: contents;
  }

  /* Sidebar starts at the very top, level with the colour bar */
  .collection-wrapper:has(.cf-colour-bar) .facets-block-wrapper .facets {
    grid-column: 1;
    grid-row: 1 / span 14;
    align-self: start;
    position: sticky;
    top: calc(var(--header-height, 80px) + 16px);
    max-height: calc(100vh - var(--header-height, 80px) - 32px);
    overflow-y: auto;
    scrollbar-width: none;
  }

  .collection-wrapper:has(.cf-colour-bar) .facets-block-wrapper .facets::-webkit-scrollbar {
    display: none;
  }

  /* Colour bar row: pills bottom-left, sort/count/density bottom-right,
     bottom aligned. The expanded panel overlays the products (absolute). */
  .collection-wrapper:has(.cf-colour-bar) .cf-colour-bar {
    grid-column: 2;
    grid-row: 1;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    padding-block: 4px 0;
    margin-block-end: 26px;
    position: relative;
    z-index: 11;
  }

  .collection-wrapper:has(.cf-colour-bar) .cf-bar-component {
    flex: 1 1 auto;
    min-width: 0;
  }

  .cf-bar-right {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    gap: 18px;
    padding-bottom: 2px;
  }

  .cf-bar-right .products-count-wrapper {
    font-size: 13px;
    color: var(--color-foreground-subdued);
    white-space: nowrap;
  }

  .collection-wrapper:has(.cf-colour-bar) .main-collection-grid {
    grid-column: 2 !important;
    grid-row: 2 / span 14;
  }

  @media screen and (max-width: 749px) {
    .collection-wrapper:has(.cf-colour-bar) {
      grid-template-columns: 1fr !important;
    }

    .collection-wrapper:has(.cf-colour-bar) .cf-colour-bar {
      grid-column: 1;
      grid-row: 1;
      display: block;
    }

    .cf-colour-bar .cf-bar-pills {
      flex-wrap: nowrap;
      overflow-x: auto;
      scrollbar-width: none;
    }

    .cf-colour-bar .cf-bar-pills::-webkit-scrollbar {
      display: none;
    }

    .cf-bar-right {
      display: none;
    }

    .collection-wrapper:has(.cf-colour-bar) .facets-block-wrapper .facets {
      display: none;
    }

    .collection-wrapper:has(.cf-colour-bar) .main-collection-grid {
      grid-column: 1 !important;
      grid-row: 2;
    }
  }

  /* ===== Colour family bar components (minimal lines) ===== */
  .cf-bar-pills { display: flex; flex-wrap: wrap; gap: 0 44px; align-items: flex-end; }
  .cf-pill {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    padding: 0 2px 14px;
    background: none;
    border: 0;
    color: inherit;
    cursor: pointer;
    font: inherit;
  }
  .cf-pill__glyph { width: 30px; height: 30px; border-radius: 50%; display: grid; place-items: center; }
  .cf-pill__glyph i { display: block; width: 14px; height: 14px; border-radius: 50%; box-shadow: inset 0 0 0 1px rgb(var(--color-foreground-rgb) / 14%); transition: transform 0.25s ease, box-shadow 0.25s ease; }
  .cf-pill:hover .cf-pill__glyph i { transform: scale(1.18); }
  .cf-pill__name {
    font-size: 11px; letter-spacing: 0.18em; text-transform: uppercase;
    color: var(--color-foreground-subdued); padding-bottom: 10px;
    border-bottom: 1px solid transparent; margin-bottom: -11px;
    transition: color 0.25s ease, border-color 0.25s ease; white-space: nowrap;
  }
  .cf-pill:hover .cf-pill__name { color: var(--color-foreground); }
  .cf-pill.is-active .cf-pill__name { color: var(--color-foreground); border-bottom-color: var(--color-foreground); }
  .cf-pill.is-active .cf-pill__glyph i {
    box-shadow: inset 0 0 0 1px rgb(var(--color-foreground-rgb) / 35%), 0 0 0 3px var(--color-background), 0 0 0 4px var(--color-foreground);
  }
  .cf-pill__count { position: absolute; top: -4px; right: -14px; font-size: 9.5px; color: var(--color-foreground-subdued); }
  .cf-bar-panel {
    display: none;
    position: absolute;
    top: calc(100% + 1px);
    left: calc(-1 * var(--page-margin, 40px));
    right: calc(-1 * var(--page-margin, 40px));
    z-index: 12;
    padding: 28px 0 30px;
    background: var(--color-background);
    border-bottom: 1px solid rgb(var(--color-foreground-rgb) / 10%);
  }
  .cf-bar-panel.open { display: block; animation: cf-panel-fade 0.3s ease; }
  @keyframes cf-panel-fade { from { opacity: 0; transform: translateY(-4px); } to { opacity: 1; transform: none; } }
  .cf-panel-head { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 22px; }
  .cf-panel-title { font-family: var(--font-heading--family, inherit); font-size: 17px; }
  .cf-panel-meta { font-size: 10.5px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--color-foreground-subdued); }
  .cf2-panel-swatches {
    display: flex; flex-wrap: nowrap; overflow-x: auto; justify-content: flex-start;
    gap: 12px 34px; scrollbar-width: none; padding-bottom: 2px;
  }
  .cf2-panel-swatches::-webkit-scrollbar { display: none; }
  .cf2-panel-swatches .cf2-item__dot {
    width: 34px; height: 34px;
    box-shadow: inset 0 0 0 1px rgb(var(--color-foreground-rgb) / 10%);
    transition: transform 0.22s ease, box-shadow 0.22s ease;
  }
  .cf2-panel-swatches .cf2-item:hover .cf2-item__dot {
    transform: scale(1.12); box-shadow: inset 0 0 0 1px rgb(var(--color-foreground-rgb) / 22%);
  }
  .cf2-panel-swatches .cf2-item input:checked + .cf2-item__label .cf2-item__dot {
    box-shadow: 0 0 0 2.5px var(--color-background), 0 0 0 4px var(--color-foreground);
  }
  .cf2-panel-swatches .cf2-item__name {
    font-size: 10.5px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-foreground-subdued);
  }
  .cf2-panel-swatches .cf2-item input:checked + .cf2-item__label .cf2-item__name { color: var(--color-foreground); }
  /* ===== Fabric texture overlays (dots only) ===== */
  .cf-texture--linen .cf2-item__dot::after, .cf-texture--satin .cf2-item__dot::after,
  .cf-texture--mesh .cf2-item__dot::after, .cf-texture--velvet .cf2-item__dot::after {
    content: ''; position: absolute; inset: 0; border-radius: inherit; pointer-events: none;
  }
  .cf-texture--linen .cf2-item__dot::after {
    background: repeating-linear-gradient(45deg, rgb(255 255 255 / 16%) 0 1px, transparent 1px 3px), repeating-linear-gradient(-45deg, rgb(0 0 0 / 12%) 0 1px, transparent 1px 3px);
  }
  .cf-texture--satin .cf2-item__dot::after {
    background: linear-gradient(135deg, rgb(255 255 255 / 42%) 0%, rgb(255 255 255 / 8%) 32%, rgb(0 0 0 / 14%) 62%, rgb(255 255 255 / 24%) 100%);
  }
  .cf-texture--mesh .cf2-item__dot::after {
    background-image: radial-gradient(circle at 25% 25%, rgb(255 255 255 / 34%) 0 1.2px, transparent 2px), radial-gradient(circle at 75% 75%, rgb(0 0 0 / 16%) 0 1.2px, transparent 2px);
    background-size: 6px 6px;
  }
  .cf-texture--velvet .cf2-item__dot::after {
    background: radial-gradient(ellipse at 35% 28%, rgb(255 255 255 / 38%), transparent 58%), radial-gradient(ellipse at 72% 78%, rgb(0 0 0 / 26%), transparent 62%);
  }
  .cf-texture--linen .cf2-item__dot, .cf-texture--satin .cf2-item__dot,
  .cf-texture--mesh .cf2-item__dot, .cf-texture--velvet .cf2-item__dot { overflow: hidden; }
{% endstylesheet %}
