{% doc %}
  Displays the current shop policy on the shipping guide. Its tables and paragraphs
  are readable before the destination filter and FAQ disclosures are initialized.
  @param {string} section_id - ID of the shipping guide section
  @param {object} policy - Published Shopify shipping policy
{% enddoc %}
{% if policy.body != blank %}
  <script src="{{ 'mv-shipping-policy-guide.js' | asset_url }}" type="module"></script>
  <mv-shipping-policy-guide class="shipping-policy-guide">
    <div class="shipping-policy-guide__intro" data-guide-intro hidden></div>
    <div class="shipping-policy-guide__layout">
      <div class="shipping-policy-guide__tabs" role="tablist" aria-label="Shipping information" hidden>
        <button type="button" role="tab" id="OverviewTab-{{ section_id }}" aria-controls="ShippingOverview-{{ section_id }}" aria-selected="true">
          <svg aria-hidden="true" focusable="false" viewBox="0 0 20 20">{% render 'icon', icon: 'box' %}</svg>Overview
        </button>
        <button type="button" role="tab" id="CountryTab-{{ section_id }}" aria-controls="ShippingCountries-{{ section_id }}" aria-selected="false" tabindex="-1" hidden>
          <svg aria-hidden="true" focusable="false" viewBox="0 0 20 20">{% render 'icon', icon: 'map_pin' %}</svg>Destinations
        </button>
        <button type="button" role="tab" id="FaqTab-{{ section_id }}" aria-controls="ShippingFaq-{{ section_id }}" aria-selected="false" tabindex="-1" hidden>
          <svg aria-hidden="true" focusable="false" viewBox="0 0 20 20">{% render 'icon', icon: 'chat_bubble' %}</svg>FAQs
        </button>
      </div>
      <div class="shipping-policy-guide__panels">
        <div id="ShippingOverview-{{ section_id }}" data-overview>
          <div class="shipping-policy-guide__copy" data-policy-copy>{{ policy.body }}</div>
          <a class="shipping-policy-guide__action" href="#ShippingCountries-{{ section_id }}" data-country-jump hidden>
            Find my shipping time {{- 'icon-arrow.svg' | inline_asset_content -}}
          </a>
        </div>
        <section id="ShippingCountries-{{ section_id }}" data-country-panel hidden></section>
        <section id="ShippingFaq-{{ section_id }}" class="shipping-guide__accordion accordion accordion--plus" data-faq-panel hidden>
          <h2>Shipping FAQs</h2>
          <template data-faq-row>
            {% capture faq_content %}
              <details class="details">
                <summary class="details__header">
                  <span data-question></span>
                  <span class="svg-wrapper icon-plus" aria-hidden="true">{{- 'icon-plus.svg' | inline_asset_content -}}</span>
                </summary>
                <div class="details-content"></div>
              </details>
            {% endcapture %}
            {% render 'accordion-custom-component', class: 'shipping-guide__detail', children: faq_content %}
          </template>
          {% render 'accordion-styles' %}
        </section>
      </div>
      <a class="shipping-policy-guide__action shipping-policy-guide__track" data-track-action hidden>
        Track my order {{- 'icon-arrow.svg' | inline_asset_content -}}
      </a>
    </div>
    <template data-country-search>
      <div class="shipping-policy-guide__search">
        <label for="ShippingSearch-{{ section_id }}">Search by country or region</label>
        <div class="shipping-policy-guide__input">
          {{- 'icon-search.svg' | inline_asset_content -}}
          <input id="ShippingSearch-{{ section_id }}" type="search" placeholder="Country name or code" autocomplete="off" aria-controls="ShippingRows-{{ section_id }}">
          <button type="button" hidden>Clear</button>
        </div>
        <p data-result-count role="status" aria-live="polite" aria-atomic="true"></p>
      </div>
    </template>
  </mv-shipping-policy-guide>
{% else %}
  <p>Contact us with your delivery address and event date for shipping options.</p>
{% endif %}
