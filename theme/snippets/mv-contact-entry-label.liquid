{% doc %}
  Renders a contact directory label and its decorative line icon.

  @param {string} icon - email, tracking, shipping, returns or business.
  @param {string} label - Merchant-editable label.
{% enddoc %}
<span class="mv-contact__entry-label">
  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
    {%- case icon -%}
      {%- when 'email' -%}
        <rect x="2.5" y="5" width="19" height="14" rx="1.5"/>
        <path d="m3.5 6 8.5 6.5L20.5 6"/>
      {%- when 'tracking' -%}
        <path d="m12 2.5 9 4.8v9.4l-9 4.8-9-4.8V7.3l9-4.8Z M3 7.3l9 4.8 9-4.8 M12 12.1v9.4 M7.5 4.9l9 4.8v3.2"/>
      {%- when 'shipping' -%}
        <path d="M2.5 6h12v11.5H9 M5 17.5H2.5V6 M14.5 9h4l3 4v4.5h-2 M14.5 17.5h1 M16.5 10.5v3h4.8"/>
        <circle cx="7" cy="17.5" r="2"/><circle cx="17.5" cy="17.5" r="2"/>
      {%- when 'returns' -%}
        <path d="m8 4-5 5 5 5 M3 9h11a5.5 5.5 0 0 1 0 11H9"/>
      {%- when 'business' -%}
        <path d="M3 21h18 M5 21V3h13v18 M8.5 7h1 M13.5 7h1 M8.5 11h1 M13.5 11h1 M10 21v-5.5h3V21"/>
    {%- endcase -%}
  </svg>
  <span>{{ label | escape }}</span>
</span>
