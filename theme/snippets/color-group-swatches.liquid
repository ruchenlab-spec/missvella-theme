{%- doc -%}
  Renders the "Color group" swatches for a product.

  A color group bundles every product of one style in different colours. The
  group members live in a hidden collection (see `color-group-collection`),
  so every swatch links to a sibling product: each colour keeps its own URL,
  its own first image and its own share/Pinterest landing page.

  @param {object} product_resource - The product object.
  @param {string} [group_handle] - Handle of the group collection.
  @param {object} [current_product] - Product to treat as the active one.
  @param {string} [columns] - Number of columns per row, or `auto`.
  @param {number} [min_width] - Minimum card width in pixels (desktop).
  @param {number} [mobile_min_width] - Minimum card width in pixels (mobile).
  @param {number} [card_radius] - Card corner radius in pixels.
  @param {string} [selected_style] - Selected swatch style.
  @param {number} [gap_start] - Space above the swatch group, in pixels.
  @param {number} [gap_end] - Space below the swatch group, in pixels.
  @param {boolean} [tooltip_shadow] - Whether the tooltip gets a shadow.

  @example
  {% render 'color-group-swatches', product_resource: product, current_product: product %}
{%- enddoc -%}

{%- liquid
  assign current_product = current_product | default: product_resource

  if group_handle == blank
    capture group_handle_output
      render 'color-group-collection', product_resource: product_resource
    endcapture
    assign group_handle = group_handle_output | strip
  endif

  assign group_members = blank
  assign group_title = 'content.color_group_title' | t
  if group_handle != blank
    assign group_collection = collections[group_handle]
    assign group_members = group_collection.products
  endif

  assign group_member_count = group_members | size

  # ------------------------------------------------ appearance settings
  assign group_columns = columns | default: 'auto'
  assign group_min_width = min_width | default: 52
  assign group_mobile_min_width = mobile_min_width | default: 40
  assign group_card_radius = card_radius | default: 6
  assign group_selected_style = selected_style | default: 'solid'
  assign group_gap_start = gap_start | default: 0
  assign group_gap_end = gap_end | default: 12

  if group_columns == 'auto'
    assign group_grid = 'repeat(auto-fill, minmax(var(--color-group-min-width), 1fr))'
  else
    assign group_grid = 'repeat(' | append: group_columns | append: ', minmax(0, 1fr))'
  endif
-%}

{% render 'color-group-styles' %}

{% if group_member_count > 1 %}
  <fieldset
    class="variant-option variant-option--buttons color-group"
    data-mv-option-kind="color"
    data-color-group
    data-group-handle="{{ group_handle }}"
    data-selected-style="{{ group_selected_style }}"
    style="
      --color-group-grid: {{ group_grid }};
      --color-group-min-width-desktop: {{ group_min_width }}px;
      --color-group-min-width-mobile: {{ group_mobile_min_width }}px;
      --color-group-card-radius: {{ group_card_radius }}px;
      --color-group-gap-start: {{ group_gap_start }}px;
      --color-group-gap-end: {{ group_gap_end }}px;
      {% if tooltip_shadow %}--color-group-tooltip-shadow: 0 8px 20px rgb(var(--color-foreground-rgb) / 0.24);{% else %}--color-group-tooltip-shadow: none;{% endif %}
    "
  >
    <legend class="color-group__label">{{ group_title }}</legend>

    <ul class="color-group__list" role="list">
      {%- for member in group_members -%}
        {%- liquid
          assign is_current = false
          if member.id == current_product.id
            assign is_current = true
          endif

          # ------------------------------------------------ color label
          assign color_label = blank
          assign color_label_keys = 'custom.color_name,custom.color,custom.colour,custom.color_label,color_name' | split: ','
          for meta_key in color_label_keys
            assign meta_value = member.metafields[meta_key].value
            if meta_value != blank and color_label == blank
              assign color_label = meta_value
            endif
          endfor

          # ------------------------------------------------ color option of the member product
          assign swatch_color = blank
          assign swatch_image = blank
          for member_option in member.options_with_values
            assign option_key = member_option.name | strip | downcase
            if option_key == 'color' or option_key == 'colour' or option_key == '颜色'
              assign first_value = member_option.values.first
              if color_label == blank
                assign color_label = first_value.name
              endif
              if first_value.swatch.color != blank
                assign swatch_color = first_value.swatch.color
              endif
              if first_value.swatch.image != blank
                assign swatch_image = first_value.swatch.image
              endif
              break
            endif
          endfor

          if color_label == blank
            assign color_label = member.title
          endif

          # ------------------------------------------------ swatch image
          assign thumb = blank
          assign swatch_keys = 'custom.color_swatch,custom.color_image,custom.swatch' | split: ','
          for image_key in swatch_keys
            assign image_value = member.metafields[image_key].value
            if image_value != blank and thumb == blank
              assign thumb = image_value
            endif
          endfor

          if thumb == blank and swatch_image != blank
            assign thumb = swatch_image
          endif

          assign thumb_url = blank
          assign preview_url = blank
          if thumb != blank
            assign thumb_url = thumb | image_url: width: 160
          elsif member.featured_media != blank
            assign thumb_url = member.featured_media.preview_image | image_url: width: 160
          endif

          if member.featured_media != blank
            assign preview_url = member.featured_media.preview_image | image_url: width: 900
          endif

          # ------------------------------------------------ size mapping for the target product
          assign size_option_position = 0
          for member_option in member.options_with_values
            assign option_key = member_option.name | strip | downcase
            if option_key == 'size' or option_key == '尺寸'
              assign size_option_position = member_option.position
              break
            endif
          endfor

          assign size_pairs = ''
          if size_option_position > 0
            for member_variant in member.variants
              if size_option_position == 1
                assign variant_size = member_variant.option1
              elsif size_option_position == 2
                assign variant_size = member_variant.option2
              elsif size_option_position == 3
                assign variant_size = member_variant.option3
              endif
              if variant_size != blank
                assign size_value_json = variant_size | json
                assign size_pairs = size_pairs | append: '{"size":' | append: size_value_json | append: ',"variant":' | append: member_variant.id | append: '},'
              endif
            endfor
          endif

          assign sizes_json = '[]'
          if size_pairs != blank
            assign size_pairs_length = size_pairs.size | minus: 1
            assign sizes_json = '[' | append: size_pairs | slice: 0, size_pairs_length | append: ']'
          endif
        -%}

        <li class="color-group__item">
          {%- if is_current -%}
            <span
              class="color-group__swatch color-group__swatch--current"
              aria-current="true"
            >
              {%- if thumb_url != blank -%}
                <img
                  class="color-group__image"
                  src="{{ thumb_url }}"
                  alt=""
                  width="80"
                  height="100"
                  loading="lazy"
                >
              {%- else -%}
                <span
                  class="color-group__swatch-color"
                  style="background-color: {% if swatch_color %}{{ swatch_color.rgb }}{% else %}rgb(var(--color-foreground-rgb) / 0.25){% endif %};"
                ></span>
              {%- endif -%}
              <span class="color-group__tooltip" aria-hidden="true">{{ color_label }}</span>
              <span class="color-group__tooltip-arrow" aria-hidden="true"></span>
              <span class="visually-hidden">{{ color_label }}</span>
            </span>
          {%- else -%}
            <a
              class="color-group__swatch"
              href="{{ member.url }}"
              data-color-group-link
              data-sizes="{{ sizes_json }}"
              {% if preview_url != blank %}data-preview-src="{{ preview_url }}"{% endif %}
              aria-label="{{ color_label | escape }}"
            >
              {%- if thumb_url != blank -%}
                <img
                  class="color-group__image"
                  src="{{ thumb_url }}"
                  alt=""
                  width="80"
                  height="100"
                  loading="lazy"
                >
              {%- else -%}
                <span
                  class="color-group__swatch-color"
                  style="background-color: {% if swatch_color %}{{ swatch_color.rgb }}{% else %}rgb(var(--color-foreground-rgb) / 0.25){% endif %};"
                ></span>
              {%- endif -%}
              <span class="color-group__tooltip" aria-hidden="true">{{ color_label }}</span>
              <span class="color-group__tooltip-arrow" aria-hidden="true"></span>
            </a>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </fieldset>
{% endif %}
