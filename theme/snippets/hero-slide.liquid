{%- liquid
  assign overlay_opacity = block.settings.overlay_opacity | divided_by: 100.0
  assign overlay_color   = block.settings.overlay_color
  assign text_color      = block.settings.text_color
  assign h_align         = block.settings.content_h_align
  assign v_align         = block.settings.content_v_align
  assign text_align      = block.settings.text_alignment | default: 'center'
  assign h_align_mobile = block.settings.content_h_align_mobile | default: 'inherit'
  assign v_align_mobile = block.settings.content_v_align_mobile | default: 'inherit'
  assign text_align_mobile = block.settings.text_alignment_mobile | default: 'inherit'
  assign content_width_mobile = 'fit-content'

  if h_align_mobile == 'inherit'
    assign h_align_mobile = h_align
    assign content_width_mobile = '100%'
  endif
  if v_align_mobile == 'inherit'
    assign v_align_mobile = v_align
  endif
  if text_align_mobile == 'inherit'
    assign text_align_mobile = text_align
  endif

  case text_align
    when 'left'
      assign inner_align = 'flex-start'
    when 'right'
      assign inner_align = 'flex-end'
    else
      assign inner_align = 'center'
  endcase

  case text_align_mobile
    when 'left'
      assign inner_align_mobile = 'flex-start'
    when 'right'
      assign inner_align_mobile = 'flex-end'
    else
      assign inner_align_mobile = 'center'
  endcase

  assign desktop_image = block.settings.image
  assign mobile_image = block.settings.image_mobile | default: desktop_image
  assign mobile_widths = '375,550,750,1000,1200' | split: ','
  assign hero_loading = 'lazy'
  assign hero_priority = 'auto'
  if is_first and section.index == 1
    assign hero_loading = 'eager'
    assign hero_priority = 'high'
  endif
-%}

<div
  class="slide-item"
  {{ block.shopify_attributes }}
>
  {%- if desktop_image == blank -%}
    <div class="slide-placeholder{% if mobile_image != blank %} slide-placeholder--desktop{% endif %}">
      {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
    </div>
  {%- endif -%}
  {%- if mobile_image != blank -%}
    <picture
      class="slide-picture{% if desktop_image == blank %} slide-picture--mobile-only{% endif %}"
      style="--slide-mobile-focus: {{ mobile_image.presentation.focal_point | default: '50% 50%' }};"
    >
      <source
        media="(max-width: 768px)"
        width="{{ mobile_image.width }}"
        height="{{ mobile_image.height }}"
        sizes="100vw"
        srcset="
          {%- for candidate in mobile_widths -%}
            {%- assign image_width = candidate | plus: 0 | at_most: mobile_image.width -%}
            {{ mobile_image | image_url: width: image_width | escape }} {{ image_width }}w
            {%- if image_width == mobile_image.width or forloop.last %}{% break %}{% endif -%},
          {%- endfor -%}
        "
      >
      {%- if desktop_image != blank -%}
        {{
          desktop_image
          | image_url: width: 3840
          | image_tag:
            class: 'slide-img',
            loading: hero_loading,
            fetchpriority: hero_priority,
            widths: '750, 1100, 1500, 1780, 2000, 3000, 3840',
            sizes: '100vw',
            alt: block.settings.title
        }}
      {%- else -%}
        {% comment %}The desktop placeholder is separate. Keep the mobile-only fallback local.{% endcomment %}
        <img class="slide-img" src="data:image/gif;base64,R0lGODlhAQABAAD/ACwAAAAAAQABAAACADs=" width="{{ mobile_image.width }}" height="{{ mobile_image.height }}" loading="{{ hero_loading }}" fetchpriority="{{ hero_priority }}" alt="{{ block.settings.title | escape }}">
      {%- endif -%}
    </picture>
  {%- endif -%}

  <div
    class="slide-overlay"
    style="background-color: {{ overlay_color }}; opacity: {{ overlay_opacity }};"
  ></div>

  <div
    class="slide-content"
    style="
      --hero-content-h-align: {{ h_align }};
      --hero-content-v-align: {{ v_align }};
      --hero-content-h-align-mobile: {{ h_align_mobile }};
      --hero-content-v-align-mobile: {{ v_align_mobile }};
      color: {{ text_color }};
    "
  >
    <div
      class="slide-content-inner"
      style="
        --hero-text-align: {{ text_align }};
        --hero-inner-align: {{ inner_align }};
        --hero-text-align-mobile: {{ text_align_mobile }};
        --hero-inner-align-mobile: {{ inner_align_mobile }};
        --hero-content-width-mobile: {{ content_width_mobile }};
      "
    >
    {%- if block.settings.subtitle != blank -%}
      <p class="slide-subtitle" style="font-size: {{ block.settings.subtitle_size }}px; margin-bottom: {{ block.settings.subtitle_spacing_bottom | default: 6 }}px;">
        {{ block.settings.subtitle }}
      </p>
    {%- endif -%}

    {%- if block.settings.title != blank -%}
      <h2 class="slide-title" style="font-size: {{ block.settings.title_size }}px; margin-bottom: {{ block.settings.title_spacing_bottom | default: 6 }}px;">
        {{ block.settings.title }}
      </h2>
    {%- endif -%}

    {%- if block.settings.text != blank -%}
      <p class="slide-text" style="font-size: {{ block.settings.text_size }}px; margin-bottom: {{ block.settings.text_spacing_bottom | default: 10 }}px;">
        {{ block.settings.text }}
      </p>
    {%- endif -%}

    {%- if block.settings.button_label != blank -%}
      {%- liquid
        assign btn_text_color = block.settings.button_text_color
        assign btn_pv = block.settings.button_padding_v
        assign btn_ph = block.settings.button_padding_h
        assign btn_fs = block.settings.button_size
        assign btn_tint = block.settings.button_tint_color
        assign btn_bg_alpha = block.settings.button_bg_opacity | divided_by: 100.0
        assign btn_border_alpha = block.settings.button_border_opacity | divided_by: 100.0
        assign btn_hover_bg_alpha = btn_bg_alpha | plus: 0.10
        assign btn_hover_border_alpha = btn_border_alpha | plus: 0.15
      -%}
      <a
        href="{{ block.settings.button_link | default: '#' }}"
        class="slide-btn"
        style="
          font-size: {{ btn_fs }}px;
          padding: {{ btn_pv }}px {{ btn_ph }}px;
          color: {{ btn_text_color }};
          --hero-btn-bg: {{ btn_tint | color_modify: 'alpha', btn_bg_alpha }};
          --hero-btn-hover-bg: {{ btn_tint | color_modify: 'alpha', btn_hover_bg_alpha }};
          --hero-btn-border: {{ btn_tint | color_modify: 'alpha', btn_border_alpha }};
          --hero-btn-hover-border: {{ btn_tint | color_modify: 'alpha', btn_hover_border_alpha }};
          --hero-btn-blur: {{ block.settings.button_blur }}px;
        "
      >
        {{ block.settings.button_label }}
      </a>
    {%- endif -%}
    </div>
  </div>
</div>
