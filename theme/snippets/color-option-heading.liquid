{%- doc -%}
  Shared heading for native colour swatches and cross-product colour groups.
  @param {string} label - Colour option label.
  @param {string} [value] - Current colour name.
{%- enddoc -%}
<legend class="mv-color-heading">
  <span>{{ label | escape }}</span>
  {%- if value != blank -%}
    <span class="mv-color-heading__value">{{ value | escape }}</span>
  {%- endif -%}
</legend>

{% stylesheet %}
  variant-picker .variant-option[data-mv-option-kind='color'] > .mv-color-heading {
    display: flex;
    flex-basis: 100%;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    width: 100%;
    padding: 0;
    margin-block-end: 8px;
    font-family: var(--font-body--family);
    font-size: 11px;
    font-weight: 500;
    line-height: 1.25;
    letter-spacing: .08em;
    text-transform: uppercase;
    color: var(--pi-muted, var(--color-foreground-muted, #77736d));
  }
  .mv-color-heading__value {
    min-width: 0;
    margin-inline-start: auto;
    font-family: var(--font-body--family);
    font-size: 10px;
    font-weight: 500;
    line-height: 1;
    letter-spacing: .12em;
    text-align: end;
    overflow-wrap: anywhere;
    color: var(--pi-muted, var(--color-foreground-subdued, #77736d));
  }
{% endstylesheet %}
