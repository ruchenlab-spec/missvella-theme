{%- doc -%}
  Adapts existing INS text to the native text renderer without migrating merchant content.
  A text_style block supplies the native controls; absent a block, semantic HTML uses theme defaults.

  @param {object} section - INS section with content and local style blocks
  @param {string} role - Text role matched to text_style.settings.text_role
  @param {string} text - Existing plain text content
  @param {string} [tag] - Semantic element inside the text block (defaults to p)
  @param {string} [class] - Wrapper class for section spacing
  @param {string} [color] - Fallback color when the text block has no override
  @param {string} [alignment] - Wrapper alignment for fit-width native text blocks
{%- enddoc -%}

{%- liquid
  assign text_style = nil
  for candidate in section.blocks
    if candidate.type == 'text_style' and candidate.settings.text_role == role
      assign text_style = candidate
      break
    endif
  endfor
  assign tag = tag | default: 'p'
  assign width = text_style.settings.width | default: '100%'
  assign alignment = alignment | default: section.settings.header_align
-%}

{%- capture content -%}<{{ tag }}>{{ text }}</{{ tag }}>{%- endcapture -%}
<div class="{{ class }} text-block--align-{{ alignment }}" style="--text-align: inherit;{% if color != blank %}--color: {{ color }};{% endif %}">
  {% render 'text', block: text_style, fallback_text: content, width: width %}
</div>
