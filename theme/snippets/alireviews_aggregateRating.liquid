{%- comment -%}
  Product structured data (JSON-LD) for rich results.

  The AliReviews rating data is supplied by the AliReviews app as a metafield
  holding a ready-made JSON-LD fragment. The app is not installed on this store,
  so the metafield resolves to blank and only the base Product schema is emitted.

  The app can hand over that fragment in two shapes, so both are handled:
  - a JSON *field* fragment (e.g. `"aggregateRating": {...}`): inlined into the
    Product object, with a trailing comma added when it omits one.
  - a complete JSON *object* (starts with `{`): emitted as its own script tag,
    because it cannot be nested inside the Product object.

  This snippet is included from sections/header.liquid, which renders on every
  page. The `product` guard keeps non-product pages from emitting a bogus
  Product schema (null name / url / brand and an empty offers list).
{%- endcomment -%}

{%- if product -%}
  {%- assign alireviews_rating = product.metafields.alireviews.seo_rating_review_key_script -%}
  {%- assign seo_media = product.featured_media -%}
  {%- if alireviews_rating != blank and alireviews_rating.first == '{' -%}
    <script type="application/ld+json">{{ alireviews_rating }}</script>
  {%- endif -%}
<script type="application/ld+json">
    {
      "@context": "http://schema.org/",
      "@type": "Product",
      {%- if alireviews_rating != blank and alireviews_rating.first != '{' -%}
        {{ alireviews_rating }}{%- if alireviews_rating.last != ',' -%},{%- endif -%}
      {%- endif -%}
      "name": {{ product.title | json }},
      "url": {{ request.origin | append: product.url | json }},
      {% if seo_media -%}
        "image": [
          {{ seo_media | image_url: width: seo_media.preview_image.width | prepend: "https:" | json }}
        ],
      {%- endif %}
      "description": {{ product.description | strip_html | json }},
      {% if product.selected_or_first_available_variant.sku != blank -%}
        "sku": {{ product.selected_or_first_available_variant.sku | json }},
      {%- endif -%}
      "brand": {
        "@type": "Thing",
        "name": {{ product.vendor | json }}
      },
      "offers": [
        {%- for variant in product.variants -%}
          {
            "@type" : "Offer",
            {%- if variant.sku != blank -%}
              "sku": {{ variant.sku | json }},
            {%- endif -%}
            "availability" : "http://schema.org/{% if variant.available %}InStock{% else %}OutOfStock{% endif %}",
            "price" : {{ variant.price | divided_by: 100.00 | json }},
            "priceCurrency" : {{ cart.currency.iso_code | json }},
            "url" : {{ request.origin | append: variant.url | json }}
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  </script>
{%- endif -%}
