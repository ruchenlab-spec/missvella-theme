{%- doc -%}
  Renders a default variant picker, used to display the variant picker in the variants block.

  @param {object} product_resource - The product object.
  @param {object} [block] - The block object
  @param {object} section - The section object.
  @param {object} product - The current product object (used to determine selected variant state).
{%- enddoc -%}

{% assign block_settings = block.settings %}

{% liquid
  # Custom styling applies to:
  #   - dropdowns + buttons when variant_style_class == 'custom' (unselected colors)
  #   - buttons only when selected_variant_style_class == 'custom' (selected colors)
  # The 'buttons' label is kept for backwards-compat of the class name.
  assign has_custom_variant_buttons = false
  if block_settings.variant_style_class == 'custom'
    assign has_custom_variant_buttons = true
  endif
  if block_settings.variant_style == 'buttons' and block_settings.selected_variant_style_class == 'custom'
    assign has_custom_variant_buttons = true
  endif
  assign fieldset_index = 0

  # Size layout: the merchant can show every size at once (matrix) instead of a
  # dropdown. Missing settings fall back to the matrix, which is the default.
  assign size_layout = block_settings.size_layout | default: 'matrix'
  assign show_fit_tabs = true
  if block_settings.show_fit_tabs == false
    assign show_fit_tabs = false
  endif

  assign product_has_size_option = false
  for option_scan in product_resource.options_with_values
    assign option_scan_key = option_scan.name | strip | downcase
    if option_scan_key == 'size' or option_scan_key == '尺寸'
      assign product_has_size_option = true
      break
    endif
  endfor

  assign show_size_chart = false
  if request.page_type == 'product' and product_has_size_option and block_settings.show_size_chart
    assign show_size_chart = true
  endif
  assign size_chart_uid = section.id | append: '-' | append: block.id | handleize

  # ------------------------------------------------------------------
  # Cross-product color group.
  # A group bundles every product of one style in different colours. When
  # the current product belongs to a group, the group swatches replace the
  # native Color option so shoppers never see two color pickers on the
  # same page. Merchants can switch the group off, in which case the
  # native Color option is shown as usual.
  # ------------------------------------------------------------------
  assign color_group_enabled = true
  if block_settings.color_group_enabled == false
    assign color_group_enabled = false
  endif

  capture color_group_handle_output
    render 'color-group-collection', product_resource: product_resource
  endcapture
  assign color_group_handle = color_group_handle_output | strip

  assign color_group_members = blank
  assign color_group_member_count = 0
  if color_group_handle != blank
    assign color_group_collection = collections[color_group_handle]
    assign color_group_members = color_group_collection.products
    assign color_group_member_count = color_group_members | size
  endif

  assign has_color_group = false
  if color_group_enabled and color_group_member_count > 1
    assign has_color_group = true
  endif

  # The group swatches only replace the native Color option when the
  # product itself holds a single colour. A product with several colour
  # variants keeps its native picker, otherwise the shopper would not be
  # able to switch colour at all.
  assign color_option_value_count = 0
  for color_option in product_resource.options_with_values
    assign color_option_key = color_option.name | strip | downcase
    if color_option_key == 'color' or color_option_key == 'colour' or color_option_key == '颜色'
      assign color_option_value_count = color_option.values | size
      break
    endif
  endfor

  assign hide_native_color = false
  if has_color_group and color_option_value_count <= 1
    assign hide_native_color = true
  endif
-%}

{% unless product_resource.has_only_default_variant %}
  {% if has_custom_variant_buttons %}
    {% render 'variant-button-custom-styles', block_settings: block_settings, block_id: block.id %}
  {% endif %}
  <variant-picker
    class="variant-picker spacing-style variant-picker--{{ block_settings.alignment }}{% if has_custom_variant_buttons %} variant-picker--custom-{{ block.id }}{% endif %}"
    style="
      {% render 'spacing-style', settings: block_settings %}
       {% if block_settings.option_label_text_color != blank %}
        --variant-option-label-color: rgba({{ block_settings.option_label_text_color.rgba }});
        --variant-option-label-color-subdued: rgba({{ block_settings.option_label_text_color.rgb }} / var(--opacity-subdued-text));
      {% endif %}
    "
    data-section-id="{{ section.id }}"
    data-product-id="{{ product_resource.id }}"
    data-product-handle="{{ product_resource.handle }}"
    data-product-title="{{ product_resource.title | escape }}"
    data-block-id="{{ block.id }}"
    data-product-url="{{ product_resource.url }}"
    ref="mainVariantPicker"
    {% if product.id == product_resource.id %}
      data-template-product-match="true"
    {% endif %}
    {{ block.shopify_attributes }}
    {% if request.visual_preview_mode %}
      data-shopify-visual-preview
    {% endif %}
  >
    <form class="variant-picker__form">
      {%- if has_color_group -%}
        {%- comment -%}
          Cross-product color group: one swatch per colour, each linking to
          the matching product page.
        {%- endcomment -%}
        {%- render 'color-group-swatches',
          product_resource: product_resource,
          group_handle: color_group_handle,
          current_product: product,
          display_style: block_settings.color_group_display_style,
          columns: block_settings.color_group_columns,
          min_width: block_settings.color_group_min_width,
          mobile_min_width: block_settings.color_group_mobile_min_width,
          card_radius: block_settings.color_group_card_radius,
          selected_style: block_settings.color_group_selected_style,
          tooltip_shadow: block_settings.color_group_tooltip_shadow,
          gap: block_settings.color_group_gap,
          gap_start: block_settings.color_group_gap_start,
          gap_end: block_settings.color_group_gap_end
        -%}
      {%- endif -%}
      {%- if show_fit_tabs and product_has_size_option -%}
        {%- comment -%}
          Fit preference tabs. The tabs only switch what is shown: Standard Size
          reveals the size matrix rendered by this picker, Custom Fit reveals the
          Custom Size block that lives next to this picker.
        {%- endcomment -%}
        <div class="mv-fit-tabs" role="tablist" aria-label="Fit preference">
          <button
            type="button"
            class="mv-fit-tab is-active"
            role="tab"
            aria-selected="true"
            aria-controls="mv-fit-panel-standard"
            data-mv-fit-tab="standard"
          >
            <span class="mv-fit-tab__text">Standard Size</span>
          </button>
          <button
            type="button"
            class="mv-fit-tab"
            role="tab"
            aria-selected="false"
            aria-controls="mv-fit-panel-custom"
            data-mv-fit-tab="custom"
          >
            <span class="mv-fit-tab__text">Custom Fit</span>
          </button>
        </div>
        <p class="mv-fit-error" data-mv-fit-error hidden></p>
      {%- endif -%}
      {%- for product_option in product_resource.options_with_values -%}
        {%- liquid
          assign option_name_key = product_option.name | strip | downcase
          assign is_color_option = false
          assign is_size_option = false
          assign has_custom_color_option = false

          if option_name_key == 'color' or option_name_key == 'colour' or option_name_key == '颜色'
            assign is_color_option = true
          endif

          if option_name_key == 'size' or option_name_key == '尺寸'
            assign is_size_option = true
          endif

          if is_color_option
            for option_scan_value in product_option.values
              assign option_scan_name = option_scan_value.name | strip | downcase
              if option_scan_name == 'custom color' or option_scan_name == 'custom colors' or option_scan_name == 'custom colour' or option_scan_name == 'custom colours'
                assign has_custom_color_option = true
                break
              endif
            endfor
          endif
        -%}

        {%- comment -%}
          Products that contain the real Shopify option value "Custom Color" use
          the dedicated Color Swatch Picker block for the visible UI. Keep the
          complete native radio fieldset in the DOM so Horizon still owns variant
          resolution, media, price, availability and URL changes.
        {%- endcomment -%}
        {%- if is_color_option and has_custom_color_option -%}
          {%- render 'variant-hidden-option-fieldset',
            product_option: product_option,
            product_resource: product_resource,
            block: block,
            fieldset_index: fieldset_index
          -%}
          {%- assign fieldset_index = fieldset_index | plus: 1 -%}
          {%- continue -%}
        {%- endif -%}

        {%- if is_color_option and hide_native_color -%}
          {%- comment -%}
            The color group swatches above act as the color selector for this
            product. The native Color radios stay in the DOM (hidden) so that
            variant resolution, availability and URL updates keep working.
          {%- endcomment -%}
          {%- render 'variant-hidden-option-fieldset',
            product_option: product_option,
            product_resource: product_resource,
            block: block,
            fieldset_index: fieldset_index
          -%}
          {%- assign fieldset_index = fieldset_index | plus: 1 -%}
          {%- continue -%}
        {%- endif -%}

        {%- liquid
          assign swatch_count = product_option.values | map: 'swatch' | compact | size
          assign variant_style = block_settings.variant_style

          # PDP Color options should always use swatches when swatches are enabled.
          # Shopify may leave product_option_value.swatch empty, but we can still
          # resolve the visual from the variant image or the Missvella color palette.
          if is_color_option and block_settings.show_swatches
            assign variant_style = 'swatch'
          elsif swatch_count > 0 and block_settings.show_swatches
            if block_settings.variant_style == 'dropdown'
              assign variant_style = 'swatch_dropdown'
            else
              assign variant_style = 'swatch'
            endif
          endif

          assign option_id_attribute = blank
          assign longest_value = 0
          assign is_plus_size_collapsible = false
          assign plus_size_selected = false
          assign is_size_matrix = false

          # PDP size matrix: every size is shown at once, no extra click needed.
          if is_size_option and size_layout == 'matrix'
            assign is_size_matrix = true
            assign variant_style = 'buttons'
          endif

          if variant_style == 'buttons' and settings.variant_button_width == 'equal-width-buttons'
            assign fieldset_id = section.id | append: '-' | append: product_resource.id | append: '-' | append: product_option.name | handleize
            assign option_id_attribute = 'data-option-id="' | append: fieldset_id | append: '"'
          endif

          # PDP Size option: collapse everything from US18+ onward behind a compact toggle.
          # Custom Sizes is a technical placeholder and must not affect Plus Size expansion.
          # The size matrix shows every size, so it never collapses.
          if variant_style != 'swatch' and is_size_matrix == false
            if is_size_option
              assign plus_size_scan_started = false
              for option_scan_value in product_option.values
                assign option_scan_name = option_scan_value.name | strip | downcase
                if option_scan_name == 'us18+'
                  assign plus_size_scan_started = true
                  assign is_plus_size_collapsible = true
                endif
                if plus_size_scan_started and option_scan_value.selected and option_scan_name != 'custom sizes' and option_scan_name != 'custom size'
                  assign plus_size_selected = true
                endif
              endfor
            endif
          endif
        -%}

        {%- if product_option.values.size == 1 and variant_style != 'swatch' -%}
          <div
            class="variant-option"
            data-testid="variant-option-single"
          >
            {{- product_option.name | escape -}}
            <span
              class="variant-option__swatch-value"
              data-testid="variant-option-single-value"
            >
              {{- product_option.selected_value -}}
            </span>
          </div>
        {%- elsif variant_style == 'swatch' or variant_style == 'buttons' -%}
          <fieldset
            class="variant-option variant-option--buttons{% if variant_style == 'swatch' %} variant-option--swatches{% elsif is_size_matrix %}{% else %} variant-option--{{ settings.variant_button_width }}{% endif %}{% if is_size_matrix %} variant-option--matrix{% endif %}{% if is_plus_size_collapsible %} variant-option--plus-size-collapsible{% endif %}"
            data-fieldset-index="{{ fieldset_index }}"
            {% if is_color_option %}
              data-mv-option-kind="color"
            {% elsif is_size_option %}
              data-mv-option-kind="size"
            {% endif %}
            {% if is_plus_size_collapsible %}
              data-plus-size-collapsible="true"
              data-plus-size-key="{{ product_resource.id }}-{{ product_option.position }}"
              data-plus-size-initial-expanded="{% if plus_size_selected %}true{% else %}false{% endif %}"
            {% endif %}
            ref="fieldsets[]"
            {{ option_id_attribute }}
          >
            <legend{% if is_size_option and show_size_chart %} class="mv-size-legend"{% endif %}>
              {%- if is_size_option and show_size_chart -%}
                <span class="mv-size-legend-row">
                  <span>{{ product_option.name | escape }}</span>
                  <button
                    type="button"
                    class="mv-size-chart-trigger"
                    data-size-chart-trigger="{{ size_chart_uid }}"
                    aria-haspopup="dialog"
                    aria-controls="mv-size-chart-drawer-{{ size_chart_uid }}"
                  >
                    <img
                      class="mv-size-chart-trigger-icon"
                      src="{{ 'size-chart-icon.svg' | asset_url }}"
                      alt=""
                      width="14"
                      height="14"
                      loading="lazy"
                      aria-hidden="true"
                    >
                    <span>SIZE GUIDE</span>
                  </button>
                </span>
              {%- else -%}
                {{ product_option.name | escape -}}
                {%- if variant_style == 'swatch' -%}
                  <span class="variant-option__swatch-value">{{ product_option.selected_value }}</span>
                {%- endif %}
              {%- endif -%}
            </legend>
            {%- assign plus_size_render_started = false -%}
            {%- for product_option_value in product_option.values -%}
              {%- assign current_option_value_name = product_option_value.name | strip | downcase -%}
              {% if product_option_value.size > longest_value and option_id_attribute %}
                {% assign longest_value = product_option_value.size %}
              {% endif %}

              {%- if is_plus_size_collapsible -%}
                {%- if current_option_value_name == 'us18+' -%}
                  {%- assign plus_size_render_started = true -%}
                  <button
                    type="button"
                    class="variant-option__button-label variant-option__plus-size-toggle"
                    data-plus-size-toggle
                    aria-expanded="{% if plus_size_selected %}true{% else %}false{% endif %}"
                  >
                    <span data-plus-size-toggle-text>More Plus Size</span>
                  </button>
                {%- endif -%}
              {%- endif -%}

              {%- liquid
                assign is_custom_size_placeholder_value = false
                if is_size_option and current_option_value_name == 'custom sizes'
                  assign is_custom_size_placeholder_value = true
                elsif is_size_option and current_option_value_name == 'custom size'
                  assign is_custom_size_placeholder_value = true
                endif
              -%}
              <label
                class="variant-option__button-label{% if variant_style == 'swatch' %} variant-option__button-label--has-swatch{% endif %}{% if is_plus_size_collapsible and plus_size_render_started %} variant-option__button-label--plus-size{% endif %}{% if is_custom_size_placeholder_value %} variant-option__button-label--custom-size-placeholder{% endif %}"
              >
                <input
                  type="radio"
                  name="{{ product_option.name | escape }}-{{ block.id }}-{{ product_resource.id }}"
                  value="{{ product_option_value | escape }}"
                  aria-label="{{ product_option_value.name | escape }}{% if product_option_value.available == false %} - {{ 'products.product.sold_out' | t }}{% endif %}"
                  {% if product_option_value.available == false %}
                    aria-disabled="true"
                  {% endif %}
                  data-previous-checked="false"
                  data-fieldset-index="{{ fieldset_index }}"
                  data-input-index="{{ forloop.index0 }}"
                  data-input-id="{{ product_option.position }}-{{ forloop.index0 }}"
                  data-option-name="{{ product_option.name | escape }}"
                  data-option-value-id="{{ product_option_value.id }}"
                  data-option-available="{{ product_option_value.available }}"
                  data-connected-product-url="{{ product_option_value.product_url }}"
                  {% if is_custom_size_placeholder_value %}
                    data-mv-custom-size-placeholder="true"
                  {% endif %}
                  {% if product_option_value.variant.id %}
                    data-variant-id="{{ product_option_value.variant.id }}"
                  {% endif %}
                  {% if product_option_value.selected %}
                    data-current-checked="true"
                    checked
                  {% else %}
                    data-current-checked="false"
                  {% endif %}
                >
                {% if variant_style == 'swatch' %}
                  {% liquid
                    assign featured_media = product_option_value.variant.featured_media

                    # If the variant has no featured media, and we have a combined listing product, then fall back to
                    # using the featured media of the child product that is linked to this option value.
                    if featured_media == blank and product_option_value.product_url
                      assign featured_media = product_option_value.variant.product.featured_media
                    endif
                  %}

                  {% render 'swatch',
                    swatch: product_option_value.swatch,
                    variant_image: featured_media,
                    mode: 'unscaled',
                    label: product_option_value.name,
                    force_variant_image: is_color_option
                  %}
                {% else %}
                  {% if product_option_value.available == true %}
                    <span
                      class="variant-option__button-label__pill"
                      data-key="variant-option-pill"
                    ></span>
                  {% endif %}
                  <span
                    class="variant-option__button-label__text"
                    data-key="variant-option-text"
                  >
                    {{- product_option_value | escape -}}
                  </span>
                {% endif %}
                {% render 'strikethrough-variant', product_option: product_option_value %}
              </label>
            {%- endfor -%}
            {% if option_id_attribute %}
              {% style %}
                [data-option-id="{{ fieldset_id }}"] {
                  --variant-ch: {{ longest_value | times: 0.65 }}em;
                }
              {% endstyle %}
            {% endif %}
          </fieldset>
          {%- if is_size_matrix -%}
            <p class="mv-size-summary" data-mv-size-summary>
              <span class="mv-size-summary__label">Selected size</span>
              <span class="mv-size-summary__value" data-mv-size-value>{{ product_option.selected_value }}</span>
            </p>
          {%- endif -%}
          {%- assign fieldset_index = fieldset_index | plus: 1 -%}
        {%- elsif block_settings.variant_style == 'dropdowns' -%}
          {%
            # There is an opportunity to build a custom select component that will allow us to style the select element further (animation for dropdown, swatches shown in the dropdown options, etc)
            # It's too bad as it mean rebuilding baked in behaviours but I think we've already done that for the locale selectors
            # in dawn. So it might mean more time spent in setting it up but worth it for future updates/styling.
          %}
          {% liquid
            assign property_being_updated = false
            if settings.variant_swatch_width != settings.variant_swatch_height
              assign property_being_updated = true
              # (original width / original height) x new height (20px at the moment) = new width
              assign new_width = settings.variant_swatch_width | times: 1.0 | divided_by: settings.variant_swatch_height | times: 20
            endif
          %}

          <div class="variant-option variant-option--dropdowns">
            {%- if is_size_option and show_size_chart -%}
              <div class="mv-size-dropdown-label-row">
                <label for="Option-{{ block.id }}-{{ forloop.index0 }}">{{ product_option.name | escape }}</label>
                <button
                  type="button"
                  class="mv-size-chart-trigger"
                  data-size-chart-trigger="{{ size_chart_uid }}"
                  aria-haspopup="dialog"
                  aria-controls="mv-size-chart-drawer-{{ size_chart_uid }}"
                >
                  <img
                      class="mv-size-chart-trigger-icon"
                      src="{{ 'size-chart-icon.svg' | asset_url }}"
                      alt=""
                      width="14"
                      height="14"
                      loading="lazy"
                      aria-hidden="true"
                    >
                  <span>SIZE GUIDE</span>
                </button>
              </div>
            {%- else -%}
              <label for="Option-{{ block.id }}-{{ forloop.index0 }}">{{ product_option.name | escape }}</label>
            {%- endif -%}
            <div
              class="variant-option__select-wrapper"
              style="
                {%- if property_being_updated  -%}
                  --variant-picker-swatch-width: clamp(10px,{{ new_width }}px, 50px);
                {%- endif -%}
              "
            >
              <select
                id="Option-{{ block.id }}-{{ forloop.index0 }}"
                name="options[{{ product_option.name | escape }}]"
                class="variant-option__select"
              >
                {%- for product_option_value in product_option.values -%}
                  {%- assign dropdown_option_value_name = product_option_value.name | strip | downcase -%}
                  <option
                    value="{{ product_option_value | escape }}"
                    data-input-id="{{ product_option.position }}-{{ forloop.index0 }}"
                    data-option-name="{{ product_option.name | escape }}"
                    data-option-value-id="{{ product_option_value.id }}"
                    data-variant-id="{{ product_option_value.variant.id }}"
                    data-connected-product-url="{{ product_option_value.product_url }}"
                    {% if is_size_option %}
                      {% if dropdown_option_value_name == 'custom sizes' or dropdown_option_value_name == 'custom size' %}
                        data-mv-custom-size-placeholder="true"
                        hidden
                      {% endif %}
                    {% endif %}
                    {% if product_option_value.selected %}
                      selected="selected"
                    {% endif %}
                  >
                    {% if product_option_value.available == false %}
                      {{ product_option_value | escape }} - {{ 'content.unavailable' | t }}
                    {% else %}
                      {{ product_option_value | escape }}
                    {% endif %}
                  </option>
                {%- endfor -%}
              </select>
              <svg
                aria-hidden="true"
                focusable="false"
                class="icon icon-caret icon-caret--line"
                viewBox="0 0 12 12"
                fill="none"
              >
                <path
                  d="M2.75 4.75 6 8l3.25-3.25"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}

      <script type="application/json">
        {{ product_resource.selected_or_first_available_variant | json }}
      </script>
      {%- if show_fit_tabs and product_has_size_option -%}
        {%- comment -%}
          Fit preference tabs + selected size summary.

          The tabs toggle a mode class on the product details wrapper, which is the
          closest common ancestor of this picker and the Custom Size block. CSS then
          decides what is visible, so no markup is moved around.
        {%- endcomment -%}
        <script>
          (function () {
            var picker = document.currentScript && document.currentScript.closest('variant-picker');
            if (!picker || picker.dataset.mvFitInit) return;
            picker.dataset.mvFitInit = '1';

            var scope = picker.closest('.product-details') || document;
            var errorLine = picker.querySelector('[data-mv-fit-error]');
            var summary = picker.querySelector('[data-mv-size-summary]');
            var currentMode = 'standard';

            function tabButtons() {
              return picker.querySelectorAll('[data-mv-fit-tab]');
            }

            function customBlock() {
              return scope.querySelector('.custom-sizes-block');
            }

            function showError(message) {
              if (!errorLine) return;
              errorLine.textContent = message;
              errorLine.hidden = false;
            }

            function hideError() {
              if (errorLine) errorLine.hidden = true;
            }

            function applyMode(mode, notify) {
              currentMode = mode;
              scope.classList.toggle('mv-fit-standard', mode === 'standard');
              scope.classList.toggle('mv-fit-custom', mode === 'custom');
              Array.prototype.forEach.call(tabButtons(), function (tab) {
                var active = tab.dataset.mvFitTab === mode;
                tab.classList.toggle('is-active', active);
                tab.setAttribute('aria-selected', active ? 'true' : 'false');
              });
              if (tabButtons().length) {
                var customTab = picker.querySelector('[data-mv-fit-tab="custom"]');
                if (customTab && !customBlock()) customTab.hidden = true;
              }
              hideError();
              if (notify !== false) {
                document.dispatchEvent(new CustomEvent('mv:fit-mode', { detail: { mode: mode } }));
              }
            }

            // Delegated listener: the theme re-renders the picker markup on
            // variant changes, which would drop listeners bound to the buttons.
            picker.addEventListener('click', function (event) {
              var tab = event.target && event.target.closest ? event.target.closest('[data-mv-fit-tab]') : null;
              if (!tab || !picker.contains(tab)) return;
              if (tab.dataset.mvFitTab === 'custom' && !customBlock()) return;
              applyMode(tab.dataset.mvFitTab, true);
            });

            // Keep the "Selected size" line in sync with the current selection.
            function syncSummary() {
              if (!summary) return;
              var value = picker.querySelector('[data-mv-size-value]');
              var checked = picker.querySelector('.variant-option--matrix input[type="radio"]:checked');
              if (value && checked && checked.value) value.textContent = checked.value;
            }

            picker.addEventListener('change', syncSummary);
            document.addEventListener('shopify:product:select', function (event) {
              if (event.target !== picker) return;
              if (event.promise && typeof event.promise.then === 'function') {
                event.promise.then(syncSummary).catch(function () {});
              } else {
                syncSummary();
              }
            });

            // Re-apply the mode after the theme re-renders the picker markup.
            if (typeof MutationObserver === 'function') {
              var queued = false;
              new MutationObserver(function () {
                if (queued) return;
                queued = true;
                requestAnimationFrame(function () {
                  queued = false;
                  applyMode(currentMode, false);
                });
              }).observe(picker, { childList: true, subtree: true });
            }

            applyMode('standard', true);
          })();
        </script>
      {%- endif -%}
    </form>
  </variant-picker>
{% endunless %}

