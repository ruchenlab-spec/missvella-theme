    }
    .mv-size-chart-header { display:flex; align-items:flex-start; justify-content:space-between; gap:18px; padding:20px 22px 16px; border-bottom:1px solid var(--sc-border); }
    .mv-size-chart-header h2 { margin:0; font:inherit; font-size:14px; font-weight:700; letter-spacing:.055em; }
    .mv-size-chart-header p { margin:4px 0 0; font-size:11px; color:var(--sc-muted); line-height:1.4; }
    .mv-size-chart-header-actions { display:flex; align-items:center; gap:10px; flex:0 0 auto; }
    .mv-size-chart-close { width:36px; height:36px; border:1px solid var(--sc-border); background:var(--color-background); color:var(--color-foreground); display:grid; place-items:center; cursor:pointer; padding:0; }
    .mv-size-chart-close svg { width:18px; height:18px; }
    .mv-size-chart-unit { position:relative; display:grid; grid-template-columns:1fr 1fr; width:104px; height:40px; padding:4px; border:1px solid var(--sc-border); background:rgb(var(--color-foreground-rgb) / 0.04); overflow:hidden; }
    .mv-size-chart-unit-slider { position:absolute; top:4px; left:4px; width:46px; height:30px; background:var(--color-foreground); transition:transform .26s cubic-bezier(.22,.72,.24,1); }
