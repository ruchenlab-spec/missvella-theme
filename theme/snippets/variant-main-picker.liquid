    .size-chart-unit-copy { font-size:10px; color:var(--sc-muted); white-space:nowrap; }
    /* The size table owns both scroll axes so sticky header/first column stay reliable. */
    .size-chart-scroll {
      position:relative;
      overflow:auto;
      max-height:calc(100vh - 285px);
      border:1px solid var(--sc-border);
      background:var(--color-background);
