{%- doc -%}
  Renders a default variant picker, used to display the variant picker in the variants block.

  @param {object} product_resource - The product object.
  @param {object} [block] - The block object
  @param {object} section - The section object.
  @param {object} product - The current product object (used to determine selected variant state).
{%- enddoc -%}

{% assign block_settings = block.settings %}

{% liquid
  # Custom styling applies to:
  #   - dropdowns + buttons when variant_style_class == 'custom' (unselected colors)
  #   - buttons only when selected_variant_style_class == 'custom' (selected colors)
  # The 'buttons' label is kept for backwards-compat of the class name.
  assign has_custom_variant_buttons = false
  if block_settings.variant_style_class == 'custom'
    assign has_custom_variant_buttons = true
  endif
  if block_settings.variant_style == 'buttons' and block_settings.selected_variant_style_class == 'custom'
    assign has_custom_variant_buttons = true
  endif
  assign fieldset_index = 0

  # Size layout: the merchant can show every size at once (matrix) instead of a
  # dropdown. Missing settings fall back to the matrix, which is the default.
  assign size_layout = block_settings.size_layout | default: 'matrix'
  assign show_fit_tabs = true
  if block_settings.show_fit_tabs == false
    assign show_fit_tabs = false
  endif

  assign product_has_size_option = false
  for option_scan in product_resource.options_with_values
    assign option_scan_key = option_scan.name | strip | downcase
    if option_scan_key == 'size' or option_scan_key == '尺寸'
      assign product_has_size_option = true
      break
    endif
  endfor

  assign show_size_chart = false
  if request.page_type == 'product' and product_has_size_option and block_settings.show_size_chart
    assign show_size_chart = true
  endif
  assign size_chart_uid = section.id | append: '-' | append: block.id | handleize

  # ------------------------------------------------------------------
  # Cross-product color group.
  # A group bundles every product of one style in different colours. When
  # the current product belongs to a group, the group swatches replace the
  # native Color option so shoppers never see two color pickers on the
  # same page. Merchants can switch the group off, in which case the
  # native Color option is shown as usual.
  # ------------------------------------------------------------------
  assign color_group_enabled = true
  if block_settings.color_group_enabled == false
    assign color_group_enabled = false
  endif

  assign color_group_members = blank
  assign color_group_member_count = 0
  if color_group_enabled
    capture color_group_handle_output
      render 'color-group-collection', product_resource: product_resource
    endcapture
    assign color_group_handle = color_group_handle_output | strip
    if color_group_handle != blank
      assign color_group_collection = collections[color_group_handle]
      assign color_group_members = color_group_collection.products
      assign color_group_member_count = color_group_members | size
    endif
  endif

  assign has_color_group = false
  if color_group_enabled and color_group_member_count > 1
    assign has_color_group = true
  endif

  # The group swatches only replace the native Color option when the
  # product itself holds a single colour. A product with several colour
  # variants keeps its native picker, otherwise the shopper would not be
  # able to switch colour at all.
  assign color_option_value_count = 0
  for color_option in product_resource.options_with_values
    assign color_option_key = color_option.name | strip | downcase
    if color_option_key == 'color' or color_option_key == 'colour' or color_option_key == '颜色'
      assign color_option_value_count = color_option.values | size
      break
    endif
  endfor

  assign hide_native_color = false
  if has_color_group and color_option_value_count <= 1
    assign hide_native_color = true
  endif
-%}

{% unless product_resource.has_only_default_variant %}
  {% if has_custom_variant_buttons %}
    {% render 'variant-button-custom-styles', block_settings: block_settings, block_id: block.id %}
  {% endif %}
  <variant-picker
    class="variant-picker spacing-style variant-picker--{{ block_settings.alignment }}{% if has_custom_variant_buttons %} variant-picker--custom-{{ block.id }}{% endif %}"
    style="
      {% render 'spacing-style', settings: block_settings %}
       {% if block_settings.option_label_text_color != blank %}
        --variant-option-label-color: rgba({{ block_settings.option_label_text_color.rgba }});
        --variant-option-label-color-subdued: rgba({{ block_settings.option_label_text_color.rgb }} / var(--opacity-subdued-text));
      {% endif %}
    "
    data-section-id="{{ section.id }}"
    data-product-id="{{ product_resource.id }}"
    data-product-handle="{{ product_resource.handle }}"
    data-product-title="{{ product_resource.title | escape }}"
    data-block-id="{{ block.id }}"
    data-product-url="{{ product_resource.url }}"
    ref="mainVariantPicker"
    {% if product.id == product_resource.id %}
      data-template-product-match="true"
    {% endif %}
    {{ block.shopify_attributes }}
    {% if request.visual_preview_mode %}
      data-shopify-visual-preview
    {% endif %}
  >
    <form class="variant-picker__form">
      {%- if has_color_group -%}
        {%- comment -%}
          Cross-product color group: one swatch per colour, each linking to
          the matching product page.
        {%- endcomment -%}
        {%- render 'color-group-swatches',
          product_resource: product_resource,
          group_handle: color_group_handle,
          current_product: product,
          display_style: block_settings.color_group_display_style,
          columns_desktop: block_settings.color_group_columns_desktop,
          columns_mobile: block_settings.color_group_columns_mobile,
          card_radius: block_settings.color_group_card_radius,
          selected_style: block_settings.color_group_selected_style,
          tooltip_shadow: block_settings.color_group_tooltip_shadow
        -%}
      {%- endif -%}
      {%- if show_fit_tabs and product_has_size_option -%}
        {%- comment -%}
          Fit preference tabs. The tabs only switch what is shown: Standard Size
          reveals the size matrix rendered by this picker, Custom Fit reveals the
          Custom Size block that lives next to this picker.
        {%- endcomment -%}
        <div class="mv-fit-tabs" role="tablist" aria-label="Fit preference">
          <button
            type="button"
            class="mv-fit-tab is-active"
            role="tab"
            id="mv-fit-tab-standard-{{ size_chart_uid }}"
            aria-selected="true"
            aria-controls="mv-fit-panel-standard-{{ size_chart_uid }}"
            data-mv-fit-tab="standard"
          >
            <span class="mv-fit-tab__text">Standard Size</span>
          </button>
          <button
            type="button"
            class="mv-fit-tab"
            role="tab"
            id="mv-fit-tab-custom-{{ size_chart_uid }}"
            aria-selected="false"
            aria-controls="mv-fit-panel-custom-{{ size_chart_uid }}"
            data-mv-fit-tab="custom"
          >
            <span class="mv-fit-tab__text">Custom Fit</span>
          </button>
          {%- if show_size_chart -%}
            <button
              type="button"
              class="mv-size-chart-trigger mv-fit-tabs__guide"
              data-size-chart-trigger="{{ size_chart_uid }}"
              aria-haspopup="dialog"
              aria-controls="mv-size-chart-drawer-{{ size_chart_uid }}"
            >
              <img
                class="mv-size-chart-trigger-icon"
                src="{{ 'size-chart-icon.svg' | asset_url }}"
                alt=""
                width="14"
                height="14"
                loading="lazy"
                aria-hidden="true"
              >
              <span>SIZE GUIDE</span>
            </button>
          {%- endif -%}
        </div>
        <p class="mv-fit-error" data-mv-fit-error hidden></p>
      {%- endif -%}
      {%- for product_option in product_resource.options_with_values -%}
        {%- liquid
          assign option_name_key = product_option.name | strip | downcase
          assign is_color_option = false
          assign is_size_option = false
          assign has_custom_color_option = false

          if option_name_key == 'color' or option_name_key == 'colour' or option_name_key == '颜色'
            assign is_color_option = true
          endif

          if option_name_key == 'size' or option_name_key == '尺寸'
            assign is_size_option = true
          endif

          if is_color_option
            for option_scan_value in product_option.values
              assign option_scan_name = option_scan_value.name | strip | downcase
              if option_scan_name == 'custom color' or option_scan_name == 'custom colors' or option_scan_name == 'custom colour' or option_scan_name == 'custom colours'
                assign has_custom_color_option = true
                break
              endif
            endfor
          endif
        -%}

        {%- comment -%}
          Products that contain the real Shopify option value "Custom Color" use
          the dedicated Color Swatch Picker block for the visible UI. Keep the
          complete native radio fieldset in the DOM so Horizon still owns variant
          resolution, media, price, availability and URL changes.
        {%- endcomment -%}
        {%- if is_color_option and has_custom_color_option -%}
          {%- render 'variant-hidden-option-fieldset',
            product_option: product_option,
            product_resource: product_resource,
            block: block,
            fieldset_index: fieldset_index
          -%}
          {%- assign fieldset_index = fieldset_index | plus: 1 -%}
          {%- continue -%}
        {%- endif -%}

        {%- if is_color_option and hide_native_color -%}
          {%- comment -%}
            The color group swatches above act as the color selector for this
            product. The native Color radios stay in the DOM (hidden) so that
            variant resolution, availability and URL updates keep working.
          {%- endcomment -%}
          {%- render 'variant-hidden-option-fieldset',
            product_option: product_option,
            product_resource: product_resource,
            block: block,
            fieldset_index: fieldset_index
          -%}
          {%- assign fieldset_index = fieldset_index | plus: 1 -%}
          {%- continue -%}
        {%- endif -%}

        {%- liquid
          assign swatch_count = product_option.values | map: 'swatch' | compact | size
          assign variant_style = block_settings.variant_style | default: 'buttons'

          # Legacy value saved by older theme versions.
          if variant_style == 'pills'
            assign variant_style = 'buttons'
          endif

          # PDP Color options should always use swatches when swatches are enabled.
          # Shopify may leave product_option_value.swatch empty, but we can still
          # resolve the visual from the variant image or the Missvella color palette.
          if is_color_option and block_settings.show_swatches
            assign variant_style = 'swatch'
          elsif swatch_count > 0 and block_settings.show_swatches and variant_style != 'dropdowns'
            assign variant_style = 'swatch'
          endif

          assign option_id_attribute = blank
          assign longest_value = 0
          assign is_plus_size_collapsible = false
          assign plus_size_selected = false
          assign is_size_matrix = false

          # PDP size layout: matrix shows every size at once; dropdowns forces a
          # select regardless of the global variant style.
          if is_size_option and size_layout == 'matrix'
            assign is_size_matrix = true
            assign variant_style = 'buttons'
          elsif is_size_option and size_layout == 'dropdowns'
            assign variant_style = 'dropdowns'
          endif

          if variant_style == 'buttons' and settings.variant_button_width == 'equal-width-buttons'
            assign fieldset_id = section.id | append: '-' | append: product_resource.id | append: '-' | append: product_option.name | handleize
            assign option_id_attribute = 'data-option-id="' | append: fieldset_id | append: '"'
          endif

          # PDP Size option: collapse everything from US18+ onward behind a compact toggle.
          # Custom Sizes is a technical placeholder and must not affect Plus Size expansion.
          # The size matrix shows every size, so it never collapses.
          if variant_style != 'swatch' and is_size_matrix == false
            if is_size_option
              assign plus_size_scan_started = false
              for option_scan_value in product_option.values
                assign option_scan_name = option_scan_value.name | strip | downcase
                if option_scan_name == 'us18+'
                  assign plus_size_scan_started = true
                  assign is_plus_size_collapsible = true
                endif
                if plus_size_scan_started and option_scan_value.selected and option_scan_name != 'custom sizes' and option_scan_name != 'custom size'
                  assign plus_size_selected = true
                endif
              endfor
            endif
          endif
        -%}

        {%- if product_option.values.size == 1 and variant_style != 'swatch' -%}
          <div
            class="variant-option"
            data-testid="variant-option-single"
            {% if is_size_option %}
              id="mv-fit-panel-standard-{{ size_chart_uid }}"
              data-mv-standard-size-panel
            {% endif %}
          >
            {{- product_option.name | escape -}}
            <span
              class="variant-option__swatch-value"
              data-testid="variant-option-single-value"
            >
              {{- product_option.selected_value -}}
            </span>
          </div>
        {%- elsif variant_style == 'swatch' or variant_style == 'buttons' -%}
          <fieldset
            class="variant-option variant-option--buttons{% if variant_style == 'swatch' %} variant-option--swatches{% elsif is_size_matrix %}{% else %} variant-option--{{ settings.variant_button_width }}{% endif %}{% if is_size_matrix %} variant-option--matrix{% endif %}{% if is_plus_size_collapsible %} variant-option--plus-size-collapsible{% endif %}"
            data-fieldset-index="{{ fieldset_index }}"
            {% if is_color_option %}
              data-mv-option-kind="color"
            {% elsif is_size_option %}
              data-mv-option-kind="size"
            {% endif %}
            {% if is_size_option %}
              id="mv-fit-panel-standard-{{ size_chart_uid }}"
              data-mv-standard-size-panel
              style="--color-group-card-radius: {{ block_settings.color_group_card_radius | default: 0 }}px;"
            {% endif %}
            {% if is_plus_size_collapsible %}
              data-plus-size-collapsible="true"
              data-plus-size-key="{{ product_resource.id }}-{{ product_option.position }}"
              data-plus-size-initial-expanded="{% if plus_size_selected %}true{% else %}false{% endif %}"
            {% endif %}
            ref="fieldsets[]"
            {{ option_id_attribute }}
          >
            <legend{% if is_size_option and show_size_chart %} class="mv-size-legend{% if show_fit_tabs %} mv-size-legend--hidden{% endif %}"{% endif %}>
              {%- if is_size_option and show_size_chart -%}
                {%- if show_fit_tabs -%}
                  {%- comment -%} Fit tabs already carry the row title + SIZE GUIDE; keep an a11y-only name. {%- endcomment -%}
                  <span class="mv-visually-hidden">{{ product_option.name | escape }}</span>
                {%- else -%}
                  <span class="mv-size-legend-row">
                    <span>{{ product_option.name | escape }}</span>
                    <button
                      type="button"
                      class="mv-size-chart-trigger"
                      data-size-chart-trigger="{{ size_chart_uid }}"
                      aria-haspopup="dialog"
                      aria-controls="mv-size-chart-drawer-{{ size_chart_uid }}"
                    >
                      <img
                        class="mv-size-chart-trigger-icon"
                        src="{{ 'size-chart-icon.svg' | asset_url }}"
                        alt=""
                        width="14"
                        height="14"
                        loading="lazy"
                        aria-hidden="true"
                      >
                      <span>SIZE GUIDE</span>
                    </button>
                  </span>
                {%- endif -%}
              {%- else -%}
                {{ product_option.name | escape -}}
                {%- if variant_style == 'swatch' -%}
                  <span class="variant-option__swatch-value">{{ product_option.selected_value }}</span>
                {%- endif %}
              {%- endif -%}
            </legend>
            {%- assign plus_size_render_started = false -%}
            {%- for product_option_value in product_option.values -%}
              {%- assign current_option_value_name = product_option_value.name | strip | downcase -%}
              {% if product_option_value.size > longest_value and option_id_attribute %}
                {% assign longest_value = product_option_value.size %}
              {% endif %}

              {%- if is_plus_size_collapsible -%}
                {%- if current_option_value_name == 'us18+' -%}
                  {%- assign plus_size_render_started = true -%}
                  <button
                    type="button"
                    class="variant-option__button-label variant-option__plus-size-toggle"
                    data-plus-size-toggle
                    aria-expanded="{% if plus_size_selected %}true{% else %}false{% endif %}"
                  >
                    <span data-plus-size-toggle-text>More Plus Size</span>
                  </button>
                {%- endif -%}
              {%- endif -%}

              {%- liquid
                assign is_custom_size_placeholder_value = false
                if is_size_option and current_option_value_name == 'custom sizes'
                  assign is_custom_size_placeholder_value = true
                elsif is_size_option and current_option_value_name == 'custom size'
                  assign is_custom_size_placeholder_value = true
                endif
              -%}
              <label
                class="variant-option__button-label{% if variant_style == 'swatch' %} variant-option__button-label--has-swatch{% endif %}{% if is_plus_size_collapsible and plus_size_render_started %} variant-option__button-label--plus-size{% endif %}{% if is_custom_size_placeholder_value %} variant-option__button-label--custom-size-placeholder{% endif %}"
              >
                <input
                  type="radio"
                  name="{{ product_option.name | escape }}-{{ block.id }}-{{ product_resource.id }}"
                  value="{{ product_option_value | escape }}"
                  aria-label="{{ product_option_value.name | escape }}{% if product_option_value.available == false %} - {{ 'products.product.sold_out' | t }}{% endif %}"
                  {% if product_option_value.available == false %}
                    aria-disabled="true"
                  {% endif %}
                  data-previous-checked="false"
                  data-fieldset-index="{{ fieldset_index }}"
                  data-input-index="{{ forloop.index0 }}"
                  data-input-id="{{ product_option.position }}-{{ forloop.index0 }}"
                  data-option-name="{{ product_option.name | escape }}"
                  data-option-value-id="{{ product_option_value.id }}"
                  data-option-available="{{ product_option_value.available }}"
                  data-connected-product-url="{{ product_option_value.product_url }}"
                  {% if is_custom_size_placeholder_value %}
                    data-mv-custom-size-placeholder="true"
                  {% endif %}
                  {% if product_option_value.variant.id %}
                    data-variant-id="{{ product_option_value.variant.id }}"
                  {% endif %}
                  {% if product_option_value.selected %}
                    data-current-checked="true"
                    checked
                  {% else %}
                    data-current-checked="false"
                  {% endif %}
                >
                {% if variant_style == 'swatch' %}
                  {% liquid
                    assign featured_media = product_option_value.variant.featured_media

                    # If the variant has no featured media, and we have a combined listing product, then fall back to
                    # using the featured media of the child product that is linked to this option value.
                    if featured_media == blank and product_option_value.product_url
                      assign featured_media = product_option_value.variant.product.featured_media
                    endif
                  %}

                  {% render 'swatch',
                    swatch: product_option_value.swatch,
                    variant_image: featured_media,
                    mode: 'unscaled',
                    label: product_option_value.name,
                    force_variant_image: is_color_option
                  %}
                {% else %}
                  {% if product_option_value.available == true %}
                    <span
                      class="variant-option__button-label__pill"
                      data-key="variant-option-pill"
                    ></span>
                  {% endif %}
                  <span
                    class="variant-option__button-label__text"
                    data-key="variant-option-text"
                  >
                    {{- product_option_value | escape -}}
                  </span>
                {% endif %}
                {% render 'strikethrough-variant', product_option: product_option_value %}
              </label>
            {%- endfor -%}
            {% if option_id_attribute %}
              {% style %}
                [data-option-id="{{ fieldset_id }}"] {
                  --variant-ch: {{ longest_value | times: 0.65 }}em;
                }
              {% endstyle %}
            {% endif %}
          </fieldset>
          {%- if is_size_matrix -%}
            <p class="mv-size-summary" data-mv-size-summary>
              <span class="mv-size-summary__label">Selected size</span>
              <span class="mv-size-summary__value" data-mv-size-value>{{ product_option.selected_value }}</span>
            </p>
          {%- endif -%}
          {%- assign fieldset_index = fieldset_index | plus: 1 -%}
        {%- elsif variant_style == 'dropdowns' -%}
          {%
            # There is an opportunity to build a custom select component that will allow us to style the select element further (animation for dropdown, swatches shown in the dropdown options, etc)
            # It's too bad as it mean rebuilding baked in behaviours but I think we've already done that for the locale selectors
            # in dawn. So it might mean more time spent in setting it up but worth it for future updates/styling.
          %}
          {% liquid
            assign property_being_updated = false
            if settings.variant_swatch_width != settings.variant_swatch_height
              assign property_being_updated = true
              # (original width / original height) x new height (20px at the moment) = new width
              assign new_width = settings.variant_swatch_width | times: 1.0 | divided_by: settings.variant_swatch_height | times: 20
            endif
          %}

          <div
            class="variant-option variant-option--dropdowns"
            {% if is_size_option %}
              id="mv-fit-panel-standard-{{ size_chart_uid }}"
              data-mv-standard-size-panel
            {% endif %}
          >
            {%- if is_size_option and show_size_chart and show_fit_tabs -%}
              {%- comment -%} Fit tabs already carry the row title + SIZE GUIDE. {%- endcomment -%}
              <label class="mv-visually-hidden" for="Option-{{ block.id }}-{{ forloop.index0 }}">{{ product_option.name | escape }}</label>
            {%- elsif is_size_option and show_size_chart -%}
              <div class="mv-size-dropdown-label-row">
                <label for="Option-{{ block.id }}-{{ forloop.index0 }}">{{ product_option.name | escape }}</label>
                <button
                  type="button"
                  class="mv-size-chart-trigger"
                  data-size-chart-trigger="{{ size_chart_uid }}"
                  aria-haspopup="dialog"
                  aria-controls="mv-size-chart-drawer-{{ size_chart_uid }}"
                >
                  <img
                      class="mv-size-chart-trigger-icon"
                      src="{{ 'size-chart-icon.svg' | asset_url }}"
                      alt=""
                      width="14"
                      height="14"
                      loading="lazy"
                      aria-hidden="true"
                    >
                  <span>SIZE GUIDE</span>
                </button>
              </div>
            {%- else -%}
              <label for="Option-{{ block.id }}-{{ forloop.index0 }}">{{ product_option.name | escape }}</label>
            {%- endif -%}
            <div
              class="variant-option__select-wrapper"
              style="
                {%- if property_being_updated  -%}
                  --variant-picker-swatch-width: clamp(10px,{{ new_width }}px, 50px);
                {%- endif -%}
              "
            >
              <select
                id="Option-{{ block.id }}-{{ forloop.index0 }}"
                name="options[{{ product_option.name | escape }}]"
                class="variant-option__select"
              >
                {%- for product_option_value in product_option.values -%}
                  {%- assign dropdown_option_value_name = product_option_value.name | strip | downcase -%}
                  <option
                    value="{{ product_option_value | escape }}"
                    data-input-id="{{ product_option.position }}-{{ forloop.index0 }}"
                    data-option-name="{{ product_option.name | escape }}"
                    data-option-value-id="{{ product_option_value.id }}"
                    data-variant-id="{{ product_option_value.variant.id }}"
                    data-connected-product-url="{{ product_option_value.product_url }}"
                    {% if is_size_option %}
                      {% if dropdown_option_value_name == 'custom sizes' or dropdown_option_value_name == 'custom size' %}
                        data-mv-custom-size-placeholder="true"
                        hidden
                      {% endif %}
                    {% endif %}
                    {% if product_option_value.selected %}
                      selected="selected"
                    {% endif %}
                  >
                    {% if product_option_value.available == false %}
                      {{ product_option_value | escape }} - {{ 'content.unavailable' | t }}
                    {% else %}
                      {{ product_option_value | escape }}
                    {% endif %}
                  </option>
                {%- endfor -%}
              </select>
              <svg
                aria-hidden="true"
                focusable="false"
                class="icon icon-caret icon-caret--line"
                viewBox="0 0 12 12"
                fill="none"
              >
                <path
                  d="M2.75 4.75 6 8l3.25-3.25"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}

      <script type="application/json">
        {{ product_resource.selected_or_first_available_variant | json }}
      </script>
      {%- if show_fit_tabs and product_has_size_option -%}
        {%- comment -%}
          Fit preference tabs + selected size summary.

          The tabs toggle a mode class on the product details wrapper, which is the
          closest common ancestor of this picker and the Custom Size block. CSS then
          decides what is visible, so no markup is moved around.
        {%- endcomment -%}
        <script>
          (function () {
            var picker = document.currentScript && document.currentScript.closest('variant-picker');
            if (!picker || picker.dataset.mvFitInit) return;
            picker.dataset.mvFitInit = '1';

            var scope = picker.closest('.product-details') || document;
            var errorLine = picker.querySelector('[data-mv-fit-error]');
            var summary = picker.querySelector('[data-mv-size-summary]');
            var productId = picker.dataset.productId || '';
            var currentMode = 'standard';

            function tabButtons() {
              return picker.querySelectorAll('[data-mv-fit-tab]');
            }

            function customBlock() {
              return scope.querySelector('.custom-sizes-block');
            }

            function hideError() {
              if (errorLine) errorLine.hidden = true;
            }

            function applyMode(mode, notify) {
              currentMode = mode;
              scope.classList.toggle('mv-fit-standard', mode === 'standard');
              scope.classList.toggle('mv-fit-custom', mode === 'custom');
              Array.prototype.forEach.call(tabButtons(), function (tab) {
                var active = tab.dataset.mvFitTab === mode;
                tab.classList.toggle('is-active', active);
                tab.setAttribute('aria-selected', active ? 'true' : 'false');
              });
              // The Custom Sizes block renders after this picker, so its
              // availability can change between parse time and DOM ready.
              var customTab = picker.querySelector('[data-mv-fit-tab="custom"]');
              if (customTab) customTab.hidden = !customBlock();
              hideError();
              if (notify !== false) {
                document.dispatchEvent(new CustomEvent('mv:fit-mode', {
                  detail: { mode: mode, productId: productId }
                }));
              }
            }

            // Delegated listener: the theme re-renders the picker markup on
            // variant changes, which would drop listeners bound to the buttons.
            picker.addEventListener('click', function (event) {
              var tab = event.target && event.target.closest ? event.target.closest('[data-mv-fit-tab]') : null;
              if (!tab || !picker.contains(tab)) return;
              if (tab.dataset.mvFitTab === 'custom' && !customBlock()) return;
              applyMode(tab.dataset.mvFitTab, true);
            });

            // Keep the "Selected size" line in sync with the current selection,
            // regardless of whether Size renders as a matrix, buttons or a select.
            function syncSummary() {
              if (!summary) return;
              var value = picker.querySelector('[data-mv-size-value]');
              var panel = picker.querySelector('[data-mv-standard-size-panel]');
              if (!value || !panel) return;
              var checked = panel.querySelector('input[type="radio"]:checked');
              var select = panel.querySelector('select');
              var next = checked ? checked.value : (select ? select.value : '');
              if (next) value.textContent = next;
            }

            picker.addEventListener('change', syncSummary);
            document.addEventListener('shopify:product:select', function (event) {
              if (event.target !== picker) return;
              if (event.promise && typeof event.promise.then === 'function') {
                event.promise.then(syncSummary).catch(function () {});
              } else {
                syncSummary();
              }
            });

            // Re-apply the mode after the theme re-renders the picker markup.
            if (typeof MutationObserver === 'function') {
              var queued = false;
              new MutationObserver(function () {
                if (queued) return;
                queued = true;
                requestAnimationFrame(function () {
                  queued = false;
                  applyMode(currentMode, false);
                });
              }).observe(picker, { childList: true, subtree: true });
            }

            // The Custom Sizes block is parsed after this picker, so the first
            // applyMode runs before it exists. Re-apply once the DOM is ready
            // so the Custom Fit tab visibility reflects the final markup.
            function start() {
              applyMode(currentMode, false);
              syncSummary();
            }
            if (document.readyState === 'loading') {
              document.addEventListener('DOMContentLoaded', start, { once: true });
            } else {
              start();
            }
            applyMode('standard', false);
          })();
        </script>
      {%- endif -%}
    </form>
  </variant-picker>
{% endunless %}

{%- if show_size_chart -%}
  <div class="mv-size-chart-overlay" id="mv-size-chart-overlay-{{ size_chart_uid }}" aria-hidden="true"></div>
  <aside
    class="mv-size-chart-drawer"
    id="mv-size-chart-drawer-{{ size_chart_uid }}"
    data-size-chart-drawer="{{ size_chart_uid }}"
    role="dialog"
    aria-modal="true"
    aria-labelledby="mv-size-chart-title-{{ size_chart_uid }}"
    aria-hidden="true"
  >
    <div class="mv-size-chart-drag" aria-hidden="true"></div>
    <header class="mv-size-chart-header">
      <div>
        <h2 id="mv-size-chart-title-{{ size_chart_uid }}">SIZE GUIDE</h2>
        <p>Find your best fit and learn how to measure.</p>
      </div>
      <div class="mv-size-chart-header-actions">
        <div class="mv-size-chart-unit" data-sc-unit="cm" role="group" aria-label="Measurement unit">
          <span class="mv-size-chart-unit-slider" aria-hidden="true"></span>
          <button type="button" data-unit="cm" class="active" aria-pressed="true">CM</button>
          <button type="button" data-unit="in" aria-pressed="false">IN</button>
        </div>
        <button type="button" class="mv-size-chart-close" data-size-chart-close aria-label="Close size guide">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M5 5 19 19M19 5 5 19"/></svg>
        </button>
      </div>
    </header>

    <div class="mv-size-chart-tabs" data-sc-tab="chart">
      <span class="mv-size-chart-tab-slider" aria-hidden="true"></span>
      <button type="button" class="active" data-size-chart-tab="chart">Size Chart</button>
      <button type="button" data-size-chart-tab="measure">How to Measure</button>
    </div>

    <div class="mv-size-chart-body">
      <section class="mv-size-chart-panel active" data-size-chart-panel="chart">
        <div class="size-chart-section">
          <div class="size-chart-heading-row">
            <h2 class="size-chart-title">Adult Sizes</h2>
            <div class="size-chart-unit-copy">All measurements in <span data-size-chart-unit-copy>CM</span></div>
          </div>
          <div class="size-chart-scroll">
            <table class="size-chart">
              <thead><tr><th>Size</th><th>Bust</th><th>Waist</th><th>Hips</th><th>Hollow to Hem</th></tr></thead>
              <tbody>
              {%- render 'size-chart-rows' -%}
              </tbody>
            </table>
          </div>
        </div>
      </section>

      <section class="mv-size-chart-panel" data-size-chart-panel="measure">
        <div class="mv-size-chart-htm">
          <div class="mv-size-chart-image-wrap">
            <img src="{{ 'size-chart-how-to-measure.png' | asset_url }}" alt="How to measure" width="852" height="1394" loading="lazy">
            <div class="mv-size-chart-hotspot" style="left:calc(23% - 11px);top:calc(25% - 11px);" data-sc-hotspot="1"><span>1</span></div>
            <div class="mv-size-chart-hotspot" style="left:calc(23% - 11px);top:calc(33% - 11px);" data-sc-hotspot="2"><span>2</span></div>
            <div class="mv-size-chart-hotspot" style="left:calc(23% - 11px);top:calc(44% - 11px);" data-sc-hotspot="3"><span>3</span></div>
            <div class="mv-size-chart-hotspot" style="left:calc(13% - 11px);top:calc(57% - 11px);" data-sc-hotspot="4"><span>4</span></div>
            <div class="mv-size-chart-hotspot" style="left:calc(84% - 11px);top:calc(50% - 11px);" data-sc-hotspot="5"><span>5</span></div>
          </div>
          <div class="mv-size-chart-accordions">
            <div class="mv-accordion-item" data-sc-step="1"><button type="button" class="mv-accordion-header"><span class="mv-accordion-number">1</span><strong>Bust</strong><svg class="mv-chevron" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2"><polyline points="4,6 8,10 12,6"/></svg></button><div class="mv-accordion-content"><div class="mv-accordion-text">Measure around the fullest part of your bust, keeping the tape level around your back.</div></div></div>
            <div class="mv-accordion-item" data-sc-step="2"><button type="button" class="mv-accordion-header"><span class="mv-accordion-number">2</span><strong>Waist</strong><svg class="mv-chevron" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2"><polyline points="4,6 8,10 12,6"/></svg></button><div class="mv-accordion-content"><div class="mv-accordion-text">Measure around the narrowest part of your natural waistline without pulling the tape tight.</div></div></div>
            <div class="mv-accordion-item" data-sc-step="3"><button type="button" class="mv-accordion-header"><span class="mv-accordion-number">3</span><strong>Hips</strong><svg class="mv-chevron" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2"><polyline points="4,6 8,10 12,6"/></svg></button><div class="mv-accordion-content"><div class="mv-accordion-text">Measure around the fullest part of your hips, keeping the tape parallel to the floor.</div></div></div>
            <div class="mv-accordion-item" data-sc-step="4"><button type="button" class="mv-accordion-header"><span class="mv-accordion-number">4</span><strong>Hollow to Floor</strong><svg class="mv-chevron" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2"><polyline points="4,6 8,10 12,6"/></svg></button><div class="mv-accordion-content"><div class="mv-accordion-text">Measure from the hollow where the collarbones meet at the front of the neck vertically down to the floor, barefoot.</div></div></div>
            <div class="mv-accordion-item" data-sc-step="5"><button type="button" class="mv-accordion-header"><span class="mv-accordion-number">5</span><strong>Height</strong><svg class="mv-chevron" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2"><polyline points="4,6 8,10 12,6"/></svg></button><div class="mv-accordion-content"><div class="mv-accordion-text">Stand straight and measure from the top of your head to the floor, barefoot.</div></div></div>
          </div>
          <div class="mv-size-chart-note">All measurements should be taken over underwear. For best results, have someone help you measure.</div>
        </div>
      </section>
    </div>
  </aside>
{%- endif -%}

{% render 'swatch-styles' %}
{% render 'variant-picker-styles' %}
{%- comment -%}
  Compact PDP variant buttons
  - Scoped to this main variant-picker block only
  - Does not alter native swatches
  - Keeps Horizon's variant selection / morph behavior unchanged
{%- endcomment -%}
{% if request.page_type == 'product' %}
  {% style %}
    /* PDP variant colors, radius and typography all inherit the theme's global
       settings (color-palette.liquid / theme-styles-variables.liquid). Only
       layout and PDP-specific affordances are customized below. */

    /* Technical placeholder used by the Custom Sizes block; never show as a normal Size button. */
    variant-picker[data-block-id='{{ block.id }}'][data-template-product-match='true']
      .variant-option__button-label--custom-size-placeholder {
      display: none !important;
    }

    /* Keep Color typography consistent even when the product has only one color.
       Group-title standard: body font / 12px / 700 / 0.06em / uppercase. */
    variant-picker[data-block-id='{{ block.id }}'][data-template-product-match='true']
      .variant-option[data-mv-option-kind='color'] > legend {
    margin-block-end: 8px;
    line-height: 1.25;
    font-family: var(--font-body--family);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--variant-option-label-color, var(--color-foreground));
    }

    /* ------------------------------------------------------------------
       Fit preference tabs (Standard Size / Custom Fit)
       ------------------------------------------------------------------ */
    .mv-fit-tabs {
      display: flex;
      align-items: stretch;
      gap: 28px;
      width: 100%;
      /* Internal rhythm is 8px. No top margin on the first child — a margin
         there would collapse out of the block and stack onto the section's
         layout gap (12px). */
      margin-block: 0 8px;
      border-block-end: 1px solid rgb(var(--color-foreground-rgb) / 10%);
    }

    .mv-fit-tabs:not(:first-child) {
      margin-block-start: 8px;
    }

    .mv-fit-tab {
      appearance: none;
      border: 0;
      background: transparent;
      padding: 0 0 12px;
      margin: 0;
      position: relative;
      display: inline-flex;
      align-items: center;
      min-height: 24px;
      font-family: var(--font-body--family);
      font-size: 10px;
      font-weight: 500;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      line-height: 1;
      color: var(--color-foreground-muted, rgb(var(--color-foreground-rgb) / 0.55));
      cursor: pointer;
      transition: color 0.18s ease;
    }

    .mv-fit-tab::after {
      content: '';
      position: absolute;
      inset-inline: 0;
      inset-block-end: -1px;
      height: 1px;
      background: var(--color-foreground);
      transform: scaleX(0);
      transform-origin: center;
      transition: transform 0.22s cubic-bezier(0.22, 0.72, 0.24, 1);
    }

    .mv-fit-tab:hover,
    .mv-fit-tab.is-active {
      color: var(--color-foreground);
    }

    .mv-fit-tab.is-active::after {
      transform: scaleX(1);
    }

    .mv-fit-tab:focus-visible {
      outline: 1.5px solid var(--color-foreground);
      outline-offset: 3px;
    }

    .mv-fit-error {
      display: block;
      margin: 8px 0 0;
      font-family: var(--font-body--family);
      font-size: var(--font-size--2xs, 12px);
      line-height: 1.4;
      color: var(--color-error, #B4465E);
    }

    /* ------------------------------------------------------------------
       Size matrix — every size visible at once
       ------------------------------------------------------------------ */
    variant-picker[data-block-id='{{ block.id }}'][data-template-product-match='true']
      .variant-option--matrix {
      display: grid;
      /* Auto-fit instead of a fixed column count: the matrix adapts to the
         available width, so no breakpoint-specific overrides are needed. */
      grid-template-columns: repeat(auto-fit, minmax(min(64px, 100%), 1fr));
      gap: 8px;
      width: 100%;
      margin: 0;
      padding: 0;
      border: none;
    }

    variant-picker[data-block-id='{{ block.id }}'][data-template-product-match='true']
      .variant-option--matrix > legend {
      grid-column: 1 / -1;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      width: 100%;
      margin-block-end: 8px;
      padding: 0;
    }

    variant-picker[data-block-id='{{ block.id }}'][data-template-product-match='true']
      .variant-option--matrix
      .variant-option__button-label {
      /* Reset the theme defaults so the size digits always stay visible.
         `overflow: clip` is kept on purpose: the theme hides its selection
         pill by translating it out of the label. */
      flex: 0 0 auto;
      display: flex;
      align-items: center;
      justify-content: center;
      width: 100%;
      min-width: 0;
      min-height: var(--minimum-touch-target, 44px);
      margin: 0;
      padding: 0 6px;
      border: var(--variant-picker-button-border-width, 1px) solid var(--color-variant-border, rgb(var(--color-foreground-rgb) / 15%));
      border-radius: var(--color-group-card-radius, var(--variant-picker-button-radius, 0px));
      background: var(--color-variant-background, transparent);
      color: var(--color-variant-text, currentColor);
      font-family: var(--font-paragraph--family, var(--font-body--family));
      font-size: var(--font-paragraph--size, 14px);
      font-weight: 500;
      letter-spacing: 0.02em;
      line-height: 1.2;
      white-space: nowrap;
      cursor: pointer;
      box-sizing: border-box;
      transition:
        border-color 0.16s ease,
        background-color 0.16s ease,
        color 0.16s ease;
    }

    variant-picker[data-block-id='{{ block.id }}'][data-template-product-match='true']
      .variant-option--matrix
      .variant-option__button-label:hover {
      border-color: var(--color-variant-hover-border, var(--color-foreground-muted));
      background: var(--color-variant-hover-background, rgb(var(--color-foreground-rgb) / 3%));
      color: var(--color-variant-hover-text, var(--color-foreground));
    }

    variant-picker[data-block-id='{{ block.id }}'][data-template-product-match='true']
      .variant-option--matrix
      .variant-option__button-label:has(:checked),
    variant-picker[data-block-id='{{ block.id }}'][data-template-product-match='true']
      .variant-option--matrix
      .variant-option__button-label:has(:checked):hover {
      border-color: var(--color-selected-variant-border, var(--color-foreground));
      background: var(--color-selected-variant-background, var(--color-foreground));
      color: var(--color-selected-variant-text, var(--color-background));
    }

    variant-picker[data-block-id='{{ block.id }}'][data-template-product-match='true']
      .variant-option--matrix
      .variant-option__button-label:has([data-option-available='false']) {
      border-style: dashed;
      color: var(--color-foreground-muted, rgb(var(--color-foreground-rgb) / 0.55));
    }

    variant-picker[data-block-id='{{ block.id }}'][data-template-product-match='true']
      .variant-option--matrix
      .variant-option__button-label:has(:focus-visible) {
      outline: 1.5px solid var(--color-foreground);
      outline-offset: 3px;
    }

    /* The native radio stays in the DOM (variant resolution depends on it). */
    variant-picker[data-block-id='{{ block.id }}'][data-template-product-match='true']
      .variant-option--matrix
      .variant-option__button-label
      input {
      position: absolute;
      width: 1px;
      height: 1px;
      margin: -1px;
      padding: 0;
      border: 0;
      opacity: 0;
      pointer-events: none;
      clip-path: inset(50%);
    }

    variant-picker[data-block-id='{{ block.id }}'][data-template-product-match='true']
      .variant-option--matrix
      .variant-option__button-label__text {
      position: static;
      inset: auto;
      width: auto;
      height: auto;
      max-width: 100%;
      overflow: hidden;
      text-overflow: ellipsis;
      pointer-events: none;
    }

    /* Selected size summary */
    .mv-size-summary {
      display: flex;
      align-items: baseline;
      gap: 6px;
      margin: 8px 0 0;
      font-family: var(--font-body--family);
      font-size: 10px;
      font-weight: 500;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      line-height: 1;
      color: var(--color-foreground-muted, rgb(var(--color-foreground-rgb) / 0.55));
    }

    .mv-size-summary__value {
      font-weight: 600;
      color: var(--color-foreground);
    }

    /* ------------------------------------------------------------------
       Custom Fit mode: the whole standard Size control (matrix, buttons,
       dropdown or single value) and its summary step aside, so the custom
       measurement panel is the only content under the tabs.
       ------------------------------------------------------------------ */
    .mv-fit-custom
      variant-picker[data-template-product-match='true']
      [data-mv-standard-size-panel] {
      display: none;
    }

    .mv-fit-custom .mv-size-summary.mv-size-summary {
      display: none;
    }

    /* Dropdown option labels (e.g. Size) share the same typography as the
       Color legend so both option titles look identical. */
    variant-picker[data-block-id='{{ block.id }}'][data-template-product-match='true']
      .variant-option--dropdowns
      > label,
    variant-picker[data-block-id='{{ block.id }}'][data-template-product-match='true']
      .variant-option--dropdowns
      .mv-size-dropdown-label-row
      > label {
    margin-block-end: 8px;
    line-height: 1.25;
    font-family: var(--font-body--family);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--variant-option-label-color, var(--color-foreground));
    }

    /* ------------------------------------------------------------------
       Refined size dropdown: quieter border, generous hit area, a stroked
       chevron that flips while the control has focus. Colors and radius
       follow the theme's global input settings.
       ------------------------------------------------------------------ */
    variant-picker[data-block-id='{{ block.id }}'][data-template-product-match='true']
      .variant-option__select-wrapper {
      border-color: var(--color-input-border, currentColor);
      border-radius: var(--style-border-radius-inputs, 0px);
      background: var(--color-input-background, transparent);
      box-shadow: 0 1px 2px rgb(var(--color-foreground-rgb) / 0.04);
      transition:
        border-color .18s ease,
        background-color .18s ease,
        box-shadow .18s ease;
    }

    variant-picker[data-block-id='{{ block.id }}'][data-template-product-match='true']
      .variant-option__select-wrapper:hover {
      border-color: var(--color-foreground-muted, var(--color-input-border));
    }

    variant-picker[data-block-id='{{ block.id }}'][data-template-product-match='true']
      .variant-option__select-wrapper:has(.variant-option__select:focus) {
      border-color: var(--color-input-text, var(--color-foreground));
      box-shadow: 0 0 0 3px rgb(var(--color-foreground-rgb) / 0.06);
    }

    variant-picker[data-block-id='{{ block.id }}'][data-template-product-match='true']
      .variant-option__select {
      font-family: var(--font-paragraph--family, var(--font-body--family));
      font-size: var(--font-paragraph--size, 14px);
      font-weight: 500;
      letter-spacing: 0.02em;
      line-height: 1.2;
      color: var(--color-input-text, var(--color-foreground));
      padding-block: 15px;
      padding-inline: 16px 46px;
      background: transparent;
    }

    variant-picker[data-block-id='{{ block.id }}'][data-template-product-match='true']
      .variant-option__select option {
      font-family: var(--font-paragraph--family, var(--font-body--family));
      font-size: var(--font-paragraph--size, 14px);
      color: var(--color-input-text, var(--color-foreground));
      padding: 10px 12px;
    }

    variant-picker[data-block-id='{{ block.id }}'][data-template-product-match='true']
      .variant-option__select-wrapper .icon-caret {
      width: 12px;
      height: 12px;
      inset-inline-end: 16px;
      color: var(--color-input-text, var(--color-foreground));
      opacity: 0.72;
      transition:
        transform .22s cubic-bezier(.22, .72, .24, 1),
        opacity .18s ease;
    }

    variant-picker[data-block-id='{{ block.id }}'][data-template-product-match='true']
      .variant-option__select-wrapper:hover .icon-caret {
      opacity: 1;
    }

    variant-picker[data-block-id='{{ block.id }}'][data-template-product-match='true']
      .variant-option__select-wrapper:has(.variant-option__select:focus) .icon-caret {
      opacity: 1;
      transform: translateY(-50%) rotate(180deg);
    }

    variant-picker[data-block-id='{{ block.id }}'][data-template-product-match='true']
      .variant-option--buttons:not(.variant-option--swatches):not(.variant-option--matrix)
      legend {
      margin-block-end: 8px;
      line-height: 1.25;
      font-family: var(--font-body--family);
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--variant-option-label-color, var(--color-foreground));
    }

    variant-picker[data-block-id='{{ block.id }}'][data-template-product-match='true']
      .variant-option + .variant-option {
      margin-top: 8px;
    }

    /* Progressive enhancement: without JS, all sizes remain accessible and the toggle stays hidden. */
    variant-picker[data-block-id='{{ block.id }}'][data-template-product-match='true']
      .variant-option--plus-size-collapsible
      .variant-option__plus-size-toggle {
      display: none;
      order: 999;
      width: 100%;
      min-width: 0;
      max-width: none;
      min-height: 44px;
      padding-block: 7px;
      padding-inline: 6px;
      box-sizing: border-box;
      font: inherit;
      line-height: 1.2;
      cursor: pointer;
      appearance: none;
      -webkit-appearance: none;
    }

    variant-picker[data-block-id='{{ block.id }}'][data-template-product-match='true']
      .variant-option--plus-size-collapsible[data-plus-size-ready='true']
      .variant-option__plus-size-toggle {
      display: flex;
      align-items: center;
      justify-content: center;
    }

    variant-picker[data-block-id='{{ block.id }}'][data-template-product-match='true']
      .variant-option--plus-size-collapsible[data-plus-size-ready='true'][data-plus-size-expanded='false']
      > .variant-option__button-label--plus-size {
      display: none !important;
    }

    /* Utility control reads as a pill button: transparent base + 15% edge,
       hover = 3% ink tint. No transform jumps. */
    variant-picker[data-block-id='{{ block.id }}'][data-template-product-match='true']
      .variant-option__plus-size-toggle {
      background: transparent;
      color: var(--color-foreground);
      border: 1px solid rgb(var(--color-foreground-rgb) / 15%);
      border-radius: var(--color-group-card-radius, var(--variant-picker-button-radius, 0px));
      font-weight: 500;
      white-space: nowrap;
      transition: background 0.16s ease, border-color 0.16s ease;
    }

    @media (hover: hover) {
      variant-picker[data-block-id='{{ block.id }}'][data-template-product-match='true']
        .variant-option__plus-size-toggle:hover {
        background: rgb(var(--color-foreground-rgb) / 3%);
      }
    }

    variant-picker[data-block-id='{{ block.id }}'][data-template-product-match='true']
      .variant-option__plus-size-toggle:focus-visible {
      outline: 1.5px solid var(--color-foreground);
      outline-offset: 3px;
    }

    @media screen and (max-width: 749px) {
      variant-picker[data-block-id='{{ block.id }}'][data-template-product-match='true']
        .variant-option--plus-size-collapsible
        .variant-option__plus-size-toggle {
        min-height: 42px;
        padding-block: 6px;
        padding-inline: 4px;
        font-size: 0.92em;
      }
    }


    /* Size Chart trigger beside the Size option title. */
    .mv-size-legend-row,
    .mv-size-dropdown-label-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      width: 100%;
    }
    /* When fit tabs are on, the visible "Size" title is redundant (the tabs
       row already reads "Standard Size / Custom Fit — SIZE GUIDE"). The
       legend stays for a11y but is taken out of the visual flow. Scoped to
       the same prefix as the legend rules so the override outranks them. */
    variant-picker[data-block-id='{{ block.id }}'][data-template-product-match='true']
      .variant-option--buttons
      legend.mv-size-legend--hidden {
      position: absolute;
      width: 1px;
      height: 1px;
      margin: 0;
      padding: 0;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
