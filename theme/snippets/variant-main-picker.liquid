    }
    .size-chart td:first-child {
      z-index:2;
      background:rgb(var(--color-foreground-rgb) / 0.02);
    }
    /* Top-left cell must sit above both sticky axes. */
    .size-chart th:first-child {
      z-index:5;
      background:var(--sc-stone);
    }
    .size-chart th:not(:first-child),
    .size-chart td:not(:first-child) { min-width:82px; }
    .size-chart th:last-child,
    .size-chart td:last-child { min-width:108px; }
    .mv-size-chart-htm { padding:20px 22px 28px; display:flex; flex-direction:column; gap:16px; }
    .mv-size-chart-image-wrap { position:relative; width:min(100%,300px); margin:0 auto; border:1px solid var(--sc-border); overflow:hidden; background:var(--color-background); }
    .mv-size-chart-image-wrap img { width:100%; height:auto; display:block; }
    .mv-size-chart-accordions { display:flex; flex-direction:column; gap:8px; }
    .mv-size-chart-accordions .mv-accordion-header { width:100%; border:0; font:inherit; text-align:left; }
    .mv-size-chart-accordions .mv-accordion-header strong { flex:1; font-size:11px; }
    /* Scope the accordion arrow so global theme SVG rules cannot blow it up. */
    .mv-size-chart-accordions .mv-chevron {
      width:16px !important;
      height:16px !important;
      min-width:16px !important;
      max-width:16px !important;
      min-height:16px !important;
      max-height:16px !important;
      flex:0 0 16px !important;
      display:block !important;
      overflow:visible;
      margin-left:auto;
      transform-origin:50% 50%;
    }
    .mv-size-chart-accordions .mv-chevron polyline {
      vector-effect:non-scaling-stroke;
    }
    .mv-size-chart-note { padding:10px 12px; border-left:3px solid var(--color-foreground); background:rgb(var(--color-foreground-rgb) / 0.04); color:var(--sc-muted); font-size:10.5px; line-height:1.55; }
    @media screen and (max-width:749px) {
      .mv-size-chart-header { padding:16px 18px 14px; }
      .mv-size-chart-tabs { margin:12px 18px 0; }
      .size-chart-section, .mv-size-chart-htm { padding:16px 18px 22px; }
      .size-chart-scroll { max-height:calc(88vh - 250px); }
      .size-chart { min-width:450px; }
      .size-chart th, .size-chart td { padding-inline:6px; }
      .size-chart th:not(:first-child), .size-chart td:not(:first-child) { min-width:76px; }
      .size-chart th:last-child, .size-chart td:last-child { min-width:102px; }
      .mv-size-chart-image-wrap { width:min(100%,280px); }
      .mv-size-chart-unit { width:92px; }
      .mv-size-chart-unit-slider { width:40px; }
      .mv-size-chart-unit[data-sc-unit='in'] .mv-size-chart-unit-slider { transform:translateX(42px); }
      .mv-size-chart-header p { display:none; }
    }

