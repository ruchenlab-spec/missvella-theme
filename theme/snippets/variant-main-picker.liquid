        </div>
      </section>
    </div>
  </aside>
{%- endif -%}

{% render 'swatch-styles' %}
{% render 'variant-picker-styles' %}
{% render 'mv-swatch-button-styles' %}
{%- comment -%}
  Compact PDP variant buttons
  - Scoped to this main variant-picker block only
  - Does not alter native swatches
  - Keeps Horizon's variant selection / morph behavior unchanged
{%- endcomment -%}
{% if request.page_type == 'product' %}
  {% style %}
    /* NOTE: these rules are keyed on the block instance id ONLY — never on
       [data-template-product-match]. That attribute is absent in the theme
       editor's visual preview (which renders a fallback product), and the
       merchant reviews styling there; gating on it makes every rule vanish
       in the editor while the live storefront looks correct. */

    /* Technical placeholder used by the Custom Sizes block; never show as a normal Size button. */
    variant-picker[data-block-id='{{ block.id }}']
      .variant-option__button-label--custom-size-placeholder {
      display: none !important;
    }

    /* Option legend = quiet functional label (spec: 9-11px / 500 / tracked
       uppercase, muted). flex-basis 100% keeps it on its own line above the
       swatch row. The selected color name rides the same line, right after
       the "COLOR" word ("COLOR IVORY") — not beside the swatch. */
    variant-picker[data-block-id='{{ block.id }}']
      .variant-option[data-mv-option-kind='color'] > legend {
    flex-basis: 100%;
    margin-block-end: 8px;
    line-height: 1.25;
    font-family: var(--font-body--family);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-foreground-muted, rgb(var(--color-foreground-rgb) / 0.55));
    }

    variant-picker[data-block-id='{{ block.id }}']
      .variant-option[data-mv-option-kind='color'] .mv-color-legend-row {
    display: inline-flex;
    align-items: baseline;
    gap: 8px;
    }

    /* Selected color name inside the legend: regular weight, full foreground,
       so it reads as the current value next to the muted label. */
    variant-picker[data-block-id='{{ block.id }}']
      .variant-option[data-mv-option-kind='color'] .mv-color-legend-value {
    font-size: 12px;
    font-weight: 400;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--variant-option-label-color, var(--color-foreground));
    }

    /* Square color swatch + selection ring geometry lives in the shared
       `mv-swatch-button-styles` snippet (single source of truth, also used by
       the cross-product color group swatches). */

    /* ------------------------------------------------------------------
       Fit preference tabs (Standard Size / Custom Fit)
       ------------------------------------------------------------------ */
    /* ------------------------------------------------------------------
       Fit preference tabs — brand demo style B.
       One hairline rectangle with a 3px inner inset, so the frame reads as a
       quiet ring around the two cells; the cells touch (no divider), the
       selected cell wears the warm grey tint. No pills, no heavy fills, no
       underlines, no shadows.
       ------------------------------------------------------------------ */
    .mv-fit-tabs {
      /* Brand values from the demo style study. */
      --mv-fit-line: #d8d3ca;
      --mv-fit-active-bg: #efede7;
      --mv-fit-inset: 3px;

      display: block;
      width: 100%;
      /* Internal rhythm is 8px. No top margin on the first child — a margin
         there would collapse out of the block and stack onto the section's
         layout gap (12px). */
      margin-block: 0 8px;
    }

    /* The Color row and the Size selector (tabs + panel) are sibling units, so
       the gap between them follows the merchant's layout gap (--gap, rendered
       by the surrounding group block) instead of the 8px internal rhythm.
       Keyed on the Color control itself (native fieldset or color group) so
       the zero-height, absolutely positioned native-color holder used by the
       Custom Color picker never pushes the tabs down. */
    .variant-option[data-mv-option-kind='color'] + .mv-fit-tabs {
      margin-block-start: var(--gap, 8px);
    }

    .mv-fit-tabs__segments {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0;
      padding: var(--mv-fit-inset);
      border: 1px solid var(--mv-fit-line);
    }

    /* The custom editor continues this frame across the sibling block. */
    .mv-fit-custom .mv-fit-tabs {
      margin-block-end: 0;
    }

    .mv-fit-tab {
      appearance: none;
      min-width: 0;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      min-height: 34px;
      margin: 0;
      padding: 0 8px;
      border: 0;
      background: transparent;
      font-family: var(--font-body--family);
      /* Demo style-B label: 10px / 500 / 0.09em uppercase. The active cell is
         told apart by the warm tint and full foreground color, not weight —
         never by an underline. */
      font-size: 10px;
      font-weight: 500;
      letter-spacing: 0.09em;
      text-transform: uppercase;
      line-height: 1;
      text-decoration: none;
      color: var(--color-foreground-muted, rgb(var(--color-foreground-rgb) / 0.55));
      white-space: nowrap;
      cursor: pointer;
      transition: background-color 0.2s ease, color 0.2s ease;
    }

    .mv-fit-tab__icon {
      width: 16px;
      height: 16px;
      flex: 0 0 16px;
      fill: currentColor;
      stroke: none;
    }

    @media (hover: hover) {
      .mv-fit-tab:hover {
        color: var(--color-foreground);
      }
    }

    /* Selected = warm grey tint only. No heavier border, no fill swap. */
    .mv-fit-tab.is-active {
      background: var(--mv-fit-active-bg);
      color: var(--color-foreground);
    }

    .mv-fit-tab:focus-visible {
      outline: 1.5px solid var(--color-foreground);
      outline-offset: 3px;
    }

    .mv-fit-error {
      display: block;
      margin: 8px 0 0;
      font-family: var(--font-body--family);
      font-size: var(--font-size--2xs, 12px);
      line-height: 1.4;
      color: var(--color-error, #B4465E);
    }

    /* ------------------------------------------------------------------
       Size matrix — every size visible at once. Column counts and radius come
       from the block settings via --size-columns-desktop/-mobile and
       --size-card-radius (rendered on the fieldset).
       ------------------------------------------------------------------ */
    variant-picker[data-block-id='{{ block.id }}']
      .variant-option--matrix {
      display: grid;
      grid-template-columns: repeat(var(--size-columns-desktop, 6), minmax(0, 1fr));
      gap: 8px;
      width: 100%;
      margin: 0;
      padding: 0;
      border: none;
    }

    @media screen and (max-width: 749px) {
      variant-picker[data-block-id='{{ block.id }}']
        .variant-option--matrix {
        grid-template-columns: repeat(var(--size-columns-mobile, 4), minmax(0, 1fr));
      }
    }

    variant-picker[data-block-id='{{ block.id }}']
      .variant-option--matrix > legend {
      grid-column: 1 / -1;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      width: 100%;
      margin-block-end: 8px;
      padding: 0;
    }

    variant-picker[data-block-id='{{ block.id }}']
      .variant-option--matrix
      .variant-option__button-label {
      /* Reset the theme defaults so the size digits always stay visible.
         `overflow: clip` is kept on purpose: the theme hides its selection
         pill by translating it out of the label. */
      flex: 0 0 auto;
      display: flex;
      align-items: center;
      justify-content: center;
      width: 100%;
      min-width: 0;
      min-height: 40px;
      margin: 0;
      padding: 0 4px;
      border: var(--variant-picker-button-border-width, 1px) solid var(--color-variant-border, rgb(var(--color-foreground-rgb) / 15%));
      border-radius: var(--size-card-radius, var(--variant-picker-button-radius, 0px));
      background: var(--color-variant-background, transparent);
      color: var(--color-variant-text, currentColor);
      /* Size digits wear the heading (serif) voice, matching the product
         title; paragraph/body families stay as the fallback. */
      font-family: var(--font-heading--family, var(--font-paragraph--family, var(--font-body--family)));
      font-size: var(--font-paragraph--size, 14px);
      font-weight: 500;
      letter-spacing: 0.02em;
      line-height: 1.2;
      white-space: nowrap;
      cursor: pointer;
      box-sizing: border-box;
      transition:
        border-color 0.16s ease,
        background-color 0.16s ease,
        color 0.16s ease;
    }

    variant-picker[data-block-id='{{ block.id }}']
      .variant-option--matrix
      .variant-option__button-label:hover {
      border-color: var(--color-variant-hover-border, var(--color-foreground-muted));
      background: var(--color-variant-hover-background, rgb(var(--color-foreground-rgb) / 3%));
      color: var(--color-variant-hover-text, var(--color-foreground));
    }

    variant-picker[data-block-id='{{ block.id }}']
      .variant-option--matrix
      .variant-option__button-label:has(:checked),
    variant-picker[data-block-id='{{ block.id }}']
      .variant-option--matrix
      .variant-option__button-label:has(:checked):hover {
      border-color: var(--color-selected-variant-border, var(--color-foreground));
      background: var(--color-selected-variant-background, var(--color-foreground));
      color: var(--color-selected-variant-text, var(--color-background));
    }

    variant-picker[data-block-id='{{ block.id }}']
      .variant-option--matrix
      .variant-option__button-label:has([data-option-available='false']) {
      border-style: dashed;
      color: var(--color-foreground-muted, rgb(var(--color-foreground-rgb) / 0.55));
    }

    variant-picker[data-block-id='{{ block.id }}']
      .variant-option--matrix
      .variant-option__button-label:has(:focus-visible) {
      outline: 1.5px solid var(--color-foreground);
      outline-offset: 3px;
    }

    /* The native radio stays in the DOM (variant resolution depends on it). */
    variant-picker[data-block-id='{{ block.id }}']
      .variant-option--matrix
      .variant-option__button-label
      input {
      position: absolute;
      width: 1px;
      height: 1px;
      margin: -1px;
      padding: 0;
      border: 0;
      opacity: 0;
      pointer-events: none;
      clip-path: inset(50%);
    }

    variant-picker[data-block-id='{{ block.id }}']
      .variant-option--matrix
      .variant-option__button-label__text {
      position: static;
      inset: auto;
      width: auto;
      height: auto;
      max-width: 100%;
      overflow: hidden;
      text-overflow: ellipsis;
      pointer-events: none;
    }

    /* Selected size summary */
    .mv-size-summary {
      display: flex;
      align-items: baseline;
      gap: 6px;
      margin: 0;
      font-family: var(--font-body--family);
      font-size: 10px;
      font-weight: 500;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      line-height: 1;
      color: var(--color-foreground-muted, rgb(var(--color-foreground-rgb) / 0.55));
    }

    .mv-size-summary__value {
      font-weight: 600;
      color: var(--color-foreground);
    }

    /* ------------------------------------------------------------------
       Custom Fit mode: the whole standard Size control (matrix, buttons or
       single value) and its summary step aside, so the custom measurement
       panel is the only content under the tabs.
       ------------------------------------------------------------------ */
    .mv-fit-custom
      variant-picker[data-block-id='{{ block.id }}']
      [data-mv-standard-size-panel] {
      display: none;
    }

    .mv-fit-custom .mv-size-summary.mv-size-summary {
      display: none;
    }

    variant-picker[data-block-id='{{ block.id }}']
      .variant-option--buttons:not(.variant-option--swatches):not(.variant-option--matrix)
      legend {
      margin-block-end: 8px;
      line-height: 1.25;
      font-family: var(--font-body--family);
      font-size: 11px;
      font-weight: 500;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--color-foreground-muted, rgb(var(--color-foreground-rgb) / 0.55));
    }

    variant-picker[data-block-id='{{ block.id }}']
      .variant-option + .variant-option {
      margin-top: 8px;
    }

    /* Progressive enhancement: without JS, all sizes remain accessible and the toggle stays hidden. */
    variant-picker[data-block-id='{{ block.id }}']
      .variant-option--plus-size-collapsible
      .variant-option__plus-size-toggle {
      display: none;
      order: 999;
      width: 100%;
      min-width: 0;
      max-width: none;
      min-height: 44px;
      padding-block: 7px;
      padding-inline: 6px;
      box-sizing: border-box;
      font: inherit;
      line-height: 1.2;
      cursor: pointer;
      appearance: none;
      -webkit-appearance: none;
    }

    variant-picker[data-block-id='{{ block.id }}']
      .variant-option--plus-size-collapsible[data-plus-size-ready='true']
      .variant-option__plus-size-toggle {
      display: flex;
      align-items: center;
      justify-content: center;
    }

    variant-picker[data-block-id='{{ block.id }}']
      .variant-option--plus-size-collapsible[data-plus-size-ready='true'][data-plus-size-expanded='false']
      > .variant-option__button-label--plus-size {
      display: none !important;
    }

    /* Utility control reads as a pill button: transparent base + 15% edge,
       hover = 3% ink tint. No transform jumps. */
    variant-picker[data-block-id='{{ block.id }}']
      .variant-option__plus-size-toggle {
      background: transparent;
      color: var(--color-foreground);
      border: 1px solid rgb(var(--color-foreground-rgb) / 15%);
      border-radius: var(--size-card-radius, var(--variant-picker-button-radius, 0px));
      font-weight: 500;
      white-space: nowrap;
      transition: background 0.16s ease, border-color 0.16s ease;
    }

    @media (hover: hover) {
      variant-picker[data-block-id='{{ block.id }}']
        .variant-option__plus-size-toggle:hover {
        background: rgb(var(--color-foreground-rgb) / 3%);
      }
    }

    variant-picker[data-block-id='{{ block.id }}']
      .variant-option__plus-size-toggle:focus-visible {
      outline: 1.5px solid var(--color-foreground);
      outline-offset: 3px;
    }

    @media screen and (max-width: 749px) {
      variant-picker[data-block-id='{{ block.id }}']
        .variant-option--plus-size-collapsible
        .variant-option__plus-size-toggle {
        min-height: 42px;
        padding-block: 6px;
        padding-inline: 4px;
        font-size: 0.92em;
      }
    }


    /* Size Chart trigger beside the Size option title. */
    .mv-size-legend-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      width: 100%;
    }
    .mv-visually-hidden {
      position: absolute;
      width: 1px;
      height: 1px;
      margin: 0;
      padding: 0;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
    /* SIZE GUIDE lives in the Size legend row below the tabs as a quiet
       underlined text link (brand demo spec). */
    .mv-size-chart-trigger {
      appearance: none;
      border: 0;
      background: transparent;
      color: var(--color-foreground);
      padding: 2px 0;
      display: inline-flex;
      align-items: center;
      gap: 5px;
      font: inherit;
      font-size: 10px;
      font-weight: 500;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      line-height: 1;
      white-space: nowrap;
      cursor: pointer;
      border-bottom: 1px solid rgb(var(--color-foreground-rgb) / 70%);
    }
    .mv-size-chart-trigger-arrow { margin-inline-start: 2px; }
    @media (hover:hover) { .mv-size-chart-trigger:hover { border-color:var(--color-foreground); } }
    .mv-size-chart-trigger:focus-visible { outline:1.5px solid var(--color-foreground); outline-offset:3px; }

    .mv-size-chart-overlay {
      display:none; position:fixed; inset:0; z-index:2147483644; background:rgb(var(--color-foreground-rgb) / .3);
    }
    .mv-size-chart-overlay.open { display:block; }
    .mv-size-chart-drawer {
      --sc-border: rgb(var(--color-foreground-rgb) / 10%);
      --sc-stone: rgb(var(--color-foreground-rgb) / 4%);
      --sc-muted: var(--color-foreground-muted, rgb(var(--color-foreground-rgb) / 0.55));
      position:fixed; z-index:2147483645; background:var(--color-background); color:var(--color-foreground);
      display:flex; flex-direction:column; overflow:hidden; visibility:hidden; pointer-events:none;
      box-shadow:0 20px 70px rgb(var(--color-foreground-rgb) / .16);
      transition:transform .32s cubic-bezier(.22,.72,.24,1), visibility 0s linear .32s;
    }
