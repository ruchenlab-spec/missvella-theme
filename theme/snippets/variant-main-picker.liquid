  <script>
    (function () {
      const pickerSelector = "variant-picker[data-block-id='{{ block.id }}'][data-template-product-match='true']";
      window.__missvellaPlusSizeState = window.__missvellaPlusSizeState || {};
      window.__missvellaPlusSizeObservers = window.__missvellaPlusSizeObservers || new WeakMap();

      function getPicker() {
        return document.querySelector(pickerSelector);
      }

      function applyPlusSizeState(picker) {
        if (!picker || !picker.isConnected) return;

        picker.querySelectorAll('[data-plus-size-collapsible="true"]').forEach((fieldset) => {
          const stateKey = fieldset.dataset.plusSizeKey;
          if (!stateKey) return;

          if (typeof window.__missvellaPlusSizeState[stateKey] !== 'boolean') {
            window.__missvellaPlusSizeState[stateKey] = fieldset.dataset.plusSizeInitialExpanded === 'true';
          }

          const expanded = window.__missvellaPlusSizeState[stateKey];
          const expandedValue = expanded ? 'true' : 'false';

          if (fieldset.dataset.plusSizeReady !== 'true') {
            fieldset.dataset.plusSizeReady = 'true';
          }
          if (fieldset.dataset.plusSizeExpanded !== expandedValue) {
            fieldset.dataset.plusSizeExpanded = expandedValue;
          }

          const toggle = fieldset.querySelector('[data-plus-size-toggle]');
          if (!toggle) return;

          if (toggle.getAttribute('aria-expanded') !== expandedValue) {
            toggle.setAttribute('aria-expanded', expandedValue);
          }

          const text = toggle.querySelector('[data-plus-size-toggle-text]');
          const desiredText = expanded ? 'Hide Plus Size' : 'More Plus Size';

          // IMPORTANT: only write text when it actually changes.
          // Writing textContent on every MutationObserver callback would itself
          // create another childList mutation and cause an endless observer loop.
          if (text && text.textContent !== desiredText) {
            text.textContent = desiredText;
          }
        });
      }

      function initializePicker() {
        const picker = getPicker();
        if (!picker) return;

        applyPlusSizeState(picker);

        if (!window.__missvellaPlusSizeObservers.has(picker)) {
          let updateScheduled = false;
          const observer = new MutationObserver(() => {
            if (updateScheduled) return;
            updateScheduled = true;

            requestAnimationFrame(() => {
              updateScheduled = false;
              applyPlusSizeState(picker);
            });
          });

          // Horizon morphs the existing <variant-picker> subtree after a
          // variant change. Watching childList is enough to re-apply the UI
          // state; do not observe attributes, otherwise our own data/ARIA
          // updates could feed back into the observer.
          observer.observe(picker, { childList: true, subtree: true });
          window.__missvellaPlusSizeObservers.set(picker, observer);
        }
      }

      if (!window.__missvellaPlusSizeToggleClickBound) {
        window.__missvellaPlusSizeToggleClickBound = true;

        document.addEventListener('click', function (event) {
          const target = event.target;
          if (!(target instanceof Element)) return;

          const toggle = target.closest('[data-plus-size-toggle]');
          if (!toggle) return;

          const fieldset = toggle.closest('[data-plus-size-collapsible="true"]');
          const picker = toggle.closest('variant-picker');
          if (!fieldset || !picker) return;

          const stateKey = fieldset.dataset.plusSizeKey;
          if (!stateKey) return;

          const isExpanded = fieldset.dataset.plusSizeExpanded === 'true';
          window.__missvellaPlusSizeState[stateKey] = !isExpanded;
          applyPlusSizeState(picker);
        });
      }

      initializePicker();
      document.addEventListener('shopify:section:load', initializePicker);
    })();
  </script>


  {%- if show_size_chart -%}
  <script>
    (function () {
      const uid = {{ size_chart_uid | json }};
      const overlayId = 'mv-size-chart-overlay-' + uid;
      const drawerId = 'mv-size-chart-drawer-' + uid;

      function initSizeChart() {
        let drawer = document.getElementById(drawerId);
        let overlay = document.getElementById(overlayId);
        if (!drawer || !overlay) return;

        const oldDrawer = document.body.querySelector('#' + CSS.escape(drawerId));
        if (oldDrawer && oldDrawer !== drawer) oldDrawer.remove();
        const oldOverlay = document.body.querySelector('#' + CSS.escape(overlayId));
        if (oldOverlay && oldOverlay !== overlay) oldOverlay.remove();

        if (drawer.parentElement !== document.body) document.body.appendChild(drawer);
        if (overlay.parentElement !== document.body) document.body.appendChild(overlay);
        if (drawer.dataset.initialized === 'true') return;
        drawer.dataset.initialized = 'true';

        const closeBtn = drawer.querySelector('[data-size-chart-close]');
        const unit = drawer.querySelector('.mv-size-chart-unit');
        const unitBtns = drawer.querySelectorAll('[data-unit]');
        const unitCopy = drawer.querySelector('[data-size-chart-unit-copy]');
        const cells = drawer.querySelectorAll('[data-cm]');
        const tabs = drawer.querySelector('.mv-size-chart-tabs');
        const tabBtns = drawer.querySelectorAll('[data-size-chart-tab]');
        const panels = drawer.querySelectorAll('[data-size-chart-panel]');
        const accordions = drawer.querySelectorAll('[data-sc-step]');
        const hotspots = drawer.querySelectorAll('[data-sc-hotspot]');

        function open() {
          drawer.classList.add('open');
          overlay.classList.add('open');
          drawer.setAttribute('aria-hidden','false');
          overlay.setAttribute('aria-hidden','false');
          document.body.style.overflow = 'hidden';
        }
        function close() {
          drawer.classList.remove('open');
          overlay.classList.remove('open');
          drawer.setAttribute('aria-hidden','true');
          overlay.setAttribute('aria-hidden','true');
          document.body.style.overflow = '';
        }
        function setUnit(next) {
          const isIn = next === 'in';
          unit.dataset.scUnit = isIn ? 'in' : 'cm';
          unitBtns.forEach(btn => {
            const active = btn.dataset.unit === next;
            btn.classList.toggle('active',active);
            btn.setAttribute('aria-pressed',active ? 'true':'false');
          });
          if (unitCopy) unitCopy.textContent = isIn ? 'IN' : 'CM';
          cells.forEach(cell => {
            const cm = Number(cell.dataset.cm);
            if (!Number.isFinite(cm)) return;
            cell.textContent = isIn ? (cm / 2.54).toFixed(1).replace(/\.0$/,'') : String(cm);
          });
        }
        function setTab(next) {
          tabs.dataset.scTab = next;
          tabBtns.forEach(btn => btn.classList.toggle('active',btn.dataset.sizeChartTab === next));
          panels.forEach(panel => panel.classList.toggle('active',panel.dataset.sizeChartPanel === next));
        }

        document.addEventListener('click', function (event) {
          const target = event.target instanceof Element ? event.target.closest('[data-size-chart-trigger="' + uid + '"]') : null;
          if (target) open();
        });
        overlay.addEventListener('click',close);
        closeBtn?.addEventListener('click',close);
        unitBtns.forEach(btn => btn.addEventListener('click',() => setUnit(btn.dataset.unit)));
        tabBtns.forEach(btn => btn.addEventListener('click',() => setTab(btn.dataset.sizeChartTab)));
        document.addEventListener('keydown',event => { if (event.key === 'Escape' && drawer.classList.contains('open')) close(); });

        accordions.forEach(item => {
          item.querySelector('.mv-accordion-header')?.addEventListener('click',() => {
            const active = item.classList.contains('active');
            accordions.forEach(a => a.classList.remove('active'));
            hotspots.forEach(h => h.classList.remove('active'));
            if (!active) {
              item.classList.add('active');
              drawer.querySelector('[data-sc-hotspot="' + item.dataset.scStep + '"]')?.classList.add('active');
            }
          });
        });
        hotspots.forEach(h => h.addEventListener('click',() => {
          const item = drawer.querySelector('[data-sc-step="' + h.dataset.scHotspot + '"]');
          if (item) item.querySelector('.mv-accordion-header')?.click();
        }));
      }

      initSizeChart();
      document.addEventListener('shopify:section:load',initSizeChart);
    })();
  </script>
  {%- endif -%}
