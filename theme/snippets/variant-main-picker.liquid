    .mv-size-chart-tabs { position:relative; margin:14px 22px 0; display:grid; grid-template-columns:1fr 1fr; padding:4px; border:1px solid var(--sc-border); background:rgb(var(--color-foreground-rgb) / 0.04); min-height:44px; }
