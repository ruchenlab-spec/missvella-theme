    .size-chart td {
      padding:8px 7px;
      text-align:center;
      border-top:1px solid var(--sc-border);
      white-space:nowrap;
      background:var(--color-background);
    }
    /* Freeze the Size column while horizontally scrolling. */
    .size-chart th:first-child,
