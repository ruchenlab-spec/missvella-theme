{% stylesheet %}
  .mv-size-chart-overlay { display: none; position: fixed; inset: 0; z-index: 2147483644; background: rgb(var(--color-foreground-rgb) / .3); }
  .mv-size-chart-overlay.open { display: block; }
  .mv-size-chart-drawer {
    --sc-ink: var(--pi-text, var(--color-foreground));
    --sc-accent: var(--pi-accent, var(--color-foreground));
    --sc-surface: var(--pi-surface, var(--color-background));
    --sc-border: var(--pi-border, var(--color-border));
    --sc-stone: var(--pi-soft, #efede7);
    --sc-muted: var(--pi-muted, var(--color-foreground-muted));
    position: fixed; z-index: 2147483645; display: flex; flex-direction: column;
    overflow: hidden; visibility: hidden; pointer-events: none;
    background: var(--sc-surface); color: var(--sc-ink); border: 0; border-radius: 0; box-shadow: none;
    font-family: var(--font-body--family); font-size: 12px; font-weight: 400; line-height: 1.5;
    transition: transform .3s cubic-bezier(.22,.72,.24,1), visibility 0s linear .3s;
  }
  .mv-size-chart-drawer.open { visibility: visible; pointer-events: auto; transition-delay: 0s; }
  .mv-size-chart-header { display: flex; align-items: center; justify-content: space-between; gap: 16px; flex: 0 0 auto; padding: 14px 24px; border-block-end: 1px solid var(--sc-border); }
  .mv-size-chart-header h2 { margin: 0; font-family: var(--font-heading--family); font-size: 24px; font-weight: 400; line-height: 1.2; letter-spacing: .01em; text-transform: none; color: var(--sc-accent); }
  .mv-size-chart-header p { margin: 5px 0 0; font-size: 11px; line-height: 1.5; color: var(--sc-muted); }
  .mv-size-chart-close { display: grid; place-items: center; width: 40px; height: 40px; padding: 0; flex: 0 0 auto; border: 0; border-radius: 0; background: transparent; color: var(--sc-accent); cursor: pointer; }
  .mv-size-chart-close svg { width: 18px; height: 18px; }
  .mv-size-chart-tabs, .mv-size-chart-unit { display: grid; grid-template-columns: 1fr 1fr; padding: 3px; gap: 0; border: 1px solid var(--sc-border); background: var(--sc-surface); }
  .mv-size-chart-tabs { margin: 16px 24px 0; flex: 0 0 auto; }
  .mv-size-chart-unit { width: 104px; flex: 0 0 auto; }
  .mv-size-chart-tabs button, .mv-size-chart-unit button {
    appearance: none; display: inline-flex; align-items: center; justify-content: center; min-width: 0;
    min-height: 36px; margin: 0; padding: 6px 8px; border: 0; border-radius: 0; box-shadow: none;
    background: transparent; font-family: var(--font-body--family); font-size: 10px; font-weight: 500;
    letter-spacing: .09em; line-height: 1.4; text-transform: uppercase; color: var(--sc-muted);
    cursor: pointer; transition: background-color .2s ease, color .2s ease;
  }
  .mv-size-chart-unit button { min-height: 28px; }
  .mv-size-chart-tabs button.active, .mv-size-chart-unit button.active { background: var(--sc-stone); color: var(--sc-ink); }
  .mv-size-chart-drawer :is(button, [tabindex]):focus-visible { outline: 1px solid var(--sc-accent); outline-offset: -3px; }
  .mv-size-chart-body { min-height: 0; flex: 1; overflow-y: auto; overscroll-behavior: contain; }
  .mv-size-chart-panel { display: none; }
  .mv-size-chart-panel.active { display: block; }
  .size-chart-section, .mv-size-chart-htm { padding: 20px 24px 24px; }
  .size-chart-heading-row { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-block-end: 16px; }
  .size-chart-title { margin: 0; font-family: var(--font-body--family); font-size: 11px; font-weight: 500; line-height: 1.4; letter-spacing: .09em; text-transform: uppercase; color: var(--sc-ink); }
  .size-chart-unit-copy { margin-block-start: 4px; font-size: 10px; line-height: 1.5; color: var(--sc-muted); }
  .size-chart-scroll { position: relative; overflow: auto; max-height: calc(100dvh - 250px); border: 1px solid var(--sc-border); background: var(--sc-surface); overscroll-behavior: contain; -webkit-overflow-scrolling: touch; }
  .mv-size-chart-drawer .size-chart { width: 100%; min-width: 500px; margin: 0; border: 0; border-collapse: separate; border-spacing: 0; table-layout: auto; font-family: var(--font-body--family); font-size: 12px; font-variant-numeric: tabular-nums; line-height: 1.5; background: var(--sc-surface); color: var(--sc-ink); }
  .mv-size-chart-drawer .size-chart :is(th, td) { padding: 11px 10px; border: 0; border-block-end: 1px solid var(--sc-border); text-align: center; white-space: nowrap; }
  .mv-size-chart-drawer .size-chart th { position: sticky; top: 0; z-index: 3; background: var(--sc-stone); font-size: 10px; font-weight: 500; letter-spacing: .06em; text-transform: uppercase; color: var(--sc-ink); }
  .mv-size-chart-drawer .size-chart td { background: var(--sc-surface); font-weight: 400; }
  .mv-size-chart-drawer .size-chart tbody tr:last-child td { border-block-end: 0; }
  .mv-size-chart-drawer .size-chart :is(th, td):first-child { position: sticky; left: 0; min-width: 68px; font-weight: 500; box-shadow: 1px 0 0 var(--sc-border); }
  .mv-size-chart-drawer .size-chart td:first-child { z-index: 2; background: var(--sc-surface); }
  .mv-size-chart-drawer .size-chart th:first-child { z-index: 5; background: var(--sc-stone); }
  .mv-size-chart-drawer .size-chart :is(th, td):not(:first-child) { min-width: 86px; }
  .mv-size-chart-drawer .size-chart :is(th, td):last-child { min-width: 120px; }
  @media (hover: hover) {
    .mv-size-chart-tabs button:hover, .mv-size-chart-unit button:hover, .mv-size-chart-close:hover { color: var(--sc-accent); }
    .mv-size-chart-drawer .size-chart tbody tr:hover td { background: color-mix(in srgb, var(--sc-stone) 45%, var(--sc-surface)); }
  }
  @media screen and (min-width: 750px) {
    .mv-size-chart-drawer { top: 0; right: 0; width: min(600px, 100vw); height: 100dvh; border-inline-start: 1px solid var(--sc-border); transform: translateX(100%); }
    .mv-size-chart-drawer.open { transform: translateX(0); }
  }
  @media screen and (max-width: 749px) {
    .mv-size-chart-drawer { inset: auto 0 0; width: 100%; height: min(90dvh, 800px); border-block-start: 1px solid var(--sc-border); transform: translateY(100%); }
    .mv-size-chart-drawer.open { transform: translateY(0); }
    .mv-size-chart-header { padding: 12px 16px; }
    .mv-size-chart-header h2 { font-size: 22px; }
    .mv-size-chart-header p { font-size: 10px; }
    .mv-size-chart-tabs { margin: 14px 16px 0; }
    .size-chart-section, .mv-size-chart-htm { padding: 16px 16px 24px; padding-block-end: max(24px, env(safe-area-inset-bottom)); }
    .size-chart-scroll { max-height: calc(min(90dvh, 800px) - 240px); }
  }
  @media (prefers-reduced-motion: reduce) {
    .mv-size-chart-drawer, .mv-size-chart-tabs button, .mv-size-chart-unit button { transition: none; }
  }
{% endstylesheet %}
