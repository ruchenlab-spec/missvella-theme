{% liquid
  assign product_resource = closest.product
  if request.visual_preview_mode and product_resource == blank
    assign product_resource = collections.all.products.first
  endif
-%}

{% unless product_resource == blank %}
  {% render 'variant-main-picker', product_resource: product_resource, section: section, product: product, block: block %}
{% endunless %}

{% schema %}
{
  "name": "t:names.product_variant_picker",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "t:content.type"
    },
    {
      "type": "select",
      "id": "variant_style",
      "label": "t:settings.style",
      "options": [
        {
          "value": "dropdowns",
          "label": "t:options.dropdowns"
        },
        {
          "value": "buttons",
          "label": "t:options.buttons"
        }
      ],
      "default": "buttons"
    },
    {
      "type": "checkbox",
      "id": "show_swatches",
      "label": "t:settings.swatches",
      "default": true
    },
    {
      "type": "header",
      "content": "尺码表"
    },
    {
      "type": "checkbox",
      "id": "show_size_chart",
      "label": "显示尺码表",
      "default": true
    },
    {
      "type": "header",
      "content": "尺码展示方式"
    },
    {
      "type": "select",
      "id": "size_layout",
      "label": "尺码展示方式",
      "options": [
        {
          "value": "matrix",
          "label": "尺码矩阵（一次展示全部尺码）"
        },
        {
          "value": "dropdowns",
          "label": "下拉框"
        }
      ],
      "default": "matrix"
    },
    {
      "type": "checkbox",
      "id": "show_fit_tabs",
      "label": "显示 Standard Size / Custom Fit 切换 Tab",
      "default": true,
      "info": "开启后，标准尺码矩阵与 Custom Size（定制测量）区块通过 Tab 切换展示，两者不会同时出现"
    },
    {
      "type": "header",
      "content": "颜色组（同款不同色）"
    },
    {
      "type": "checkbox",
      "id": "color_group_enabled",
      "label": "启用颜色组选择器",
      "default": true,
      "info": "关闭后改为显示商品原生的颜色选项"
    },
    {
      "type": "select",
      "id": "color_group_display_style",
      "visible_if": "{{ block.settings.color_group_enabled }}",
      "label": "展示样式",
      "options": [
        {
          "value": "cards",
          "label": "图片卡片"
        },
        {
          "value": "swatches",
          "label": "小色块"
        }
      ],
      "default": "cards",
      "info": "图片卡片：显示每个颜色的商品图，占空间较大；小色块：只显示颜色（色号），更紧凑。每行排列数量由下方「每行列数」决定，宽度和间距按数量自动计算"
    },
    {
      "type": "range",
      "id": "color_group_columns_desktop",
      "visible_if": "{{ block.settings.color_group_enabled }}",
      "label": "每行列数（桌面）",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 6,
      "info": "每行排列的数量。卡片/色块宽度与间距按此数量自动均分计算，始终填满整行"
    },
    {
      "type": "range",
      "id": "color_group_columns_mobile",
      "visible_if": "{{ block.settings.color_group_enabled }}",
      "label": "每行列数（移动端）",
      "min": 1,
      "max": 8,
      "step": 1,
      "default": 4,
      "info": "移动端每行排列的数量"
    },
    {
      "type": "range",
      "id": "color_group_card_radius",
      "visible_if": "{{ block.settings.color_group_enabled }}",
      "label": "卡片圆角",
      "min": 0,
      "max": 26,
      "step": 1,
      "unit": "px",
      "default": 0,
      "info": "极简奢侈风默认直角（0）；如需圆角可手动调大"
    },
    {
      "type": "select",
      "id": "color_group_selected_style",
      "visible_if": "{{ block.settings.color_group_enabled }}",
      "label": "选中样式",
      "options": [
        {
          "value": "solid",
          "label": "实心描边"
        },
        {
          "value": "outline",
          "label": "外扩描边"
        },
        {
          "value": "bar",
          "label": "底部指示条"
        },
        {
          "value": "dot",
          "label": "右下角圆点"
        },
        {
          "value": "none",
          "label": "无"
        }
      ],
      "default": "solid"
    },
    {
      "type": "checkbox",
      "id": "color_group_tooltip_shadow",
      "visible_if": "{{ block.settings.color_group_enabled }}",
      "label": "颜色名称气泡阴影",
      "default": false
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "color",
      "id": "option_label_text_color",
      "label": "t:settings.text_color",
      "placeholder": "t:settings.default",
      "alpha": true
    },
    {
      "type": "select",
      "id": "variant_style_class",
      "label": "t:settings.variant_button_style",
      "options": [
        {
          "value": "default",
          "label": "t:options.default"
        },
        {
          "value": "custom",
          "label": "t:options.custom"
        }
      ],
      "default": "default",
      "info": "t:info.edit_variants_in_theme_settings"
    },
    {
      "type": "color",
      "id": "custom_variant_background",
      "label": "t:settings.background",
      "default": "{{ settings.color_palette.background }}",
      "alpha": true,
      "visible_if": "{{ block.settings.variant_style_class == 'custom' }}"
    },
    {
      "type": "color",
      "id": "custom_variant_text",
      "label": "t:settings.text",
      "default": "{{ settings.color_palette.foreground }}",
      "alpha": true,
      "visible_if": "{{ block.settings.variant_style_class == 'custom' }}"
    },
    {
      "type": "color",
      "id": "custom_variant_border",
      "label": "t:settings.borders",
      "default": "{{ settings.color_palette.foreground }}",
      "alpha": true,
      "visible_if": "{{ block.settings.variant_style_class == 'custom' }}"
    },
    {
      "type": "select",
      "id": "selected_variant_style_class",
      "label": "t:settings.selected_variant_button_style",
      "options": [
        {
          "value": "default",
          "label": "t:options.default"
        },
        {
          "value": "custom",
          "label": "t:options.custom"
        }
      ],
      "default": "default",
      "visible_if": "{{ block.settings.variant_style == 'buttons' }}"
    },
    {
      "type": "color",
      "id": "custom_selected_variant_background",
      "label": "t:settings.background",
      "default": "{{ settings.color_palette.foreground }}",
      "alpha": true,
      "visible_if": "{{ block.settings.variant_style == 'buttons' and block.settings.selected_variant_style_class == 'custom' }}"
    },
    {
      "type": "color",
      "id": "custom_selected_variant_text",
      "label": "t:settings.text",
      "default": "{{ settings.color_palette.background }}",
      "alpha": true,
      "visible_if": "{{ block.settings.variant_style == 'buttons' and block.settings.selected_variant_style_class == 'custom' }}"
    },
    {
      "type": "color",
      "id": "custom_selected_variant_border",
      "label": "t:settings.borders",
      "default": "{{ settings.color_palette.foreground }}",
      "alpha": true,
      "visible_if": "{{ block.settings.variant_style == 'buttons' and block.settings.selected_variant_style_class == 'custom' }}"
    },
    {
      "type": "text_alignment",
      "id": "alignment",
      "label": "t:settings.alignment",
      "default": "left"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:names.product_variant_picker",
      "category": "t:categories.product"
    }
  ]
}
{% endschema %}
