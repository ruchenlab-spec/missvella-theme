{%- assign block_settings = block.settings -%}
{%- if block_settings.height == 'fill' -%}
  {% # `.full-height--desktop` consumes `--header-group-height` at first paint (stylesheet below) %}
  {% render 'measure-header-heights', only_on_desktop: true %}
{%- endif -%}
<div
  id="ProductInformation-{{ section.id }}"
  class="
    product-details
    {% if block_settings.sticky_details_desktop %} sticky-content--desktop{% endif %}
    {% if block_settings.height == 'fill' -%} full-height--desktop{% endif -%}
  "
  style="--details-position: {{ block_settings.details_position }};"
  data-testid="product-information-details"
  {% if settings.transition_to_main_product %}
    data-view-transition-type="product-details"
  {% endif %}
>
  {% capture children %}
    {% render 'product-series', product: closest.product, settings: block_settings %}
    <div class="view-product-title">
      <a
        href="{{ closest.product.selected_or_first_available_variant.url }}"
      >
        {{- closest.product.title }}
      </a>
    </div>
    {% content_for 'blocks' %}
  {% endcapture %}

  {% render 'group',
    children: children,
    settings: block_settings,
    shopify_attributes: block.shopify_attributes,
    background_color: block_settings.background_color,
    block_id: block.id
  %}
</div>

{%- comment -%}
  Price emphasis for the product page only.

  The price that sits under the product title is rendered with the `price`
  block, which is also used by every product card (collection grids, best
  sellers, related products, ...). Applying the style globally would make
  all card prices bold and larger, so the rule is scoped to the product
  details column of a product page.
{%- endcomment -%}
{%- if request.page_type == 'product' -%}
  {% style %}
    /* ------------------------------------------------------------------
       Editorial typography system for the details column (Missvella UI
       spec): serif display title, quiet functional labels, light price.
       Layout, spacing and block order stay in the merchant's hands — only
       type hierarchy, color and weight are set here.
       ------------------------------------------------------------------ */

    /* Product title — the serif voice of the brand. Size / weight / family /
       colour are merchant settings on this block (the "产品标题" section in the
       block settings panel); the defaults reproduce the editorial scale. The
       second selector outranks the text block's custom-font-size/custom-color
       variants without resorting to !important. */
    .product-details {
      --mv-title-size: {{ block_settings.title_font_size | default: 32 }}px;
      --mv-title-weight: {{ block_settings.title_font_weight | default: 400 }};
      --mv-title-family: {% if block_settings.title_font_family == 'body' %}var(--font-body--family){% else %}var(--font-heading--family){% endif %};
      {% if block_settings.title_color != blank %}--mv-title-color: {{ block_settings.title_color }};{% endif %}
    }

    .product-details .text-block h1,
    .product-details .text-block.custom-font-size.custom-color h1 {
      font-family: var(--mv-title-family);
      font-weight: var(--mv-title-weight);
      font-size: clamp(calc(var(--mv-title-size) * 0.8), 2.5vw, var(--mv-title-size));
      line-height: 1.18;
      letter-spacing: 0.01em;
      text-transform: none;
      text-wrap: balance;
      color: var(--mv-title-color, var(--color-foreground));
      margin-block: 0;
    }

    .product-details .text-block h1 a {
      color: inherit;
      text-decoration: none;
    }

    /* Series / SKU line — quiet functional label above the title. Only the
       letter spacing / case are set here; family, size and colour come from
       the block's 系列标题与 SKU settings (via product-series.liquid) so the
       merchant's controls keep working. */
    .product-details .product-series__sku {
      font-size: {{ block_settings.sku_font_size | default: 10 }}px;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      line-height: 1;
    }

    /* Price — functional sans text, medium weight (never bold display). */
    .product-details product-price .price {
      font-weight: 500;
      font-size: 15px;
      letter-spacing: 0.02em;
    }

    /* Accordion headers — the same functional-label standard as the option
       legends; the theme's 14px body voice is too heavy for this list. */
    .product-details accordion-custom summary.details__header {
      font-family: var(--font-body--family);
      font-size: 11px;
      font-weight: 500;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--color-foreground);
    }
  {% endstyle %}
{%- endif -%}

{% stylesheet %}
  /* Clear padding on mobile, if not full-width */
  @media screen and (max-width: 749px) {
    .product-information.section--page-width .product-details > .group-block {
      padding-inline: 0;
    }
  }

  .view-product-title {
    display: none;
  }

  /* ------------------------------------------------------------------
     Tighten the vertical rhythm of the title cluster on the product page:
     series/SKU line → product title → price.

     The spacing comes from the merchant's group gap (12px) plus the series
     bottom margin, so it is trimmed here instead of touching the saved
     block settings. Only the group that actually holds the price is
     affected; the accordion and the other groups keep their spacing.
     ------------------------------------------------------------------ */
  .product-details .product-series {
    margin-block-end: 0;
  }

  .product-details .group-block:has(> .group-block-content > product-price) {
    margin-block-start: -4px;
  }

  .product-details
    .group-block:has(> .group-block-content > product-price)
    > .group-block-content {
    row-gap: 8px;
  }

  /* ------------------------------------------------------------------
     Fit preference tabs: only one panel is visible at a time. The variant
     picker owns the tabs and toggles `mv-fit-standard` / `mv-fit-custom`
     on `.product-details`; the Custom Size block hides itself in standard
     mode (see blocks/custom-sizes.liquid).
     ------------------------------------------------------------------ */

  /* Container styles */
  .product-details {
    display: flex;
    align-self: start;
    justify-content: center;
  }

  @media screen and (min-width: 750px) {
    .product-details > .group-block {
      height: min-content;
    }

    .full-height--desktop {
      height: 100%;
      max-height: calc(100vh - var(--header-group-height, 0));
      min-height: fit-content;
    }

    .full-height--desktop .group-block {
      align-self: var(--details-position, 'flex-start');
    }
  }
{% endstylesheet %}

