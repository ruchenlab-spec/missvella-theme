{%- assign block_settings = block.settings -%}
{%- if block_settings.height == 'fill' -%}
  {% # `.full-height--desktop` consumes `--header-group-height` at first paint (stylesheet below) %}
  {% render 'measure-header-heights', only_on_desktop: true %}
{%- endif -%}
<div
  id="ProductInformation-{{ section.id }}"
  class="
    product-details
    {% if block_settings.sticky_details_desktop %} sticky-content--desktop{% endif %}
    {% if block_settings.height == 'fill' -%} full-height--desktop{% endif -%}
  "
  style="
    --details-position: {{ block_settings.details_position }};
    --mv-sku-size: {{ block_settings.sku_font_size | default: 10 }}px;
    {% render 'product-information-palette', settings: section.settings %}
  "
  {% if section.settings.info_palette_enabled != false %}data-product-palette{% endif %}
  {% if request.page_type == 'product' %}data-product-editorial{% endif %}
  {% if block_settings.metadata_blocks %}data-metadata-blocks{% endif %}
  data-testid="product-information-details"
  {% if settings.transition_to_main_product %}
    data-view-transition-type="product-details"
  {% endif %}
>
  {% capture children %}
    {% unless block_settings.metadata_blocks %}
      {% render 'product-series', product: closest.product, settings: block_settings %}
    {% endunless %}
    <div class="view-product-title">
      <a
        href="{{ closest.product.selected_or_first_available_variant.url }}"
      >
        {{- closest.product.title }}
      </a>
    </div>
    {% content_for 'blocks' %}
  {% endcapture %}

  {% render 'group',
    children: children,
    settings: block_settings,
    shopify_attributes: block.shopify_attributes,
    background_color: block_settings.background_color,
    block_id: block.id
  %}
</div>

{% stylesheet %}
  /* Native metadata blocks keep their own text-block typography. */
  .product-details[data-metadata-blocks] .product-series,
  .product-details:has([data-product-metadata='sku']) .product-series--sku-only { display: none; }
  .product-details:has([data-product-metadata='sku']) .product-series__sku { display: none; }
  .product-details:has(.product-series-block) .product-series__label { display: none; }
  .product-details:has([data-product-metadata='sku']):has(.product-series-block) .product-series { display: none; }

  /* One palette bridge, reused by the details column and portaled dialogs. */
  [data-product-palette] {
    --color-foreground: var(--pi-text);
    --color-foreground-rgb: var(--pi-text-rgb);
    --color-foreground-muted: var(--pi-muted);
    --color-foreground-subdued: var(--pi-muted);
    --color-background: var(--pi-surface);
    --color-background-rgb: var(--pi-surface-rgb);
    --color-border: var(--pi-border);
    --color-primary-button-background: var(--pi-accent);
    --color-primary-button-text: var(--pi-on-accent);
    --color-primary-button-border: var(--pi-accent);
    --color-primary-button-hover-background: color-mix(in srgb, var(--pi-accent) 88%, var(--pi-surface));
    --color-primary-button-hover-text: var(--pi-on-accent);
    --color-primary-button-hover-border: var(--color-primary-button-hover-background);
  }

  .product-details[data-product-palette] {
    color: var(--pi-text);
    background: var(--pi-surface);
  }

  .product-details[data-product-editorial] .product-series__sku {
    font-size: var(--mv-sku-size);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    line-height: 1.3;
  }

  .product-details[data-product-palette] .product-series__sku {
    color: var(--pi-muted);
    opacity: 1;
  }

  .product-details[data-product-palette] .product-series__label { color: var(--pi-text); }

  .product-details[data-product-editorial] product-price .price {
    font-family: var(--font-body--family);
    font-size: 15px;
    font-weight: 400;
    letter-spacing: 0.02em;
    color: var(--pi-text, var(--color-foreground));
  }

  .product-details[data-product-palette] .accordion {
    --color-border: var(--pi-border);
    --color-foreground: var(--pi-text);
    --color-background: var(--pi-surface);
    color: var(--pi-text);
  }

  .product-details[data-product-editorial] accordion-custom summary.details__header {
    min-height: 48px;
    font-family: var(--font-body--family);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--pi-text, var(--color-foreground));
  }

  .product-details[data-product-editorial] .details-content {
    font-family: var(--font-body--family);
    font-size: 13px;
    line-height: 1.7;
    color: var(--pi-muted, var(--color-foreground));
  }

  .product-details[data-product-editorial] .add-to-cart-button {
    min-height: 48px;
    padding-block: 14px;
    border-radius: 0;
    font-family: var(--font-body--family);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    transform: none;
    box-shadow: none;
    transition: background-color 0.16s ease, color 0.16s ease, opacity 0.16s ease;
  }

  .product-details[data-product-palette] .add-to-cart-button {
    --button-background-color: var(--pi-accent);
    --button-color: var(--pi-on-accent);
    --button-border-color: var(--pi-accent);
  }

  .product-details[data-product-palette] > .group-block { background-color: var(--pi-surface); }

  @media (hover: hover) {
    .product-details[data-product-palette] .add-to-cart-button:hover {
      --button-background-color: var(--color-primary-button-hover-background);
      --button-color: var(--pi-on-accent);
      --button-border-color: var(--color-primary-button-hover-background);
    }
  }

  /* Clear padding on mobile, if not full-width */
  @media screen and (max-width: 749px) {
    .product-information.section--page-width .product-details > .group-block {
      padding-inline: 0;
    }
  }

  .view-product-title {
    display: none;
  }

  /* ------------------------------------------------------------------
     Tighten the vertical rhythm of the title cluster on the product page:
     series/SKU line → product title → price.

     The spacing comes from the merchant's group gap (12px) plus the series
     bottom margin, so it is trimmed here instead of touching the saved
     block settings. Only the group that actually holds the price is
     affected; the accordion and the other groups keep their spacing.
     ------------------------------------------------------------------ */
  .product-details .product-series {
    margin-block-end: 0;
  }

  .product-details .group-block:has(> .group-block-content > product-price) {
    margin-block-start: -4px;
  }

  .product-details
    .group-block:has(> .group-block-content > product-price)
    > .group-block-content {
    row-gap: 8px;
  }

  /* ------------------------------------------------------------------
     Fit preference tabs: only one panel is visible at a time. The variant
     picker owns the tabs and toggles `mv-fit-standard` / `mv-fit-custom`
     on `.product-details`; the Custom Size block hides itself in standard
     mode (see blocks/custom-sizes.liquid).
     ------------------------------------------------------------------ */

  /* Container styles */
  .product-details {
    display: flex;
    align-self: start;
    justify-content: center;
  }

  @media screen and (min-width: 750px) {
    .product-details > .group-block {
      height: min-content;
    }

    .full-height--desktop {
      height: 100%;
      max-height: calc(100vh - var(--header-group-height, 0));
      min-height: fit-content;
    }

    .full-height--desktop .group-block {
      align-self: var(--details-position, 'flex-start');
    }
  }
{% endstylesheet %}

