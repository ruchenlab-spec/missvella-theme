}
#cs-modal-{{ cs_id }}.cs-inline.active { display: flex; }
#cs-modal-{{ cs_id }}.cs-inline::before,
#cs-modal-{{ cs_id }}.cs-inline .mv-modal-close { display: none; }
#cs-modal-{{ cs_id }}.cs-inline .cs-modal-body-{{ cs_id }} {
  overflow: visible;
  flex: none;
}
#cs-modal-{{ cs_id }}.cs-inline .cs-modal-header-{{ cs_id }} { display: none; }
#cs-modal-{{ cs_id }}.cs-inline .cs-tabs-nav-{{ cs_id }} {
  align-items: center;
  gap: 14px;
  margin: 0 16px;
  border-block-end: 1px solid var(--mv-pal-border);
}
#cs-modal-{{ cs_id }}.cs-inline .cs-tab-btn-{{ cs_id }} {
  flex: none;
  min-height: 42px;
  padding: 0;
  border-block-end-width: 1px;
  font-family: var(--font-body--family);
  font-size: 9px;
  font-weight: 400;
  letter-spacing: 0.08em;
  white-space: nowrap;
}
#cs-modal-{{ cs_id }}.cs-inline .cs-tab-btn-{{ cs_id }} svg { display: none; }
#cs-modal-{{ cs_id }}.cs-inline .cs-unit-toggle-{{ cs_id }} {
  margin-inline-start: auto;
  padding: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
}
#cs-modal-{{ cs_id }}.cs-inline .cs-unit-btn-{{ cs_id }} {
  height: 28px;
  padding: 0 7px;
  border-block-end: 1px solid transparent;
  border-radius: 0;
  background: transparent;
  color: var(--mv-pal-muted);
  font-size: 9px;
  font-weight: 400;
  letter-spacing: 0.06em;
}
#cs-modal-{{ cs_id }}.cs-inline .cs-unit-btn-{{ cs_id }}.active {
  color: var(--mv-pal-ink);
  border-block-end-color: currentColor;
}
#cs-modal-{{ cs_id }}.cs-inline .cs-tab-panel-{{ cs_id }}[data-panel='form'] {
  padding: 16px;
}
#cs-modal-{{ cs_id }}.cs-inline .cs-form-grid-{{ cs_id }} {
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14px 12px;
}
#cs-modal-{{ cs_id }}.cs-inline .cs-form-group-{{ cs_id }} { gap: 5px; }
#cs-modal-{{ cs_id }}.cs-inline .cs-form-label-{{ cs_id }} {
  font-family: var(--font-body--family);
  font-size: 9px;
  font-weight: 500;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}
#cs-modal-{{ cs_id }}.cs-inline .cs-optional-tag-{{ cs_id }} {
  padding: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
  font-size: 8px;
  font-weight: 400;
  letter-spacing: 0.04em;
}
#cs-modal-{{ cs_id }}.cs-inline .cs-input-wrap-{{ cs_id }} input {
  height: 40px;
  padding: 10px 30px 10px 10px;
  border: 1px solid var(--mv-pal-border);
  border-radius: 0;
  background: transparent;
  box-shadow: none;
  font-family: var(--font-body--family);
  font-size: 12px;
  font-weight: 400;
}
#cs-modal-{{ cs_id }}.cs-inline .cs-input-wrap-{{ cs_id }} input:focus {
  border-color: var(--mv-pal-ink);
  outline: 1px solid var(--mv-pal-ink);
  outline-offset: -1px;
}
#cs-modal-{{ cs_id }}.cs-inline .cs-input-unit-{{ cs_id }} {
  right: 10px;
  font-size: 9px;
}
#cs-modal-{{ cs_id }}.cs-inline .cs-form-footer-{{ cs_id }} {
  flex-direction: row;
  align-items: center;
  gap: 16px;
  margin-block-start: 18px;
}
#cs-modal-{{ cs_id }}.cs-inline .cs-form-footer-{{ cs_id }} button {
  min-height: 40px;
  border-radius: 0;
  box-shadow: none;
  font-family: var(--font-body--family);
  font-size: 9px;
  font-weight: 500;
  line-height: 1.4;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}
#cs-modal-{{ cs_id }}.cs-inline .cs-btn-confirm-{{ cs_id }} {
  padding: 10px 12px;
  background: var(--mv-pal-ink);
  color: var(--mv-pal-surface);
}
#cs-modal-{{ cs_id }}.cs-inline .cs-btn-ghost-{{ cs_id }} {
  flex: 0 0 auto;
  padding: 0;
  border: 0;
  text-decoration: underline;
  text-underline-offset: 3px;
}
#cs-modal-{{ cs_id }}.cs-inline button:hover { transform: none; }
#cs-modal-{{ cs_id }}.cs-inline .cs-review-{{ cs_id }} { padding: 16px; }
#cs-modal-{{ cs_id }}.cs-inline .cs-review-tag-{{ cs_id }} {
  padding: 10px 0;
  font-size: 12px;
}
#cs-modal-{{ cs_id }}.cs-inline .cs-cart-line-{{ cs_id }} {
  padding: 12px 0 0;
  margin: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
  font-size: 11px;
}
.cs-block-{{ cs_id }}.has-inline-form .cs-summary-{{ cs_id }} {
  margin: 0;
  padding: 16px;
  border-color: #d8d3ca;
  border-block-start: 0;
  border-radius: 0;
}
.cs-block-{{ cs_id }}.has-inline-form:has(> .cs-inline.active) .cs-summary-{{ cs_id }} {
  display: none;
}
.cs-block-{{ cs_id }}.has-inline-form .cs-summary-title-{{ cs_id }} {
  font-family: var(--font-body--family);
  font-size: 11px;
  font-weight: 500;
  letter-spacing: 0.06em;
  text-transform: uppercase;
}
.cs-block-{{ cs_id }}.has-inline-form .cs-summary-tags-{{ cs_id }} span,
.cs-block-{{ cs_id }}.has-inline-form .cs-summary-status-{{ cs_id }},
.cs-block-{{ cs_id }}.has-inline-form .cs-summary-actions-{{ cs_id }} button,
.cs-block-{{ cs_id }}.has-inline-form .cs-checkbox-box-{{ cs_id }} {
  border-radius: 0;
  box-shadow: none;
}
#cs-measure-dialog-{{ cs_id }} {
  --cs-guide-secondary: {{ block.settings.secondary_color | default: '#9c876d' }};
  --cs-guide-line: color-mix(in srgb, var(--cs-guide-secondary) 24%, var(--mv-pal-surface));
  --cs-guide-wash: color-mix(in srgb, var(--cs-guide-secondary) 7%, var(--mv-pal-surface));
  --mv-pal-border: var(--cs-guide-line);
  --mv-pal-muted: rgb(var(--color-foreground-rgb) / 0.68);
  width: min(760px, calc(100vw - 32px));
  max-width: none;
  max-height: min(88dvh, 860px);
  padding: 0;
  border: 1px solid var(--cs-guide-line);
  border-radius: 0;
  background: var(--mv-pal-surface);
  color: var(--mv-pal-ink);
  box-shadow: none;
}
#cs-measure-dialog-{{ cs_id }}[open] { display: flex; flex-direction: column; }
#cs-measure-dialog-{{ cs_id }}::backdrop { background: rgb(26 22 20 / 42%); }
.cs-measure-dialog-header-{{ cs_id }} {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  flex: 0 0 auto;
  padding: 20px 28px;
  border-block-end: 1px solid var(--mv-pal-border);
}
.cs-measure-dialog-header-{{ cs_id }} h2 {
  margin: 0;
  font-family: var(--font-heading--family);
  font-size: 26px;
  font-weight: 400;
  line-height: 1.25;
  letter-spacing: 0.01em;
  text-transform: none;
  color: var(--mv-pal-accent);
}
.cs-measure-dialog-close-{{ cs_id }} {
  display: grid;
  place-items: center;
  width: 40px;
  height: 40px;
  padding: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
  color: var(--mv-pal-accent);
  cursor: pointer;
}
.cs-measure-dialog-close-{{ cs_id }}:focus-visible {
  outline: 1px solid currentColor;
  outline-offset: -4px;
}
.cs-measure-dialog-body-{{ cs_id }} {
  overflow-y: auto;
  overscroll-behavior: contain;
  min-height: 0;
}
#cs-measure-dialog-{{ cs_id }} .cs-htm-content-{{ cs_id }} {
  display: grid;
  grid-template-columns: minmax(0, 0.9fr) minmax(0, 1fr);
  align-items: start;
  gap: 28px;
  padding: 28px;
}
#cs-measure-dialog-{{ cs_id }} .cs-htm-image-wrapper-{{ cs_id }} {
  width: 100%;
  border: 0;
  border-radius: 0;
  background: var(--cs-guide-wash);
  box-shadow: none;
}
#cs-measure-dialog-{{ cs_id }} .cs-htm-image-{{ cs_id }} { mix-blend-mode: multiply; }
#cs-measure-dialog-{{ cs_id }} .cs-measurement-step-{{ cs_id }} { padding-block: 14px; }
#cs-measure-dialog-{{ cs_id }} .cs-measurement-step-{{ cs_id }}:first-child { padding-block-start: 0; }
#cs-measure-dialog-{{ cs_id }} .cs-measurement-title-{{ cs_id }} {
  display: flex;
  align-items: center;
  gap: 10px;
  color: var(--mv-pal-accent);
  letter-spacing: 0.1em;
}
#cs-measure-dialog-{{ cs_id }} .cs-measurement-title-{{ cs_id }} span {
  display: inline-grid;
  place-items: center;
  width: 22px;
  height: 22px;
  margin: 0;
  flex: 0 0 22px;
  background: var(--mv-pal-accent);
  color: var(--mv-pal-surface);
  font-size: 10px;
  letter-spacing: 0;
}
#cs-measure-dialog-{{ cs_id }} .cs-measurement-description-{{ cs_id }} {
  margin: 7px 0 0 32px;
  font-size: 12px;
  line-height: 1.75;
}
#cs-measure-dialog-{{ cs_id }} .cs-htm-note-{{ cs_id }} {
  padding: 14px 16px;
  margin-block-start: 10px;
  border: 0;
  border-inline-start: 1px solid var(--cs-guide-secondary);
  background: var(--cs-guide-wash);
  line-height: 1.7;
}
@media screen and (max-width: 549px) {
  .cs-measure-dialog-header-{{ cs_id }} { padding: 16px 20px; }
  .cs-measure-dialog-header-{{ cs_id }} h2 { font-size: 23px; }
  #cs-measure-dialog-{{ cs_id }} .cs-htm-content-{{ cs_id }} {
    grid-template-columns: minmax(0, 1fr);
    gap: 20px;
    padding: 20px;
  }
  #cs-measure-dialog-{{ cs_id }} .cs-htm-image-wrapper-{{ cs_id }} { max-width: 260px; }
}
{% endstyle %}

<custom-sizes-{{ cs_id }} class="custom-sizes-block" {{ block.shopify_attributes }}>
  <div class="cs-block-{{ cs_id }}" id="cs-block-{{ cs_id }}">

    {%- comment -%}
      Guide state: shown until the shopper has saved measurements. The button
      opens the measurement form; the JS swaps this area for the summary.
    {%- endcomment -%}
    <div class="cs-guide-{{ cs_id }}" id="cs-guide-{{ cs_id }}">
      <p class="cs-guide-kicker-{{ cs_id }}">Complimentary custom sizing</p>
      <h3 class="cs-guide-title-{{ cs_id }}">Custom Measurements</h3>
      <p class="cs-guide-hint-{{ cs_id }}">Enter your measurements for a more personalized fit.</p>
      <button type="button" class="cs-trigger-{{ cs_id }}" id="cs-trigger-{{ cs_id }}">
        <span class="cs-trigger-icon-{{ cs_id }}">
          <img src="{{ 'custom-size-icon.svg' | asset_url }}" alt="" width="18" height="18" loading="lazy">
        </span>
        <span class="cs-trigger-body-{{ cs_id }}">
          <span class="cs-trigger-title-{{ cs_id }}" id="cs-trigger-title-{{ cs_id }}">Enter measurements</span>
        </span>
        <span class="cs-trigger-right-{{ cs_id }}">
          <span class="mv-badge-free">Free</span>
        </span>
      </button>
    </div>

    <div class="cs-summary-{{ cs_id }}" id="cs-summary-{{ cs_id }}">
      <div class="cs-summary-label-{{ cs_id }}">
        <div class="cs-summary-title-{{ cs_id }}">
          <svg class="cs-ruler-icon" viewBox="0 0 24 24" fill="none">
            <path d="M4 6h16v12H4V6Z" stroke="currentColor" stroke-width="1.8"/>
            <path d="M8 6v5M12 6v3M16 6v5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
          </svg>
          Custom Measurements
        </div>
        <div class="cs-summary-status-{{ cs_id }}" id="cs-summary-status-{{ cs_id }}">
          <span class="cs-status-dot-{{ cs_id }}"></span>
          Measurements saved
        </div>
      </div>
      <div class="cs-summary-tags-{{ cs_id }}" id="cs-summary-tags-{{ cs_id }}"></div>
      <div class="cs-summary-bottom-{{ cs_id }}">
        <div class="cs-checkbox-row-{{ cs_id }}" id="cs-checkbox-row-{{ cs_id }}" role="checkbox" aria-checked="true" tabindex="0">
          <div class="cs-checkbox-box-{{ cs_id }}" id="cs-checkbox-box-{{ cs_id }}">
            <svg viewBox="0 0 20 20" fill="none" stroke="currentColor"
              stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 10.3 8.3 13.5 15.2 6.5"/>
            </svg>
          </div>
          <span class="cs-checkbox-label-{{ cs_id }}">Include in order</span>
        </div>
        <div class="cs-summary-actions-{{ cs_id }}">
          <button type="button" class="cs-btn-edit-{{ cs_id }}" id="cs-edit-{{ cs_id }}">Edit</button>
          <button type="button" class="cs-btn-cancel-{{ cs_id }}" id="cs-cancel-{{ cs_id }}">Cancel</button>
        </div>
      </div>
    </div>

  </div>
</custom-sizes-{{ cs_id }}>

<div id="cs-overlay-{{ cs_id }}"></div>
<div id="cs-modal-{{ cs_id }}">
  <div class="mv-modal-header cs-modal-header-{{ cs_id }}">
    <div>
      <div class="cs-modal-kicker-{{ cs_id }}">Made to Measure</div>
      <div class="cs-modal-title-{{ cs_id }}">{{ block.settings.modal_title }}</div>
      <div class="cs-modal-subtitle-{{ cs_id }}">Crafted to your exact measurements · Included free</div>
    </div>
    <div style="display:flex;align-items:center;gap:10px;">
      <div class="cs-unit-toggle-{{ cs_id }}" id="cs-unit-{{ cs_id }}" role="group" aria-label="Measurement unit" data-active-unit="cm">
        <button type="button" class="cs-unit-btn-{{ cs_id }} active" data-cs-unit="cm" aria-pressed="true">CM</button>
        <button type="button" class="cs-unit-btn-{{ cs_id }}" data-cs-unit="inch" aria-pressed="false">IN</button>
      </div>
      <button type="button" class="mv-modal-close" id="cs-close-{{ cs_id }}">
        <svg viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <line x1="1" y1="1" x2="13" y2="13"/>
          <line x1="13" y1="1" x2="1" y2="13"/>
        </svg>
      </button>
    </div>
  </div>

  <div class="cs-tabs-nav-{{ cs_id }}" data-active-tab="form">
    <button type="button" class="cs-tab-btn-{{ cs_id }} active" data-tab="form">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <path d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
      </svg>
      Enter Measurements
    </button>
    <button type="button" class="cs-tab-btn-{{ cs_id }}" data-tab="htm" aria-haspopup="dialog" aria-controls="cs-measure-dialog-{{ cs_id }}">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <path d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
      </svg>
      How to Measure
    </button>
  </div>

  <div class="cs-modal-body-{{ cs_id }}">
    <div class="cs-tab-panel-{{ cs_id }} active" data-panel="form">
      <div class="cs-form-grid-{{ cs_id }}" id="cs-form-grid-{{ cs_id }}">
        {%- assign fields = "bust|Bust|88|34.6|true~waist|Waist|70|27.6|true~hips|Hips|96|37.8|true~hollow|Hollow to Floor|150|59.1|true~height|Height|170|67|false" | split: "~" -%}
        {%- for field in fields -%}
          {%- assign parts = field | split: "|" -%}
          <div class="cs-form-group-{{ cs_id }}">
            <div class="cs-form-label-row-{{ cs_id }}">
              <label class="cs-form-label-{{ cs_id }}" for="cs-input-{{ cs_id }}-{{ parts[0] }}">{{ parts[1] }}</label>
              {%- unless parts[4] == 'true' -%}
                <span class="cs-optional-tag-{{ cs_id }}">optional</span>
              {%- endunless -%}
            </div>
            <div class="cs-input-wrap-{{ cs_id }}">
              <input type="number" step="0.1" min="0"
                id="cs-input-{{ cs_id }}-{{ parts[0] }}"
                class="mv-input{% unless parts[4] == 'true' %} optional{% endunless %}"
                data-key="{{ parts[0] }}"
                data-cm="{{ parts[2] }}" data-inch="{{ parts[3] }}"
                data-required="{{ parts[4] }}"
                placeholder="e.g. {{ parts[2] }} cm">
              <span class="cs-input-unit-{{ cs_id }}" data-cs-unit-label>cm</span>
            </div>
          </div>
        {%- endfor -%}
      </div>
      <div class="cs-form-footer-{{ cs_id }}">
        <button type="button" class="cs-btn-ghost-{{ cs_id }}" id="cs-clear-{{ cs_id }}">Clear</button>
        <button type="button" class="cs-btn-confirm-{{ cs_id }}" id="cs-next-{{ cs_id }}">Continue to Review →</button>
      </div>
    </div>

    <div class="cs-tab-panel-{{ cs_id }}" data-panel="review">
      <div class="cs-review-{{ cs_id }} on" id="cs-review-{{ cs_id }}">
        <div id="cs-review-tags-{{ cs_id }}"></div>
        <div class="cs-cart-line-{{ cs_id }}">
          Your measurements will be included with this item.
          <span id="cs-propval-{{ cs_id }}" hidden></span>
        </div>
        <div class="cs-form-footer-{{ cs_id }}">
          <button type="button" class="cs-btn-ghost-{{ cs_id }}" id="cs-back-{{ cs_id }}">← Back</button>
          <button type="button" class="cs-btn-confirm-{{ cs_id }}" id="cs-confirm-{{ cs_id }}">Confirm &amp; Keep</button>
        </div>
      </div>
    </div>

    <div class="cs-tab-panel-{{ cs_id }}" data-panel="htm">
      <div class="cs-htm-content-{{ cs_id }}">
        <div class="cs-htm-image-wrapper-{{ cs_id }}">
          {%- if block.settings.htm_image != blank -%}
            <img
              src="{{ block.settings.htm_image | image_url: width: 600 }}"
              alt="How to Measure"
              class="cs-htm-image-{{ cs_id }}"
              width="{{ block.settings.htm_image.width | at_most: 600 }}"
              height="{{ block.settings.htm_image.height | times: 600 | divided_by: block.settings.htm_image.width }}"
              loading="lazy"
            >
          {%- else -%}
            <img
              src="{{ 'size-chart-how-to-measure.png' | asset_url }}"
              alt="How to Measure"
              class="cs-htm-image-{{ cs_id }}"
              width="971"
              height="1619"
              loading="lazy"
            >
          {%- endif -%}
        </div>
        <div>
          <div class="cs-measurement-list-{{ cs_id }}">
            {%- assign htm_fields = "1|Bust|Measure around the fullest part of your bust~2|Waist|Measure around the narrowest part of your natural waistline~3|Hips|Measure around the fullest part of your hips, about 8 inches below your waist~4|Hollow to Floor|Measure from the hollow at the base of your throat to the floor~5|Height|Stand straight and measure from the top of your head to the floor" | split: "~" -%}
            {%- for hf in htm_fields -%}
              {%- assign hfparts = hf | split: "|" -%}
              <section class="cs-measurement-step-{{ cs_id }}">
                <h3 class="cs-measurement-title-{{ cs_id }}"><span>{{ hfparts[0] }}</span>{{ hfparts[1] }}</h3>
                <p class="cs-measurement-description-{{ cs_id }}">{{ hfparts[2] }}</p>
              </section>
            {%- endfor -%}
          </div>
          {%- if block.settings.htm_note != blank -%}
            <div class="cs-htm-note-{{ cs_id }}">{{ block.settings.htm_note }}</div>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</div>

<dialog id="cs-measure-dialog-{{ cs_id }}" aria-labelledby="cs-measure-dialog-title-{{ cs_id }}">
  <header class="cs-measure-dialog-header-{{ cs_id }}">
    <h2 id="cs-measure-dialog-title-{{ cs_id }}">How to Measure</h2>
    <button type="button" class="cs-measure-dialog-close-{{ cs_id }}" aria-label="Close measurement guide" autofocus>
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true"><path d="m3 3 10 10M13 3 3 13"/></svg>
    </button>
  </header>
  <div class="cs-measure-dialog-body-{{ cs_id }}"></div>
</dialog>

<script>
(function() {
  const id = '{{ cs_id }}';
  const PRODUCT_ID = {{ p.id | json }};
  const PLACEHOLDER_SIZE = {{ custom_size_placeholder_value | default: 'Custom Sizes' | json }};
  const HAS_PLACEHOLDER_SIZE = {{ has_custom_size_placeholder | json }};

  function init() {
    const block = document.getElementById('cs-block-' + id);
    if (!block || block._csInit) return;
    block._csInit = true;

    // Fit scope: the closest product details wrapper carries the mode class
    // (`mv-fit-standard` / `mv-fit-custom`) added by the variant picker tabs.
    function fitScope() {
      return block.closest('.product-details');
    }

    function currentFitMode() {
      const scope = fitScope();
      if (!scope) return 'legacy';
      if (scope.classList.contains('mv-fit-standard')) return 'standard';
      if (scope.classList.contains('mv-fit-custom')) return 'custom';
      return 'legacy';
    }

    function fitErrorLine() {
      const scope = fitScope();
      return scope ? scope.querySelector('[data-mv-fit-error]') : null;
    }

    function showFitError(message) {
      const line = fitErrorLine();
      if (!line) {
        window.alert(message);
        return;
      }
      line.textContent = message;
      line.hidden = false;
    }

    const overlay   = document.getElementById('cs-overlay-' + id);
    const modal     = document.getElementById('cs-modal-' + id);
    const measureDialog = document.getElementById('cs-measure-dialog-' + id);

    // A previous section render can leave portaled copies in <body>. Drop the
    // stale ones so this init always works with its own elements.
    document.querySelectorAll('#cs-overlay-' + id + ', #cs-modal-' + id + ', #cs-measure-dialog-' + id).forEach(function (el) {
      if (el !== overlay && el !== modal && el !== measureDialog) {
        if (el instanceof HTMLDialogElement && el.open) el.close();
        el.remove();
      }
    });

    const trigger   = document.getElementById('cs-trigger-' + id);
    const closeBtn  = document.getElementById('cs-close-' + id);
    const unit      = document.getElementById('cs-unit-' + id);
    const clearBtn  = document.getElementById('cs-clear-' + id);
    const nextBtn    = document.getElementById('cs-next-' + id);
    const backBtn    = document.getElementById('cs-back-' + id);
    const confirmBtn = document.getElementById('cs-confirm-' + id);
    const reviewTags = document.getElementById('cs-review-tags-' + id);
    const propVal    = document.getElementById('cs-propval-' + id);
    const editBtn   = document.getElementById('cs-edit-' + id);
    const cancelBtn = document.getElementById('cs-cancel-' + id);
    const summary   = document.getElementById('cs-summary-' + id);
    const sumTags   = document.getElementById('cs-summary-tags-' + id);
    const cbRow     = document.getElementById('cs-checkbox-row-' + id);
    const cbBox     = document.getElementById('cs-checkbox-box-' + id);
    const trigTitle = document.getElementById('cs-trigger-title-' + id);

    if (!overlay || !modal || !measureDialog || !trigger || !closeBtn || !unit || !nextBtn || !backBtn || !confirmBtn || !clearBtn || !editBtn || !cancelBtn) {
      return;
    }

    // Keep the inline editor outside the picker so variant morphs preserve drafts.
    // Products without fit tabs retain the standalone measurement dialog.
    const usesInlineForm = !!fitScope()?.querySelector('[data-mv-fit-tab="custom"]');
    if (!overlay.isConnected || overlay.parentElement !== document.body) document.body.appendChild(overlay);
    if (usesInlineForm) {
      block.classList.add('has-inline-form');
      modal.classList.add('cs-inline');
      modal.setAttribute('role', 'region');
      modal.setAttribute('aria-label', 'Custom measurements');
      block.appendChild(modal);
    } else if (!modal.isConnected || modal.parentElement !== document.body) {
      document.body.appendChild(modal);
    }

    const inputs    = modal.querySelectorAll('[data-key]');
    const tabBtns   = modal.querySelectorAll('[data-tab]');
    const guidePanel = modal.querySelector('[data-panel="htm"]');
    const tabPanels = modal.querySelectorAll('[data-panel]:not([data-panel="htm"])');
    const unitBtns  = modal.querySelectorAll('[data-cs-unit]');
    const tabsNav   = modal.querySelector('.cs-tabs-nav-' + id);
    if (usesInlineForm && tabsNav) {
      const formTab = tabsNav.querySelector('[data-tab="form"]');
      if (formTab) formTab.textContent = 'Measurements';
      tabsNav.appendChild(unit);
    }
    // Native dialog keeps the guide outside document flow and traps focus.
    document.body.appendChild(measureDialog);
    if (guidePanel) {
      measureDialog.querySelector('.cs-measure-dialog-body-' + id).appendChild(guidePanel);
      guidePanel.classList.add('active');
    }
    let guidePreviousOverflow = null;
    function restoreGuideScroll() {
      if (guidePreviousOverflow === null) return;
      document.body.style.overflow = guidePreviousOverflow;
      guidePreviousOverflow = null;
    }
    function openMeasureGuide() {
      if (measureDialog.open) return;
      guidePreviousOverflow = document.body.style.overflow;
      measureDialog.showModal();
      document.body.style.overflow = 'hidden';
    }
    function closeMeasureGuide() {
      if (measureDialog.open) measureDialog.close();
      restoreGuideScroll();
    }
    measureDialog.querySelector('button').addEventListener('click', closeMeasureGuide);
    measureDialog.addEventListener('cancel', restoreGuideScroll);
    measureDialog.addEventListener('close', restoreGuideScroll);
    measureDialog.addEventListener('click', (event) => {
      if (event.target !== measureDialog) return;
      const rect = measureDialog.getBoundingClientRect();
      if (event.clientX < rect.left || event.clientX > rect.right || event.clientY < rect.top || event.clientY > rect.bottom) closeMeasureGuide();
    });

    let sheetHeightTimer = null;
    function animateMobileSheetHeight(mutator) {
      if (typeof mutator !== 'function') return;
      const isMobile = window.matchMedia('(max-width: 749px)').matches;
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (usesInlineForm || !isMobile || reduceMotion || !modal.classList.contains('active')) {
        mutator();
        return;
      }

      const from = modal.getBoundingClientRect().height;
      modal.style.transitionProperty = 'none';
      modal.style.height = 'auto';
      const to = modal.getBoundingClientRect().height;
      modal.style.height = from + 'px';
      void modal.offsetHeight;
      modal.style.transitionProperty = '';

      mutator();

      // Measure once more after DOM state changes; max-height still caps the sheet.
      modal.style.transitionProperty = 'none';
      modal.style.height = 'auto';
      const finalHeight = modal.getBoundingClientRect().height || to;
      modal.style.height = from + 'px';
      void modal.offsetHeight;
      modal.style.transitionProperty = '';

      requestAnimationFrame(() => {
        modal.style.height = finalHeight + 'px';
      });

      if (sheetHeightTimer) clearTimeout(sheetHeightTimer);
      sheetHeightTimer = setTimeout(() => {
        modal.style.height = '';
      }, 420);
    }

    let currentUnit = 'cm';
    let savedData   = null;
    let pendingData = null;
    let isChecked   = true;
    let lastStandardSize = null;

    const fieldMeta = {
      bust:   { label: 'Bust' },
      waist:  { label: 'Waist' },
      hips:   { label: 'Hips' },
      hollow: { label: 'Hollow to Floor' },
      height: { label: 'Height' }
    };

    function getVariantPicker() {
      return document.querySelector('variant-picker[data-product-id="' + PRODUCT_ID + '"]')
        || document.querySelector('variant-picker');
    }

    function getProductForms() {
      const forms = [];
      const seen = new Set();

      document.querySelectorAll('product-form-component').forEach(component => {
        if (component.dataset.productId && String(component.dataset.productId) !== String(PRODUCT_ID)) return;
        const form = component.querySelector('form[action*="/cart/add"]');
        if (form && !seen.has(form)) {
          seen.add(form);
          forms.push(form);
        }
      });

      if (forms.length === 0) {
        document.querySelectorAll('form[action*="/cart/add"]').forEach(form => {
          if (!seen.has(form)) {
            seen.add(form);
            forms.push(form);
          }
        });
      }

      return forms;
    }

    function optionNameOf(control) {
      if (!control) return '';
      return (control?.dataset?.optionName || '').trim().toLowerCase();
    }

    function isSizeControl(control) {
      const name = optionNameOf(control);
      return name === 'size' || name === '尺寸';
    }

    function valueOf(control) {
      return control?.value || '';
    }

    function getCurrentSizeControl() {
      const picker = getVariantPicker();
      if (!picker) return null;

      return Array.from(picker.querySelectorAll('input[type="radio"]:checked')).find(isSizeControl) || null;
    }

    function getSizeRadio(value) {
      const picker = getVariantPicker();
      if (!picker) return null;
      return Array.from(picker.querySelectorAll('input[type="radio"]')).find(input => {
        return isSizeControl(input) && input.value === value;
      }) || null;
    }

    function captureStandardSize() {
      const current = getCurrentSizeControl();
      if (current && valueOf(current) && valueOf(current) !== PLACEHOLDER_SIZE) {
        lastStandardSize = valueOf(current);
        return;
      }

      const picker = getVariantPicker();
      if (!picker) return;
      const fallback = Array.from(picker.querySelectorAll('input[type="radio"]')).find(input => {
        return isSizeControl(input) && input.value !== PLACEHOLDER_SIZE && input.dataset.optionAvailable !== 'false';
      });
      if (fallback && !lastStandardSize) lastStandardSize = fallback.value;
    }

    function openModal() {
      if (!usesInlineForm) {
        overlay.classList.add('active');
        document.body.style.overflow = 'hidden';
      }
      modal.classList.add('active');
      if (savedData) {
        inputs.forEach(inp => {
          if (savedData[inp.dataset.key] !== undefined) inp.value = savedData[inp.dataset.key];
        });
      }
      switchTab('form');
    }

    function closeModal() {
      closeMeasureGuide();
      overlay.classList.remove('active');
      modal.classList.remove('active');
      if (!usesInlineForm) document.body.style.overflow = '';
    }

    function expandSummary() {
      block.classList.add('expanded');
      summary?.classList.add('visible');
    }

    function collapseSummary() {
      block.classList.remove('expanded');
      summary?.classList.remove('visible');
    }

    function removePropertyInputs() {
      getProductForms().forEach(form => {
        form.querySelectorAll('input[name="properties[Custom Size]"]').forEach(inp => inp.remove());
      });
    }

    function syncProperty() {
      if (!savedData || !isChecked) {
        removePropertyInputs();
        return;
      }

      const u = savedData._unit === 'cm' ? 'cm' : 'in';
      const parts = [];
      Object.entries(fieldMeta).forEach(([k, m]) => {
        if (savedData[k] !== undefined) parts.push(m.label + ' ' + savedData[k] + u);
      });
      const value = parts.join(' / ');

      getProductForms().forEach(form => {
        let inp = form.querySelector('input[name="properties[Custom Size]"]');
        if (!inp) {
          inp = document.createElement('input');
          inp.type = 'hidden';
          inp.name = 'properties[Custom Size]';
          form.appendChild(inp);
        }
        inp.value = value;
      });
    }

    // Size changes made by the fit preference tabs must not be treated as a
    // shopper picking a standard size (that would wipe the saved measurements).
    function withProgrammaticSizeChange(control, action) {
      if (!control) {
        action();
        return;
      }
      control.dataset.mvProgrammaticSize = 'true';
      try {
        action();
      } finally {
        delete control.dataset.mvProgrammaticSize;
      }
    }

    function selectNativeSize(value) {
      const radio = getSizeRadio(value);
      if (radio) {
        if (!radio.checked) withProgrammaticSizeChange(radio, () => radio.click());
        return true;
      }

      return false;
    }

    function syncNativeSizeVariant(toCustom) {
      if (toCustom) {
        captureStandardSize();
        if (!HAS_PLACEHOLDER_SIZE) return false;
        return selectNativeSize(PLACEHOLDER_SIZE);
      }

      captureStandardSize();
      let target = lastStandardSize;
      if (!target || target === PLACEHOLDER_SIZE) {
        const picker = getVariantPicker();
        const fallback = picker
          ? Array.from(picker.querySelectorAll('input[type="radio"]')).find(input =>
              isSizeControl(input) &&
              input.value !== PLACEHOLDER_SIZE &&
              input.dataset.optionAvailable !== 'false'
            )
          : null;
        target = fallback?.value || null;
      }

      if (target) return selectNativeSize(target);
      return false;
    }

    function resetCustomSizeState(options = {}) {
      const { clearInputs = true, switchVariant = false } = options;
      savedData = null;
      pendingData = null;
      isChecked = true;
      if (clearInputs) inputs.forEach(inp => inp.value = '');
      cbBox?.classList.remove('unchecked');
      cbRow?.classList.remove('unchecked');
      collapseSummary();
      block.classList.remove('has-data');
      removePropertyInputs();
      if (switchVariant) syncNativeSizeVariant(false);
      if (usesInlineForm) openModal();
    }

    trigger.addEventListener('click', () => {
      if (!savedData) openModal();
      else block.classList.contains('expanded') ? collapseSummary() : expandSummary();
    });

    overlay.addEventListener('click', closeModal);
    closeBtn.addEventListener('click', closeModal);
    editBtn.addEventListener('click', openModal);

    cancelBtn.addEventListener('click', () => {
      resetCustomSizeState({ clearInputs: true, switchVariant: true });
    });

    unitBtns.forEach(btn => btn.addEventListener('click', () => setUnit(btn.dataset.csUnit)));
    tabBtns.forEach(b => b.addEventListener('click', () => {
      if (b.dataset.tab === 'htm') openMeasureGuide();
      else switchTab(b.dataset.tab);
    }));

    function switchTab(tab) {
      const nextPanel = Array.from(tabPanels).find(p => p.dataset.panel === tab);
      animateMobileSheetHeight(() => {
        if (tabsNav) tabsNav.dataset.activeTab = tab;
        tabBtns.forEach(b => b.classList.toggle('active', b.dataset.tab === tab));
        tabPanels.forEach(p => p.classList.toggle('active', p.dataset.panel === tab));
      });

      if (nextPanel && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        requestAnimationFrame(() => {
          nextPanel.animate(
            [
              { opacity: 0, transform: 'translateY(4px)' },
              { opacity: 1, transform: 'translateY(0)' }
            ],
            { duration: 240, easing: 'cubic-bezier(.22,.72,.24,1)', fill: 'both' }
          );
        });
      }
    }

    function setUnit(nextUnit) {
      if (nextUnit !== 'cm' && nextUnit !== 'inch') return;
      if (nextUnit === currentUnit) return;

      const previousUnit = currentUnit;
      currentUnit = nextUnit;
      const lbl = currentUnit === 'cm' ? 'cm' : 'in';

      unit.dataset.activeUnit = currentUnit;
      unitBtns.forEach(btn => {
        const active = btn.dataset.csUnit === currentUnit;
        btn.classList.toggle('active', active);
        btn.setAttribute('aria-pressed', active ? 'true' : 'false');
      });

      inputs.forEach(inp => {
        const ph = currentUnit === 'cm' ? inp.dataset.cm : inp.dataset.inch;
        inp.placeholder = 'e.g. ' + ph + ' ' + lbl;
        if (inp.value) {
          const v = parseFloat(inp.value);
          if (!Number.isNaN(v)) {
            inp.value = previousUnit === 'inch' && currentUnit === 'cm'
              ? (v * 2.54).toFixed(1)
              : (v / 2.54).toFixed(1);
          }
        }
      });

      modal.querySelectorAll('[data-cs-unit-label]').forEach(el => el.textContent = lbl);
    }

    function showSummary() {
      const u = savedData._unit === 'cm' ? 'cm' : 'in';
      if (sumTags) {
        sumTags.innerHTML = Object.entries(fieldMeta)
          .filter(([k]) => savedData[k] !== undefined)
          .map(([k, m]) => '<span><strong>' + m.label + '</strong> ' + savedData[k] + u + '</span>')
          .join('');
      }
      summary?.classList.add('visible');
      block.classList.add('has-data');
      block.classList.add('expanded');
      if (trigTitle) trigTitle.textContent = 'Enter measurements';
    }

    function validateAndCollect() {
      const data = {};
      let valid = true;

      inputs.forEach(inp => {
        const v = inp.value.trim();
        const req = inp.dataset.required === 'true';
        inp.style.borderColor = '';
        inp.style.animation = '';

        if (req && (!v || isNaN(v) || parseFloat(v) <= 0)) {
          inp.style.borderColor = '#B4465E';
          void inp.offsetWidth;
          inp.style.animation = 'cs-shake-' + id + ' 0.4s ease';
          setTimeout(() => inp.style.animation = '', 400);
          valid = false;
        } else if (v && !isNaN(v) && parseFloat(v) > 0) {
          data[inp.dataset.key] = parseFloat(v);
        }
      });

      return valid ? data : null;
    }

    function propStringOf(data) {
      const u = data._unit === 'cm' ? 'cm' : 'in';
      return Object.entries(fieldMeta).filter(([k]) => data[k] !== undefined)
        .map(([k, m]) => m.label + ' ' + data[k] + u).join(' / ');
    }

    function showReview(data) {
      if (reviewTags) {
        reviewTags.innerHTML = Object.entries(fieldMeta).filter(([k]) => data[k] !== undefined)
          .map(([k, m]) => '<div class="cs-review-tag-' + id + '"><span class="k">' + m.label + '</span><span class="v">' + data[k] + ' ' + (data._unit === 'cm' ? 'cm' : 'in') + '</span></div>').join('');
      }
      if (propVal) propVal.textContent = propStringOf(data);
      tabPanels.forEach(p => p.classList.toggle('active', p.dataset.panel === 'review'));
      tabBtns.forEach(b => b.classList.toggle('active', b.dataset.tab === 'form'));
      if (tabsNav) tabsNav.dataset.activeTab = 'form';
    }

    nextBtn.addEventListener('click', () => {
      const data = validateAndCollect();
      if (!data) return;
      data._unit = currentUnit;
      pendingData = data;
      showReview(data);
    });

    backBtn.addEventListener('click', () => switchTab('form'));

    confirmBtn.addEventListener('click', () => {
      if (!pendingData) return;
      savedData = pendingData;
      isChecked = true;
      cbBox?.classList.remove('unchecked');
      cbRow?.classList.remove('unchecked');

      showSummary();
      syncProperty();

      if (!syncNativeSizeVariant(true)) {
        resetCustomSizeState({ clearInputs: false, switchVariant: false });
        console.error('[Custom Sizes] This product needs a real Shopify Size option value named "Custom Sizes" or "Custom Size".');
        window.alert('Custom sizing is not configured for this product yet. Please add a "Custom Sizes" value to the Shopify Size option.');
        return;
      }

      closeModal();
      switchTab('form');
    });

    inputs.forEach(inp => inp.addEventListener('input', () => {
      inp.style.borderColor = '';
      inp.style.animation = '';
    }));

    clearBtn.addEventListener('click', () => inputs.forEach(inp => inp.value = ''));

    cbRow?.addEventListener('click', () => {
      isChecked = !isChecked;
      cbBox?.classList.toggle('unchecked', !isChecked);
      cbRow.classList.toggle('unchecked', !isChecked);
      cbRow?.setAttribute('aria-checked', isChecked ? 'true' : 'false');
      syncProperty();
      syncNativeSizeVariant(isChecked);
    });

    // Keyboard support for the "Include in order" switch.
    cbRow?.addEventListener('keydown', (event) => {
      if (event.key !== 'Enter' && event.key !== ' ') return;
      event.preventDefault();
      cbRow.click();
    });

    // Same clear rule as the example: once the customer chooses a normal Shopify
    // Size again, Custom Size is no longer part of the line item. Registered
    // through the document handler registry below (single live instance).

    captureStandardSize();

    // ------------------------------------------------------------------
    // Document level listeners. A section reload re-runs this script, so the
    // handlers live in a registry: the previous instance's listeners are
    // removed first, otherwise a stale closure would answer events.
    // ------------------------------------------------------------------
    const REGISTRY = (window.__mvCustomSizesHandlers = window.__mvCustomSizesHandlers || {});
    if (REGISTRY.fitMode) document.removeEventListener('mv:fit-mode', REGISTRY.fitMode);
    if (REGISTRY.submit) document.removeEventListener('submit', REGISTRY.submit, true);
    if (REGISTRY.change) document.removeEventListener('change', REGISTRY.change, true);
    if (REGISTRY.keydown) document.removeEventListener('keydown', REGISTRY.keydown);

    REGISTRY.fitMode = (event) => {
      const detail = event.detail || {};
      // Events from a different product's variant picker must not switch this block.
      if (detail.productId && String(detail.productId) !== String(PRODUCT_ID)) return;
      const mode = detail.mode;
      if (mode === 'custom') {
        if (usesInlineForm) openModal();
        if (savedData && isChecked) syncProperty();
        syncNativeSizeVariant(true);
      } else if (mode === 'standard') {
        if (usesInlineForm) closeModal();
        removePropertyInputs();
        syncNativeSizeVariant(false);
      }
    };

    // Add to bag validation: the standard and the custom path are checked
    // separately so a standard size is never submitted as a custom size.
    REGISTRY.submit = (event) => {
      const form = event.target;
      if (!(form instanceof HTMLFormElement)) return;
      if (!form.matches('form[action*="/cart/add"]')) return;
      if (getProductForms().indexOf(form) === -1) return;

      const mode = currentFitMode();

      if (mode === 'standard') {
        // Accept whatever control the Size option currently renders as:
        // matrix/button radios or a single fixed value.
        const control = getCurrentSizeControl();
        const controlOk = control && valueOf(control) && valueOf(control) !== PLACEHOLDER_SIZE;

        let singleOk = false;
        if (!controlOk) {
          const picker = getVariantPicker();
          const single = picker
            ? picker.querySelector('[data-mv-standard-size-panel] [data-testid="variant-option-single-value"]')
            : null;
          const singleValue = single ? (single.textContent || '').trim() : '';
          singleOk = !!singleValue && singleValue !== PLACEHOLDER_SIZE;
        }

        if (!controlOk && !singleOk) {
          event.preventDefault();
          event.stopPropagation();
          showFitError('Please select a size before adding to bag.');
        }
        return;
      }

      if (mode === 'custom') {
        if (!savedData) {
          event.preventDefault();
          event.stopPropagation();
          showFitError('Please enter your measurements before adding to bag.');
          if (usesInlineForm) openModal();
          return;
        }
        if (!isChecked) {
          event.preventDefault();
          event.stopPropagation();
          showFitError('Please keep "Include in order" checked to add your custom size.');
        }
      }
    };

    REGISTRY.change = (event) => {
      const control = event.target;
      if (!(control instanceof HTMLInputElement)) return;
      // Ignore size switches performed by the fit preference tabs.
      if (control.dataset && control.dataset.mvProgrammaticSize) return;

      const picker = control.closest('variant-picker');
      if (!picker || String(picker.dataset.productId || '') !== String(PRODUCT_ID)) return;
      if (!isSizeControl(control)) return;

      const value = valueOf(control);
      if (value && value !== PLACEHOLDER_SIZE) {
        lastStandardSize = value;
        if (savedData || block.classList.contains('has-data')) {
          resetCustomSizeState({ clearInputs: true, switchVariant: false });
        } else {
          removePropertyInputs();
        }
      }
    };

    REGISTRY.keydown = (event) => {
      if (measureDialog.open) return;
      if (event.key === 'Escape' && !usesInlineForm) closeModal();
    };

    document.addEventListener('mv:fit-mode', REGISTRY.fitMode);
    document.addEventListener('submit', REGISTRY.submit, true);
    document.addEventListener('change', REGISTRY.change, true);
    document.addEventListener('keydown', REGISTRY.keydown);
    if (usesInlineForm && currentFitMode() === 'custom') openModal();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }

  // Bind the re-init hooks once: every section load re-runs this script, and
  // stacking listeners would call init several times per event.
  if (!window.__mvCustomSizesHooks) {
    window.__mvCustomSizesHooks = true;
    document.addEventListener('shopify:section:load', init);
    document.addEventListener('shopify:block:select', init);
  }
})();
</script>

{%- endif -%}

