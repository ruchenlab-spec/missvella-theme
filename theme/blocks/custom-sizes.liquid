{% doc %}
  Custom Sizes v7 — Horizon ProductSelectEvent compatible
  - Renders whenever the product has a Size option, so the Custom Size entry never disappears just because the technical placeholder is absent/mis-cased.
  - Recognizes both "Custom Sizes" and "Custom Size" as the technical Shopify placeholder value.
  - Keeps the native Size picker UI / three-column layout untouched.
  - Saving measurements selects the real hidden placeholder option and writes properties[Custom Size].
  - Selecting a normal Size clears properties[Custom Size] and the saved custom-size UI state.
{% enddoc %}

{%- liquid
  assign p = closest.product
  if request.visual_preview_mode and p == blank
    assign p = collections.all.products.first
  endif

  assign cs_id = block.id | replace: '_', '' | downcase
  assign size_opt = blank
  assign custom_size_placeholder_value = blank
  assign has_custom_size_placeholder = false

  if p
    assign size_opt = p.options_by_name['Size']
    if size_opt == blank
      assign size_opt = p.options_by_name['尺寸']
    endif
  endif

  if size_opt
    for size_value in size_opt.values
      assign size_value_name = size_value.name | default: size_value
      assign size_value_key = size_value_name | strip | downcase
      if size_value_key == 'custom sizes' or size_value_key == 'custom size'
        assign custom_size_placeholder_value = size_value_name
        assign has_custom_size_placeholder = true
        break
      endif
    endfor
  endif
-%}

{%- if size_opt != blank -%}
{%- liquid
  assign accent_color = block.settings.accent_color | default: '#1A1A1A'
  assign accent_r = accent_color | color_extract: 'red'
  assign accent_g = accent_color | color_extract: 'green'
  assign accent_b = accent_color | color_extract: 'blue'
-%}
{% style %}
.cs-block-{{ cs_id }},
#cs-measure-dialog-{{ cs_id }} {
  --mv-pal-accent: {{ accent_color }};
  --mv-pal-accent-rgb: {{ accent_r }}, {{ accent_g }}, {{ accent_b }};
  --mv-pal-gold: #C9A227;
  /* Neutral surfaces follow the theme palette; only the accent is a
     merchant-controlled local setting. */
  --mv-pal-ink: var(--color-foreground);
  --mv-pal-surface: var(--color-background);
  --mv-pal-page: rgb(var(--color-foreground-rgb) / 0.03);
  --mv-pal-border: var(--color-border, rgb(var(--color-foreground-rgb) / 0.12));
  --mv-pal-muted: var(--color-foreground-muted, rgb(var(--color-foreground-rgb) / 0.55));
  font-family: var(--font-body--family, 'Helvetica Neue', sans-serif);
  color: var(--mv-pal-ink);
}

.cs-trigger-{{ cs_id }} {
  width: 100%;
  min-height: 62px;
  padding: 12px 16px;
  background: var(--mv-pal-surface);
  border: 1px solid var(--mv-pal-border);
  border-radius: 14px;
  cursor: pointer;
  display: flex;
  align-items: center;
  gap: 12px;
  font-family: inherit;
  text-align: left;
  box-sizing: border-box;
  transition: border-color .18s ease, box-shadow .18s ease, transform .18s ease;
}
@media (hover:hover) {
  .cs-trigger-{{ cs_id }}:hover {
    border-color: rgb(var(--mv-pal-accent-rgb) / 55%);
    box-shadow: 0 10px 26px rgb(var(--mv-pal-accent-rgb) / 10%);
    transform: translateY(-1px);
  }
}
.cs-trigger-{{ cs_id }}:focus-visible,
.cs-btn-edit-{{ cs_id }}:focus-visible,
.cs-btn-cancel-{{ cs_id }}:focus-visible,
.cs-tab-btn-{{ cs_id }}:focus-visible {
  outline: 2px solid var(--mv-pal-accent);
  outline-offset: 2px;
}
.cs-trigger-icon-{{ cs_id }} {
  width: 38px;
  height: 38px;
  border-radius: 11px;
  display: grid;
  place-items: center;
  background: var(--mv-pal-page);
  border: 1px solid var(--mv-pal-border);
  color: var(--mv-pal-accent);
  flex-shrink: 0;
  transition: background .16s ease, color .16s ease, border-color .16s ease;
}
.cs-trigger-icon-{{ cs_id }} svg { width: 18px; height: 18px; color: currentColor; }
.cs-trigger-icon-{{ cs_id }} img { width: 18px; height: 18px; display: block; object-fit: contain; }
/* Keep the Custom Size service icon visually stable after measurements are saved. */
.cs-block-{{ cs_id }}.has-data .cs-trigger-icon-{{ cs_id }} {
  background: var(--mv-pal-page);
  color: var(--mv-pal-accent);
  border-color: var(--mv-pal-border);
}
.cs-trigger-body-{{ cs_id }} { flex: 1; min-width: 0; }
.cs-trigger-title-{{ cs_id }} {
  font-family: var(--font-heading--family, Georgia, 'Times New Roman', serif);
  font-size: 15px;
  font-weight: 600;
  color: var(--mv-pal-ink);
  letter-spacing: .01em;
  line-height: 1.25;
}
.cs-trigger-sub-{{ cs_id }} {
  font-size: 9.5px;
  color: var(--mv-pal-gold);
  margin-top: 3px;
  line-height: 1.3;
  letter-spacing: .14em;
  text-transform: uppercase;
  font-weight: 600;
}
.cs-trigger-right-{{ cs_id }} {
  display: flex;
  align-items: center;
  gap: 8px;
  flex-shrink: 0;
  color: var(--mv-pal-accent);
}
.cs-block-{{ cs_id }}.has-data.expanded .cs-trigger-right-{{ cs_id }} .mv-chevron { transform: rotate(180deg); }

.cs-summary-{{ cs_id }} {
  display: none;
  margin-top: 8px;
  padding: 14px;
  border: 1px solid var(--mv-pal-border);
  border-radius: 14px;
  background: var(--mv-pal-surface);
  box-sizing: border-box;
}
.cs-summary-{{ cs_id }}.visible,
.cs-block-{{ cs_id }}.has-data.expanded .cs-summary-{{ cs_id }} {
  display: flex;
  flex-direction: column;
}
.cs-block-{{ cs_id }}.has-data:not(.expanded) .cs-summary-{{ cs_id }} { display: none; }
.cs-summary-label-{{ cs_id }} {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  padding-bottom: 11px;
  border-bottom: 1px dashed var(--mv-pal-border);
}
.cs-summary-title-{{ cs_id }} {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  font-family: var(--font-heading--family, Georgia, 'Times New Roman', serif);
  font-size: 13.5px;
  font-weight: 600;
  color: var(--mv-pal-ink);
}
.cs-summary-title-{{ cs_id }} .cs-ruler-icon { width: 16px; height: 16px; color: var(--mv-pal-accent); }
.cs-summary-status-{{ cs_id }} {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 4px 9px;
  border-radius: 999px;
  font-size: 9.5px;
  font-weight: 600;
  letter-spacing: .06em;
  text-transform: uppercase;
  color: var(--mv-pal-accent);
  background: rgb(var(--mv-pal-accent-rgb) / 8%);
  white-space: nowrap;
}
.cs-status-dot-{{ cs_id }} {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: var(--mv-pal-accent);
}
.cs-summary-tags-{{ cs_id }} {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  padding: 11px 0;
}
.cs-summary-tags-{{ cs_id }} span {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  min-height: 26px;
  padding: 4px 9px;
  border-radius: 999px;
  background: var(--mv-pal-page);
  border: 1px solid var(--mv-pal-border);
  color: var(--mv-pal-muted);
  font-size: 10.5px;
  white-space: nowrap;
}
.cs-summary-tags-{{ cs_id }} span strong { color: var(--mv-pal-ink); font-weight: 600; }
.cs-summary-bottom-{{ cs_id }} {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  padding-top: 11px;
  border-top: 1px dashed var(--mv-pal-border);
}
.cs-checkbox-row-{{ cs_id }} {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  cursor: pointer;
}
.cs-checkbox-box-{{ cs_id }} {
  width: 20px;
  height: 20px;
  border-radius: 6px;
  display: grid;
  place-items: center;
  color: #fff;
  background: var(--mv-pal-accent);
  flex-shrink: 0;
  transition: background .16s ease, box-shadow .16s ease;
}
.cs-checkbox-box-{{ cs_id }}.unchecked {
  background: var(--mv-pal-surface);
  box-shadow: inset 0 0 0 1px rgb(var(--color-foreground-rgb) / 0.3);
}
.cs-checkbox-box-{{ cs_id }} svg { width: 12px; height: 12px; }
.cs-checkbox-box-{{ cs_id }}.unchecked svg { display: none; }
.cs-checkbox-label-{{ cs_id }} { font-size: 11px; color: var(--mv-pal-ink); font-weight: 500; }
.cs-checkbox-row-{{ cs_id }}.unchecked .cs-checkbox-label-{{ cs_id }} { color: var(--mv-pal-muted); }
.cs-summary-actions-{{ cs_id }} { display: inline-flex; gap: 7px; flex-shrink: 0; }
.cs-btn-edit-{{ cs_id }},
.cs-btn-cancel-{{ cs_id }} {
  min-height: 32px;
  padding: 0 14px;
  border-radius: 999px;
  font: inherit;
  font-size: 10.5px;
  font-weight: 600;
  cursor: pointer;
  transition: transform .14s ease, background .14s ease, border-color .14s ease;
}
.cs-btn-edit-{{ cs_id }} { border: 1px solid var(--mv-pal-accent); background: var(--mv-pal-accent); color: #fff; }
.cs-btn-cancel-{{ cs_id }} { border: 1px solid var(--mv-pal-border); background: #fff; color: var(--mv-pal-muted); }
@media (hover:hover) {
  .cs-btn-edit-{{ cs_id }}:hover { background: rgb(var(--mv-pal-accent-rgb) / 85%); border-color: rgb(var(--mv-pal-accent-rgb) / 85%); transform: translateY(-1px); }
  .cs-btn-cancel-{{ cs_id }}:hover { border-color: var(--mv-pal-accent); color: var(--mv-pal-accent); }
}

#cs-overlay-{{ cs_id }} {
  display: none;
  position: fixed;
  inset: 0;
  background: rgb(26 22 20 / 34%);
  z-index: 2147483646;
}
#cs-overlay-{{ cs_id }}.active { display: block; }
#cs-modal-{{ cs_id }} {
  /* The modal is portaled to <body>, so it must carry the full palette
     itself — nothing can be inherited from .cs-block-{{ cs_id }}. */
  --mv-pal-accent: {{ accent_color }};
  --mv-pal-accent-rgb: {{ accent_r }}, {{ accent_g }}, {{ accent_b }};
  --mv-pal-gold: #C9A227;
  --mv-pal-ink: var(--color-foreground);
  --mv-pal-surface: var(--color-background);
  --mv-pal-page: rgb(var(--color-foreground-rgb) / 0.03);
  --mv-pal-border: var(--color-border, rgb(var(--color-foreground-rgb) / 0.12));
  --mv-pal-muted: var(--color-foreground-muted, rgb(var(--color-foreground-rgb) / 0.55));
  position: fixed;
  background: var(--mv-pal-surface);
  color: var(--mv-pal-ink);
  z-index: 2147483647;
  flex-direction: column;
  overflow: hidden;
  box-shadow: 0 40px 90px rgb(26 22 20 / 28%);
  display: flex;
  opacity: 1;
  visibility: hidden;
  pointer-events: none;
  transition: transform .3s cubic-bezier(.22,.61,.36,1), opacity .3s ease, visibility 0s linear .3s;
}
#cs-modal-{{ cs_id }}.active {
  visibility: visible;
  pointer-events: auto;
  transition-delay: 0s;
}
@media screen and (min-width: 750px) {
  #cs-modal-{{ cs_id }} {
    top: 50%;
    left: 50%;
    width: min(560px, calc(100vw - 48px));
    height: min(86vh, 720px);
    border-radius: 22px;
    transform: translate(-50%, -46%) scale(.97);
    opacity: 0;
  }
  #cs-modal-{{ cs_id }}.active {
    transform: translate(-50%, -50%) scale(1);
    opacity: 1;
  }
}
@media screen and (max-width: 749px) {
  #cs-modal-{{ cs_id }} {
    bottom: 0; left: 0; right: 0;
    width: 100%; max-height: 90vh;
    border-radius: 18px 18px 0 0;
    transform: translateY(100%);
    transition: transform .34s cubic-bezier(.22,.72,.24,1), height .36s cubic-bezier(.22,.72,.24,1), visibility 0s linear .34s;
    will-change: transform, height;
  }
  #cs-modal-{{ cs_id }}.active {
    transition-delay: 0s;
    transform: translateY(0);
  }
  #cs-modal-{{ cs_id }}::before {
    content: '';
    width: 38px;
    height: 4px;
    border-radius: 4px;
    background: rgb(var(--color-foreground-rgb) / 0.22);
    margin: 8px auto -2px;
    flex-shrink: 0;
  }
}
.cs-modal-header-{{ cs_id }} {
  border-radius: 0;
  border-bottom: 1px solid var(--mv-pal-border);
  padding: 20px 28px 0;
  background: var(--mv-pal-surface);
}
.cs-modal-kicker-{{ cs_id }} {
  font-size: 10px;
  color: var(--mv-pal-gold);
  font-weight: 600;
  letter-spacing: .22em;
  text-transform: uppercase;
}
.cs-modal-title-{{ cs_id }} {
  font-family: var(--font-heading--family, Georgia, 'Times New Roman', serif);
  font-size: 20px;
  color: var(--mv-pal-ink);
  font-weight: 600;
  margin-top: 5px;
}
.cs-modal-subtitle-{{ cs_id }} {
  margin-top: 3px;
  font-size: 11px;
  line-height: 1.4;
  color: var(--mv-pal-muted);
}

 .cs-tabs-nav-{{ cs_id }} {
  display: flex;
  margin: 18px 28px 0;
  border-bottom: 1px solid var(--mv-pal-border);
  flex-shrink: 0;
}
.cs-tab-btn-{{ cs_id }} {
  flex: 1;
  min-height: 46px;
  padding: 0 10px;
  background: transparent;
  border: 0;
  border-bottom: 2px solid transparent;
  margin-bottom: -1px;
  font-family: inherit;
  font-size: 10.5px;
  font-weight: 600;
  letter-spacing: .12em;
  text-transform: uppercase;
  color: var(--mv-pal-muted);
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 7px;
  transition: color .25s ease, border-color .25s ease;
}
.cs-tab-btn-{{ cs_id }} svg {
  width: 14px;
  height: 14px;
  color: currentColor;
}
.cs-tab-btn-{{ cs_id }}.active {
  color: var(--mv-pal-accent);
  border-color: var(--mv-pal-accent);
}

/* CM / IN segmented control */
.cs-unit-toggle-{{ cs_id }} {
  display: inline-flex;
  border: 1px solid var(--mv-pal-border);
  border-radius: 999px;
  background: var(--mv-pal-page);
  padding: 3px;
  box-sizing: border-box;
  flex-shrink: 0;
}
.cs-unit-btn-{{ cs_id }} {
  height: 28px;
  padding: 0 16px;
  border: 0;
  border-radius: 999px;
  background: transparent;
  color: var(--mv-pal-muted);
  font: inherit;
  font-size: 10.5px;
  font-weight: 650;
  line-height: 1;
  cursor: pointer;
  transition: color .2s ease, background .2s ease;
}
.cs-unit-btn-{{ cs_id }}.active {
  background: var(--mv-pal-accent);
  color: var(--color-background, #FFFFFF);
}
.cs-unit-btn-{{ cs_id }}:active { transform: scale(.96); }
.cs-unit-btn-{{ cs_id }}:focus-visible {
  outline: 2px solid var(--mv-pal-accent);
  outline-offset: 2px;
}
.cs-modal-body-{{ cs_id }} { overflow-y: auto; flex: 1; min-height: 0; background: var(--mv-pal-surface); }
.cs-tab-panel-{{ cs_id }} { display: none; }
.cs-tab-panel-{{ cs_id }}.active { display: block; }
/* The real form panel has no .cs-form-wrap element; apply the gutter to the actual panel. */
.cs-modal-body-{{ cs_id }} > .cs-tab-panel-{{ cs_id }}[data-panel='form'] {
  padding: 22px 28px 28px;
  box-sizing: border-box;
}
.cs-form-group-{{ cs_id }} {
  display: flex;
  flex-direction: column;
  gap: 7px;
  min-width: 0;
}
.cs-form-label-row-{{ cs_id }} {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 8px;
  min-height: 18px;
}
.cs-form-grid-{{ cs_id }} {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16px;
}
@media screen and (max-width: 749px) {
  .cs-form-grid-{{ cs_id }} { grid-template-columns: 1fr; gap: 10px; }
  .cs-modal-header-{{ cs_id }} { padding: 16px 20px 0; }
  .cs-tabs-nav-{{ cs_id }} { margin-inline: 20px; }
  .cs-modal-body-{{ cs_id }} > .cs-tab-panel-{{ cs_id }}[data-panel='form'] { padding: 18px 20px 22px; }
}
.cs-field-{{ cs_id }} { display: flex; flex-direction: column; gap: 6px; }
.cs-field-head-{{ cs_id }} {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
}
.cs-form-label-{{ cs_id }} {
  font-size: 12px;
  font-weight: 600;
  color: var(--mv-pal-ink);
}
.cs-optional-tag-{{ cs_id }} {
  font-size: 9.5px;
  color: var(--mv-pal-muted);
  text-transform: uppercase;
  letter-spacing: .06em;
}
.cs-input-wrap-{{ cs_id }} { position: relative; }
.cs-input-wrap-{{ cs_id }} input {
  width: 100%;
  padding: 13px 44px 13px 14px;
  border-radius: 12px;
  border: 1.5px solid var(--mv-pal-border);
  background: var(--mv-pal-page);
  font: inherit;
  font-size: 14px;
  color: var(--mv-pal-ink);
  outline: none;
  transition: border-color .2s ease, background .2s ease, box-shadow .2s ease;
}
.cs-input-wrap-{{ cs_id }} input:focus {
  border-color: var(--mv-pal-accent);
  background: var(--mv-pal-surface);
  box-shadow: 0 0 0 3.5px rgb(var(--mv-pal-accent-rgb) / 10%);
}
.cs-input-wrap-{{ cs_id }} input::placeholder { color: rgb(var(--color-foreground-rgb) / 0.35); }
.cs-input-unit-{{ cs_id }} {
  position: absolute;
  right: 13px;
  top: 50%;
  transform: translateY(-50%);
  font-size: 11px;
  color: var(--mv-pal-muted);
  pointer-events: none;
}
.cs-form-footer-{{ cs_id }} {
  display: flex;
  gap: 12px;
  margin-top: 22px;
}
.cs-btn-confirm-{{ cs_id }} {
  flex: 2;
  padding: 15px;
  border-radius: 999px;
  border: 0;
  cursor: pointer;
  font: inherit;
  font-size: 13px;
  font-weight: 600;
  letter-spacing: .04em;
  color: #FFFFFF;
  background: linear-gradient(135deg, var(--mv-pal-accent), rgb(var(--mv-pal-accent-rgb) / 82%));
  box-shadow: 0 12px 26px rgb(var(--mv-pal-accent-rgb) / 26%);
  transition: transform .2s ease, box-shadow .2s ease;
}
.cs-btn-confirm-{{ cs_id }}:hover { transform: translateY(-1px); box-shadow: 0 16px 32px rgb(var(--mv-pal-accent-rgb) / 32%); }
.cs-btn-ghost-{{ cs_id }} {
  flex: 1;
  padding: 15px;
  border-radius: 999px;
  cursor: pointer;
  background: none;
  border: 1.5px solid var(--mv-pal-border);
  color: var(--mv-pal-muted);
  font: inherit;
  font-size: 13px;
  font-weight: 500;
  transition: all .2s ease;
}
.cs-btn-ghost-{{ cs_id }}:hover { border-color: var(--mv-pal-accent); color: var(--mv-pal-accent); }

/* Review step */
.cs-review-{{ cs_id }} { display: none; }
.cs-review-{{ cs_id }}.on { display: block; }
.cs-review-tag-{{ cs_id }} {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 13px 4px;
  border-bottom: 1px dashed var(--mv-pal-border);
  font-size: 13px;
}
.cs-review-tag-{{ cs_id }} .k { color: var(--mv-pal-muted); }
.cs-review-tag-{{ cs_id }} .v { font-weight: 600; }
.cs-cart-line-{{ cs_id }} {
  margin-top: 20px;
  padding: 14px 18px;
  border-radius: 14px;
  background: var(--mv-pal-page);
  border: 1px dashed var(--mv-pal-gold);
  font-size: 12px;
  color: var(--mv-pal-muted);
  line-height: 1.8;
}
.cs-cart-line-{{ cs_id }} code {
  font-family: 'SF Mono', Consolas, monospace;
  font-size: 11px;
  color: var(--mv-pal-accent);
  background: rgb(var(--mv-pal-accent-rgb) / 7%);
  padding: 2px 6px;
  border-radius: 6px;
  word-break: break-all;
}
.cs-htm-content-{{ cs_id }} {
  display: flex;
  flex-direction: column;
  gap: 18px;
  padding: 22px 28px 28px;
}
.cs-htm-image-wrapper-{{ cs_id }} {
  position: relative;
  width: min(100%, 300px);
  margin-inline: auto;
  border-radius: 16px;
  overflow: hidden;
  background: var(--mv-pal-page);
  border: 1px solid var(--mv-pal-border);
  flex: 0 0 auto;
}
.cs-htm-image-{{ cs_id }} {
  display: block;
  width: 100%;
  height: auto;
}
.cs-measurement-list-{{ cs_id }} {
  display: flex;
  flex-direction: column;
  gap: 0;
  width: 100%;
}
.cs-measurement-step-{{ cs_id }} {
  padding-block: 12px;
  border-block-end: 1px solid var(--mv-pal-border);
}
.cs-measurement-step-{{ cs_id }}:first-child { padding-block-start: 0; }
.cs-measurement-step-{{ cs_id }}:last-child { border-block-end: 0; }
.cs-measurement-title-{{ cs_id }} {
  margin: 0;
  font-family: var(--font-body--family);
  font-size: 10px;
  font-weight: 500;
  line-height: 1.5;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--mv-pal-ink);
}
.cs-measurement-title-{{ cs_id }} span {
  margin-inline-end: 8px;
  color: var(--mv-pal-muted);
}
.cs-measurement-description-{{ cs_id }},
.cs-htm-note-{{ cs_id }} {
  margin: 5px 0 0;
  font-family: var(--font-body--family);
  font-size: 12px;
  font-weight: 400;
  line-height: 1.65;
  letter-spacing: 0;
  color: var(--mv-pal-muted);
}
.cs-htm-note-{{ cs_id }} {
  margin-block-start: 12px;
  padding-block-start: 12px;
  border-block-start: 1px solid var(--mv-pal-border);
  font-size: 11px;
}
.cs-htm-note-{{ cs_id }} p { margin: 0; }
@media screen and (max-width: 749px) {
  .cs-modal-body-{{ cs_id }} > .cs-tab-panel-{{ cs_id }}[data-panel='form'] {
    padding: 16px 18px 20px;
  }
  .cs-form-footer-{{ cs_id }} { flex-direction: column; }
  .cs-htm-content-{{ cs_id }} { padding: 16px 18px 20px; gap: 14px; }
  .cs-htm-image-wrapper-{{ cs_id }} { width: min(100%, 280px); }
}
@keyframes cs-shake-{{ cs_id }} {
  0% { transform: translateX(0); }
  20% { transform: translateX(-4px); }
  40% { transform: translateX(4px); }
  60% { transform: translateX(-3px); }
  80% { transform: translateX(3px); }
}

/* ------------------------------------------------------------------
   Fit preference integration.

   The variant picker adds a mode class to the product details wrapper
   (`mv-fit-standard` / `mv-fit-custom`). In standard mode this whole block
   stays hidden, in custom mode it is the panel content shown under the tabs.
   ------------------------------------------------------------------ */
.mv-fit-standard .custom-sizes-block {
  display: none;
}

/* ------------------------------------------------------------------
   Guide state — no measurements yet
   ------------------------------------------------------------------ */
.cs-guide-{{ cs_id }} {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 0;
  margin-block-start: 14px;
  padding: 18px 20px 20px;
  border: 1px solid var(--mv-pal-border);
  border-radius: 10px;
  background: var(--mv-pal-surface);
}

.cs-block-{{ cs_id }}.has-data .cs-guide-{{ cs_id }} {
  display: none;
}

.cs-guide-kicker-{{ cs_id }} {
  margin: 0;
  font-family: var(--font-body--family);
  font-size: 9.5px;
  font-weight: 600;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--mv-pal-gold);
}

.cs-guide-title-{{ cs_id }} {
  margin: 6px 0 0;
  font-family: var(--font-heading--family, Georgia, 'Times New Roman', serif);
  font-size: 16px;
  font-weight: 600;
  line-height: 1.25;
  color: var(--mv-pal-ink);
}

.cs-guide-hint-{{ cs_id }} {
  margin: 6px 0 14px;
  font-family: var(--font-body--family);
  font-size: 12px;
  line-height: 1.5;
  color: var(--mv-pal-muted);
}

/* The guide action doubles as the trigger that opens the measurement form.
   Styled as a primary action: it follows the theme's global button colors. */
.cs-block-{{ cs_id }} .cs-trigger-{{ cs_id }} {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  min-height: 44px;
  padding: 0 12px 0 6px;
  border: 1px solid var(--color-primary-button-background, var(--mv-pal-accent));
  border-radius: 999px;
  background: var(--color-primary-button-background, var(--mv-pal-accent));
  color: var(--color-primary-button-text, #FFFFFF);
  cursor: pointer;
  transition:
    transform 0.16s ease,
    box-shadow 0.16s ease;
}

@media (hover: hover) {
  .cs-block-{{ cs_id }} .cs-trigger-{{ cs_id }}:hover {
    transform: translateY(-1px);
    box-shadow: 0 8px 20px rgb(var(--color-foreground-rgb) / .18);
  }
}

.cs-block-{{ cs_id }} .cs-trigger-icon-{{ cs_id }} {
  width: 32px;
  height: 32px;
  border: 0;
  border-radius: 999px;
  background: rgb(255 255 255 / 0.14);
  color: var(--color-primary-button-text, #FFFFFF);
  flex-shrink: 0;
}

.cs-block-{{ cs_id }} .cs-trigger-icon-{{ cs_id }} img {
  width: 16px;
  height: 16px;
  filter: brightness(0) invert(1);
}

.cs-block-{{ cs_id }} .cs-trigger-body-{{ cs_id }} {
  flex: 0 1 auto;
  min-width: 0;
}

.cs-block-{{ cs_id }} .cs-trigger-title-{{ cs_id }} {
  font-family: var(--font-body--family);
  font-size: 12px;
  font-weight: 600;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  line-height: 1.2;
  color: var(--color-primary-button-text, #FFFFFF);
  white-space: nowrap;
}

.cs-block-{{ cs_id }} .cs-trigger-sub-{{ cs_id }} {
  display: none;
}

.cs-block-{{ cs_id }} .cs-trigger-right-{{ cs_id }} {
  color: var(--color-primary-button-text, #FFFFFF);
}

.cs-block-{{ cs_id }} .cs-trigger-right-{{ cs_id }} .mv-badge-free {
  background: rgb(255 255 255 / 0.14);
  border-color: rgb(255 255 255 / 0.28);
  color: var(--color-primary-button-text, #FFFFFF);
}

/* ------------------------------------------------------------------
   Saved state — compact measurement summary
   ------------------------------------------------------------------ */
.cs-block-{{ cs_id }} .cs-summary-{{ cs_id }} {
  display: none;
  margin-block-start: 14px;
  padding: 18px 20px;
  border: 1px solid var(--mv-pal-border);
  border-radius: 10px;
  background: var(--mv-pal-surface);
}

.cs-block-{{ cs_id }}.has-data .cs-summary-{{ cs_id }} {
  display: flex;
  flex-direction: column;
}

.cs-summary-label-{{ cs_id }} {
  padding-block-end: 12px;
}

.cs-summary-status-{{ cs_id }} {
  background: rgb(var(--mv-pal-accent-rgb) / 8%);
}

.cs-summary-tags-{{ cs_id }} span {
  min-height: 28px;
}

@media screen and (max-width: 749px) {
  .cs-guide-{{ cs_id }} {
    margin-block-start: 10px;
    padding: 16px 16px 18px;
  }

  .cs-block-{{ cs_id }} .cs-summary-{{ cs_id }} {
    padding: 16px;
  }
}
/* With fit tabs, the measurement editor lives directly below Custom Fit. */
.mv-fit-custom variant-picker ~ .custom-sizes-block {
  margin-block-start: calc(-1 * var(--gap, 0px));
}
.cs-block-{{ cs_id }}.has-inline-form .cs-guide-{{ cs_id }} {
  display: none;
}
.cs-block-{{ cs_id }}.has-inline-form {
  font-family: var(--font-body--family);
  font-size: 12px;
  font-weight: 400;
  line-height: 1.5;
}
#cs-modal-{{ cs_id }}.cs-inline {
  display: none;
  position: static;
  inset: auto;
  width: 100%;
  height: auto;
  max-height: none;
  margin-block-start: 0;
  border: 1px solid #d8d3ca;
  border-block-start: 0;
  border-radius: 0;
  box-shadow: none;
  transform: none;
  opacity: 1;
  visibility: visible;
  pointer-events: auto;
  transition: none;
  will-change: auto;
