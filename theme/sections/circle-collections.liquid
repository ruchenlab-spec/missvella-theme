{%- comment -%}
  Circular collection list carousel.
  - Each circle is a "circle_collection" block: pick a collection, optionally override
    with a custom image / video and title.
  - "heading" blocks render above the carousel.
  - Paged one screen at a time with theme slideshow arrows, laid out in their own
    grid columns beside the circles (never overlapping them), vertically centered
    on the circle row.
{%- endcomment -%}

{% liquid
  assign circle_gap = section.settings.circle_gap | default: 16
  assign columns = section.settings.columns | default: 5
  assign mobile_columns = section.settings.mobile_columns | default: '2'

  assign slide_count = 0
  for block in section.blocks
    if block.type == 'circle_collection'
      assign slide_count = slide_count | plus: 1
    endif
  endfor

  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
-%}

{%- capture header_html -%}
  {%- for block in section.blocks -%}
    {%- if block.type == 'heading' -%}
      <div
        class="circle-collections__heading-wrapper"
        style="
          --circle-heading-size: {{ block.settings.heading_size | default: '1.5rem' }};
          --circle-heading-align: {{ block.settings.alignment | default: 'center' }};
        "
        {{ block.shopify_attributes }}
      >
        <h2 class="circle-collections__heading">{{ block.settings.heading }}</h2>
      </div>
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}

<div
  class="
    section
    section--{{ section.settings.section_width }}
    circle-collections
    spacing-style
    {% if section.settings.background_color != blank %}color-custom-{{ section.id }}{% endif %}
  "
  style="
    {% render 'spacing-style', settings: section.settings %}
    --circle-columns: {{ columns }};
    --circle-columns-mobile: {{ mobile_columns }};
    --circle-gap: {{ circle_gap }}px;
    --circle-title-size: {{ section.settings.title_font_size | default: 12 }}px;
    --circle-title-spacing: {{ section.settings.title_letter_spacing | default: 1 }}px;
    --circle-title-transform: {{ section.settings.title_case | default: 'uppercase' }};
    {% if section.settings.title_color != blank %}--circle-title-color: {{ section.settings.title_color }};{% endif %}
  "
>
  {{ header_html }}

  {%- capture slides -%}
    {%- assign circle_index = 0 -%}
    {%- for block in section.blocks -%}
      {%- if block.type == 'circle_collection' -%}
        {%- liquid
          assign col = block.settings.collection
          assign item_link = '#'
          if col != blank
            assign item_link = col.url
          endif
          assign item_title = block.settings.custom_title
          if item_title == blank and col != blank
            assign item_title = col.title
          endif
        -%}
        {%- capture slide_content -%}
          <a class="circle-collections__item" href="{{ item_link }}">
            <div class="circle-collections__media">
              {%- if block.settings.custom_video != blank -%}
                {{
                  block.settings.custom_video
                  | video_tag:
                    image_size: '600x',
                    muted: true,
                    loop: true,
                    autoplay: true,
                    controls: false,
                    class: 'circle-collections__image circle-collections__video'
                }}
              {%- elsif block.settings.custom_image != blank -%}
                {{
                  block.settings.custom_image
                  | image_url: width: 600
                  | image_tag:
                    loading: 'lazy',
                    sizes: '(max-width: 749px) 44vw, 20vw',
                    widths: '150, 300, 450, 600',
                    class: 'circle-collections__image'
                }}
              {%- elsif col != blank and col.featured_image -%}
                {{
                  col.featured_image
                  | image_url: width: 600
                  | image_tag:
                    loading: 'lazy',
                    sizes: '(max-width: 749px) 44vw, 20vw',
                    widths: '150, 300, 450, 600',
                    class: 'circle-collections__image'
                }}
              {%- else -%}
                {{ 'collection-1' | placeholder_svg_tag: 'circle-collections__image placeholder-svg' }}
              {%- endif -%}
            </div>
            {%- if item_title != blank -%}
              <span class="circle-collections__title">{{ item_title }}</span>
            {%- endif -%}
          </a>
        {%- endcapture -%}
        {%- render 'slideshow-slide',
          index: circle_index,
          class: 'circle-collections__slide',
          children: slide_content,
          attributes: block.shopify_attributes
        -%}
        {%- assign circle_index = circle_index | plus: 1 -%}
      {%- endif -%}
    {%- endfor -%}
  {%- endcapture -%}

  {%- if section.settings.icons_style != 'none' -%}
    {%- capture custom_arrows -%}
      <div class="circle-collections__arrows circle-collections__arrows--prev">
        {%- render 'slideshow-arrow',
          action: 'previous',
          icon_style: section.settings.icons_style,
          icon_shape: section.settings.icons_shape
        -%}
      </div>
      <div class="circle-collections__arrows circle-collections__arrows--next">
        {%- render 'slideshow-arrow',
          action: 'next',
          icon_style: section.settings.icons_style,
          icon_shape: section.settings.icons_shape
        -%}
      </div>
    {%- endcapture -%}
  {%- endif -%}

  {%- render 'slideshow',
    ref: 'circleCollections',
    class: 'circle-collections__carousel',
    slides: slides,
    slide_count: slide_count,
    show_arrows: false,
    slideshow_arrows: custom_arrows,
    infinite: false,
    initial_slide: 0
  -%}
</div>

{% stylesheet %}
  .circle-collections {
    container-type: inline-size;
    container-name: circle-collections;
  }

  /* Heading block */
  .circle-collections__heading-wrapper {
    text-align: var(--circle-heading-align, center);
    margin-block-end: 20px;
  }

  .circle-collections__heading {
    font-family: var(--font-heading--family, var(--font-body--family));
    font-size: var(--circle-heading-size, 1.5rem);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin: 0;
    color: var(--color-foreground);
  }

  /*
   * Grid layout: [prev arrow] [slides] [next arrow]
   * Arrows own their own columns, so they never overlap the circles, and
   * align-items: center centers them on the circle row (not the whole section).
   */
  .circle-collections .circle-collections__carousel {
    position: relative;
    width: 100%;
  }

  .circle-collections .circle-collections__carousel slideshow-container {
    display: grid;
    grid-template-columns: auto 1fr auto;
    grid-template-rows: 1fr;
    align-items: center;
    column-gap: 8px;
  }

  .circle-collections__arrows {
    display: flex;
    align-items: center;
    grid-row: 1;
  }

  .circle-collections__arrows--prev {
    grid-column: 1;
    justify-content: flex-start;
  }

  .circle-collections__arrows--next {
    grid-column: 3;
    grid-column-start: 3;
    justify-content: flex-end;
  }

  .circle-collections .circle-collections__carousel slideshow-slides {
    grid-column: 2;
    grid-row: 1;
    gap: var(--circle-gap);
    margin-block: -12px;
    padding-block: 12px;
  }

  /* Arrows keep a consistent tap size even when hidden on small screens */
  .circle-collections__arrows .slideshow-control {
    opacity: 1;
  }

  @container circle-collections (max-width: 749px) {
    .circle-collections__arrows .slideshow-control {
      min-width: 36px;
      padding-inline: 0;
    }
  }

  .circle-collections__slide {
    flex: 0 0 auto;
    min-width: 0;
    scroll-snap-align: start;
    width: calc((100% - (var(--circle-gap) * (var(--circle-columns-mobile) - 1))) / var(--circle-columns-mobile));
  }

  @container circle-collections (min-width: 750px) {
    .circle-collections__slide {
      width: calc((100% - (var(--circle-gap) * (var(--circle-columns) - 1))) / var(--circle-columns));
    }
  }

  .circle-collections__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    color: var(--color-foreground);
  }

  .circle-collections__media {
    width: 100%;
    aspect-ratio: 1 / 1;
    border-radius: 50%;
    overflow: hidden;
    background-color: var(--color-background);
    box-shadow: 0 0 0 1px rgb(0 0 0 / 6%);
  }

  .circle-collections__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: scale var(--hover-transition-duration, 0.25s) var(--hover-transition-timing, ease-out);
  }

  .circle-collections__item:hover .circle-collections__image {
    scale: 1.05;
  }

  .circle-collections__media .placeholder-svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    padding: 25%;
    fill: var(--color-foreground);
    opacity: 0.35;
  }

  .circle-collections__title {
    font-family: var(--font-body--family);
    font-size: var(--circle-title-size);
    font-weight: 500;
    letter-spacing: var(--circle-title-spacing);
    text-align: center;
    text-transform: var(--circle-title-transform, uppercase);
    color: var(--circle-title-color, var(--color-foreground));
  }
{% endstylesheet %}

{% schema %}
{
  "name": "圆形集合轮播",
  "class": "circle-collections-section",
  "max_blocks": 24,
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "blocks": [
    {
      "type": "heading",
      "name": "标题",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "标题文字",
          "default": "Shop by Color"
        },
        {
          "type": "select",
          "id": "heading_size",
          "label": "字号",
          "options": [
            {
              "value": "1.125rem",
              "label": "小"
            },
            {
              "value": "1.5rem",
              "label": "中"
            },
            {
              "value": "2rem",
              "label": "大"
            }
          ],
          "default": "1.5rem"
        },
        {
          "type": "select",
          "id": "alignment",
          "label": "对齐",
          "options": [
            {
              "value": "left",
              "label": "左"
            },
            {
              "value": "center",
              "label": "中"
            },
            {
              "value": "right",
              "label": "右"
            }
          ],
          "default": "center"
        }
      ]
    },
    {
      "type": "circle_collection",
      "name": "圆形集合",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "集合",
          "info": "决定链接与默认标题，未上传自定义图时使用集合封面"
        },
        {
          "type": "image_picker",
          "id": "custom_image",
          "label": "自定义图片",
          "info": "覆盖集合封面，建议正方形图片"
        },
        {
          "type": "video",
          "id": "custom_video",
          "label": "自定义视频",
          "info": "设置后优先于图片展示（自动静音循环播放）"
        },
        {
          "type": "text",
          "id": "custom_title",
          "label": "自定义标题",
          "info": "覆盖集合名称"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "布局"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "桌面每屏数量",
      "min": 3,
      "max": 8,
      "step": 1,
      "default": 5
    },
    {
      "type": "select",
      "id": "mobile_columns",
      "label": "移动每屏数量",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        }
      ],
      "default": "2"
    },
    {
      "type": "range",
      "id": "circle_gap",
      "label": "圆形间距",
      "min": 0,
      "max": 48,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "标题样式"
    },
    {
      "type": "select",
      "id": "title_case",
      "label": "文字大小写",
      "options": [
        {
          "value": "uppercase",
          "label": "大写"
        },
        {
          "value": "none",
          "label": "默认"
        }
      ],
      "default": "uppercase"
    },
    {
      "type": "range",
      "id": "title_font_size",
      "label": "字号",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "title_letter_spacing",
      "label": "字距",
      "min": 0,
      "max": 4,
      "step": 0.5,
      "unit": "px",
      "default": 1
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "标题颜色",
      "placeholder": "默认"
    },
    {
      "type": "header",
      "content": "翻页箭头"
    },
    {
      "type": "select",
      "id": "icons_style",
      "label": "箭头样式",
      "options": [
        {
          "value": "arrow",
          "label": "箭头"
        },
        {
          "value": "chevron",
          "label": "尖括号"
        },
        {
          "value": "arrows_large",
          "label": "大箭头"
        },
        {
          "value": "chevron_large",
          "label": "大尖括号"
        },
        {
          "value": "none",
          "label": "无"
        }
      ],
      "default": "arrow"
    },
    {
      "type": "select",
      "id": "icons_shape",
      "label": "箭头背景",
      "options": [
        {
          "value": "none",
          "label": "无"
        },
        {
          "value": "circle",
          "label": "圆形"
        },
        {
          "value": "square",
          "label": "方形"
        }
      ],
      "default": "circle"
    },
    {
      "type": "header",
      "content": "区块"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "宽度",
      "options": [
        {
          "value": "page-width",
          "label": "页面宽"
        },
        {
          "value": "full-width",
          "label": "全宽"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "背景色",
      "placeholder": "默认"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "上边距",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "下边距",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "圆形集合轮播",
      "category": "t:categories.collections",
      "blocks": [
        {
          "type": "heading",
          "settings": {
            "heading": "Shop by Color",
            "heading_size": "1.5rem",
            "alignment": "center"
          }
        },
        {
          "type": "circle_collection"
        },
        {
          "type": "circle_collection"
        },
        {
          "type": "circle_collection"
        },
        {
          "type": "circle_collection"
        }
      ],
      "settings": {
        "columns": 5,
        "mobile_columns": "2",
        "circle_gap": 16,
        "icons_style": "arrow",
        "icons_shape": "circle",
        "section_width": "page-width",
        "padding-block-start": 36,
        "padding-block-end": 36
      }
    }
  ]
}
{% endschema %}
