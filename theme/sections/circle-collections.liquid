            {
              "value": "1.25rem",
              "label": "20px"
            },
            {
              "value": "1.5rem",
              "label": "24px"
            },
            {
              "value": "2rem",
              "label": "32px"
            },
            {
              "value": "2.5rem",
              "label": "40px"
            },
