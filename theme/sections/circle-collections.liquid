{%- comment -%}
  Circular collection list carousel.

  Header: native theme blocks (group / text / image / button ...) rendered above the
  carousel through content_for 'blocks'. Adding a "group" block gives the full theme
  header styling panel (direction, alignment, gap, background media, borders, radius).

  Circles: section.settings.collection_list, one circle per collection.
  Per-item overrides are supported through collection metafields:
    - custom.circle_image  (file_reference -> image) overrides the collection cover
    - custom.circle_video  (file_reference -> video) takes priority over images
    - custom.circle_title  (single_line_text_field) overrides the collection title

  Arrows: theme slideshow arrows in their own grid columns beside the circles
  (never overlapping), vertically centered on the circle row.
{%- endcomment -%}

{% liquid
  assign circle_gap = section.settings.circle_gap | default: 16
  assign columns = section.settings.columns | default: 5
  assign mobile_columns = section.settings.mobile_columns | default: '2'

  assign section_collections = section.settings.collection_list
  assign slide_count = section_collections.size

  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
-%}

<div
  class="
    section
    section--{{ section.settings.section_width }}
    circle-collections
    spacing-style
    {% if section.settings.background_color != blank %}color-custom-{{ section.id }}{% endif %}
  "
  style="
    {% render 'spacing-style', settings: section.settings %}
    --circle-columns: {{ columns }};
    --circle-columns-mobile: {{ mobile_columns }};
    --circle-gap: {{ circle_gap }}px;
    --circle-title-size: {{ section.settings.title_font_size | default: 12 }}px;
    --circle-title-spacing: {{ section.settings.title_letter_spacing | default: 1 }}px;
    --circle-title-transform: {{ section.settings.title_case | default: 'uppercase' }};
    {% if section.settings.title_color != blank %}--circle-title-color: {{ section.settings.title_color }};{% endif %}
  "
>
  {%- comment -%} Header area: native theme blocks (group, text, image, button ...) {%- endcomment -%}
  {%- content_for 'blocks' -%}

  {%- capture slides -%}
    {%- if section_collections != blank -%}
      {%- for collection in section_collections -%}
        {%- liquid
          assign custom_image = collection.metafields.custom.circle_image.value
          assign custom_video = collection.metafields.custom.circle_video.value
          assign custom_title = collection.metafields.custom.circle_title.value

          assign item_title = custom_title
          if item_title == blank
            assign item_title = collection.title
          endif
        -%}
        {%- capture circle_content -%}
          <a class="circle-collections__item" href="{{ collection.url }}">
            <div class="circle-collections__media">
              {%- if custom_video != blank -%}
                {{
                  custom_video
                  | video_tag:
                    image_size: '600x',
                    muted: true,
                    loop: true,
                    autoplay: true,
                    controls: false,
                    class: 'circle-collections__image circle-collections__video'
                }}
              {%- elsif custom_image != blank -%}
                {{
                  custom_image
                  | image_url: width: 600
                  | image_tag:
                    loading: 'lazy',
                    sizes: '(max-width: 749px) 44vw, 20vw',
                    widths: '150, 300, 450, 600',
                    class: 'circle-collections__image'
                }}
              {%- elsif collection.featured_image -%}
                {{
                  collection.featured_image
                  | image_url: width: 600
                  | image_tag:
                    loading: 'lazy',
                    sizes: '(max-width: 749px) 44vw, 20vw',
                    widths: '150, 300, 450, 600',
                    class: 'circle-collections__image'
                }}
              {%- else -%}
                {{ 'collection-1' | placeholder_svg_tag: 'circle-collections__image placeholder-svg' }}
              {%- endif -%}
            </div>
            {%- if item_title != blank -%}
              <span class="circle-collections__title">{{ item_title }}</span>
            {%- endif -%}
          </a>
        {%- endcapture -%}
        {%- render 'slideshow-slide',
          index: forloop.index0,
          class: 'circle-collections__slide',
          children: circle_content
        -%}
      {%- endfor -%}
    {%- else -%}
      {%- for i in (1..columns) -%}
        {%- capture placeholder_index -%}{% cycle '1', '2', '3', '4', '5', '6' %}{%- endcapture -%}
        {%- capture slide_content -%}
          <div class="circle-collections__item">
            <div class="circle-collections__media">
              {{ 'collection-' | append: placeholder_index | placeholder_svg_tag: 'circle-collections__image placeholder-svg' }}
            </div>
            <span class="circle-collections__title">{{ 'placeholders.collection_title' | t }}</span>
          </div>
        {%- endcapture -%}
        {%- render 'slideshow-slide',
          index: forloop.index0,
          class: 'circle-collections__slide',
          children: slide_content
        -%}
      {%- endfor -%}
    {%- endif -%}
  {%- endcapture -%}

  {%- if section.settings.icons_style != 'none' -%}
    {%- capture custom_arrows -%}
      <div class="circle-collections__arrows circle-collections__arrows--prev">
        {%- render 'slideshow-arrow',
          action: 'previous',
          icon_style: section.settings.icons_style,
          icon_shape: section.settings.icons_shape
        -%}
      </div>
      <div class="circle-collections__arrows circle-collections__arrows--next">
        {%- render 'slideshow-arrow',
          action: 'next',
          icon_style: section.settings.icons_style,
          icon_shape: section.settings.icons_shape
        -%}
      </div>
    {%- endcapture -%}
  {%- endif -%}

  {%- render 'slideshow',
    ref: 'circleCollections',
    class: 'circle-collections__carousel',
    slides: slides,
    slide_count: slide_count,
    show_arrows: false,
    slideshow_arrows: custom_arrows,
    infinite: false,
    initial_slide: 0
  -%}
</div>

{% stylesheet %}
  .circle-collections {
    container-type: inline-size;
    container-name: circle-collections;
  }

  /*
   * Grid layout: [prev arrow] [slides] [next arrow]
   * Arrows own their own columns, so they never overlap the circles, and
   * align-items: center centers them on the circle row (not the whole section).
   */
  .circle-collections .circle-collections__carousel {
    position: relative;
    width: 100%;
  }

  .circle-collections .circle-collections__carousel slideshow-container {
    display: grid;
    grid-template-columns: auto 1fr auto;
    grid-template-rows: 1fr;
    align-items: center;
    column-gap: 8px;
  }

  .circle-collections__arrows {
    display: flex;
    align-items: center;
    grid-row: 1;
  }

  .circle-collections__arrows--prev {
    grid-column: 1;
    justify-content: flex-start;
  }

  .circle-collections__arrows--next {
    grid-column: 3;
    justify-content: flex-end;
  }

  .circle-collections .circle-collections__carousel slideshow-slides {
    grid-column: 2;
    grid-row: 1;
    gap: var(--circle-gap);
    margin-block: -12px;
    padding-block: 12px;
  }

  .circle-collections__arrows .slideshow-control {
    opacity: 1;
  }

  @container circle-collections (max-width: 749px) {
    .circle-collections__arrows .slideshow-control {
      min-width: 36px;
      padding-inline: 0;
    }
  }

  .circle-collections__slide {
    flex: 0 0 auto;
    min-width: 0;
    scroll-snap-align: start;
    width: calc((100% - (var(--circle-gap) * (var(--circle-columns-mobile) - 1))) / var(--circle-columns-mobile));
  }

  @container circle-collections (min-width: 750px) {
    .circle-collections__slide {
      width: calc((100% - (var(--circle-gap) * (var(--circle-columns) - 1))) / var(--circle-columns));
    }
  }

  .circle-collections__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    color: var(--color-foreground);
  }

  .circle-collections__media {
    width: 100%;
    aspect-ratio: 1 / 1;
    border-radius: 50%;
    overflow: hidden;
    background-color: var(--color-background);
    box-shadow: 0 0 0 1px rgb(0 0 0 / 6%);
  }

  .circle-collections__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: scale var(--hover-transition-duration, 0.25s) var(--hover-transition-timing, ease-out);
  }

  .circle-collections__item:hover .circle-collections__image {
    scale: 1.05;
  }

  .circle-collections__media .placeholder-svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    padding: 25%;
    fill: var(--color-foreground);
    opacity: 0.35;
  }

  .circle-collections__title {
    font-family: var(--font-body--family);
    font-size: var(--circle-title-size);
    font-weight: 500;
    letter-spacing: var(--circle-title-spacing);
    text-align: center;
    text-transform: var(--circle-title-transform, uppercase);
    color: var(--circle-title-color, var(--color-foreground));
  }
{% endstylesheet %}

{% schema %}
{
  "name": "圆形集合轮播",
  "class": "circle-collections-section",
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "collection_list",
      "id": "collection_list",
      "label": "集合列表",
      "info": "每个集合显示为一个圆形；可在集合的自定义数据中设置 circle_image / circle_video / circle_title 覆盖"
    },
    {
      "type": "header",
      "content": "布局"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "桌面每屏数量",
      "min": 3,
      "max": 8,
      "step": 1,
      "default": 5
    },
    {
      "type": "select",
      "id": "mobile_columns",
      "label": "移动每屏数量",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        }
      ],
      "default": "2"
    },
    {
      "type": "range",
      "id": "circle_gap",
      "label": "圆形间距",
      "min": 0,
      "max": 48,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "圆形文字"
    },
    {
      "type": "select",
      "id": "title_case",
      "label": "文字大小写",
      "options": [
        {
          "value": "uppercase",
          "label": "大写"
        },
        {
          "value": "none",
          "label": "默认"
        }
      ],
      "default": "uppercase"
    },
    {
      "type": "range",
      "id": "title_font_size",
      "label": "字号",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "title_letter_spacing",
      "label": "字距",
      "min": 0,
      "max": 4,
      "step": 0.5,
      "unit": "px",
      "default": 1
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "文字颜色",
      "placeholder": "默认"
    },
    {
      "type": "header",
      "content": "翻页箭头"
    },
    {
      "type": "select",
      "id": "icons_style",
      "label": "箭头样式",
      "options": [
        {
          "value": "arrow",
          "label": "箭头"
        },
        {
          "value": "chevron",
          "label": "尖括号"
        },
        {
          "value": "arrows_large",
          "label": "大箭头"
        },
        {
          "value": "chevron_large",
          "label": "大尖括号"
        },
        {
          "value": "none",
          "label": "无"
        }
      ],
      "default": "arrow"
    },
    {
      "type": "select",
      "id": "icons_shape",
      "label": "箭头背景",
      "options": [
        {
          "value": "none",
          "label": "无"
        },
        {
          "value": "circle",
          "label": "圆形"
        },
        {
          "value": "square",
          "label": "方形"
        }
      ],
      "default": "circle"
    },
    {
      "type": "header",
      "content": "区块"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "宽度",
      "options": [
        {
          "value": "page-width",
          "label": "页面宽"
        },
        {
          "value": "full-width",
          "label": "全宽"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "背景色",
      "placeholder": "默认"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "上边距",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "下边距",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "圆形集合轮播",
      "category": "t:categories.collections",
      "blocks": {
        "group_header": {
          "type": "group",
          "name": "t:names.header",
          "settings": {
            "content_direction": "column",
            "vertical_on_mobile": true,
            "horizontal_alignment": "flex-start",
            "vertical_alignment": "center",
            "horizontal_alignment_flex_direction_column": "center",
            "vertical_alignment_flex_direction_column": "center",
            "gap": 12,
            "width": "fill",
            "custom_width": 100,
            "width_mobile": "fill",
            "custom_width_mobile": 100,
            "height": "fit",
            "custom_height": 100,
            "background_media": "none",
            "video_position": "cover",
            "background_image_position": "cover",
            "border": "none",
            "border_width": 1,
            "border_opacity": 100,
            "border_radius": 0,
            "padding-block-start": 0,
            "padding-block-end": 16,
            "padding-inline-start": 0,
            "padding-inline-end": 0
          },
          "blocks": {
            "text_title": {
              "type": "text",
              "name": "t:names.text",
              "settings": {
                "text": "<h2>Shop by Color</h2>",
                "width": "fit-content",
                "max_width": "normal",
                "alignment": "center",
                "type_preset": "rte",
                "font": "var(--font-heading--family)",
                "font_size": "",
                "line_height": "normal",
                "letter_spacing": "normal",
                "case": "none",
                "wrap": "pretty",
                "background": false,
                "background_color": "#00000026",
                "corner_radius": 0,
                "padding-block-start": 0,
                "padding-block-end": 0,
                "padding-inline-start": 0,
                "padding-inline-end": 0
              },
              "blocks": {}
            }
          },
          "block_order": ["text_title"]
        }
      },
      "block_order": ["group_header"],
      "settings": {
        "collection_list": [],
        "columns": 5,
        "mobile_columns": "2",
        "circle_gap": 16,
        "icons_style": "arrow",
        "icons_shape": "circle",
        "section_width": "page-width",
        "padding-block-start": 36,
        "padding-block-end": 36
      }
    }
  ]
}
{% endschema %}
