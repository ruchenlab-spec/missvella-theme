          "visible_if": "{{ block.settings.width == '100%' }}"
        },
        {
          "type": "header",
          "content": "t:content.typography"
        },
        {
          "type": "select",
          "id": "type_preset",
          "label": "t:settings.preset",
          "options": [
            {
              "value": "rte",
              "label": "t:options.default"
            },
            {
              "value": "paragraph",
              "label": "t:options.paragraph"
            },
            {
              "value": "h1",
              "label": "t:options.h1"
            },
            {
              "value": "h2",
              "label": "t:options.h2"
            },
            {
              "value": "h3",
              "label": "t:options.h3"
            },
            {
              "value": "h4",
              "label": "t:options.h4"
            },
            {
              "value": "h5",
              "label": "t:options.h5"
            },
            {
              "value": "h6",
              "label": "t:options.h6"
            },
            {
              "value": "custom",
              "label": "t:options.custom"
            }
          ],
