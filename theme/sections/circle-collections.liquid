{%- comment -%}
  Circular collection list carousel.

  Blocks (all section-scoped, so header text and circles can live side by side):
  - heading: renders through the theme's native `text` snippet, so it keeps the full
    native text settings (richtext, width / max width, typography preset, font, size,
    line height, letter spacing, case, wrap, text color, background, padding).
  - circle_collection: one circle per block - pick a collection and optionally override
    with a custom image / video and a custom title, straight in the theme editor.

  Arrows: theme slideshow arrows in their own grid columns beside the circles
  (never overlapping), vertically centered on the circle row.
{%- endcomment -%}

{% liquid
  assign circle_gap = section.settings.circle_gap | default: 16
  assign columns = section.settings.columns | default: 5
  assign mobile_columns = section.settings.mobile_columns | default: '2'

  assign slide_count = 0
  for block in section.blocks
    if block.type == 'circle_collection'
      assign slide_count = slide_count | plus: 1
    endif
  endfor

  # Circle diameter: 0 means "fill the available column width"
  assign circle_size_css = '100%'
  if section.settings.circle_size > 0
    assign circle_size_css = section.settings.circle_size | append: 'px'
  endif

  assign arrow_size = section.settings.arrow_size | default: 48

  # Full-width sections need their own side gutters (page-width mode already has --page-margin)
  assign pad_inline_start = 0
  assign pad_inline_end = 0
  if section.settings.section_width == 'full-width'
    assign pad_inline_start = section.settings.padding_inline_start | default: 40
    assign pad_inline_end = section.settings.padding_inline_end | default: 40
  endif

  assign arrow_icon = 'arrow'
  if section.settings.icons_style contains 'chevron'
    assign arrow_icon = 'caret'
  endif

  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
-%}

<div
  class="
    section
    section--{{ section.settings.section_width }}
    circle-collections
    spacing-style
    {% if section.settings.background_color != blank %}color-custom-{{ section.id }}{% endif %}
  "
  style="
    {% render 'spacing-style', settings: section.settings %}
    --padding-inline-start: {{ pad_inline_start }}px;
    --padding-inline-end: {{ pad_inline_end }}px;
    --circle-columns: {{ columns }};
    --circle-columns-mobile: {{ mobile_columns }};
    --circle-gap: {{ circle_gap }}px;
    --circle-size: {{ circle_size_css }};
    --circle-arrow-size: {{ arrow_size }}px;
    --circle-title-size: {{ section.settings.title_font_size | default: 12 }}px;
    --circle-title-spacing: {{ section.settings.title_letter_spacing | default: 1 }}px;
    --circle-title-transform: {{ section.settings.title_case | default: 'uppercase' }};
    {% if section.settings.title_color != blank %}--circle-title-color: {{ section.settings.title_color }};{% endif %}
  "
>
  {%- comment -%} Header: heading blocks rendered with the native text snippet {%- endcomment -%}
  {%- for block in section.blocks -%}
    {%- if block.type == 'heading' -%}
      <div class="circle-collections__header">
        {%- render 'text', block: block -%}
      </div>
    {%- endif -%}
  {%- endfor -%}

  {%- capture slides -%}
    {%- assign circle_index = 0 -%}
    {%- for block in section.blocks -%}
      {%- if block.type == 'circle_collection' -%}
        {%- liquid
          assign col = block.settings.collection
          assign item_link = '#'
          if col != blank
            assign item_link = col.url
          endif
          assign item_title = block.settings.custom_title
          if item_title == blank and col != blank
            assign item_title = col.title
          endif
        -%}
        {%- capture circle_content -%}
          <a class="circle-collections__item" href="{{ item_link }}">
            <div class="circle-collections__media">
              {%- if block.settings.custom_video != blank -%}
                {{
                  block.settings.custom_video
                  | video_tag:
                    image_size: '600x',
                    muted: true,
                    loop: true,
                    autoplay: true,
                    controls: false,
                    class: 'circle-collections__image circle-collections__video'
                }}
              {%- elsif block.settings.custom_image != blank -%}
                {{
                  block.settings.custom_image
                  | image_url: width: 600
                  | image_tag:
                    loading: 'lazy',
                    sizes: '(max-width: 749px) 44vw, 20vw',
                    widths: '150, 300, 450, 600',
                    class: 'circle-collections__image'
                }}
              {%- elsif col != blank and col.featured_image -%}
                {{
                  col.featured_image
                  | image_url: width: 600
                  | image_tag:
                    loading: 'lazy',
                    sizes: '(max-width: 749px) 44vw, 20vw',
                    widths: '150, 300, 450, 600',
                    class: 'circle-collections__image'
                }}
              {%- else -%}
                {{ 'collection-1' | placeholder_svg_tag: 'circle-collections__image placeholder-svg' }}
              {%- endif -%}
            </div>
            {%- if item_title != blank -%}
              <span class="circle-collections__title">{{ item_title }}</span>
            {%- endif -%}
          </a>
        {%- endcapture -%}
        {%- render 'slideshow-slide',
          index: circle_index,
          class: 'circle-collections__slide',
          children: circle_content,
          attributes: block.shopify_attributes
        -%}
        {%- assign circle_index = circle_index | plus: 1 -%}
      {%- endif -%}
    {%- endfor -%}
    {%- if slide_count == 0 -%}
      {%- for i in (1..columns) -%}
        {%- capture placeholder_index -%}{% cycle '1', '2', '3', '4', '5', '6' %}{%- endcapture -%}
        {%- capture slide_content -%}
          <div class="circle-collections__item">
            <div class="circle-collections__media">
              {{ 'collection-' | append: placeholder_index | placeholder_svg_tag: 'circle-collections__image placeholder-svg' }}
            </div>
            <span class="circle-collections__title">{{ 'placeholders.collection_title' | t }}</span>
          </div>
        {%- endcapture -%}
        {%- render 'slideshow-slide',
          index: forloop.index0,
          class: 'circle-collections__slide',
          children: slide_content
        -%}
      {%- endfor -%}
    {%- endif -%}
  {%- endcapture -%}

  {%- if section.settings.icons_style != 'none' -%}
    {%- capture custom_arrows -%}
      <button
        type="button"
        class="
          circle-collections__arrow circle-collections__arrow--prev
          circle-collections__arrow--shape-{{ section.settings.icons_shape }}
          circle-collections__arrow--{{ arrow_icon }} flip-x
        "
        ref="previous"
        on:click="/previous"
        aria-label="{{ 'accessibility.slideshow_previous' | t }}"
      >
        <span class="circle-collections__arrow-icon">
          {%- if arrow_icon == 'caret' -%}
            {{- 'icon-caret.svg' | inline_asset_content -}}
          {%- else -%}
            {{- 'icon-arrow.svg' | inline_asset_content -}}
          {%- endif -%}
        </span>
      </button>
      <button
        type="button"
        class="
          circle-collections__arrow circle-collections__arrow--next
          circle-collections__arrow--shape-{{ section.settings.icons_shape }}
          circle-collections__arrow--{{ arrow_icon }}
        "
        ref="next"
        on:click="/next"
        aria-label="{{ 'accessibility.slideshow_next' | t }}"
      >
        <span class="circle-collections__arrow-icon">
          {%- if arrow_icon == 'caret' -%}
            {{- 'icon-caret.svg' | inline_asset_content -}}
          {%- else -%}
            {{- 'icon-arrow.svg' | inline_asset_content -}}
          {%- endif -%}
        </span>
      </button>
    {%- endcapture -%}
  {%- endif -%}

  {%- render 'slideshow',
    ref: 'circleCollections',
    class: 'circle-collections__carousel',
    slides: slides,
    slide_count: slide_count,
    show_arrows: false,
    controls: custom_arrows,
    infinite: false,
    initial_slide: 0
  -%}
</div>

{% stylesheet %}
  .circle-collections {
    container-type: inline-size;
    container-name: circle-collections;
  }

  .circle-collections__header {
    margin-block-end: 20px;
  }

  /*
   * Three grid columns on the slideshow component itself: [prev] [slides] [next].
   * The arrows are siblings of the carousel container (not inside it), so they can
   * be any size, are never clipped by the container edges, and stay vertically
   * centered on the circle row.
   */
  .circle-collections .circle-collections__carousel {
    display: grid;
    grid-template-columns: var(--circle-arrow-size) minmax(0, 1fr) var(--circle-arrow-size);
    align-items: center;
    column-gap: 8px;
    width: 100%;
  }

  .circle-collections .circle-collections__carousel slideshow-container {
    grid-column: 2;
    grid-row: 1;
    min-width: 0;
  }

  /*
   * Arrows are plain grid items centered with align-items: center. The grid row
   * is exactly as tall as the circles (titles are absolutely positioned, see
   * below), so centering lands on the circle center with no offset math.
   */
  .circle-collections__arrow {
    position: relative;
    grid-row: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--circle-arrow-size);
    height: var(--circle-arrow-size);
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--color-foreground);
    cursor: pointer;
    transition: opacity 0.2s ease, transform 0.2s ease, background-color 0.2s ease;
  }

  /* Keep a 44px tap target even when the visible button is smaller */
  .circle-collections__arrow::before {
    content: '';
    position: absolute;
    inset: calc((var(--minimum-touch-target, 44px) - var(--circle-arrow-size)) / -2);
  }

  .circle-collections__arrow--prev {
    grid-column: 1;
    justify-self: start;
  }

  .circle-collections__arrow--next {
    grid-column: 3;
    justify-self: end;
  }

  .circle-collections__arrow--shape-circle {
    border-radius: 50%;
    background: var(--color-primary-button-background);
    color: var(--color-primary-button-text);
  }

  .circle-collections__arrow--shape-square {
    background: var(--color-primary-button-background);
    color: var(--color-primary-button-text);
  }

  .circle-collections__arrow-icon {
    display: inline-flex;
    width: calc(var(--circle-arrow-size) * 0.45);
    height: calc(var(--circle-arrow-size) * 0.45);
  }

  .circle-collections__arrow-icon svg {
    width: 100%;
    height: 100%;
  }

  .circle-collections__arrow--caret .circle-collections__arrow-icon svg {
    rotate: -90deg;
  }

  .circle-collections__arrow:hover {
    transform: scale(1.06);
  }

  .circle-collections__arrow[disabled] {
    opacity: 0.25;
    cursor: default;
    transform: none;
  }

  @container circle-collections (max-width: 749px) {
    .circle-collections .circle-collections__carousel {
      column-gap: 4px;
    }
  }

  /* This section writes raw pixel gutters (not scaled by spacing-style), so use
     0.5 - instead of the shared 0.7 - to land at the same ~20px on mobile. */
  @media screen and (max-width: 749px) {
    .circle-collections.section--full-width.spacing-style[style*='--padding-inline-start'] {
      padding-inline: calc(var(--padding-inline-start, 40px) * 0.5) calc(var(--padding-inline-end, 40px) * 0.5);
    }
  }

  /*
   * Slide content stays in normal flow (title included) so nothing gets clipped.
   * The bottom negative margin cancels the title block (12px gap + title height)
   * plus the 12px hover padding, so the carousel row is exactly as tall as the
   * circles and `align-items: center` lands the arrows on the circle center.
   *   24px = 12px gap + 12px padding-bottom
   *   1.2  = title line-height (set above, single line)
   */
  .circle-collections .circle-collections__carousel slideshow-slides {
    gap: var(--circle-gap);
    padding-block: 12px;
    margin-top: -12px;
    margin-bottom: calc(-24px - var(--circle-title-size) * 1.2);
    justify-content: safe center;
  }

  .circle-collections__slide {
    flex: 0 0 auto;
    min-width: 0;
    scroll-snap-align: start;
    width: min(
      var(--circle-size),
      calc((100% - (var(--circle-gap) * (var(--circle-columns-mobile) - 1))) / var(--circle-columns-mobile))
    );
  }

  @container circle-collections (min-width: 750px) {
    .circle-collections__slide {
      width: min(
        var(--circle-size),
        calc((100% - (var(--circle-gap) * (var(--circle-columns) - 1))) / var(--circle-columns))
      );
    }
  }

  .circle-collections__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    color: var(--color-foreground);
  }

  .circle-collections__media {
    width: 100%;
    aspect-ratio: 1 / 1;
    border-radius: 50%;
    overflow: hidden;
    background-color: var(--color-background);
    box-shadow: 0 0 0 1px rgb(0 0 0 / 6%);
  }

  .circle-collections__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: scale var(--hover-transition-duration, 0.25s) var(--hover-transition-timing, ease-out);
  }

  .circle-collections__item:hover .circle-collections__image {
    scale: 1.05;
  }

  .circle-collections__media .placeholder-svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    padding: 25%;
    fill: var(--color-foreground);
    opacity: 0.35;
  }

  .circle-collections__title {
    font-family: var(--font-body--family);
    font-size: var(--circle-title-size);
    line-height: 1.2;
    font-weight: 500;
    letter-spacing: var(--circle-title-spacing);
    text-align: center;
    text-transform: var(--circle-title-transform, uppercase);
    color: var(--circle-title-color, var(--color-foreground));
    max-width: 100%;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "圆形集合轮播",
  "class": "circle-collections-section",
  "max_blocks": 24,
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "blocks": [
    {
      "type": "heading",
      "name": "标题",
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "t:settings.text"
        },
        {
          "type": "header",
          "content": "t:content.layout"
        },
        {
          "type": "select",
          "id": "width",
          "label": "t:settings.width",
          "options": [
            {
              "value": "fit-content",
              "label": "t:options.fit"
            },
            {
              "value": "100%",
              "label": "t:options.fill"
            }
          ],
          "default": "fit-content"
        },
        {
          "type": "select",
          "id": "max_width",
          "label": "t:settings.max_width",
          "options": [
            {
              "value": "narrow",
              "label": "t:options.narrow"
            },
            {
              "value": "normal",
              "label": "t:options.normal"
            },
            {
              "value": "none",
              "label": "t:options.none"
            }
          ],
          "default": "normal"
        },
        {
          "type": "text_alignment",
          "id": "alignment",
          "label": "t:settings.alignment",
          "default": "center",
          "visible_if": "{{ block.settings.width == '100%' }}"
        },
        {
          "type": "header",
          "content": "t:content.typography"
        },
        {
          "type": "select",
          "id": "type_preset",
          "label": "t:settings.preset",
          "options": [
            {
              "value": "rte",
              "label": "t:options.default"
            },
            {
              "value": "paragraph",
              "label": "t:options.paragraph"
            },
            {
              "value": "h1",
              "label": "t:options.h1"
            },
            {
              "value": "h2",
              "label": "t:options.h2"
            },
            {
              "value": "h3",
              "label": "t:options.h3"
            },
            {
              "value": "h4",
              "label": "t:options.h4"
            },
            {
              "value": "h5",
              "label": "t:options.h5"
            },
            {
              "value": "h6",
              "label": "t:options.h6"
            },
            {
              "value": "custom",
              "label": "t:options.custom"
            }
          ],
          "default": "rte",
          "info": "t:info.edit_presets_in_theme_settings"
        },
        {
          "type": "select",
          "id": "font",
          "label": "t:settings.font",
          "options": [
            {
              "value": "var(--font-body--family)",
              "label": "t:options.body"
            },
            {
              "value": "var(--font-subheading--family)",
              "label": "t:options.subheading"
            },
            {
              "value": "var(--font-heading--family)",
              "label": "t:options.heading"
            },
            {
              "value": "var(--font-accent--family)",
              "label": "t:options.accent"
            }
          ],
          "default": "var(--font-heading--family)",
          "visible_if": "{{ block.settings.type_preset == 'custom' }}"
        },
        {
          "type": "select",
          "id": "font_size",
          "label": "t:settings.size",
          "options": [
            {
              "value": "",
              "label": "t:options.default"
            },
            {
              "value": "0.625rem",
              "label": "10px"
            },
            {
              "value": "0.75rem",
              "label": "12px"
            },
            {
              "value": "0.875rem",
              "label": "14px"
            },
            {
              "value": "1rem",
              "label": "16px"
            },
            {
              "value": "1.125rem",
              "label": "18px"
            },
            {
              "value": "1.25rem",
              "label": "20px"
            },
            {
              "value": "1.5rem",
              "label": "24px"
            },
            {
              "value": "2rem",
              "label": "32px"
            },
            {
              "value": "2.5rem",
              "label": "40px"
            },
            {
              "value": "3rem",
              "label": "48px"
            }
          ],
          "default": "1rem",
          "visible_if": "{{ block.settings.type_preset == 'custom' }}"
        },
        {
          "type": "select",
          "id": "line_height",
          "label": "t:settings.line_height",
          "options": [
            {
              "value": "tight",
              "label": "t:options.tight"
            },
            {
              "value": "normal",
              "label": "t:options.normal"
            },
            {
              "value": "loose",
              "label": "t:options.loose"
            }
          ],
          "default": "normal",
          "visible_if": "{{ block.settings.type_preset == 'custom' }}"
        },
        {
          "type": "select",
          "id": "letter_spacing",
          "label": "t:settings.letter_spacing",
          "options": [
            {
              "value": "tight",
              "label": "t:options.tight"
            },
            {
              "value": "normal",
              "label": "t:options.normal"
            },
            {
              "value": "loose",
              "label": "t:options.loose"
            }
          ],
          "default": "normal",
          "visible_if": "{{ block.settings.type_preset == 'custom' }}"
        },
        {
          "type": "select",
          "id": "case",
          "label": "t:settings.case",
          "options": [
            {
              "value": "none",
              "label": "t:options.default"
            },
            {
              "value": "uppercase",
              "label": "t:options.uppercase"
            }
          ],
          "default": "none",
          "visible_if": "{{ block.settings.type_preset == 'custom' }}"
        },
        {
          "type": "select",
          "id": "wrap",
          "label": "t:settings.wrap",
          "options": [
            {
              "value": "pretty",
              "label": "t:options.pretty"
            },
            {
              "value": "balance",
              "label": "t:options.balance"
            },
            {
              "value": "nowrap",
              "label": "t:options.none"
            }
          ],
          "default": "pretty",
          "visible_if": "{{ block.settings.type_preset == 'custom' }}"
        },
        {
          "type": "header",
          "content": "t:content.appearance"
        },
        {
          "type": "color",
          "id": "text_color",
          "label": "t:settings.text_color",
          "placeholder": "t:settings.default"
        },
        {
          "type": "checkbox",
          "id": "background",
          "label": "t:settings.background",
          "default": false
        },
        {
          "type": "color",
          "id": "background_color",
          "label": "t:settings.background_color",
          "alpha": true,
          "default": "#00000026",
          "visible_if": "{{ block.settings.background }}"
        },
        {
          "type": "range",
          "id": "corner_radius",
          "label": "t:settings.corner_radius",
          "default": 0,
          "min": 0,
          "max": 50,
          "step": 1,
          "visible_if": "{{ block.settings.background }}"
        },
        {
          "type": "header",
          "content": "t:content.padding"
        },
        {
          "type": "range",
          "id": "padding-block-start",
          "label": "t:settings.top",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "px",
          "default": 0
        },
        {
          "type": "range",
          "id": "padding-block-end",
          "label": "t:settings.bottom",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "px",
          "default": 8
        },
        {
          "type": "range",
          "id": "padding-inline-start",
          "label": "t:settings.left",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "px",
          "default": 0
        },
        {
          "type": "range",
          "id": "padding-inline-end",
          "label": "t:settings.right",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "px",
          "default": 0
        }
      ]
    },
    {
      "type": "circle_collection",
      "name": "圆形集合",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "集合",
          "info": "决定链接与默认标题，未上传自定义图时使用集合封面"
        },
        {
          "type": "image_picker",
          "id": "custom_image",
          "label": "自定义图片",
          "info": "覆盖集合封面，建议正方形图片"
        },
        {
          "type": "video",
          "id": "custom_video",
          "label": "自定义视频",
          "info": "设置后优先于图片展示（自动静音循环播放）"
        },
        {
          "type": "text",
          "id": "custom_title",
          "label": "自定义标题",
          "info": "覆盖集合名称"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "布局"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "桌面每屏数量",
      "min": 3,
      "max": 8,
      "step": 1,
      "default": 5
    },
    {
