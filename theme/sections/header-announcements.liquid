{% if section.blocks.size > 1 or request.design_mode %}
  <script
    src="{{ 'announcement-bar.js' | asset_url }}"
    type="module"
    fetchpriority="low"
  ></script>
{% endif %}

{% render 'contrast-override', background_color: section.settings.background_color, section_id: section.id %}

<div class="section-background color-custom-{{ section.id }}"></div>
<aside
  class="announcement-bar spacing-style section section--{{ section.settings.section_width }} color-custom-{{ section.id }}"
  style="{% render 'spacing-padding', settings: section.settings %}; --border-bottom-width: {{ section.settings.divider_width }}px;{% if section.settings.divider_color != blank %} --color-border: {{ section.settings.divider_color }};{% endif %}"
>
  <announcement-bar-component
    class="announcement-bar__slider"
    autoplay="{{ section.settings.speed }}"
  >
    {% if section.blocks.size > 1 %}
      {% render 'slideshow-arrows', icon_style: 'chevron' %}
    {% endif %}

    <div class="announcement-bar__slides" ref="track">
      {% content_for 'blocks' %}
    </div>
  </announcement-bar-component>
</aside>

{% stylesheet %}
  .announcement-bar {
    border-block-end: var(--border-bottom-width) solid var(--color-border);
  }

  .announcement-bar__slider {
    display: block;
    min-width: 0;
    position: relative;
  }

  .announcement-bar__slides {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(0, 1fr);
  }

  .announcement-bar__slide {
    position: relative;
    display: grid;
    align-items: center;
    min-width: 0;
    padding-inline: clamp(0.75rem, 2vw, 2rem);
    text-align: center;
    overflow-wrap: anywhere;
  }

  .announcement-bar__slide + .announcement-bar__slide::before {
    content: '';
    position: absolute;
    inset-inline-start: 0;
    top: 50%;
    height: min(1em, 75%);
    border-inline-start: 1px solid rgb(var(--color-foreground-rgb) / 25%);
    transform: translateY(-50%);
  }

  .announcement-bar__text:first-child {
    margin: 0 auto;
    max-width: 680px;
  }

  .announcement-bar__link {
    position: absolute;
    inset: 0;
    outline-offset: -2px;
  }

  .announcement-bar__slider slideshow-arrows {
    display: none;
  }

  @media (width < 750px) {
    .announcement-bar__slider {
      grid-column: 1 / -1;
    }

    .announcement-bar__slides {
      grid-auto-columns: 100%;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      overflow-x: auto;
      overflow-y: hidden;
    }

    .announcement-bar__slide {
      scroll-snap-align: center;
    }

    .announcement-bar__slide::before {
      display: none;
    }

    .announcement-bar__slider[data-rotating] .announcement-bar__slides {
      grid-template-columns: minmax(0, 1fr);
      margin-inline: var(--button-size);
      overflow: clip;
    }

    .announcement-bar__slider[data-rotating] .announcement-bar__slide {
      grid-area: 1 / 1;
      padding: 0.15em 0.25rem;
    }

    .announcement-bar__slide[aria-hidden='true'] {
      visibility: hidden;
    }

    .announcement-bar__slider[data-rotating] slideshow-arrows {
      display: flex;
      padding: 0;
      mix-blend-mode: normal;
    }

    .announcement-bar__slider .slideshow-control {
      display: grid;
      place-items: center;
      width: var(--button-size);
      height: var(--button-size);
      padding: 0;
      color: var(--color-foreground);
      opacity: 1;
      animation: none;
    }

    .announcement-bar__slider .slideshow-control .icon-caret {
      width: var(--icon-size-xs);
      height: var(--icon-size-xs);
      rotate: 0deg;
    }

    .announcement-bar__slider .slideshow-control--previous .icon-caret {
      rotate: 180deg;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.announcement_bar",
  "blocks": [
    {
      "type": "_announcement"
    }
  ],
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "range",
      "id": "speed",
      "label": "t:settings.scroll_speed",
      "min": 2,
      "max": 10,
      "default": 5,
      "unit": "sec"
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.section_width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "range",
      "id": "divider_width",
      "label": "t:settings.divider_thickness",
      "min": 0,
      "max": 5,
      "step": 0.5,
      "unit": "px",
      "default": 0
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "t:settings.divider_color",
      "placeholder": "t:settings.default",
      "visible_if": "{{ section.settings.divider_width > 0 }}"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 15
    }
  ],
  "presets": [
    {
      "name": "t:names.announcement_bar",
      "blocks": {
        "announcement_1": {
          "type": "_announcement"
        }
      },
      "block_order": ["announcement_1"]
    }
  ]
}
{% endschema %}
