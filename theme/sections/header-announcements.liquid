<script src="{{ 'announcement-bar.js' | asset_url }}" type="module" fetchpriority="low"></script>
<script src="{{ 'dialog.js' | asset_url }}" type="module"></script>

{% render 'contrast-override', background_color: section.settings.background_color, section_id: section.id %}
{% render 'dialog-styles' %}

<div class="section-background color-custom-{{ section.id }}"></div>
<aside
  class="announcement-bar spacing-style section section--{{ section.settings.section_width }} color-custom-{{ section.id }}"
  style="{% render 'spacing-padding', settings: section.settings %}; --border-bottom-width: {{ section.settings.divider_width }}px; --announcement-separator-color: {{ section.settings.separator_color | default: '#A0A0A0' }};{% if section.settings.divider_color != blank %} --color-border: {{ section.settings.divider_color }};{% endif %}"
>
  <announcement-bar-component
    class="announcement-bar__slider"
    autoplay="{{ section.settings.speed }}"
  >
    <div class="announcement-bar__slides" ref="track">
      {% content_for 'blocks' %}
    </div>

    <dialog-component class="announcement-bar__signup-popup" ref="signupDialog">
      <dialog class="announcement-bar__dialog dialog-modal color-custom-popover" ref="dialog" scroll-lock aria-labelledby="AnnouncementSignupTitle-{{ section.id }}">
        <button class="button button-unstyled close-button announcement-bar__dialog-close" type="button" aria-label="{{ 'accessibility.close_dialog' | t }}" on:click="/closeDialog">
          {{ 'icon-close.svg' | inline_asset_content }}
        </button>
        <div class="announcement-bar__dialog-content">
          <h2 id="AnnouncementSignupTitle-{{ section.id }}">Get 15% off your first order</h2>
          <p>Join our email list for your welcome offer.</p>
          {% form 'customer', id: 'AnnouncementSignup', class: 'announcement-bar__signup-form email-signup__form' %}
            <input type="hidden" name="contact[tags]" value="newsletter">
            <label for="AnnouncementEmail-{{ section.id }}" class="visually-hidden">Email address</label>
            <div class="announcement-bar__input-group">
              <input id="AnnouncementEmail-{{ section.id }}" type="email" name="contact[email]" autocomplete="email" required placeholder="Email address" value="{{ form.email | escape }}">
              <button class="button announcement-bar__submit" type="submit">Subscribe</button>
            </div>
            {% if form.errors %}
              <span data-signup-feedback hidden></span>
              <div class="announcement-bar__form-message" role="alert">{{ form.errors | default_errors }}</div>
            {% elsif form.posted_successfully? %}
              <span data-signup-feedback hidden></span>
              <p class="announcement-bar__form-message" role="status">Thank you for subscribing.</p>
            {% endif %}
          {% endform %}
        </div>
      </dialog>
    </dialog-component>
  </announcement-bar-component>
</aside>

{% stylesheet %}
  .announcement-bar {
    border-block-end: var(--border-bottom-width) solid var(--color-border);
  }

  .announcement-bar__slider {
    display: block;
    min-width: 0;
    position: relative;
  }

  .announcement-bar__slides {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(0, 1fr);
  }

  .announcement-bar__slide {
    position: relative;
    display: grid;
    align-items: center;
    min-width: 0;
    padding-inline: clamp(0.75rem, 2vw, 2rem);
    text-align: center;
    overflow-wrap: anywhere;
  }

  .announcement-bar__slide + .announcement-bar__slide::before {
    content: '';
    position: absolute;
    inset-inline-start: 0;
    top: 50%;
    height: min(1em, 75%);
    border-inline-start: 1px solid var(--announcement-separator-color);
    transform: translateY(-50%);
  }

  .announcement-bar__text:first-child {
    margin: 0 auto;
    max-width: 680px;
  }

  .announcement-bar__link {
    position: absolute;
    inset: 0;
    outline-offset: -2px;
  }

  .announcement-bar__action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.4em;
    width: 100%;
    border: 0;
    padding: 0;
    background: transparent;
    color: inherit;
    font: inherit;
    letter-spacing: inherit;
    line-height: inherit;
    text-transform: inherit;
    cursor: pointer;
  }

  .announcement-bar__action:hover .announcement-bar__action-label,
  .announcement-bar__action:focus-visible .announcement-bar__action-label {
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  .announcement-bar__action-prompt {
    display: inline-flex;
    align-items: center;
    gap: 0.3em;
    white-space: nowrap;
  }

  .announcement-bar__action-prompt svg {
    width: 1em;
    height: 1em;
    flex: none;
  }

  .announcement-bar__action:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 3px;
  }

  .announcement-bar__action-label {
    font-size: 0.85em;
    font-weight: 600;
    white-space: nowrap;
  }

  .announcement-bar__dialog.dialog-modal.color-custom-popover {
    width: min(480px, calc(100vw - 2rem));
    height: auto;
    max-width: calc(100vw - 2rem);
    max-height: min(90dvh, var(--modal-max-height));
    margin: auto;
    border: var(--style-border-popover);
    border-radius: var(--style-border-radius-popover);
    padding: clamp(1.5rem, 5vw, 2.5rem);
    background: var(--color-background);
    color: var(--color-foreground);
    box-shadow: var(--shadow-popover);
  }

  .announcement-bar__dialog-content {
    display: grid;
    gap: var(--gap-md);
  }

  .announcement-bar__dialog h2 {
    margin: 0 2rem 0 0;
    font-family: var(--font-heading--family);
    font-size: clamp(1.5rem, 5vw, 2rem);
    line-height: 1.15;
  }

  .announcement-bar__dialog-content > p {
    margin: 0;
  }

  .announcement-bar__dialog .announcement-bar__dialog-close {
    position: absolute;
    top: var(--margin-2xs);
    inset-inline-end: var(--margin-2xs);
  }

  .announcement-bar__signup-form.email-signup__form {
    display: grid;
    gap: var(--gap-md);
  }

  .announcement-bar__input-group {
    display: flex;
    align-items: stretch;
    gap: var(--gap-xs);
  }

  .announcement-bar__input-group input {
    flex: 1;
    min-width: 0;
    min-height: var(--minimum-touch-target);
    border: var(--style-border-width-inputs) solid var(--color-input-border);
    border-radius: var(--style-border-radius-inputs);
    padding: var(--padding-md);
    background: var(--color-input-background);
    color: var(--color-input-text);
    font: inherit;
  }

  .announcement-bar__input-group input::placeholder {
    color: rgb(var(--color-input-text-rgb) / var(--opacity-70));
  }

  .announcement-bar__input-group .announcement-bar__submit {
    min-height: var(--minimum-touch-target);
    padding-inline: var(--padding-xl);
  }

  .announcement-bar__dialog .announcement-bar__form-message {
    margin: 0;
  }

  @media (width < 750px) {
    .announcement-bar__input-group {
      flex-direction: column;
    }

    .announcement-bar__input-group .announcement-bar__submit {
      width: 100%;
    }

    .announcement-bar__slider {
      grid-column: 1 / -1;
    }

    .announcement-bar__slides {
      grid-auto-columns: 100%;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      overflow-x: auto;
      overflow-y: hidden;
    }

    .announcement-bar__slide {
      scroll-snap-align: center;
    }

    .announcement-bar__slide::before {
      display: none;
    }

    .announcement-bar__slider[data-rotating] .announcement-bar__slides {
      grid-template-columns: minmax(0, 1fr);
      overflow: clip;
    }

    .announcement-bar__slider[data-rotating] .announcement-bar__slide {
      grid-area: 1 / 1;
      padding: 0.15em 1rem;
    }

    .announcement-bar__slide[aria-hidden='true'] {
      visibility: hidden;
    }

  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.announcement_bar",
  "blocks": [
    {
      "type": "_announcement"
    }
  ],
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "range",
      "id": "speed",
      "label": "t:settings.scroll_speed",
      "min": 2,
      "max": 10,
      "default": 5,
      "unit": "sec"
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.section_width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "color",
      "id": "separator_color",
      "label": "公告之间竖线颜色",
      "default": "#A0A0A0"
    },
    {
      "type": "range",
      "id": "divider_width",
      "label": "t:settings.divider_thickness",
      "min": 0,
      "max": 5,
      "step": 0.5,
      "unit": "px",
      "default": 0
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "t:settings.divider_color",
      "placeholder": "t:settings.default",
      "visible_if": "{{ section.settings.divider_width > 0 }}"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 15
    }
  ],
  "presets": [
    {
      "name": "t:names.announcement_bar",
      "blocks": {
        "announcement_1": {
          "type": "_announcement"
        }
      },
      "block_order": ["announcement_1"]
    }
  ]
}
{% endschema %}
