<script src="{{ 'announcement-bar.js' | asset_url }}" type="module" fetchpriority="low"></script>

{% render 'contrast-override', background_color: section.settings.background_color, section_id: section.id %}

<div class="section-background color-custom-{{ section.id }}"></div>
<aside
  class="announcement-bar spacing-style section section--{{ section.settings.section_width }} color-custom-{{ section.id }}"
  style="{% render 'spacing-padding', settings: section.settings %}; --border-bottom-width: {{ section.settings.divider_width }}px; --announcement-separator-color: {{ section.settings.separator_color | default: '#A0A0A0' }};{% if section.settings.divider_color != blank %} --color-border: {{ section.settings.divider_color }};{% endif %}"
>
  <announcement-bar-component
    class="announcement-bar__slider"
    autoplay="{{ section.settings.speed }}"
  >
    <div class="announcement-bar__slides" ref="track">
      {% content_for 'blocks' %}
    </div>

    {% render 'mv-signup-popup', instance_id: section.id, fallback_rules: section.settings %}
  </announcement-bar-component>
</aside>

{% stylesheet %}
  .announcement-bar {
    border-block-end: var(--border-bottom-width) solid var(--color-border);
  }

  .announcement-bar__slider {
    display: block;
    min-width: 0;
    position: relative;
  }

  .announcement-bar__slides {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(0, 1fr);
  }

  .announcement-bar__slide {
    position: relative;
    display: grid;
    align-items: center;
    min-width: 0;
    padding-inline: clamp(0.75rem, 2vw, 2rem);
    text-align: center;
    overflow-wrap: anywhere;
  }

  .announcement-bar__slide + .announcement-bar__slide::before {
    content: '';
    position: absolute;
    inset-inline-start: 0;
    top: 50%;
    height: min(1em, 75%);
    border-inline-start: 1px solid var(--announcement-separator-color);
    transform: translateY(-50%);
  }

  .announcement-bar__text:first-child {
    margin: 0 auto;
    max-width: 680px;
  }

  .announcement-bar__link {
    position: absolute;
    inset: 0;
    outline-offset: -2px;
  }

  .announcement-bar__action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.4em;
    width: 100%;
    border: 0;
    padding: 0;
    background: transparent;
    color: inherit;
    font: inherit;
    letter-spacing: inherit;
    line-height: inherit;
    text-transform: inherit;
    cursor: pointer;
  }

  .announcement-bar__action:hover .announcement-bar__action-label,
  .announcement-bar__action:focus-visible .announcement-bar__action-label {
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  .announcement-bar__action-prompt {
    display: inline-flex;
    align-items: center;
    gap: 0.3em;
    white-space: nowrap;
  }

  .announcement-bar__action-prompt svg {
    width: 1em;
    height: 1em;
    flex: none;
  }

  .announcement-bar__action:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 3px;
  }

  .announcement-bar__action-label {
    font-size: 0.85em;
    font-weight: 600;
    white-space: nowrap;
  }

  @media (width < 750px) {
    .announcement-bar__slider {
      grid-column: 1 / -1;
    }

    .announcement-bar__slides {
      grid-auto-columns: 100%;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      overflow-x: auto;
      overflow-y: hidden;
    }

    .announcement-bar__slide {
      scroll-snap-align: center;
    }

    .announcement-bar__slide::before {
      display: none;
    }

    .announcement-bar__slider[data-rotating] .announcement-bar__slides {
      grid-template-columns: minmax(0, 1fr);
      overflow: clip;
    }

    .announcement-bar__slider[data-rotating] .announcement-bar__slide {
      grid-area: 1 / 1;
      padding: 0.15em 1rem;
    }

    .announcement-bar__slide[aria-hidden='true'] {
      visibility: hidden;
    }

  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.announcement_bar",
  "blocks": [
    {
      "type": "_announcement"
    }
  ],
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "range",
      "id": "speed",
      "label": "t:settings.scroll_speed",
      "min": 2,
      "max": 10,
      "default": 5,
      "unit": "sec"
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.section_width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "color",
      "id": "separator_color",
      "label": "公告之间竖线颜色",
      "default": "#A0A0A0"
    },
    {
      "type": "range",
      "id": "divider_width",
      "label": "t:settings.divider_thickness",
      "min": 0,
      "max": 5,
      "step": 0.5,
      "unit": "px",
      "default": 0
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "t:settings.divider_color",
      "placeholder": "t:settings.default",
      "visible_if": "{{ section.settings.divider_width > 0 }}"
    },
    { "type": "header", "content": "邮件弹窗规则" },
    { "type": "paragraph", "content": "当前页面添加了「Missvella 邮件弹窗」时，以该分区的规则为准。" },
    { "type": "checkbox", "id": "auto_open", "label": "新访客进站时自动弹出", "default": true },
    { "type": "range", "id": "delay_seconds", "label": "进站后等待", "min": 0, "max": 30, "step": 1, "unit": "s", "default": 6, "visible_if": "{{ section.settings.auto_open }}" },
    { "type": "range", "id": "cooldown_days", "label": "关闭后免打扰天数", "min": 1, "max": 90, "step": 1, "unit": "天", "default": 7, "visible_if": "{{ section.settings.auto_open }}" },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 15
    }
  ],
  "presets": [
    {
      "name": "t:names.announcement_bar",
      "blocks": {
        "announcement_1": {
          "type": "_announcement"
        }
      },
      "block_order": ["announcement_1"]
    }
  ]
}
{% endschema %}
