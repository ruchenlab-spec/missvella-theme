            { "value": "flex-start", "label": "靠左" },
            { "value": "center", "label": "居中" },
            { "value": "flex-end", "label": "靠右" }
          ],
          "default": "center"
        },
        {
          "type": "select",
          "id": "text_alignment",
          "label": "文字对齐方式",
          "options": [
            { "value": "left", "label": "左对齐" },
            { "value": "center", "label": "居中" },
            { "value": "right", "label": "右对齐" }
          ],
          "default": "center"
