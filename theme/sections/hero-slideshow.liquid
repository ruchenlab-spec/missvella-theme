  "step": 1,
  "default": 13
},
{
  "type": "range",
  "id": "button_padding_v",
  "label": "按钮上下内边距（px）",
  "min": 0,
  "max": 28,
  "step": 2,
  "default": 14
},
{
  "type": "range",
  "id": "button_padding_h",
