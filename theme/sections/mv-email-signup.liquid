{% liquid
  assign signup_image = section.settings.image
  assign signup_image_alt = signup_image.alt | default: 'Missvella occasionwear inspiration'
  assign form_id = 'MvEmailSignup-' | append: section.id
%}

<section
  class="mv-email-signup mv-email-signup--image-{{ section.settings.image_position }}"
  style="
    --mv-email-background: {{ section.settings.background_color }};
    --mv-email-foreground: {{ section.settings.text_color }};
    --mv-email-accent: {{ section.settings.accent_color }};
    --mv-email-button-text: {{ section.settings.button_text_color }};
    --mv-email-padding-top: {{ section.settings.padding_top }}px;
    --mv-email-padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="mv-email-signup__shell">
    <div class="mv-email-signup__card">
      <div class="mv-email-signup__media">
        {% if signup_image != blank %}
          {{
            signup_image
            | image_url: width: 1600
            | image_tag:
              class: 'mv-email-signup__image',
              widths: '400, 600, 800, 1100, 1600',
              sizes: '(min-width: 750px) 50vw, 100vw',
              loading: 'lazy',
              alt: signup_image_alt
          }}
        {% else %}
          <div class="mv-email-signup__art" aria-hidden="true">
            <span class="mv-email-signup__art-brand">MISSVELLA</span>
            <span class="mv-email-signup__art-letter">M</span>
            <span class="mv-email-signup__art-caption">MOMENTS, BEAUTIFULLY DRESSED</span>
          </div>
        {% endif %}
        {% if section.settings.image_caption != blank %}
          <span class="mv-email-signup__image-caption">{{ section.settings.image_caption | escape }}</span>
        {% endif %}
      </div>

      <div class="mv-email-signup__content">
        {% if section.settings.eyebrow != blank %}
          <p class="mv-email-signup__eyebrow"><span aria-hidden="true"></span>{{ section.settings.eyebrow | escape }}</p>
        {% endif %}
        {% if section.settings.heading != blank %}
          <h2 class="mv-email-signup__heading">{{ section.settings.heading | escape }}</h2>
        {% endif %}
        {% if section.settings.description != blank %}
          <div class="mv-email-signup__description rte">{{ section.settings.description }}</div>
        {% endif %}

        {% form 'customer', id: form_id, class: 'mv-email-signup__form' %}
          <input type="hidden" name="contact[tags]" value="newsletter">
          {% if form.posted_successfully? %}
            <p class="mv-email-signup__message" role="status" tabindex="-1">{{ section.settings.success_message | escape }}</p>
          {% else %}
            {% if form.errors %}
              <div class="mv-email-signup__message mv-email-signup__message--error" id="{{ form_id }}-error" role="alert">
                {{ form.errors | default_errors }}
              </div>
            {% endif %}
            <label class="visually-hidden" for="{{ form_id }}-email">{{ section.settings.email_placeholder | escape }}</label>
            <div class="mv-email-signup__field">
              <input
                id="{{ form_id }}-email"
                class="mv-email-signup__input"
                type="email"
                name="contact[email]"
                value="{{ form.email | escape }}"
                placeholder="{{ section.settings.email_placeholder | escape }}"
                autocomplete="email"
                autocapitalize="off"
                spellcheck="false"
                required
                {% if form.errors %}aria-invalid="true" aria-describedby="{{ form_id }}-error"{% endif %}
              >
              <button class="mv-email-signup__submit" type="submit">
                <span>{{ section.settings.button_label | escape }}</span>
                <svg aria-hidden="true" viewBox="0 0 20 20" fill="none">
                  <path d="M3 10h13m-5-5 5 5-5 5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </button>
            </div>
          {% endif %}
        {% endform %}
        {% if section.settings.fine_print != blank %}
          <p class="mv-email-signup__fine-print">{{ section.settings.fine_print | escape }}</p>
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .mv-email-signup {
    padding-block: var(--mv-email-padding-top) var(--mv-email-padding-bottom);
    color: var(--mv-email-foreground);
    background: var(--mv-email-background);
  }

  .mv-email-signup__shell {
    width: min(100% - 32px, 1400px);
    margin-inline: auto;
  }

  .mv-email-signup__card {
    display: grid;
    grid-template-columns: minmax(0, 49fr) minmax(0, 51fr);
    min-height: 560px;
    border: 1px solid rgb(0 0 0 / 10%);
  }

  .mv-email-signup--image-right .mv-email-signup__media {
    order: 2;
  }

  .mv-email-signup__media {
    position: relative;
    min-width: 0;
    overflow: hidden;
    background: #c8b7a9;
  }

  .mv-email-signup__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  .mv-email-signup__art {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    padding: clamp(28px, 4vw, 58px);
    overflow: hidden;
    color: #fffaf5;
    background:
      radial-gradient(ellipse at 70% 35%, rgb(246 221 204 / 65%), transparent 45%),
      linear-gradient(140deg, #a78b7d 0%, #d2beb1 55%, #8e746b 100%);
    text-align: center;
  }

  .mv-email-signup__art::before {
    content: '';
    position: absolute;
    width: 72%;
    aspect-ratio: 0.72;
    top: 19%;
    border: 1px solid rgb(255 250 245 / 48%);
    border-radius: 50% 50% 0 0;
    transform: rotate(-13deg);
  }

  .mv-email-signup__art-brand,
  .mv-email-signup__art-caption {
    position: relative;
    z-index: 1;
    font-family: var(--font-body--family);
    font-size: 11px;
    letter-spacing: 0.32em;
  }

  .mv-email-signup__art-letter {
    position: relative;
    z-index: 1;
    font-family: var(--font-heading--family);
    font-size: clamp(190px, 27vw, 390px);
    font-weight: 300;
    line-height: 0.8;
    opacity: 0.72;
  }

  .mv-email-signup__image-caption {
    position: absolute;
    z-index: 2;
    bottom: 26px;
    left: 30px;
    padding: 8px 10px;
    color: #fff;
    background: rgb(0 0 0 / 25%);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .mv-email-signup__content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-width: 0;
    padding: clamp(42px, 7vw, 110px);
  }

  .mv-email-signup__eyebrow {
    display: flex;
    align-items: center;
    gap: 14px;
    margin: 0 0 32px;
    color: var(--mv-email-accent);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  .mv-email-signup__eyebrow span {
    width: 30px;
    height: 1px;
    flex: none;
    background: currentColor;
  }

  .mv-email-signup__heading {
    max-width: 12ch;
    margin: 0;
    color: var(--mv-email-foreground);
    font-family: var(--font-heading--family);
    font-size: clamp(34px, 4vw, 62px);
    font-weight: 400;
    line-height: 1.08;
    letter-spacing: -0.035em;
  }

  .mv-email-signup__description {
    max-width: 44ch;
    margin-top: 26px;
    color: var(--mv-email-foreground);
    font-size: clamp(14px, 1.1vw, 16px);
    line-height: 1.7;
    opacity: 0.78;
  }

  .mv-email-signup__description p {
    margin: 0;
  }

  .mv-email-signup__form {
    margin-top: 42px;
  }

  .mv-email-signup__field {
    display: flex;
    align-items: stretch;
    min-height: 58px;
    border-bottom: 1px solid var(--mv-email-accent);
  }

  .mv-email-signup__input {
    flex: 1;
    min-width: 0;
    border: 0;
    border-radius: 0;
    padding: 12px 14px 12px 0;
    outline: 0;
    color: var(--mv-email-foreground);
    background: transparent;
    font: inherit;
    font-size: 15px;
  }

  .mv-email-signup__input::placeholder {
    color: var(--mv-email-foreground);
    opacity: 0.56;
  }

  .mv-email-signup__input:focus-visible {
    box-shadow: inset 0 -2px var(--mv-email-accent);
  }

  .mv-email-signup__submit {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    min-width: 142px;
    border: 0;
    padding: 12px 18px;
    color: var(--mv-email-button-text);
    background: var(--mv-email-accent);
    font: inherit;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    transition: opacity 180ms ease;
  }

  .mv-email-signup__submit:hover {
    opacity: 0.82;
  }

  .mv-email-signup__submit:focus-visible {
    outline: 2px solid var(--mv-email-foreground);
    outline-offset: 3px;
  }

  .mv-email-signup__submit svg {
    width: 18px;
    height: 18px;
    flex: none;
  }

  .mv-email-signup__fine-print {
    margin: 16px 0 0;
    font-size: 11px;
    line-height: 1.5;
    opacity: 0.62;
  }

  .mv-email-signup__message {
    margin: 0;
    border-inline-start: 2px solid var(--mv-email-accent);
    padding: 12px 16px;
    background: rgb(0 0 0 / 4%);
    line-height: 1.5;
  }

  .mv-email-signup__message--error {
    margin-bottom: 16px;
  }

  @media (max-width: 749px) {
    .mv-email-signup__shell {
      width: min(100% - 28px, 540px);
    }

    .mv-email-signup__card {
      display: flex;
      flex-direction: column;
      min-height: 0;
    }

    .mv-email-signup--image-right .mv-email-signup__media {
      order: 0;
    }

    .mv-email-signup__media {
      min-height: 270px;
      aspect-ratio: 1.35;
    }

    .mv-email-signup__image {
      height: 100%;
    }

    .mv-email-signup__art-letter {
      font-size: clamp(130px, 40vw, 220px);
    }

    .mv-email-signup__content {
      padding: 38px 26px 42px;
    }

    .mv-email-signup__eyebrow {
      margin-bottom: 22px;
    }

    .mv-email-signup__heading {
      font-size: clamp(32px, 9vw, 44px);
    }

    .mv-email-signup__description {
      margin-top: 18px;
    }

    .mv-email-signup__form {
      margin-top: 30px;
    }

    .mv-email-signup__submit {
      min-width: 54px;
      gap: 8px;
      padding-inline: 12px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mv-email-signup__submit {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Missvella Email Signup",
  "tag": "section",
  "class": "mv-email-signup-section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "THE MISSVELLA LETTER" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Good style is worth sharing." },
    { "type": "richtext", "id": "description", "label": "Description", "default": "<p>New arrivals, occasion inspiration and little extras, delivered thoughtfully to your inbox.</p>" },
    { "type": "text", "id": "email_placeholder", "label": "Email placeholder", "default": "Your email address" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Join the list" },
    { "type": "text", "id": "success_message", "label": "Success message", "default": "You're on the list. Look out for a note from us soon." },
    { "type": "text", "id": "fine_print", "label": "Fine print", "default": "By signing up, you agree to receive emails from Missvella. Unsubscribe anytime." },
    { "type": "header", "content": "Image" },
    { "type": "image_picker", "id": "image", "label": "Image", "info": "Choose a portrait or editorial photo. A styled preview appears until an image is selected." },
    { "type": "text", "id": "image_caption", "label": "Image caption" },
    { "type": "select", "id": "image_position", "label": "Image position on desktop", "options": [{ "value": "left", "label": "Left" }, { "value": "right", "label": "Right" }], "default": "left" },
    { "type": "header", "content": "Colors and spacing" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#F4EFE9" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#292522" },
    { "type": "color", "id": "accent_color", "label": "Accent and button", "default": "#41322D" },
    { "type": "color", "id": "button_text_color", "label": "Button text", "default": "#FFFFFF" },
    { "type": "range", "id": "padding_top", "label": "Top spacing", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 72 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom spacing", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 72 }
  ],
  "presets": [
    { "name": "Missvella Email Signup" }
  ]
}
{% endschema %}
