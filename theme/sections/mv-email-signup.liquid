{% render 'mv-signup-popup', instance_id: section.id, config: section.settings %}

{% schema %}
{
  "name": "Missvella 邮件弹窗",
  "class": "mv-signup-section",
  "limit": 1,
  "settings": [
    { "type": "paragraph", "content": "选中此分区即可预览。公告栏的 Open email signup 会打开此弹窗。添加在页脚组可跨页面使用。" },
    { "type": "checkbox", "id": "auto_open", "label": "新访客进站时自动弹出", "default": true, "info": "已登录客户以及本浏览器识别过的客户或订阅者会自动跳过。" },
    { "type": "range", "id": "delay_seconds", "label": "进站后等待", "min": 0, "max": 30, "step": 1, "unit": "s", "default": 6, "visible_if": "{{ section.settings.auto_open }}" },
    { "type": "range", "id": "cooldown_days", "label": "关闭后免打扰天数", "min": 1, "max": 90, "step": 1, "unit": "天", "default": 7, "visible_if": "{{ section.settings.auto_open }}" },
    { "type": "image_picker", "id": "image", "label": "背景照片", "info": "照片以黑白呈现，留空时使用缎面背景。" },
    { "type": "text", "id": "eyebrow", "label": "胶带标签", "default": "MISSVELLA" },
    { "type": "text", "id": "heading", "label": "标题", "default": "You're invited." },
    { "type": "richtext", "id": "description", "label": "副标题", "default": "<p>Join our email list for 15% off your first order.</p>" },
    { "type": "text", "id": "coupon_title", "label": "优惠券说明", "default": "Black Friday · 10% off" },
    { "type": "text", "id": "coupon_code", "label": "点击复制的优惠码", "default": "BFCM10", "info": "填写后台已创建的优惠码，清空可隐藏整张券。" },
    { "type": "text", "id": "email_placeholder", "label": "邮箱输入提示", "default": "Email address" },
    { "type": "text", "id": "button_label", "label": "订阅按钮", "default": "Sign me up" },
    { "type": "text", "id": "success_message", "label": "订阅成功提示", "default": "You're on the list. Thank you for subscribing." },
    { "type": "text", "id": "fine_print", "label": "表单附注" },
    { "type": "color", "id": "background_color", "label": "纸张底色", "default": "#F5ECD9" },
    { "type": "color", "id": "text_color", "label": "正文颜色", "default": "#352D2A" },
    { "type": "color", "id": "accent_color", "label": "标题、优惠券和按钮颜色", "default": "#751E2A" },
    { "type": "color", "id": "button_text_color", "label": "按钮文字", "default": "#FFFFFF" }
  ],
  "presets": [{ "name": "Missvella 邮件弹窗" }]
}
{% endschema %}
