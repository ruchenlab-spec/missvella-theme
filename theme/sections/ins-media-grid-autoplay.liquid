{%- liquid
  assign hover_effect   = section.settings.hover_effect
  assign show_caption   = section.settings.show_caption
  assign video_loop     = section.settings.video_loop
  assign video_controls = section.settings.video_controls
  assign media_position = section.settings.media_position
  assign social_link = section.settings.social_link
  if social_link == blank and section.settings.social_platform == 'instagram'
    assign social_link = 'https://www.instagram.com/missvella/'
  endif

  assign video_muted = section.settings.video_muted
  # Keep preload at "metadata" even with autoplay: the IntersectionObserver
  # gates playback, and play() triggers the real download for visible videos.
  assign video_preload = 'metadata'
  if section.settings.video_autoplay
    assign video_muted = true
  endif

  capture image_sizes
    echo '(max-width: 749px) '
    echo section.settings.card_width_mobile
    echo 'vw, '
    echo section.settings.card_width_desktop
    echo 'vw'
  endcapture
-%}

{{ 'ins-media.css' | asset_url | stylesheet_tag }}
{% render 'contrast-override', background_color: section.settings.background_color, skip_contrast: true, section_id: section.id %}
<div class="section-background color-custom-{{ section.id }}"></div>


<section
  id="ins-{{ section.id }}"
  class="ins-media-section section section--{{ section.settings.section_width }} spacing-style color-custom-{{ section.id }}"
  style="
    {% render 'spacing-style', settings: section.settings %}
    --color: {{ section.settings.text_color }};
    --color-foreground: {{ section.settings.text_color }};
    --ins-padding: {{ section.settings.section_padding_v }}px;
    --ins-header-gap: {{ section.settings.header_gap }}px;
    --ins-card-width: {{ section.settings.card_width_desktop }}%;
    --ins-card-width-mobile: {{ section.settings.card_width_mobile }}%;
    --ins-gap: {{ section.settings.film_gap }}px;
    --ins-gap-mobile: {{ section.settings.film_gap_mobile }}px;
    --ins-accent: {{ section.settings.accent_color }};
    --ins-align: {{ section.settings.header_align }};
    --ins-focus: {{ media_position }};
    --ins-ratio: {% case section.settings.aspect_ratio %}{% when 'square' %}1 / 1{% when 'portrait' %}4 / 5{% when 'portrait_3_4' %}3 / 4{% when 'story' %}9 / 16{% when 'landscape' %}16 / 9{% else %}auto{% endcase %};
  "
  data-hover="{{ hover_effect }}"
  data-natural-ratio="{% if section.settings.aspect_ratio == 'auto' %}true{% else %}false{% endif %}"
>

  <div class="ins-header">
    <div class="ins-header-body">
      {%- if section.settings.instagram_handle != blank -%}
        {%- capture social_text -%}
          <span>{{ section.settings.instagram_handle }}</span>
          <svg class="ins-social-icon" viewBox="0 0 20 20" aria-hidden="true" focusable="false">{% render 'icon', icon: section.settings.social_platform %}</svg>
        {%- endcapture -%}
        {%- if social_link != blank -%}
          <a class="ins-social-link" href="{{ social_link }}" target="_blank" rel="noopener noreferrer" aria-label="{{ section.settings.social_platform | capitalize }} · {{ section.settings.instagram_handle | escape }}">
            {% render 'ins-media-text', section: section, role: 'handle', text: social_text, tag: 'span', class: 'ins-handle', color: section.settings.accent_color, alignment: 'left' %}
          </a>
        {%- else -%}
          {% render 'ins-media-text', section: section, role: 'handle', text: social_text, tag: 'span', class: 'ins-handle', color: section.settings.accent_color, alignment: 'left' %}
        {%- endif -%}
      {%- endif -%}
      {%- if section.settings.title != blank -%}
        {% render 'ins-media-text', section: section, role: 'title', text: section.settings.title, tag: 'h2', class: 'ins-title', color: section.settings.accent_color %}
      {%- endif -%}
      {%- if section.settings.subtitle != blank -%}
        {% render 'ins-media-text', section: section, role: 'subtitle', text: section.settings.subtitle, class: 'ins-subtitle', color: section.settings.text_color %}
      {%- endif -%}
    </div>
    <div class="ins-controls">
      <button class="ins-arrow ins-arrow--prev" id="ins-prev-{{ section.id }}" type="button" aria-label="上一张" hidden>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m14 6-6 6 6 6M8 12h12"/></svg>
      </button>
      <button class="ins-arrow ins-arrow--next" id="ins-next-{{ section.id }}" type="button" aria-label="下一张" hidden>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m10 6 6 6-6 6M4 12h12"/></svg>
      </button>
    </div>
  </div>

  <div class="ins-slider-wrap">
    <div class="ins-slider-viewport" tabindex="0" role="region" aria-label="{{ section.settings.title | default: 'Media gallery' | escape }}">

      <div class="ins-slider-track" id="ins-track-{{ section.id }}">
        {%- assign media_index = 0 -%}
        {%- for block in section.blocks -%}
          {%- unless block.type == 'media_item' -%}{%- continue -%}{%- endunless -%}
          {%- assign media_index = media_index | plus: 1 -%}
          {%- liquid
            assign has_video = false
            if block.settings.video != blank
              assign has_video = true
            endif

          -%}

          <div class="ins-item-wrap" {{ block.shopify_attributes }}>
            <div class="ins-item{% if has_video %} ins-item--video{% endif %}">

              {%- if has_video -%}
                {{- block.settings.video
                  | video_tag:
                    image_size: '1200x',
                    autoplay: section.settings.video_autoplay,
                    loop: video_loop,
                    muted: video_muted,
                    controls: video_controls,
                    preload: video_preload,
                    playsinline: true,
                    class: 'ins-media ins-media--video'
                -}}
              {%- elsif block.settings.image != blank -%}
                {{- block.settings.image
                  | image_url: width: 1600
                  | image_tag:
                    widths: '320, 480, 640, 800, 1000, 1200, 1600',
                    sizes: image_sizes,
                    loading: 'lazy',
                    class: 'ins-media ins-media--image'
                -}}
              {%- else -%}
                {{- 'image' | placeholder_svg_tag: 'ins-media ins-media--placeholder' -}}
              {%- endif -%}

              {%- if block.settings.link != blank -%}
                {%- comment -%}
                  视频显示原生 controls 时不放整块透明链接，避免覆盖播放/进度控件。
                {%- endcomment -%}
                {%- unless has_video and video_controls -%}
                  <a
                    class="ins-item-link"
                    href="{{ block.settings.link }}"
                    aria-label="{{ block.settings.caption | default: 'Open media' | escape }}"
                  ></a>
                {%- endunless -%}
              {%- endif -%}

              {%- if has_video -%}
                <button
                  type="button"
                  class="ins-video-toggle"
                  aria-label="Pause video"
                  aria-pressed="false"
                >
                  <svg class="icon-pause" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M7 5h4v14H7zM13 5h4v14h-4z"></path>
                  </svg>
                  <svg class="icon-play" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M8 5v14l11-7z"></path>
                  </svg>
                </button>
              {%- endif -%}

              <div class="ins-overlay">
                <div class="ins-overlay-content">
                  {%- if block.settings.caption != blank -%}
                    {% render 'ins-media-text', section: section, role: 'caption', text: block.settings.caption, class: 'ins-overlay-caption', color: '#ffffff', alignment: 'center' %}
                  {%- endif -%}
                </div>
              </div>
            </div>

            {%- capture film_caption -%}
              <span class="ins-frame-number">FRAME {% if media_index < 10 %}0{% endif %}{{ media_index }}</span>
              {%- if show_caption and block.settings.caption != blank -%}<span>{{ block.settings.caption }}</span>{%- endif -%}
            {%- endcapture -%}
            {% render 'ins-media-text', section: section, role: 'caption', text: film_caption, class: 'ins-film-caption', color: section.settings.text_color, alignment: 'left' %}
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>


</section>

<script>
(function () {
  'use strict';

  var sid      = '{{ section.id }}';
  var track    = document.getElementById('ins-track-' + sid);
  var btnPrev  = document.getElementById('ins-prev-' + sid);
  var btnNext  = document.getElementById('ins-next-' + sid);
  var videoAutoplay = {{ section.settings.video_autoplay | json }};
  var videoObserver = null;

  if (!track || !btnPrev || !btnNext) return;
  var viewport = track.parentElement;

  /* ── 视频自动播放：仅播放当前可见卡片；离开、切列、切后台自动暂停 ── */
  function isVideoManuallyPaused(video) {
    return video.dataset.insManualPaused === 'true';
  }

  function safePlay(video, force) {
    /* 用户手动暂停优先级高于自动播放；手动点击(force=true)绕过自动播放开关 */
    if (!force && (!videoAutoplay || document.visibilityState === 'hidden' || isVideoManuallyPaused(video))) return;

    video.muted = true;
    video.defaultMuted = true;
    video.autoplay = true;
    video.playsInline = true;
    video.setAttribute('muted', '');
    video.setAttribute('autoplay', '');
    video.setAttribute('playsinline', '');

    var playPromise = video.play();
    if (playPromise && typeof playPromise.catch === 'function') {
      playPromise.catch(function () {});
    }
  }

  function pauseVideo(video) {
    if (!video.paused) video.pause();
  }

  function getVideoToggle(video) {
    var item = video.closest('.ins-item--video');
    return item ? item.querySelector('.ins-video-toggle') : null;
  }

  function updateVideoToggle(video) {
    var button = getVideoToggle(video);
    if (!button) return;

    var paused = video.paused;
    button.classList.toggle('is-paused', paused);
    button.setAttribute('aria-label', paused ? 'Play video' : 'Pause video');
    button.setAttribute('aria-pressed', paused ? 'true' : 'false');
  }

  function setupVideoToggle(video) {
    var button = getVideoToggle(video);
    if (!button || button.dataset.bound === 'true') {
      updateVideoToggle(video);
      return;
    }

    button.dataset.bound = 'true';

    button.addEventListener('click', function (event) {
      event.preventDefault();
      event.stopPropagation();

      if (video.paused) {
        /* 用户主动恢复播放，解除手动暂停锁 */
        delete video.dataset.insManualPaused;
        safePlay(video, true);
      } else {
        /* 用户主动暂停：锁定状态，禁止 IntersectionObserver / hover / 翻页同步自动恢复 */
        video.dataset.insManualPaused = 'true';
        pauseVideo(video);
      }

      requestAnimationFrame(function () {
        updateVideoToggle(video);
      });
    });

    video.addEventListener('play', function () { updateVideoToggle(video); });
    video.addEventListener('pause', function () { updateVideoToggle(video); });
    video.addEventListener('ended', function () { updateVideoToggle(video); });

    updateVideoToggle(video);
  }

  function isVideoVisibleInViewport(video) {
    var root = track.parentElement;
    if (!root || !video.isConnected) return false;

    var vr = video.getBoundingClientRect();
    var rr = root.getBoundingClientRect();
    var overlapX = Math.max(0, Math.min(vr.right, rr.right) - Math.max(vr.left, rr.left));
    var overlapY = Math.max(0, Math.min(vr.bottom, rr.bottom) - Math.max(vr.top, rr.top));
    var visibleArea = overlapX * overlapY;
    var totalArea = Math.max(1, vr.width * vr.height);

    return visibleArea / totalArea >= 0.35;
  }

  function syncVideoPlayback() {
    var videos = Array.from(track.querySelectorAll('video.ins-media--video'));
    if (!videos.length) return;

    videos.forEach(function (video) {
      if (
        videoAutoplay &&
        document.visibilityState !== 'hidden' &&
        isVideoVisibleInViewport(video) &&
        !isVideoManuallyPaused(video)
      ) {
        safePlay(video);
      } else if (!isVideoManuallyPaused(video)) {
        pauseVideo(video);
      }
      updateVideoToggle(video);
    });
  }

  function setupVideos() {
    if (videoObserver) {
      videoObserver.disconnect();
      videoObserver = null;
    }

    var videos = Array.from(track.querySelectorAll('video.ins-media--video'));
    if (!videos.length) return;

    videos.forEach(function (video) {
      video.playsInline = true;
      video.setAttribute('playsinline', '');
      setupVideoToggle(video);

      if (videoAutoplay) {
        video.muted = true;
        video.defaultMuted = true;
        video.autoplay = true;
        video.setAttribute('muted', '');
        video.setAttribute('autoplay', '');
      } else {
        video.removeAttribute('autoplay');
        pauseVideo(video);
      }
    });

    if (!videoAutoplay) return;

    if ('IntersectionObserver' in window) {
      videoObserver = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          var video = entry.target;
          if (isVideoManuallyPaused(video)) {
            /* 手动暂停后，任何可见性变化都不能重新触发自动播放 */
            pauseVideo(video);
            updateVideoToggle(video);
            return;
          }

          if (entry.isIntersecting && entry.intersectionRatio >= 0.35 && document.visibilityState !== 'hidden') {
            safePlay(video);
          } else {
            pauseVideo(video);
          }
        });
      }, {
        root: track.parentElement,
        threshold: [0, 0.15, 0.35, 0.75, 1]
      });

      videos.forEach(function (video) {
        videoObserver.observe(video);
      });
    }

    /* 初始渲染后同步可见视频；兼容 Safari / 部分移动端浏览器。 */
    requestAnimationFrame(syncVideoPlayback);
  }

  /* 浏览器切到后台时停止所有视频；返回页面后只恢复当前可见视频。 */
  document.addEventListener('visibilitychange', function () {
    if (document.visibilityState === 'hidden') {
      Array.from(track.querySelectorAll('video.ins-media--video')).forEach(pauseVideo);
    } else {
      requestAnimationFrame(syncVideoPlayback);
    }
  });

  /* Native scrolling keeps the single-row film strip usable without JavaScript. */
  function syncArrows() {
    var maxScroll = Math.max(0, viewport.scrollWidth - viewport.clientWidth);
    var position = Math.abs(viewport.scrollLeft);
    btnPrev.hidden = maxScroll <= 1;
    btnNext.hidden = maxScroll <= 1;
    btnPrev.disabled = position <= 1;
    btnNext.disabled = position >= maxScroll - 1;
  }

  function scrollOneCard(direction) {
    var item = track.querySelector('.ins-item-wrap');
    if (!item) return;
    var gap = parseFloat(getComputedStyle(track).columnGap) || 0;
    var rtl = getComputedStyle(viewport).direction === 'rtl' ? -1 : 1;
    viewport.scrollBy({
      left: direction * rtl * (item.getBoundingClientRect().width + gap),
      behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth'
    });
  }

  btnPrev.addEventListener('click', function () { scrollOneCard(-1); });
  btnNext.addEventListener('click', function () { scrollOneCard(1); });
  viewport.addEventListener('scroll', function () {
    syncArrows();
    syncVideoPlayback();
  }, { passive: true });
  window.addEventListener('resize', syncArrows);
  if ('ResizeObserver' in window) new ResizeObserver(syncArrows).observe(viewport);
  setupVideos();
  syncArrows();
})();
</script>

{% schema %}
{
  "name": "INS 媒体展示",
  "tag": "section",
  "class": "ins-media-grid-section",
  "settings": [
    {
      "type": "header",
      "content": "t:content.section_layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ section.settings.section_width == 'full-width' }}"
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ section.settings.section_width == 'full-width' }}"
    },
    {
      "type": "range",
      "id": "section_padding_v",
      "label": "上下内边距（px）",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 60
    },
    {
      "type": "header",
      "content": "颜色"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "背景色",
      "default": "#19110e"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "文字颜色",
      "default": "#eee3d4"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "标题与社交链接颜色",
      "default": "#d9af95"
    },
    {
      "type": "header",
      "content": "横向画廊"
    },
    {
      "type": "range",
      "id": "card_width_desktop",
      "label": "桌面媒体宽度",
      "min": 20,
      "max": 50,
      "step": 1,
      "unit": "%",
      "default": 29
    },
    {
      "type": "range",
      "id": "card_width_mobile",
      "label": "手机媒体宽度",
      "min": 50,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 75
    },
    {
      "type": "range",
      "id": "film_gap",
      "label": "桌面媒体间距",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 22
    },
    {
      "type": "range",
      "id": "film_gap_mobile",
      "label": "手机媒体间距",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "媒体设置"
    },
    {
      "type": "select",
      "id": "aspect_ratio",
      "label": "媒体比例",
      "options": [
        {
          "value": "square",
          "label": "正方形（1:1）"
        },
        {
          "value": "portrait",
          "label": "竖版（4:5）"
        },
        {
          "value": "portrait_3_4",
          "label": "竖版（3:4）"
        },
        {
          "value": "story",
          "label": "竖屏视频（9:16）"
        },
        {
          "value": "landscape",
          "label": "横版（16:9）"
        },
        {
          "value": "auto",
          "label": "原始比例 / 自然高度"
        }
      ],
      "default": "square"
    },
    {
      "type": "select",
      "id": "media_position",
      "label": "裁切焦点",
      "options": [
        {
          "value": "center center",
          "label": "居中"
        },
        {
          "value": "center top",
          "label": "顶部"
        },
        {
          "value": "center bottom",
          "label": "底部"
        }
      ],
      "default": "center center"
    },
    {
      "type": "select",
      "id": "hover_effect",
      "label": "悬停效果",
      "options": [
        {
          "value": "none",
          "label": "无"
        },
        {
          "value": "zoom",
          "label": "缩放"
        },
        {
          "value": "overlay",
          "label": "暗色遮罩 + 说明文字"
        },
        {
          "value": "zoom-overlay",
          "label": "缩放 + 遮罩"
        }
      ],
      "default": "zoom-overlay"
    },
    {
      "type": "checkbox",
      "id": "show_caption",
      "label": "在媒体下方显示说明文字",
      "default": false
    },
    {
      "type": "header",
      "content": "视频播放"
    },
    {
      "type": "checkbox",
      "id": "video_autoplay",
      "label": "视频自动播放",
      "info": "开启后视频会静音并在进入当前可见网格时自动播放；滑出当前列、离开可视区域或切到后台时自动暂停。",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "video_loop",
      "label": "循环播放",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "video_muted",
      "label": "静音",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "video_controls",
      "label": "显示视频控制条",
      "info": "如果开启控制条，为避免遮挡播放控件，视频卡片的整块跳转链接将停用。",
      "default": false
    },
    {
      "type": "header",
      "content": "标题区域"
    },
    {
      "type": "select",
      "id": "header_align",
      "label": "标题对齐方式",
      "options": [
        {
          "value": "left",
          "label": "左对齐"
        },
        {
          "value": "center",
          "label": "居中"
        },
        {
          "value": "right",
          "label": "右对齐"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "header_gap",
      "label": "标题与网格间距（px）",
      "min": 8,
      "max": 80,
      "step": 4,
      "default": 32
    },
    {
      "type": "text",
      "id": "title",
      "label": "标题",
      "default": "Scenes to keep."
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "副标题"
    },
    {
      "type": "header",
      "content": "社交账号"
    },
    {
      "type": "text",
      "id": "instagram_handle",
      "label": "社交账号文字",
      "default": "@missvella"
    },
    {
      "type": "select",
      "id": "social_platform",
      "label": "社交图标",
      "options": [
        {
          "value": "instagram",
          "label": "Instagram"
        },
        {
          "value": "pinterest",
          "label": "Pinterest"
        },
        {
          "value": "facebook",
          "label": "Facebook"
        }
      ],
      "default": "instagram"
    },
    {
      "type": "url",
      "id": "social_link",
      "label": "社交链接",
      "info": "Instagram 留空时使用 @missvella 链接；Pinterest / Facebook 请填写对应平台的目标链接。"
    }
  ],
  "blocks": [
    {
      "type": "media_item",
      "name": "媒体项目",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "图片",
          "info": "未选择视频时显示此图片。"
        },
        {
          "type": "video",
          "id": "video",
