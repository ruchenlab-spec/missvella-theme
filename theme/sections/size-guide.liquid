{%- liquid
  assign default_tab = section.settings.default_tab | default: 'chart'
  assign guide_image = section.settings.htm_image
  assign guide_image_alt = guide_image.alt | default: 'Measurement diagram showing bust, waist, hips, hollow to floor and height.'
  assign chart_id = 'SizeGuideChart-' | append: section.id
  assign measure_id = 'SizeGuideMeasure-' | append: section.id
-%}

<missvella-size-guide
  class="mv-size-guide"
  style="
    --sg-max-width: {{ section.settings.max_width }}px;
    --sg-custom-image-width: {{ section.settings.image_max_width }}px;
    --sg-table-height: {{ section.settings.table_max_height }}px;
    --sg-mobile-padding: {{ section.settings.mobile_side_padding | default: 16 }}px;
    --sg-padding-top: {{ section.settings.padding_top }}px;
    --sg-padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="mv-size-guide__layout">
    <header class="mv-size-guide__intro">
      {%- if section.settings.heading != blank -%}
        <h1 class="mv-size-guide__title">
          {%- case section.settings.heading -%}
            {%- when 'Size Guide' -%}
              Size <em>Guide</em>
            {%- when 'Size guide' -%}
              Size <em>guide</em>
            {%- else -%}
              {{ section.settings.heading | escape }}
          {%- endcase -%}
        </h1>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p>{{ section.settings.subheading | escape }}</p>
      {%- endif -%}

      <div
        class="mv-size-guide__tabs"
        role="tablist"
        aria-label="Size guide sections"
        aria-orientation="vertical"
        data-active="{{ default_tab }}"
      >
        <button
          type="button"
          id="{{ chart_id }}-tab"
          role="tab"
          aria-controls="{{ chart_id }}"
          {% if default_tab == 'chart' %}aria-selected="true"{% else %}aria-selected="false" tabindex="-1"{% endif %}
        >
          Size chart
        </button>
        <button
          type="button"
          id="{{ measure_id }}-tab"
          role="tab"
          aria-controls="{{ measure_id }}"
          {% if default_tab == 'measure' %}aria-selected="true"{% else %}aria-selected="false" tabindex="-1"{% endif %}
        >
          How to measure
        </button>
      </div>
    </header>

    <section
      class="mv-size-guide__panel"
      id="{{ chart_id }}"
      role="tabpanel"
      aria-labelledby="{{ chart_id }}-tab"
      tabindex="0"
      {% unless default_tab == 'chart' %}hidden{% endunless %}
    >
      <div class="mv-size-guide__chart-heading">
        <div>
          <h2 class="mv-size-guide__panel-title" id="{{ chart_id }}-title">{{ section.settings.chart_heading | escape }}</h2>
          <p class="mv-size-guide__unit-copy" id="{{ chart_id }}-unit" aria-live="polite">Measurements in inches</p>
        </div>
        {%- if section.settings.show_unit_toggle -%}
          <div class="mv-size-guide__units" role="group" aria-label="Measurement unit">
            <button type="button" data-unit="in" aria-label="IN (inches)" aria-pressed="true">IN</button>
            <button type="button" data-unit="cm" aria-label="CM (centimeters)" aria-pressed="false">CM</button>
          </div>
        {%- endif -%}
      </div>

      <div class="mv-size-guide__table-window" role="region" aria-labelledby="{{ chart_id }}-title" tabindex="0">
        <table class="mv-size-guide__table" aria-labelledby="{{ chart_id }}-title" aria-describedby="{{ chart_id }}-unit">
          <thead>
            <tr>
              <th scope="col">Size</th>
              <th scope="col">Bust</th>
              <th scope="col">Waist</th>
              <th scope="col">Hips</th>
              <th scope="col">Hollow to hem</th>
            </tr>
          </thead>
          <tbody>
            {%- render 'size-chart-rows', unit: 'in', row_headers: true -%}
          </tbody>
        </table>
      </div>
    </section>

    <section
      class="mv-size-guide__panel"
      id="{{ measure_id }}"
      role="tabpanel"
      aria-labelledby="{{ measure_id }}-tab"
      tabindex="0"
      {% unless default_tab == 'measure' %}hidden{% endunless %}
    >
      <h2 class="mv-size-guide__panel-title">How to measure</h2>
      <figure class="mv-size-guide__figure{% if guide_image != blank %} mv-size-guide__figure--custom{% endif %}">
        {%- if guide_image != blank -%}
          {{ guide_image | image_url: width: 1040 | image_tag: loading: 'lazy', widths: '320, 520, 780, 1040', alt: guide_image_alt }}
        {%- else -%}
          <img
            src="{{ 'size-guide-how-to-measure.png' | asset_url }}"
            alt="{{ guide_image_alt | escape }}"
            width="1086"
            height="1448"
            loading="lazy"
          >
        {%- endif -%}
        {%- if section.settings.measurement_note != blank -%}
          <figcaption>{{ section.settings.measurement_note }}</figcaption>
        {%- endif -%}
      </figure>
    </section>
  </div>
</missvella-size-guide>

{% stylesheet %}
  .mv-size-guide {
    --sg-ink: #161616;
    --sg-muted: #595959;
    --sg-line: #ddd;
    --sg-paper: #fff;
    --sg-serif: "Bodoni MT", Didot, "Times New Roman", serif;
    display: block;
    padding-block: var(--sg-padding-top) var(--sg-padding-bottom);
    background: var(--sg-paper);
    color: var(--sg-ink);
    font-family: var(--font-body--family, Arial, sans-serif);
  }

  .mv-size-guide__layout {
    display: grid;
    grid-template-columns: minmax(174px, 21%) minmax(0, 1fr);
    gap: clamp(28px, 4vw, 64px);
    width: min(calc(100% - 48px), var(--sg-max-width));
    margin-inline: auto;
  }

  .mv-size-guide__intro {
    border-inline-end: 1px solid var(--sg-line);
    padding-inline-end: clamp(14px, 2vw, 28px);
  }

  .mv-size-guide__title,
  .mv-size-guide__panel-title {
    margin: 0;
    color: var(--sg-ink);
    font-family: var(--sg-serif);
    font-weight: 400;
    font-style: normal;
    line-height: 1.05;
    letter-spacing: -.045em;
    text-transform: none;
  }

  .mv-size-guide__title { font-size: clamp(38px, 3.6vw, 51px); }
  .mv-size-guide__panel-title { font-size: clamp(29px, 3.1vw, 46px); }
  .mv-size-guide__intro p { margin: 16px 0 0; color: var(--sg-muted); font-size: 14px; line-height: 1.55; }

  .mv-size-guide__tabs {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-rows: repeat(2, minmax(44px, 1fr));
    margin-block-start: 24px;
    padding: 3px;
    border: 1px solid var(--sg-line);
  }

  .mv-size-guide__tabs::before {
    content: "";
    position: absolute;
    inset-block-start: 3px;
    inset-inline-start: 3px;
    width: calc(100% - 6px);
    height: calc(50% - 3px);
    background: var(--sg-ink);
    transform: translateY(var(--sg-tab-offset, 0%));
    transition: transform 260ms cubic-bezier(.22, .65, .3, 1);
    pointer-events: none;
  }

  .mv-size-guide__tabs[data-active="measure"] { --sg-tab-offset: 100%; }

  .mv-size-guide__tabs button,
  .mv-size-guide__units button {
    position: relative;
    margin: 0;
    padding: 0 8px;
    border: 0;
    background: transparent;
    color: var(--sg-ink);
    font: inherit;
    cursor: pointer;
  }

  .mv-size-guide__tabs button {
    text-align: start;
    font-size: 13px;
    transition: color 180ms ease;
  }

  .mv-size-guide__tabs button[aria-selected="true"] { color: var(--sg-paper); }
  .mv-size-guide :is(button, [tabindex]):focus-visible { outline: 2px solid currentColor; outline-offset: -3px; }
  .mv-size-guide__panel { min-width: 0; animation: mv-size-guide-enter 240ms ease-out; }
  .mv-size-guide__panel[hidden] { display: none; }

  @keyframes mv-size-guide-enter {
    from { opacity: .42; transform: translateY(5px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .mv-size-guide__chart-heading {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 10px;
    margin-block-end: 18px;
  }

  .mv-size-guide__unit-copy { margin: 7px 0 0; color: var(--sg-muted); font-size: 12px; line-height: 1.4; }
  .mv-size-guide__units { display: flex; flex: none; border: 1px solid var(--sg-ink); }
  .mv-size-guide__units button { min-width: 42px; min-height: 42px; font-size: 11px; font-weight: 600; letter-spacing: .08em; }
  .mv-size-guide__units button[aria-pressed="true"] { background: var(--sg-ink); color: var(--sg-paper); }

  .mv-size-guide__table-window {
    max-height: var(--sg-table-height);
    overflow: auto;
    border: 1px solid var(--sg-ink);
  }

  .mv-size-guide__table {
    width: 100%;
    margin: 0;
    border: 0;
    border-collapse: separate;
    border-spacing: 0;
    table-layout: fixed;
    color: var(--sg-ink);
    font-variant-numeric: lining-nums tabular-nums;
    text-align: center;
  }

  .mv-size-guide__table :is(th, td) { padding: 9px 5px; border: 0; line-height: 1.3; }
  .mv-size-guide__table thead th {
    position: sticky;
    top: 0;
    z-index: 1;
    border-block-end: 1px solid var(--sg-ink);
    background: #f2f2f2;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: .065em;
    text-transform: uppercase;
  }
  .mv-size-guide__table thead th:first-child { width: 16%; }
  .mv-size-guide__table thead th:last-child { width: 24%; }
  .mv-size-guide__table tr > * + * { border-inline-start: 1px solid var(--sg-line); }
  .mv-size-guide__table tbody :is(th, td) { font-size: 13px; }
  .mv-size-guide__table tbody tr + tr > * { border-block-start: 1px solid var(--sg-line); }
  .mv-size-guide__table tbody th { background: #f2f2f2; font-weight: 600; }

  @media (hover: hover) {
    .mv-size-guide__table tbody tr:hover > * { background: #eaeaea; }
  }

  .mv-size-guide__figure { width: min(100%, 565px); margin: 18px 0 0; }
  .mv-size-guide__figure--custom { width: min(100%, var(--sg-custom-image-width)); }
  .mv-size-guide__figure img { display: block; width: 100%; height: auto; }
  .mv-size-guide__figure figcaption { margin-block-start: 12px; color: var(--sg-muted); font-size: 12px; line-height: 1.5; }
  .mv-size-guide__figure figcaption p { margin: 0; }

  @media (max-width: 740px) {
    .mv-size-guide__layout {
      grid-template-columns: minmax(0, 1fr);
      gap: 26px;
      width: calc(100% - 2 * var(--sg-mobile-padding));
    }
    .mv-size-guide__intro { border: 0; padding: 0; }
    .mv-size-guide__tabs { grid-template-columns: repeat(2, minmax(0, 1fr)); grid-template-rows: minmax(44px, 1fr); }
    .mv-size-guide__tabs::before {
      width: calc(50% - 3px);
      height: calc(100% - 6px);
      transform: translateX(var(--sg-tab-offset, 0%));
    }
    .mv-size-guide__tabs:dir(rtl)[data-active="measure"] { --sg-tab-offset: -100%; }
    .mv-size-guide__tabs button { text-align: center; }
    .mv-size-guide__table-window { max-height: min(var(--sg-table-height), 65vh); }
  }

  @media (max-width: 420px) {
    .mv-size-guide__table :is(th, td) { padding-inline: 3px; }
    .mv-size-guide__table thead th { font-size: 9px; letter-spacing: .025em; }
  }

  @media (prefers-reduced-motion: reduce) {
    .mv-size-guide__tabs::before,
    .mv-size-guide__tabs button { transition: none; }
    .mv-size-guide__panel { animation: none; }
  }
{% endstylesheet %}

{% javascript %}
  if (!customElements.get('missvella-size-guide')) {
    class MissvellaSizeGuide extends HTMLElement {
      connectedCallback() {
        this.events?.abort();
        const controller = new AbortController();
        this.events = controller;
        const listenerOptions = { signal: controller.signal };
        const tabList = this.querySelector('[role="tablist"]');
        const tabs = [...tabList.querySelectorAll('[role="tab"]')];
        const panels = [...this.querySelectorAll('[role="tabpanel"]')];
        const mobile = window.matchMedia('(max-width: 740px)');
        const unitButtons = [...this.querySelectorAll('[data-unit]')];
        const unitCopy = this.querySelector('.mv-size-guide__unit-copy');
        const cells = this.querySelectorAll('[data-cm]');

        function selectTab(selected) {
          tabList.dataset.active = selected === tabs[0] ? 'chart' : 'measure';
          const panelId = selected.getAttribute('aria-controls');
          for (const tab of tabs) {
            tab.setAttribute('aria-selected', String(tab === selected));
            tab.tabIndex = tab === selected ? 0 : -1;
          }
          for (const panel of panels) panel.hidden = panel.id !== panelId;
        }

        function updateOrientation() {
          tabList.setAttribute('aria-orientation', mobile.matches ? 'horizontal' : 'vertical');
        }

        for (const tab of tabs) tab.addEventListener('click', () => selectTab(tab), listenerOptions);
        tabList.addEventListener('keydown', (event) => {
          const current = tabs.indexOf(event.target);
          if (current === -1) return;
          const previous = mobile.matches ? 'ArrowLeft' : 'ArrowUp';
          const next = mobile.matches ? 'ArrowRight' : 'ArrowDown';
          let index;
          if (event.key === 'Home') index = 0;
          else if (event.key === 'End') index = tabs.length - 1;
          else if (event.key === previous) index = (current + tabs.length - 1) % tabs.length;
          else if (event.key === next) index = (current + 1) % tabs.length;
          else return;
          event.preventDefault();
          selectTab(tabs[index]);
          tabs[index].focus();
        }, listenerOptions);
        mobile.addEventListener('change', updateOrientation, listenerOptions);
        updateOrientation();

        for (const button of unitButtons) {
          button.addEventListener('click', () => {
            const inches = button.dataset.unit === 'in';
            for (const cell of cells) {
              const cm = cell.dataset.cm;
              cell.textContent = inches ? (Number(cm) / 2.54).toFixed(1).replace(/\.0$/, '') : cm;
            }
            for (const unit of unitButtons) unit.setAttribute('aria-pressed', String(unit === button));
            unitCopy.textContent = inches ? 'Measurements in inches' : 'Measurements in centimeters';
          }, listenerOptions);
        }
      }

      disconnectedCallback() {
        this.events?.abort();
      }
    }
    customElements.define('missvella-size-guide', MissvellaSizeGuide);
  }
{% endjavascript %}

{% schema %}
{
  "name": "Size Guide",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Size Guide"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Find your best fit and learn how to measure."
    },
    {
      "type": "text",
      "id": "chart_heading",
      "label": "Chart heading",
      "default": "Adult Sizes"
    },
    {
      "type": "select",
      "id": "default_tab",
      "label": "Default tab",
      "options": [
        { "value": "chart", "label": "Size Chart" },
        { "value": "measure", "label": "How to Measure" }
      ],
      "default": "chart"
    },
    {
      "type": "checkbox",
      "id": "show_unit_toggle",
      "label": "Show IN / CM toggle",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "htm_image",
      "label": "How to Measure image"
    },
    {
      "type": "richtext",
      "id": "measurement_note",
      "label": "Measurement note",
      "default": "<p>All measurements should be taken over underwear. For best results, have someone help you measure.</p>"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Maximum width",
      "min": 640,
      "max": 1400,
      "step": 20,
      "unit": "px",
      "default": 980
    },
    {
      "type": "range",
      "id": "image_max_width",
      "label": "Custom measurement image width",
      "min": 220,
      "max": 520,
      "step": 10,
      "unit": "px",
      "default": 320
    },
    {
      "type": "range",
      "id": "table_max_height",
      "label": "Table maximum height",
      "min": 360,
      "max": 800,
      "step": 20,
      "unit": "px",
      "default": 620
    },
    {
      "type": "range",
      "id": "mobile_side_padding",
      "label": "Mobile side padding",
      "min": 8,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "Size Guide",
      "category": "Text"
    }
  ]
}
{% endschema %}
