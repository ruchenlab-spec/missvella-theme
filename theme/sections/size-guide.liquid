{%- liquid
  assign sg_id = section.id | replace: '_', '' | downcase
  assign htm_image = section.settings.htm_image
-%}

<div
  class="sg-page-{{ sg_id }}"
  id="sg-page-{{ sg_id }}"
  data-sg-page
  data-default-tab="{{ section.settings.default_tab }}"
>
  <div class="sg-page__inner-{{ sg_id }}">
    <header class="sg-page__header-{{ sg_id }}">
      <div class="sg-page__heading-copy-{{ sg_id }}">
        <h2>{{ section.settings.heading | escape }}</h2>
        {%- if section.settings.subheading != blank -%}
          <p>{{ section.settings.subheading | escape }}</p>
        {%- endif -%}
      </div>

      {%- if section.settings.show_unit_toggle -%}
        <div class="sg-page__unit-{{ sg_id }}" data-sg-unit="cm" role="group" aria-label="Measurement unit">
          <span class="sg-page__unit-slider-{{ sg_id }}" aria-hidden="true"></span>
          <button type="button" data-unit="cm" class="active" aria-pressed="true">CM</button>
          <button type="button" data-unit="in" aria-pressed="false">IN</button>
        </div>
      {%- endif -%}
    </header>

    <div class="sg-page__tabs-{{ sg_id }}" data-sg-tab="{{ section.settings.default_tab }}">
      <span class="sg-page__tab-slider-{{ sg_id }}" aria-hidden="true"></span>
      <button type="button" data-tab="chart"{% if section.settings.default_tab == 'chart' %} class="active"{% endif %}>Size Chart</button>
      <button type="button" data-tab="measure"{% if section.settings.default_tab == 'measure' %} class="active"{% endif %}>How to Measure</button>
    </div>

    <div class="sg-page__content-{{ sg_id }}">
      <section class="sg-page__panel-{{ sg_id }}{% if section.settings.default_tab == 'chart' %} active{% endif %}" data-panel="chart">
        <div class="sg-page__chart-section-{{ sg_id }}">
          <div class="sg-page__chart-heading-{{ sg_id }}">
            <h3>{{ section.settings.chart_heading | escape }}</h3>
            <span>All measurements in <strong data-unit-copy>CM</strong></span>
          </div>

          <div class="sg-page__table-scroll-{{ sg_id }}">
            <table class="sg-page__table-{{ sg_id }}">
              <thead>
                <tr>
                  <th>Size</th>
                  <th>Bust</th>
                  <th>Waist</th>
                  <th>Hips</th>
                  <th>Hollow to Hem</th>
                </tr>
              </thead>
              <tbody>
                {%- render 'size-chart-rows' -%}
              </tbody>
            </table>
          </div>
        </div>
      </section>

      <section class="sg-page__panel-{{ sg_id }}{% if section.settings.default_tab == 'measure' %} active{% endif %}" data-panel="measure">
        <div class="sg-page__measure-{{ sg_id }}">
          <div class="sg-page__image-wrap-{{ sg_id }}">
            {%- if htm_image != blank -%}
              {{ htm_image | image_url: width: 900 | image_tag: loading: 'lazy', class: 'sg-page__image', alt: 'How to measure' }}
            {%- else -%}
              <img
                class="sg-page__image"
                src="{{ 'size-chart-how-to-measure.png' | asset_url }}"
                alt="How to measure"
                width="852"
                height="1394"
                loading="lazy"
              >
            {%- endif -%}

            {%- assign hs = section.settings.hotspot_size -%}
            <button type="button" class="sg-page__hotspot-{{ sg_id }}" style="left:calc({{ section.settings.hp1_x }}% - {{ hs | divided_by: 2.0 }}px);top:calc({{ section.settings.hp1_y }}% - {{ hs | divided_by: 2.0 }}px);width:{{ hs }}px;height:{{ hs }}px;" data-hotspot="1" aria-label="Bust"><span>1</span></button>
            <button type="button" class="sg-page__hotspot-{{ sg_id }}" style="left:calc({{ section.settings.hp2_x }}% - {{ hs | divided_by: 2.0 }}px);top:calc({{ section.settings.hp2_y }}% - {{ hs | divided_by: 2.0 }}px);width:{{ hs }}px;height:{{ hs }}px;" data-hotspot="2" aria-label="Waist"><span>2</span></button>
            <button type="button" class="sg-page__hotspot-{{ sg_id }}" style="left:calc({{ section.settings.hp3_x }}% - {{ hs | divided_by: 2.0 }}px);top:calc({{ section.settings.hp3_y }}% - {{ hs | divided_by: 2.0 }}px);width:{{ hs }}px;height:{{ hs }}px;" data-hotspot="3" aria-label="Hips"><span>3</span></button>
            <button type="button" class="sg-page__hotspot-{{ sg_id }}" style="left:calc({{ section.settings.hp4_x }}% - {{ hs | divided_by: 2.0 }}px);top:calc({{ section.settings.hp4_y }}% - {{ hs | divided_by: 2.0 }}px);width:{{ hs }}px;height:{{ hs }}px;" data-hotspot="4" aria-label="Hollow to Floor"><span>4</span></button>
            <button type="button" class="sg-page__hotspot-{{ sg_id }}" style="left:calc({{ section.settings.hp5_x }}% - {{ hs | divided_by: 2.0 }}px);top:calc({{ section.settings.hp5_y }}% - {{ hs | divided_by: 2.0 }}px);width:{{ hs }}px;height:{{ hs }}px;" data-hotspot="5" aria-label="Height"><span>5</span></button>
          </div>

          <div class="sg-page__accordions-{{ sg_id }}">
            <div class="sg-page__accordion-{{ sg_id }}" data-step="1">
              <button type="button" class="sg-page__accordion-head-{{ sg_id }}" aria-expanded="false"><span>1</span><strong>Bust</strong><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2"><polyline points="4,6 8,10 12,6"/></svg></button>
              <div class="sg-page__accordion-body-{{ sg_id }}"><p>Measure around the fullest part of your bust, keeping the tape level around your back.</p></div>
            </div>
            <div class="sg-page__accordion-{{ sg_id }}" data-step="2">
              <button type="button" class="sg-page__accordion-head-{{ sg_id }}" aria-expanded="false"><span>2</span><strong>Waist</strong><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2"><polyline points="4,6 8,10 12,6"/></svg></button>
              <div class="sg-page__accordion-body-{{ sg_id }}"><p>Measure around the narrowest part of your natural waistline without pulling the tape tight.</p></div>
            </div>
            <div class="sg-page__accordion-{{ sg_id }}" data-step="3">
              <button type="button" class="sg-page__accordion-head-{{ sg_id }}" aria-expanded="false"><span>3</span><strong>Hips</strong><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2"><polyline points="4,6 8,10 12,6"/></svg></button>
              <div class="sg-page__accordion-body-{{ sg_id }}"><p>Measure around the fullest part of your hips, keeping the tape parallel to the floor.</p></div>
            </div>
            <div class="sg-page__accordion-{{ sg_id }}" data-step="4">
              <button type="button" class="sg-page__accordion-head-{{ sg_id }}" aria-expanded="false"><span>4</span><strong>Hollow to Floor</strong><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2"><polyline points="4,6 8,10 12,6"/></svg></button>
              <div class="sg-page__accordion-body-{{ sg_id }}"><p>Measure from the hollow where the collarbones meet at the front of the neck vertically down to the floor, barefoot.</p></div>
            </div>
            <div class="sg-page__accordion-{{ sg_id }}" data-step="5">
              <button type="button" class="sg-page__accordion-head-{{ sg_id }}" aria-expanded="false"><span>5</span><strong>Height</strong><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2"><polyline points="4,6 8,10 12,6"/></svg></button>
              <div class="sg-page__accordion-body-{{ sg_id }}"><p>Stand straight and measure from the top of your head to the floor, barefoot.</p></div>
            </div>
          </div>

          {%- if section.settings.measurement_note != blank -%}
            <div class="sg-page__note-{{ sg_id }}">{{ section.settings.measurement_note }}</div>
          {%- endif -%}
        </div>
      </section>
    </div>
  </div>
</div>

{% style %}
  .sg-page-{{ sg_id }} {
    --sg-border: #D9D7D2;
    --sg-stone: #EBE8E2;
    --sg-soft: #F7F6F3;
    --sg-muted: #6C6A67;
    width: 100%;
    color: #000;
    font-family: var(--font-body--family, var(--font-body-family, sans-serif));
  }
  .sg-page__inner-{{ sg_id }} {
    width: min(100%, {{ section.settings.max_width }}px);
    margin: 0 auto;
    padding-block: {{ section.settings.padding_top }}px {{ section.settings.padding_bottom }}px;
  }
  .sg-page__header-{{ sg_id }} {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 20px;
  }
  .sg-page__heading-copy-{{ sg_id }} h2 {
    margin: 0;
    font: inherit;
    font-size: clamp(24px, 3vw, 36px);
    line-height: 1.1;
    font-weight: 700;
    letter-spacing: -.025em;
  }
  .sg-page__heading-copy-{{ sg_id }} p {
    margin: 8px 0 0;
    font-size: 14px;
    line-height: 1.5;
    color: var(--sg-muted);
  }
  .sg-page__unit-{{ sg_id }} {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    width: 108px;
    height: 42px;
    padding: 4px;
    border: 1px solid var(--sg-border);
    background: var(--sg-soft);
    border-radius: 11px;
    overflow: hidden;
    flex: 0 0 auto;
  }
  .sg-page__unit-slider-{{ sg_id }} {
    position: absolute;
    top: 4px;
    left: 4px;
    width: 48px;
    height: 32px;
    border-radius: 8px;
    background: #000;
    transition: transform .28s cubic-bezier(.22,.72,.24,1);
  }
  .sg-page__unit-{{ sg_id }}[data-sg-unit='in'] .sg-page__unit-slider-{{ sg_id }} { transform: translateX(50px); }
  .sg-page__unit-{{ sg_id }} button {
    position: relative;
    z-index: 1;
    border: 0;
    background: transparent;
    color: #777;
    font: inherit;
    font-size: 12px;
    font-weight: 650;
    cursor: pointer;
  }
  .sg-page__unit-{{ sg_id }} button.active { color: #fff; }

  .sg-page__tabs-{{ sg_id }} {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
    min-height: 50px;
    padding: 4px;
    border: 1px solid var(--sg-border);
    background: var(--sg-soft);
    border-radius: 12px;
    margin-bottom: 22px;
  }
  .sg-page__tab-slider-{{ sg_id }} {
    position: absolute;
    top: 4px;
    left: 4px;
    width: calc(50% - 4px);
    height: calc(100% - 8px);
    border-radius: 9px;
    background: #000;
    transition: transform .3s cubic-bezier(.22,.72,.24,1);
  }
  .sg-page__tabs-{{ sg_id }}[data-sg-tab='measure'] .sg-page__tab-slider-{{ sg_id }} { transform: translateX(100%); }
  .sg-page__tabs-{{ sg_id }} button {
    position: relative;
    z-index: 1;
    border: 0;
    background: transparent;
    color: #777;
    font: inherit;
    font-size: 13px;
    cursor: pointer;
    transition: color .18s ease;
  }
  .sg-page__tabs-{{ sg_id }} button.active { color: #fff; }

  .sg-page__panel-{{ sg_id }} { display: none; }
  .sg-page__panel-{{ sg_id }}.active { display: block; animation: sgFade-{{ sg_id }} .24s ease; }
  @keyframes sgFade-{{ sg_id }} { from { opacity: .35; transform: translateY(4px); } to { opacity: 1; transform: translateY(0); } }

  .sg-page__chart-heading-{{ sg_id }} {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 14px;
    margin-bottom: 14px;
  }
  .sg-page__chart-heading-{{ sg_id }} h3 { margin: 0; font: inherit; font-size: 20px; font-weight: 700; }
  .sg-page__chart-heading-{{ sg_id }} span { color: var(--sg-muted); font-size: 12px; white-space: nowrap; }
  .sg-page__chart-heading-{{ sg_id }} strong { color: inherit; font-weight: 500; }

  .sg-page__table-scroll-{{ sg_id }} {
    position: relative;
    overflow: auto;
    max-height: {{ section.settings.table_max_height }}px;
    border: 1px solid var(--sg-border);
    border-radius: 12px;
    background: #fff;
    overscroll-behavior: contain;
    -webkit-overflow-scrolling: touch;
  }
  .sg-page__table-{{ sg_id }} {
    width: 100%;
    min-width: 520px;
    border-collapse: separate;
    border-spacing: 0;
    font-size: 13px;
    background: #fff;
  }
  .sg-page__table-{{ sg_id }} th {
    position: sticky;
    top: 0;
    z-index: 3;
    padding: 12px 10px;
    background: var(--sg-stone);
    border-bottom: 1px solid #DEDAD4;
    font-weight: 650;
    text-align: center;
    white-space: nowrap;
  }
  .sg-page__table-{{ sg_id }} td {
    padding: 11px 10px;
    border-top: 1px solid #ECEAE6;
    background: #fff;
    text-align: center;
    white-space: nowrap;
  }
  .sg-page__table-{{ sg_id }} th:first-child,
  .sg-page__table-{{ sg_id }} td:first-child {
    position: sticky;
    left: 0;
    width: 74px;
    min-width: 74px;
    max-width: 74px;
    font-weight: 650;
    box-shadow: 1px 0 0 #E2DFDA;
  }
  .sg-page__table-{{ sg_id }} td:first-child { z-index: 2; background: #FAFAF8; }
  .sg-page__table-{{ sg_id }} th:first-child { z-index: 5; background: var(--sg-stone); }
  .sg-page__table-{{ sg_id }} th:not(:first-child),
  .sg-page__table-{{ sg_id }} td:not(:first-child) { min-width: 88px; }
  .sg-page__table-{{ sg_id }} th:last-child,
  .sg-page__table-{{ sg_id }} td:last-child { min-width: 118px; }

  .sg-page__measure-{{ sg_id }} { display: flex; flex-direction: column; gap: 20px; }
  .sg-page__image-wrap-{{ sg_id }} {
    position: relative;
    width: min(100%, {{ section.settings.image_max_width }}px);
    margin: 0 auto;
    border: 1px solid var(--sg-border);
    border-radius: 14px;
    overflow: hidden;
    background: #fff;
  }
  .sg-page__image-wrap-{{ sg_id }} .sg-page__image { width: 100%; height: auto; display: block; }
  .sg-page__hotspot-{{ sg_id }} {
    position: absolute;
    z-index: 3;
    border: 0;
    background: transparent;
    padding: 0;
    cursor: pointer;
  }
  .sg-page__hotspot-{{ sg_id }} span {
    width: 100%;
    height: 100%;
    display: grid;
    place-items: center;
    border-radius: 8px;
    border: 1.5px solid #000;
    background: #fff;
    color: #000;
    font-size: 10px;
    font-weight: 700;
    transition: background .16s ease, color .16s ease, transform .16s ease;
  }
  .sg-page__hotspot-{{ sg_id }}.active span { background: #000; color: #fff; transform: scale(1.06); }

  .sg-page__accordions-{{ sg_id }} { display: flex; flex-direction: column; gap: 10px; }
  .sg-page__accordion-{{ sg_id }} {
    border: 1px solid var(--sg-border);
    border-radius: 11px;
    overflow: hidden;
    background: #fff;
  }
  .sg-page__accordion-head-{{ sg_id }} {
    width: 100%;
    min-height: 52px;
    display: flex;
    align-items: center;
    gap: 12px;
    border: 0;
    background: #fff;
    color: #000;
    padding: 10px 14px;
    text-align: left;
    font: inherit;
    cursor: pointer;
  }
  .sg-page__accordion-head-{{ sg_id }} > span { width: 24px; color: #777; font-size: 12px; }
  .sg-page__accordion-head-{{ sg_id }} strong { flex: 1; font-size: 13px; font-weight: 650; }
  .sg-page__accordion-head-{{ sg_id }} svg {
    width: 16px !important;
    height: 16px !important;
    flex: 0 0 16px !important;
    transition: transform .22s ease;
  }
  .sg-page__accordion-{{ sg_id }}.active .sg-page__accordion-head-{{ sg_id }} svg { transform: rotate(180deg); }
  .sg-page__accordion-body-{{ sg_id }} {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows .28s cubic-bezier(.22,.72,.24,1);
  }
  .sg-page__accordion-{{ sg_id }}.active .sg-page__accordion-body-{{ sg_id }} { grid-template-rows: 1fr; }
  .sg-page__accordion-body-{{ sg_id }} > p {
    min-height: 0;
    overflow: hidden;
    margin: 0;
    padding: 0 50px 0 50px;
    color: var(--sg-muted);
    font-size: 12px;
    line-height: 1.6;
    transition: padding .28s cubic-bezier(.22,.72,.24,1);
  }
  .sg-page__accordion-{{ sg_id }}.active .sg-page__accordion-body-{{ sg_id }} > p { padding-top: 2px; padding-bottom: 14px; }
  .sg-page__note-{{ sg_id }} {
    border-left: 3px solid #000;
    border-radius: 9px;
    background: var(--sg-soft);
    padding: 12px 14px;
    color: var(--sg-muted);
    font-size: 12px;
    line-height: 1.6;
  }

  @media screen and (max-width: 749px) {
    .sg-page__inner-{{ sg_id }} {
      padding-inline: {{ section.settings.mobile_side_padding }}px;
      box-sizing: border-box;
    }
    .sg-page__header-{{ sg_id }} { align-items: center; gap: 12px; margin-bottom: 16px; }
    .sg-page__heading-copy-{{ sg_id }} h2 { font-size: 24px; }
    .sg-page__heading-copy-{{ sg_id }} p { font-size: 12px; }
    .sg-page__unit-{{ sg_id }} { width: 96px; height: 40px; }
    .sg-page__unit-slider-{{ sg_id }} { width: 42px; height: 30px; }
    .sg-page__unit-{{ sg_id }}[data-sg-unit='in'] .sg-page__unit-slider-{{ sg_id }} { transform: translateX(44px); }
    .sg-page__tabs-{{ sg_id }} { min-height: 46px; margin-bottom: 18px; }
    .sg-page__table-scroll-{{ sg_id }} { max-height: min({{ section.settings.table_max_height }}px, 62vh); }
    .sg-page__table-{{ sg_id }} { min-width: 470px; font-size: 12px; }
    .sg-page__table-{{ sg_id }} th,
    .sg-page__table-{{ sg_id }} td { padding: 10px 7px; }
    .sg-page__table-{{ sg_id }} th:not(:first-child),
    .sg-page__table-{{ sg_id }} td:not(:first-child) { min-width: 78px; }
    .sg-page__table-{{ sg_id }} th:last-child,
    .sg-page__table-{{ sg_id }} td:last-child { min-width: 104px; }
    .sg-page__image-wrap-{{ sg_id }} { width: min(100%, {{ section.settings.image_max_width | at_most: 340 }}px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .sg-page__unit-slider-{{ sg_id }},
    .sg-page__tab-slider-{{ sg_id }},
    .sg-page__accordion-body-{{ sg_id }},
    .sg-page__accordion-head-{{ sg_id }} svg,
    .sg-page__hotspot-{{ sg_id }} span { transition: none !important; }
    .sg-page__panel-{{ sg_id }}.active { animation: none; }
  }
{% endstyle %}

<script>
  (function () {
    const root = document.getElementById('sg-page-{{ sg_id }}');
    if (!root || root.dataset.initialized === 'true') return;
    root.dataset.initialized = 'true';

    const unit = root.querySelector('[data-sg-unit]');
    const unitButtons = root.querySelectorAll('[data-unit]');
    const unitCopy = root.querySelector('[data-unit-copy]');
    const cells = root.querySelectorAll('[data-cm]');
    const tabs = root.querySelector('[data-sg-tab]');
    const tabButtons = root.querySelectorAll('[data-tab]');
    const panels = root.querySelectorAll('[data-panel]');
    const accordions = root.querySelectorAll('[data-step]');
    const hotspots = root.querySelectorAll('[data-hotspot]');

    function setUnit(next) {
      if (!unit) return;
      const isIn = next === 'in';
      unit.dataset.sgUnit = isIn ? 'in' : 'cm';
      unitButtons.forEach((button) => {
        const active = button.dataset.unit === next;
        button.classList.toggle('active', active);
        button.setAttribute('aria-pressed', active ? 'true' : 'false');
      });
      if (unitCopy) unitCopy.textContent = isIn ? 'IN' : 'CM';
      cells.forEach((cell) => {
        const cm = Number(cell.dataset.cm);
        if (!Number.isFinite(cm)) return;
        cell.textContent = isIn ? (cm / 2.54).toFixed(1).replace(/\.0$/, '') : String(cm);
      });
    }

    function setTab(next) {
      if (!tabs) return;
      tabs.dataset.sgTab = next;
      tabButtons.forEach((button) => button.classList.toggle('active', button.dataset.tab === next));
      panels.forEach((panel) => panel.classList.toggle('active', panel.dataset.panel === next));
    }

    function setAccordion(item, forceOpen) {
      if (!item) return;
      const wasOpen = item.classList.contains('active');
      const shouldOpen = typeof forceOpen === 'boolean' ? forceOpen : !wasOpen;

      accordions.forEach((accordion) => {
        accordion.classList.remove('active');
        accordion.querySelector('[aria-expanded]')?.setAttribute('aria-expanded', 'false');
      });
      hotspots.forEach((hotspot) => hotspot.classList.remove('active'));

      if (shouldOpen) {
        item.classList.add('active');
        item.querySelector('[aria-expanded]')?.setAttribute('aria-expanded', 'true');
        root.querySelector('[data-hotspot="' + item.dataset.step + '"]')?.classList.add('active');
      }
    }

    unitButtons.forEach((button) => button.addEventListener('click', () => setUnit(button.dataset.unit)));
    tabButtons.forEach((button) => button.addEventListener('click', () => setTab(button.dataset.tab)));
    accordions.forEach((item) => item.querySelector('button')?.addEventListener('click', () => setAccordion(item)));
    hotspots.forEach((hotspot) => hotspot.addEventListener('click', () => {
      const item = root.querySelector('[data-step="' + hotspot.dataset.hotspot + '"]');
      setAccordion(item, true);
      item?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }));
  })();
</script>

{% schema %}
{
  "name": "Size Guide",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Size Guide"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Find your best fit and learn how to measure."
    },
    {
      "type": "text",
      "id": "chart_heading",
      "label": "Chart heading",
      "default": "Adult Sizes"
    },
    {
      "type": "select",
      "id": "default_tab",
      "label": "Default tab",
      "options": [
        { "value": "chart", "label": "Size Chart" },
        { "value": "measure", "label": "How to Measure" }
      ],
      "default": "chart"
    },
    {
      "type": "checkbox",
      "id": "show_unit_toggle",
      "label": "Show CM / IN toggle",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "htm_image",
      "label": "How to Measure image"
    },
    {
      "type": "richtext",
      "id": "measurement_note",
      "label": "Measurement note",
      "default": "<p>All measurements should be taken over underwear. For best results, have someone help you measure.</p>"
    },
