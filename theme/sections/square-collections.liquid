{%- comment -%}
  Square collection grid.

  Same idea as the circle-collections section, but laid out as a static square grid.
  Every item is a section-scoped block, so its cover image and title are configured
  in the theme editor instead of being pulled from the collection object.

  Blocks
  - heading: renders through the theme's native `text` snippet (full native text
    settings: richtext, width, typography preset, color, background, padding).
  - square_collection: collection (link + fallback title) with an optional custom
    image / custom title override. No collection image is used - when no custom
    image is set a placeholder is shown.
{%- endcomment -%}

{% liquid
  assign column_gap = section.settings.column_gap | default: 16
  assign row_gap = section.settings.row_gap | default: 24
  assign columns = section.settings.columns | default: 4
  assign mobile_columns = section.settings.mobile_columns | default: '2'
  assign image_ratio = section.settings.image_ratio | default: 'square'

  assign item_count = 0
  for block in section.blocks
    if block.type == 'square_collection'
      assign item_count = item_count | plus: 1
    endif
  endfor

  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
-%}

<div
  class="
    section
    section--{{ section.settings.section_width }}
    square-collections
    spacing-style
    {% if section.settings.background_color != blank %}color-custom-{{ section.id }}{% endif %}
  "
  style="
    {% render 'spacing-style', settings: section.settings %}
    --square-columns: {{ columns }};
    --square-columns-mobile: {{ mobile_columns }};
    --square-column-gap: {{ column_gap }}px;
    --square-row-gap: {{ row_gap }}px;
    --square-radius: {{ section.settings.image_radius | default: 0 }}px;
    --square-title-size: {{ section.settings.title_font_size | default: 14 }}px;
    --square-title-spacing: {{ section.settings.title_letter_spacing | default: 0 }}px;
    --square-title-transform: {{ section.settings.title_case | default: 'none' }};
    --square-title-align: {{ section.settings.title_alignment | default: 'center' }};
    {% if section.settings.title_color != blank %}--square-title-color: {{ section.settings.title_color }};{% endif %}
  "
>
  {%- comment -%} Header: heading blocks rendered with the native text snippet {%- endcomment -%}
  {%- for block in section.blocks -%}
    {%- if block.type == 'heading' -%}
      <div class="square-collections__header">
        {%- render 'text', block: block -%}
      </div>
    {%- endif -%}
  {%- endfor -%}

  <div class="square-collections__grid">
    {%- assign square_index = 0 -%}
    {%- for block in section.blocks -%}
      {%- if block.type != 'square_collection' -%}
        {%- continue -%}
      {%- endif -%}

      {%- liquid
        assign item_collection = block.settings.collection
        assign item_link = ''
        if item_collection != blank
          assign item_link = item_collection.url
        endif

        assign item_title = block.settings.custom_title
        if item_title == blank and item_collection != blank
          assign item_title = item_collection.title
        endif
      -%}

      <div class="square-collections__item" {{ block.shopify_attributes }}>
        {%- if item_link != blank -%}
          <a class="square-collections__link" href="{{ item_link }}">
        {%- else -%}
          <div class="square-collections__link">
        {%- endif -%}
          <div class="square-collections__media" data-ratio="{{ image_ratio }}">
            {%- if block.settings.custom_image != blank -%}
              {{
                block.settings.custom_image
                | image_url: width: 800
                | image_tag:
                  loading: 'lazy',
                  sizes: '(max-width: 749px) 44vw, 25vw',
                  widths: '150, 300, 450, 600, 800',
                  class: 'square-collections__image'
              }}
            {%- else -%}
              {{ 'collection-1' | placeholder_svg_tag: 'square-collections__image placeholder-svg' }}
            {%- endif -%}
          </div>
          {%- comment -%} No title text means no title element at all {%- endcomment -%}
          {%- if item_title != blank -%}
            <span class="square-collections__title">{{ item_title }}</span>
          {%- endif -%}
        {%- if item_link != blank -%}
          </a>
        {%- else -%}
          </div>
        {%- endif -%}
      </div>

      {%- assign square_index = square_index | plus: 1 -%}
    {%- endfor -%}

    {%- if item_count == 0 -%}
      {%- for i in (1..columns) -%}
        <div class="square-collections__item">
          <div class="square-collections__link">
            <div class="square-collections__media" data-ratio="{{ image_ratio }}">
              {{ 'collection-1' | placeholder_svg_tag: 'square-collections__image placeholder-svg' }}
            </div>
            <span class="square-collections__title">{{ 'placeholders.collection_title' | t }}</span>
          </div>
        </div>
      {%- endfor -%}
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .square-collections {
    container-type: inline-size;
    container-name: square-collections;
  }

  .square-collections__header {
    margin-block-end: 20px;
  }

  .square-collections__grid {
    display: grid;
    grid-template-columns: repeat(var(--square-columns-mobile, 2), minmax(0, 1fr));
    column-gap: var(--square-column-gap, 16px);
    row-gap: var(--square-row-gap, 24px);
  }

  @container square-collections (min-width: 750px) {
    .square-collections__grid {
      grid-template-columns: repeat(var(--square-columns, 4), minmax(0, 1fr));
    }
  }

  .square-collections__item {
    min-width: 0;
  }

  .square-collections__link {
    display: flex;
    flex-direction: column;
    gap: 12px;
    text-decoration: none;
    color: var(--color-foreground);
  }

  .square-collections__media {
    width: 100%;
    overflow: hidden;
    border-radius: var(--square-radius, 0);
    background-color: var(--color-background);
  }

  /* Aspect ratios mirror the theme's native image ratio options */
  .square-collections__media[data-ratio='square'] {
    aspect-ratio: 1 / 1;
  }

  .square-collections__media[data-ratio='portrait'] {
    aspect-ratio: 4 / 5;
  }

  .square-collections__media[data-ratio='landscape'] {
    aspect-ratio: 16 / 9;
  }

  /* Adapt: no forced ratio, the image keeps its own proportions */
  .square-collections__media[data-ratio='adapt'] {
    aspect-ratio: auto;
  }

  .square-collections__media[data-ratio='adapt'] .square-collections__image {
    height: auto;
  }

  .square-collections__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: scale var(--hover-transition-duration, 0.25s) var(--hover-transition-timing, ease-out);
  }

  .square-collections__link:hover .square-collections__image {
    scale: 1.04;
  }

  .square-collections__media .placeholder-svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    padding: 30%;
    fill: var(--color-foreground);
    opacity: 0.3;
  }

  .square-collections__title {
    font-family: var(--font-body--family);
    font-size: var(--square-title-size);
    line-height: 1.3;
    font-weight: 500;
    letter-spacing: var(--square-title-spacing);
    text-align: var(--square-title-align, center);
    text-transform: var(--square-title-transform, none);
    color: var(--square-title-color, var(--color-foreground));
    max-width: 100%;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }
{% endstylesheet %}

{% schema %}
