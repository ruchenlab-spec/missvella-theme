{% render 'contrast-override',
  background_color: section.settings.background_color,
  text_color: section.settings.text_color,
  section_id: section.id
%}

<div class="section-background color-custom-{{ section.id }}"></div>
<div
  class="section section--{{ section.settings.section_width }} section-resource-list spacing-style gap-style mv-editorial-columns color-custom-{{ section.id }}"
  style="
    {% render 'spacing-style', settings: section.settings %}
    {% render 'gap-style', value: section.settings.gap %}
    --mv-columns: {{ section.settings.columns }};
    --mv-mobile-columns: {{ section.settings.mobile_columns }};
    --mv-column-gap: {{ section.settings.columns_gap }}px;
    --mv-row-gap: {{ section.settings.rows_gap }}px;
    --mv-divider-width: {% if section.settings.show_dividers %}1px{% else %}0px{% endif %};
    --mv-divider-color: {{ section.settings.divider_color | default: 'rgb(var(--color-border-rgb) / var(--opacity-20))' }};
    --mv-number-color: {{ section.settings.number_color | default: 'var(--color-foreground)' }};
  "
>
  <div class="section-resource-list__header">
    {%- content_for 'block', type: 'text', id: 'heading' -%}
  </div>
  <div
    class="mv-editorial-columns__grid{% if section.settings.show_numbers %} mv-editorial-columns__grid--numbered{% endif %}"
    data-columns="{{ section.settings.columns }}"
    data-mobile-columns="{{ section.settings.mobile_columns }}"
  >
    {%- content_for 'blocks' -%}
  </div>
</div>

{% stylesheet %}
  .mv-editorial-columns {
    container: mv-editorial-columns / inline-size;
  }

  .mv-editorial-columns__grid {
    display: grid;
    grid-template-columns: repeat(var(--mv-mobile-columns), minmax(0, 1fr));
    gap: var(--mv-row-gap) var(--mv-column-gap);
    border-block-start: var(--mv-divider-width) solid var(--mv-divider-color);
    padding-block-start: var(--padding-xl);
    counter-reset: mv-editorial-column;
  }

  .mv-editorial-columns__grid:empty {
    display: none;
  }

  .mv-editorial-columns__grid > :is(.group-block, .text-block) {
    position: relative;
    min-width: 0;
    counter-increment: mv-editorial-column;
  }

  .mv-editorial-columns__grid--numbered > :is(.group-block, .text-block)::before {
    content: counter(mv-editorial-column, decimal-leading-zero);
    display: block;
    color: var(--mv-number-color);
    font: var(--font-paragraph--size) / 1 var(--font-heading--family);
    margin-block-end: var(--padding-xl);
  }

  .mv-editorial-columns__grid > .group-block > .group-block-content {
    height: auto;
  }

  .mv-editorial-columns__grid > :is(.group-block, .text-block)::after {
    content: '';
    position: absolute;
    pointer-events: none;
    background: var(--mv-divider-color);
  }

  @container mv-editorial-columns (min-width: 750px) {
    .mv-editorial-columns__grid {
      grid-template-columns: repeat(var(--mv-columns), minmax(0, 1fr));
    }

    .mv-editorial-columns__grid > :is(.group-block, .text-block)::after {
      inset-block: 0;
      inset-inline-start: calc(var(--mv-column-gap) / -2);
      width: var(--mv-divider-width);
    }

    .mv-editorial-columns__grid[data-columns='1'] > *::after,
    .mv-editorial-columns__grid[data-columns='2'] > :nth-child(2n + 1)::after,
    .mv-editorial-columns__grid[data-columns='3'] > :nth-child(3n + 1)::after,
    .mv-editorial-columns__grid[data-columns='4'] > :nth-child(4n + 1)::after {
      display: none;
    }
  }

  @container mv-editorial-columns (max-width: 749px) {
    .mv-editorial-columns__grid > :is(.group-block, .text-block)::after {
      inset-inline: 0;
      inset-block-start: calc(var(--mv-row-gap) / -2);
      height: var(--mv-divider-width);
    }

    .mv-editorial-columns__grid[data-mobile-columns='1'] > :first-child::after,
    .mv-editorial-columns__grid[data-mobile-columns='2'] > :nth-child(-n + 2)::after {
      display: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "杂志文字分栏",
  "class": "section-wrapper",
  "disabled_on": { "groups": ["header", "footer"] },
  "blocks": [{ "type": "group" }, { "type": "text" }],
  "settings": [
    { "type": "header", "content": "t:content.layout" },
    { "type": "range", "id": "columns", "label": "t:settings.columns", "min": 1, "max": 4, "step": 1, "default": 3 },
    { "type": "select", "id": "mobile_columns", "label": "t:settings.mobile_columns", "options": [{ "value": "1", "label": "t:options.one_number" }, { "value": "2", "label": "t:options.two_number" }], "default": "1" },
    { "type": "range", "id": "gap", "label": "标题与分栏间距", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 40 },
    { "type": "range", "id": "columns_gap", "label": "t:settings.horizontal_gap", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 64 },
    { "type": "range", "id": "rows_gap", "label": "t:settings.vertical_gap", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 40 },
    { "type": "select", "id": "section_width", "label": "t:settings.width", "options": [{ "value": "page-width", "label": "t:options.page" }, { "value": "full-width", "label": "t:options.full" }], "default": "page-width" },
    { "type": "header", "content": "t:content.appearance" },
    { "type": "color", "id": "background_color", "label": "t:settings.background_color", "placeholder": "t:settings.default" },
    { "type": "color", "id": "text_color", "label": "t:settings.text_color", "placeholder": "t:settings.default" },
    { "type": "checkbox", "id": "show_dividers", "label": "显示分隔线", "default": true },
    { "type": "color", "id": "divider_color", "label": "分隔线颜色", "placeholder": "t:settings.default", "visible_if": "{{ section.settings.show_dividers }}" },
    { "type": "checkbox", "id": "show_numbers", "label": "显示自动编号", "default": true },
    { "type": "color", "id": "number_color", "label": "编号颜色", "placeholder": "t:settings.default", "visible_if": "{{ section.settings.show_numbers }}" },
    { "type": "header", "content": "t:content.padding" },
    { "type": "range", "id": "padding-block-start", "label": "t:settings.top", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding-block-end", "label": "t:settings.bottom", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding-inline-start", "label": "t:settings.left", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 40, "visible_if": "{{ section.settings.section_width == 'full-width' }}" },
    { "type": "range", "id": "padding-inline-end", "label": "t:settings.right", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 40, "visible_if": "{{ section.settings.section_width == 'full-width' }}" }
  ],
  "presets": [
    {
      "name": "杂志文字分栏",
      "category": "t:categories.text",
      "blocks": {
        "heading": {
          "type": "text",
          "static": true,
          "name": "t:names.heading",
          "settings": { "text": "<h2>A considered dress.<br/><em>An effortless feeling.</em></h2>", "type_preset": "h2", "width": "100%", "max_width": "none" }
        },
        "individuality": {
          "type": "group",
          "name": "文字栏 · Individuality",
          "settings": { "gap": 20, "horizontal_alignment_flex_direction_column": "flex-start", "vertical_alignment_flex_direction_column": "flex-start" },
          "blocks": {
            "title": { "type": "text", "name": "t:names.heading", "settings": { "text": "<h3>Room to<br/><em>be yourself.</em></h3>", "type_preset": "h3", "width": "100%", "max_width": "none" } },
            "body": { "type": "text", "settings": { "text": "<p>Soft romance or a little drama. An understated entrance or all eyes on you. Your sense of occasion is yours to define.</p>", "width": "100%" } }
          },
          "block_order": ["title", "body"]
        },
        "details": {
          "type": "group",
          "name": "文字栏 · Details",
          "settings": { "gap": 20, "horizontal_alignment_flex_direction_column": "flex-start", "vertical_alignment_flex_direction_column": "flex-start" },
          "blocks": {
            "title": { "type": "text", "name": "t:names.heading", "settings": { "text": "<h3>Beauty in<br/><em>the details.</em></h3>", "type_preset": "h3", "width": "100%", "max_width": "none" } },
            "body": { "type": "text", "settings": { "text": "<p>The way light catches a fold. The line of a neckline. A silhouette in motion. It’s the little things that make a look feel special.</p>", "width": "100%" } }
          },
          "block_order": ["title", "body"]
        },
        "memory": {
          "type": "group",
          "name": "文字栏 · Memory",
          "settings": { "gap": 20, "horizontal_alignment_flex_direction_column": "flex-start", "vertical_alignment_flex_direction_column": "flex-start" },
          "blocks": {
            "title": { "type": "text", "name": "t:names.heading", "settings": { "text": "<h3>Made for<br/><em>the memory.</em></h3>", "type_preset": "h3", "width": "100%", "max_width": "none" } },
            "body": { "type": "text", "settings": { "text": "<p>A celebration. A long-awaited evening. A reason all your own. The best part of getting dressed is what happens next.</p>", "width": "100%" } }
          },
          "block_order": ["title", "body"]
        }
      },
      "block_order": ["individuality", "details", "memory"]
    }
  ]
}
{% endschema %}
