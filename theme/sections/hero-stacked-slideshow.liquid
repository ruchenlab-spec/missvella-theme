{{ 'hero-stacked-slideshow.css' | asset_url | stylesheet_tag }}
<script src="{{ 'hero-stacked-slideshow.js' | asset_url }}" type="module" fetchpriority="low"></script>

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  class="section section--{{ section.settings.section_width }} spacing-style color-{{ section.settings.color_scheme }} mv-hero-stack-section"
  style="
    {% render 'spacing-style', settings: section.settings %}
    --mv-stack-height: {{ section.settings.image_height }}px;
    --mv-stack-height-mobile: {{ section.settings.image_height_mobile }}px;
    --mv-stack-radius: {{ section.settings.corner_radius }}px;
    --mv-stack-duration: {{ section.settings.animation_duration }}ms;
  "
>
  <mv-hero-stack
    class="mv-hero-stack"
    data-overlap="{{ section.settings.overlap }}"
    role="region"
    aria-label="{{ section.settings.heading | default: 'Hero Slideshow' | escape }}"
  >
    {%- if section.settings.heading != blank -%}
      <h2 class="mv-hero-stack__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    <div class="mv-hero-stack__stage" data-stack-stage>
      {%- for block in section.blocks -%}
        {%- liquid
          assign image = block.settings.image | default: block.settings.image_mobile
          assign mobile_image = block.settings.image_mobile | default: image
          assign image_ratio = image.aspect_ratio | default: 0.75
          assign mobile_ratio = mobile_image.aspect_ratio | default: image_ratio
          assign image_alt = block.settings.alt | default: image.alt | default: block.settings.title
          assign card_label = block.settings.title | default: image_alt | default: forloop.index
          assign image_loading = 'lazy'
          if section.index == 1
            assign image_loading = 'eager'
          endif
          assign placeholder_index = forloop.index0 | modulo: 4 | plus: 1
          assign placeholder = 'collection-apparel-' | append: placeholder_index
        -%}
        <div
          class="mv-hero-stack__card"
          data-stack-card
          data-block-id="{{ block.id }}"
          data-ratio="{{ image_ratio }}"
          data-mobile-ratio="{{ mobile_ratio }}"
          tabindex="0"
          role="group"
          aria-label="{{ forloop.index }} / {{ section.blocks.size }} — {{ card_label | escape }}"
          {{ block.shopify_attributes }}
        >
          {%- if image != blank or mobile_image != blank -%}
            {%- if image != blank -%}
              {{ image | image_url: width: 2400 | image_tag:
                class: 'mv-hero-stack__image mv-hero-stack__image--desktop',
                widths: '320, 480, 750, 1000, 1500, 2000, 2400',
                sizes: '(min-width: 750px) 80vw, 84vw',
                loading: image_loading,
                alt: image_alt
              }}
            {%- endif -%}
            {{ mobile_image | image_url: width: 1500 | image_tag:
              class: 'mv-hero-stack__image mv-hero-stack__image--mobile',
              widths: '320, 480, 750, 1000, 1500',
              sizes: '84vw',
              loading: image_loading,
              alt: image_alt
            }}
          {%- else -%}
            {{ placeholder | placeholder_svg_tag: 'mv-hero-stack__placeholder' }}
          {%- endif -%}
          {%- if block.settings.title != blank or block.settings.link != blank -%}
            <div class="mv-hero-stack__caption" data-stack-caption inert>
              {%- if block.settings.title != blank -%}
                <h3>{{ block.settings.title | escape }}</h3>
              {%- endif -%}
              {%- if block.settings.link != blank -%}
                <a class="mv-hero-stack__link" href="{{ block.settings.link }}">
                  {{ block.settings.link_label | default: 'Explore' | escape }}
                </a>
              {%- endif -%}
            </div>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
    {%- if section.blocks.size > 1 -%}
      <div class="mv-hero-stack__controls">
        {% render 'carousel-arrow', action: 'previous', class: 'mv-hero-stack__previous' %}
        <span class="mv-hero-stack__counter" data-stack-counter aria-live="polite" aria-atomic="true">
          {{ section.blocks.size }}
        </span>
        {% render 'carousel-arrow', action: 'next', class: 'mv-hero-stack__next' %}
      </div>
    {%- endif -%}
    {%- if section.blocks.size == 0 and request.design_mode -%}
      <p class="mv-hero-stack__empty">请添加图片区块，开始配置堆叠轮播。</p>
    {%- endif -%}
  </mv-hero-stack>
</div>

{% schema %}
{
  "name": "Hero Slideshow · 堆叠",
  "tag": "section",
  "class": "mv-hero-stack-wrapper",
  "disabled_on": { "groups": ["header", "footer"] },
  "max_blocks": 12,
  "settings": [
    { "type": "text", "id": "heading", "label": "标题（可留空）" },
    {
      "type": "select", "id": "section_width", "label": "宽度", "default": "page-width",
      "options": [
        { "value": "page-width", "label": "页面宽度" },
        { "value": "full-width", "label": "全宽" }
      ]
    },
    { "type": "color_scheme", "id": "color_scheme", "label": "配色", "default": "scheme-1" },
    { "type": "header", "content": "图片堆叠" },
    { "type": "paragraph", "content": "图片按原始宽高比与数量自动堆叠。悬停展开当前图片，其余图片向两侧滑开；移出后收回。手机端可点选或使用下方箭头。宽图会等比例缩小以完整显示。" },
    { "type": "range", "id": "image_height", "label": "桌面端图片最大高度", "min": 240, "max": 840, "step": 20, "unit": "px", "default": 560 },
    { "type": "range", "id": "image_height_mobile", "label": "移动端图片最大高度", "min": 200, "max": 600, "step": 20, "unit": "px", "default": 400 },
    { "type": "range", "id": "overlap", "label": "初始重叠程度", "info": "图片较多或容器较窄时，自动增加重叠，确保所有图片都有露出。", "min": 20, "max": 85, "step": 5, "unit": "%", "default": 50 },
    { "type": "range", "id": "corner_radius", "label": "图片圆角", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 0 },
    { "type": "range", "id": "animation_duration", "label": "滑动动画时长", "min": 200, "max": 1000, "step": 50, "unit": "ms", "default": 500 },
    { "type": "header", "content": "间距" },
    { "type": "range", "id": "padding-block-start", "label": "上边距", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 36 },
    { "type": "range", "id": "padding-block-end", "label": "下边距", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 36 },
    { "type": "range", "id": "padding-inline-start", "label": "全宽左边距", "min": 0, "max": 100, "step": 2, "unit": "px", "default": 40 },
    { "type": "range", "id": "padding-inline-end", "label": "全宽右边距", "min": 0, "max": 100, "step": 2, "unit": "px", "default": 40 }
  ],
  "blocks": [
    {
      "type": "image", "name": "图片",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "图片" },
        { "type": "image_picker", "id": "image_mobile", "label": "移动端图片（可选）" },
        { "type": "text", "id": "alt", "label": "图片描述", "info": "供屏幕阅读器使用，留空则使用图片自身的描述。" },
        { "type": "text", "id": "title", "label": "图片标题（可留空）" },
        { "type": "url", "id": "link", "label": "链接" },
        { "type": "text", "id": "link_label", "label": "链接文字", "default": "Explore" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero Slideshow · 堆叠",
      "category": "图片",
      "blocks": [{ "type": "image" }, { "type": "image" }, { "type": "image" }, { "type": "image" }, { "type": "image" }]
    }
  ]
}
{% endschema %}
