{{ 'hero-stacked-slideshow.css' | asset_url | stylesheet_tag }}
<script src="{{ 'hero-stacked-slideshow.js' | asset_url }}" type="module" fetchpriority="low"></script>

{% render 'contrast-override',
  background_color: section.settings.background_color,
  text_color: section.settings.text_color,
  section_id: section.id
%}

<div class="section-background color-custom-{{ section.id }}"></div>
<div
  class="section section--{{ section.settings.section_width }} spacing-style color-custom-{{ section.id }} mv-hero-stack-section"
  style="
    {% render 'spacing-style', settings: section.settings %}
    --mv-stack-height: {% if section.settings.section_height == 'auto' %}auto{% else %}{{ section.settings.section_height | default: '640' }}px{% endif %};
    --mv-stack-height-mobile: {{ section.settings.image_height_mobile }}px;
    --mv-stack-padding-start-mobile: {{ section.settings.padding_top_mobile }}px;
    --mv-stack-padding-end-mobile: {{ section.settings.padding_bottom_mobile }}px;
    --mv-stack-radius: {{ section.settings.corner_radius }}px;
    --mv-stack-duration: {{ section.settings.animation_duration }}ms;
    --mv-stack-dim: {{ section.settings.inactive_opacity | divided_by: 100.0 }};
    --mv-stack-blur: {{ section.settings.inactive_blur }}px;
    --mv-stack-heading-size: {{ section.settings.heading_size }}px;
    --mv-stack-header-subtitle-size: {{ section.settings.header_subtitle_size }}px;
    --mv-stack-description-size: {{ section.settings.description_size }}px;
    --mv-stack-header-align: {{ section.settings.header_alignment }};
    {% if section.settings.header_text_color != blank %}--mv-stack-header-color: {{ section.settings.header_text_color }};{% endif %}
  "
>
  <mv-hero-stack
    class="mv-hero-stack"
    data-overlap="{{ section.settings.overlap }}"
    data-primary-width="{{ section.settings.primary_width | default: 100 }}"
    data-desktop-height="{{ section.settings.section_height | default: '640' }}"
    data-inactive-effect="{{ section.settings.inactive_effect }}"
    data-mobile-autoplay="{{ section.settings.mobile_autoplay }}"
    data-desktop-autoplay="{{ section.settings.desktop_autoplay }}"
    data-autoplay-speed="{{ section.settings.autoplay_speed | times: 1000 }}"
    role="region"
    aria-label="{{ section.settings.heading | default: 'Hero Slideshow' | escape }}"
  >
    {%- if section.settings.heading != blank or section.settings.subtitle != blank or section.settings.description != blank -%}
      <header class="mv-hero-stack__header">
        {%- if section.settings.subtitle != blank -%}
          <p class="mv-hero-stack__header-subtitle">{{ section.settings.subtitle | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="mv-hero-stack__heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.description != blank -%}
          <p class="mv-hero-stack__header-description">{{ section.settings.description | escape | newline_to_br }}</p>
        {%- endif -%}
      </header>
    {%- endif -%}
    <div class="mv-hero-stack__media">
    <div class="mv-hero-stack__stage" data-stack-stage>
      {%- for block in section.blocks -%}
        {%- liquid
          assign image = block.settings.image | default: block.settings.image_mobile
          assign mobile_image = block.settings.image_mobile | default: image
          assign image_ratio = image.aspect_ratio | default: 0.75
          assign mobile_ratio = mobile_image.aspect_ratio | default: image_ratio
          assign image_alt = block.settings.alt | default: image.alt | default: block.settings.title
          assign card_label = block.settings.title | default: image_alt | default: forloop.index
          assign image_loading = 'lazy'
          if section.index == 1
            assign image_loading = 'eager'
          endif
          assign placeholder_index = forloop.index0 | modulo: 4 | plus: 1
          assign placeholder = 'collection-apparel-' | append: placeholder_index
        -%}
        <div
          class="mv-hero-stack__card"
          data-stack-card
          data-block-id="{{ block.id }}"
          data-ratio="{{ image_ratio }}"
          data-image-width="{{ image.width | default: 800 }}"
          data-mobile-ratio="{{ mobile_ratio }}"
          data-primary="{{ block.settings.primary }}"
          style="
            --mv-caption-align: {{ block.settings.text_alignment | default: 'left' }};
            --mv-caption-color: {{ block.settings.caption_color | default: '#ffffff' }};
            --mv-caption-title-size: {{ block.settings.title_size }}px;
            --mv-caption-subtitle-size: {{ block.settings.subtitle_size }}px;
            --mv-caption-text-size: {{ block.settings.text_size }}px;
          "
          tabindex="0"
          role="group"
          aria-label="{{ forloop.index }} / {{ section.blocks.size }} — {{ card_label | escape }}"
          {{ block.shopify_attributes }}
        >
          {%- if image != blank or mobile_image != blank -%}
            {%- if image != blank -%}
              {{ image | image_url: width: 2400 | image_tag:
                class: 'mv-hero-stack__image mv-hero-stack__image--desktop',
                widths: '320, 480, 750, 1000, 1500, 2000, 2400',
                sizes: '(min-width: 750px) 80vw, 84vw',
                loading: image_loading,
                alt: image_alt
              }}
            {%- endif -%}
            {{ mobile_image | image_url: width: 1500 | image_tag:
              class: 'mv-hero-stack__image mv-hero-stack__image--mobile',
              widths: '320, 480, 750, 1000, 1500',
              sizes: '84vw',
              loading: image_loading,
              alt: image_alt
            }}
          {%- else -%}
            {{ placeholder | placeholder_svg_tag: 'mv-hero-stack__placeholder' }}
          {%- endif -%}
          {%- if block.settings.title != blank or block.settings.subtitle != blank or block.settings.text != blank or block.settings.link != blank -%}
            <div class="mv-hero-stack__caption" data-stack-caption inert>
              {%- if block.settings.subtitle != blank -%}
                <p class="mv-hero-stack__subtitle">{{ block.settings.subtitle | escape }}</p>
              {%- endif -%}
              {%- if block.settings.title != blank -%}
                <h3 class="mv-hero-stack__title">{{ block.settings.title | escape }}</h3>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <p class="mv-hero-stack__description">{{ block.settings.text | escape | newline_to_br }}</p>
              {%- endif -%}
              {%- if block.settings.link != blank -%}
                <a class="mv-hero-stack__link" href="{{ block.settings.link }}">
                  {{ block.settings.link_label | default: 'Explore' | escape }}
                </a>
              {%- endif -%}
            </div>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
    {%- if section.blocks.size > 1 -%}
      {%- if section.settings.show_controls or section.settings.mobile_autoplay or section.settings.desktop_autoplay -%}
      <div class="mv-hero-stack__controls{% unless section.settings.show_controls %} mv-hero-stack__controls--autoplay-only{% endunless %}">
        {%- if section.settings.show_controls -%}
          {% render 'carousel-arrow', action: 'previous', class: 'mv-hero-stack__previous' %}
        <span class="mv-hero-stack__counter" data-stack-counter aria-live="polite" aria-atomic="true">
          {{ section.blocks.size }}
        </span>
        {% render 'carousel-arrow', action: 'next', class: 'mv-hero-stack__next' %}
        {%- endif -%}
        {%- if section.settings.mobile_autoplay or section.settings.desktop_autoplay -%}
          <button
            type="button" class="mv-hero-stack__autoplay" data-stack-autoplay
            data-label-play="{{ 'accessibility.slideshow_play' | t | escape }}"
            data-label-pause="{{ 'accessibility.slideshow_pause' | t | escape }}"
            aria-label="{{ 'accessibility.slideshow_pause' | t | escape }}" aria-pressed="true"
          >
            <svg class="mv-hero-stack__progress" viewBox="0 0 32 32" aria-hidden="true">
              <circle class="mv-hero-stack__progress-track" cx="16" cy="16" r="13" />
              <circle class="mv-hero-stack__progress-ring" cx="16" cy="16" r="13" pathLength="100" data-stack-progress />
            </svg>
            <svg class="mv-hero-stack__pause-symbol" viewBox="0 0 16 16" aria-hidden="true"><path d="M5 4v8M11 4v8" /></svg>
            <svg class="mv-hero-stack__play-symbol" viewBox="0 0 16 16" aria-hidden="true"><path d="m6 4 6 4-6 4Z" /></svg>
          </button>
        {%- endif -%}
      </div>
      {%- endif -%}
    {%- endif -%}
    </div>
    {%- if section.blocks.size == 0 and request.design_mode -%}
      <p class="mv-hero-stack__empty">请添加图片区块，开始配置堆叠轮播。</p>
    {%- endif -%}
  </mv-hero-stack>
</div>

{% schema %}
{
  "name": "Hero Slideshow · 堆叠",
  "tag": "section",
  "class": "mv-hero-stack-wrapper",
  "disabled_on": { "groups": ["header", "footer"] },
  "max_blocks": 12,
  "settings": [
    { "type": "header", "content": "分区顶部文案" },
    { "type": "paragraph", "content": "以下设置控制图片上方的文案。每张图片内的叠加文案，请在对应「图片」子区块中的「图片叠加文案」设置。" },
    { "type": "text", "id": "subtitle", "label": "副标题（可留空）" },
    { "type": "text", "id": "heading", "label": "标题（可留空）" },
    { "type": "textarea", "id": "description", "label": "描述（可留空）" },
    { "type": "range", "id": "header_subtitle_size", "label": "副标题字号", "min": 10, "max": 24, "step": 1, "unit": "px", "default": 13 },
    { "type": "range", "id": "heading_size", "label": "标题字号", "min": 24, "max": 96, "step": 2, "unit": "px", "default": 40 },
    { "type": "range", "id": "description_size", "label": "描述字号", "min": 12, "max": 28, "step": 1, "unit": "px", "default": 16 },
    {
      "type": "select", "id": "header_alignment", "label": "顶部文案对齐", "default": "center",
      "options": [{ "value": "left", "label": "左对齐" }, { "value": "center", "label": "居中" }, { "value": "right", "label": "右对齐" }]
    },
    { "type": "color", "id": "header_text_color", "label": "顶部文案颜色", "placeholder": "t:settings.default" },
    { "type": "header", "content": "布局与配色" },
    {
      "type": "select", "id": "section_width", "label": "宽度", "default": "page-width",
      "options": [
        { "value": "page-width", "label": "页面宽度" },
        { "value": "full-width", "label": "全宽" }
      ]
    },
    { "type": "color", "id": "background_color", "label": "t:settings.background_color", "placeholder": "t:settings.default" },
    { "type": "color", "id": "text_color", "label": "t:settings.text_color", "placeholder": "t:settings.default" },
    { "type": "header", "content": "图片堆叠" },
    { "type": "paragraph", "content": "宽度足够时完整平铺，宽度不足时按原顺序堆叠，悬停只移动位置、调整遮挡，不改变图片大小。第一张聚焦时贴左，最后一张聚焦时贴右；中间图片根据两侧可用图片宽度定位，无循环补位。手机和桌面均可开启自动播放。" },
    { "type": "checkbox", "id": "show_controls", "label": "显示翻页按钮", "default": true },
    { "type": "checkbox", "id": "mobile_autoplay", "label": "移动端自动轮换", "default": false },
    { "type": "checkbox", "id": "desktop_autoplay", "label": "桌面端自动轮换", "default": false },
    { "type": "range", "id": "autoplay_speed", "label": "自动轮换间隔", "min": 2, "max": 12, "step": 1, "unit": "s", "default": 5, "visible_if": "{{ section.settings.mobile_autoplay or section.settings.desktop_autoplay }}" },
    {
      "type": "select", "id": "inactive_effect", "label": "非焦点图片效果", "default": "dim",
      "options": [
        { "value": "dim", "label": "黑色遮罩" },
        { "value": "blur", "label": "模糊" },
        { "value": "both", "label": "模糊与黑色遮罩" },
        { "value": "none", "label": "无" }
      ]
    },
    { "type": "range", "id": "inactive_opacity", "label": "非焦点黑色遮罩", "min": 0, "max": 80, "step": 5, "unit": "%", "default": 40 },
    { "type": "range", "id": "inactive_blur", "label": "非焦点模糊强度", "min": 0, "max": 12, "step": 1, "unit": "px", "default": 4 },
    { "type": "range", "id": "primary_width", "label": "主要优先图片展示宽度", "info": "相对于该图片的完整展示宽度，100% 为正常大小，调小后等比例缩小。请在对应图片区块勾选「设为主要优先图片」。", "min": 20, "max": 100, "step": 5, "unit": "%", "default": 100 },
    {
      "type": "select", "id": "section_height", "label": "桌面端高度", "default": "640",
      "options": [
        { "value": "640", "label": "640px" },
        { "value": "960", "label": "960px" },
        { "value": "auto", "label": "适应图片高度（自动）" }
      ]
    },
    { "type": "range", "id": "image_height_mobile", "label": "移动端图片最大高度", "min": 200, "max": 600, "step": 20, "unit": "px", "default": 400 },
    { "type": "range", "id": "overlap", "label": "堆叠重叠程度", "info": "仅宽度不足时生效。图片较多或容器较窄时，自动增加重叠，确保所有图片都有露出。", "min": 20, "max": 85, "step": 5, "unit": "%", "default": 50 },
    { "type": "range", "id": "corner_radius", "label": "图片圆角", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 0 },
    { "type": "range", "id": "animation_duration", "label": "滑动动画时长", "min": 200, "max": 1000, "step": 50, "unit": "ms", "default": 500 },
    { "type": "header", "content": "间距" },
    { "type": "range", "id": "padding-block-start", "label": "上边距", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 36 },
    { "type": "range", "id": "padding-block-end", "label": "下边距", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 36 },
    { "type": "range", "id": "padding_top_mobile", "label": "移动端上边距", "info": "按实际像素生效，不随主题间距比例缩放。", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 36 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "移动端下边距", "info": "按实际像素生效，不随主题间距比例缩放。", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 36 },
    { "type": "range", "id": "padding-inline-start", "label": "全宽左边距", "min": 0, "max": 100, "step": 2, "unit": "px", "default": 40 },
    { "type": "range", "id": "padding-inline-end", "label": "全宽右边距", "min": 0, "max": 100, "step": 2, "unit": "px", "default": 40 }
  ],
  "blocks": [
    {
      "type": "image", "name": "图片",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "图片" },
        { "type": "image_picker", "id": "image_mobile", "label": "移动端图片（可选）" },
        { "type": "checkbox", "id": "primary", "label": "设为主要优先图片", "info": "建议仅选一张；多张勾选时使用顺序最靠前的一张，未勾选时使用第一张。", "default": false },
        { "type": "text", "id": "alt", "label": "图片描述", "info": "供屏幕阅读器使用，留空则使用图片自身的描述。" },
        { "type": "header", "content": "图片叠加文案" },
        { "type": "text", "id": "subtitle", "label": "副标题（可留空）" },
        { "type": "text", "id": "title", "label": "图片标题（可留空）" },
        { "type": "textarea", "id": "text", "label": "描述（可留空）" },
        { "type": "range", "id": "title_size", "label": "标题字号", "min": 24, "max": 96, "step": 2, "unit": "px", "default": 56 },
        { "type": "range", "id": "subtitle_size", "label": "副标题字号", "min": 10, "max": 24, "step": 1, "unit": "px", "default": 13 },
        { "type": "range", "id": "text_size", "label": "描述字号", "min": 12, "max": 28, "step": 1, "unit": "px", "default": 16 },
        {
          "type": "select", "id": "text_alignment", "label": "文字对齐", "default": "left",
          "options": [{ "value": "left", "label": "左对齐" }, { "value": "center", "label": "居中" }, { "value": "right", "label": "右对齐" }]
        },
        { "type": "color", "id": "caption_color", "label": "叠加文字颜色", "default": "#ffffff" },
        { "type": "url", "id": "link", "label": "链接" },
        { "type": "text", "id": "link_label", "label": "链接文字", "default": "Explore" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero Slideshow · 堆叠",
      "category": "图片",
      "blocks": [{ "type": "image" }, { "type": "image" }, { "type": "image" }, { "type": "image" }, { "type": "image" }]
    }
  ]
}
{% endschema %}
