{%- liquid
  render 'contrast-override', background_color: section.settings.background_color, text_color: section.settings.text_color, section_id: section.id
-%}

{{ 'delivery-timeline.css' | asset_url | stylesheet_tag }}

<div class="section-background color-custom-{{ section.id }}"></div>
<div class="section page-width-normal color-custom-{{ section.id }}">
  <div class="delivery-timeline spacing-style" style="{% render 'spacing-style', settings: section.settings %}">
    {% if section.settings.heading != blank or section.settings.intro != blank %}
      <header class="delivery-timeline__header">
        {% if section.settings.heading != blank %}
          <h2 class="delivery-timeline__heading">{{ section.settings.heading | escape }}</h2>
        {% endif %}
        {% if section.settings.intro != blank %}
          <div class="delivery-timeline__intro rte">{{ section.settings.intro }}</div>
        {% endif %}
      </header>
    {% endif %}

    <ol class="delivery-timeline__steps" role="list">
      <li class="delivery-timeline__step">
        <span class="delivery-timeline__marker" aria-hidden="true"></span>
        <span class="delivery-timeline__milestone">{{ section.settings.order_label | escape }}</span>
        <div class="delivery-timeline__stage">
          <span class="delivery-timeline__stage-label">{{ section.settings.production_label | escape }}</span>
          <span class="delivery-timeline__duration">{{ section.settings.production_duration | escape }}</span>
        </div>
      </li>
      <li class="delivery-timeline__step">
        <span class="delivery-timeline__marker" aria-hidden="true"></span>
        <span class="delivery-timeline__milestone">{{ section.settings.dispatch_label | escape }}</span>
        <div class="delivery-timeline__stage">
          <span class="delivery-timeline__stage-label">{{ section.settings.transit_label | escape }}</span>
          <span class="delivery-timeline__duration">{{ section.settings.transit_duration | escape }}</span>
        </div>
      </li>
      <li class="delivery-timeline__step delivery-timeline__step--arrival">
        <span class="delivery-timeline__marker" aria-hidden="true"></span>
        <span class="delivery-timeline__milestone">{{ section.settings.arrival_label | escape }}</span>
      </li>
    </ol>

    {% if section.settings.note != blank %}
      <div class="delivery-timeline__note rte">{{ section.settings.note }}</div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Delivery timeline",
  "class": "section-wrapper",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "paragraph", "content": "An estimated delivery journey, not live order tracking. Defaults follow the requested production 2–5 days and transit 5–12 days. Confirm the day unit and align with your shipping policy before adding to a page." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "From order to arrival" },
    { "type": "richtext", "id": "intro", "label": "Introduction" },
    { "type": "header", "content": "Order and production" },
    { "type": "text", "id": "order_label", "label": "First milestone", "default": "Order placed" },
    { "type": "text", "id": "production_label", "label": "First stage", "default": "Production" },
    { "type": "text", "id": "production_duration", "label": "Production estimate", "default": "2–5 days", "info": "Editable text, including the unit (days or business days)." },
    { "type": "header", "content": "Dispatch and transit" },
    { "type": "text", "id": "dispatch_label", "label": "Second milestone", "default": "Dispatched" },
    { "type": "text", "id": "transit_label", "label": "Second stage", "default": "In transit" },
    { "type": "text", "id": "transit_duration", "label": "Transit estimate", "default": "5–12 days", "info": "Editable text. This default differs from the previously published Standard / Express estimates." },
    { "type": "text", "id": "arrival_label", "label": "Final milestone", "default": "Arrival" },
    { "type": "richtext", "id": "note", "label": "Estimate note", "default": "<p>Estimated timeframes only. Arrival dates are not guaranteed.</p>" },
    { "type": "header", "content": "Appearance" },
    { "type": "color", "id": "background_color", "label": "Background", "info": "Leave blank to inherit the theme palette." },
    { "type": "color", "id": "text_color", "label": "Text", "info": "Leave blank to inherit theme colors and contrast." },
    { "type": "range", "id": "padding-block-start", "label": "Top spacing", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 40 },
    { "type": "range", "id": "padding-block-end", "label": "Bottom spacing", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 40 }
  ],
  "presets": [{ "name": "Delivery timeline", "category": "t:categories.text" }]
}
{% endschema %}
